x 12px;background:var(--pn);border-bottom:1px solid var(--bd)}\nheader h1{font-size:16px;margin:0 8px 0 0}.sp{flex:1}\nmain{flex:1;display:flex;min-height:0}\n.stage{flex:1;overflow:auto;padding:16px;text-align:center}\n.zw{display:inline-block;text-align:left}\naside{width:250px;background:var(--pn);border-left:1px solid var(--bd);padding:12px;overflow:auto}\naside .r{display:flex;justify-content:space-between;align-items:center;margin:8px 0;gap:6px}\naside .r.hide{display:none}\naside .r[hidden]{display:none}\naside hr{border:0;border-top:1px solid var(--bd);margin:12px 0}\naside label.c{display:flex;gap:6px;margin:8px 0;align-items:center;cursor:pointer}\n.ro{border:1px solid var(--bd);border-radius:4px;padding:4px 8px;background:var(--bg);width:100%;text-align:center;margin:4px 0}\n.bt{display:flex;gap:6px;margin:8px 0}.bt button{flex:1;padding:6px 2px}\n.sc{color:var(--mu);font-size:12px;line-height:1.7}\n.sheet{position:relative;background:#fff;color:#000;box-shadow:0 2px 14px #0004;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n.cell{position:absolute;display:flex;flex-direction:column;box-sizing:border-box}\n.cell img{flex:1;min-height:0;width:100%;object-fit:contain;display:block}\n.cell img.fit{flex:none;width:auto;height:auto;max-width:100%;max-height:100%;margin:auto;object-fit:contain}\n.cell img.ol{outline:.35mm solid #000;outline-offset:-.35mm}\n.cap{height:4mm;font-size:2.8mm;line-height:4mm;text-align:center;overflow:hidden;white-space:nowrap}\n.cell.ed{border:1px solid #1b3a57;cursor:pointer}.cell.ed.sel{outline:3px solid var(--ac);z-index:2}\n.up{margin:auto;display:flex;flex-direction:column;align-items:center;gap:3mm}\n.up .cf{font-size:4.4mm;color:#000;white-space:nowrap;cursor:pointer}\n.up .cf span{border:1px solid #bbb;border-radius:1mm;padding:.6mm 2.2mm;margin-right:1.4mm;background:#f4f4f4}\n.up button{font-size:6.6mm;font-weight:700;color:#666;background:#fff;border:.7mm solid #888;border-radius:2.6mm;padding:2.2mm 8mm}\n.tb{position:absolute;top:2px;right:2px;display:none;gap:3px}.cell:hover .tb,.cell.sel .tb{display:flex}\n.tb button{padding:2px 7px;font-size:12px;background:#fffd;color:#000}\n.ov{position:fixed;inset:0;background:#000a;z-index:20;display:flex;flex-direction:column}\n.ov[hidden]{display:none}\n.bar{background:var(--pn);padding:8px 12px;display:flex;flex-wrap:wrap;gap:10px;align-items:center}\n.holder{flex:1;overflow:auto;padding:16px;text-align:center}\n.note{color:#fff;text-align:center;padding:6px;font-size:13px}\n#cm{align-items:center}\n.cw{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;width:100%}\n#cbox{position:relative;line-height:0;touch-action:none;user-select:none}\n#cimg{max-width:94vw;max-height:calc(100vh - 150px);display:block}\n#csv{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}\n#cpoly{fill:#1d6fe033;stroke:#fff;stroke-width:2}\n.pt{position:absolute;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;background:var(--ac);border:3px solid #fff;touch-action:none;cursor:grab}\n.dlg{background:var(--pn);padding:18px;border-radius:10px;min-width:290px;display:flex;flex-direction:column;gap:10px}\n.dlg label{display:flex;justify-content:space-between;gap:10px;align-items:center}\n#toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#222;color:#fff;padding:8px 14px;border-radius:8px;z-index:50;opacity:0;transition:.3s;pointer-events:none}\n@media (max-width:760px){main{flex-direction:column}aside{width:auto;border-left:0;border-top:1px solid var(--bd);max-height:42%}}\n@media print{\n html,body{background:#fff!important;height:auto}\n body>*:not(#pv){display:none!important}\n #pv{position:static!important;display:block!important;background:#fff!important}\n .bar,.note{display:none!important}\n .holder{padding:0!important;overflow:visible!important}\n .zw{zoom:1!important;display:block!important}.holder{line-height:0!important;height:auto!important}\n .sheet{box-shadow:none!important;margin:0!important;overflow:hidden!important;break-inside:avoid}\n .sheet.pg{break-after:page}.sheet.pg:last-child{break-after:auto}\n}\n</style><style>\n/* crop editor */\n#cm{align-items:stretch;background:#101216}\n#cm .note{background:#101216}\n#toast{max-width:90vw}\n#cm~#toast{bottom:84px}\n#cm .note{padding:6px 10px}\n#cm .tabs{border-radius:0;padding:6px 12px;gap:6px}\n#cm .tabs button.on{background:var(--ac);color:#fff;border-color:var(--ac)}\n#cm .cw{flex:1;min-height:0;overflow:auto;display:flex;width:100%;box-sizing:border-box;padding:22px;align-items:flex-start}\n#cm .cw>*{margin:auto;flex:none}\n#cm .cbar{margin:0;border-radius:0;justify-content:center;max-height:45vh;overflow:auto;gap:8px}\n#cm .cbar>span,#cm .cbar>label{display:inline-flex;gap:6px;align-items:center}\n#cm .cbar>.sp{flex:1;min-width:6px}\n#cm[data-mode=persp] .mr{display:none!important}\n#cm[data-mode=rect] .mp{display:none!important}\n#rbox{position:relative;line-height:0;user-select:none;-webkit-user-select:none}\n#rbox[hidden],#cbox[hidden]{display:none}\n#rcv{width:100%;height:100%;display:block;background:#fff}\n#rsel{position:absolute;box-sizing:border-box;border:2px solid #fff;box-shadow:0 0 0 100vmax #0009;cursor:move;touch-action:none;\n background:linear-gradient(#fff9,#fff9) 33.33% 0/1px 100% no-repeat,linear-gradient(#fff9,#fff9) 66.66% 0/1px 100% no-repeat,linear-gradient(#fff9,#fff9) 0 33.33%/100% 1px no-repeat,linear-gradient(#fff9,#fff9) 0 66.66%/100% 1px no-repeat}\n.hd{position:absolute;width:36px;height:36px;margin:-18px 0 0 -18px;touch-action:none}\n.hd::after{content:\"\";position:absolute;left:10px;top:10px;width:16px;height:16px;background:#fff;border:3px solid var(--ac);border-radius:4px;box-sizing:border-box}\n.hd[data-h=nw]{left:0;top:0;cursor:nwse-resize}.hd[data-h=n]{left:50%;top:0;cursor:ns-resize}.hd[data-h=ne]{left:100%;top:0;cursor:nesw-resize}\n.hd[data-h=e]{left:100%;top:50%;cursor:ew-resize}.hd[data-h=se]{left:100%;top:100%;cursor:nwse-resize}.hd[data-h=s]{left:50%;top:100%;cursor:ns-resize}\n.hd[data-h=sw]{left:0;top:100%;cursor:nesw-resize}.hd[data-h=w]{left:0;top:50%;cursor:ew-resize}\n#cimg{display:block;max-width:min(80vw,480px);max-height:min(56vh,520px)}\n#cm .cw{padding:16px}\n#cbox{touch-action:auto}\n.pdlg{flex-direction:row;flex-wrap:wrap;gap:22px;max-width:94vw;max-height:92vh;overflow:auto;box-sizing:border-box}\n.pcol{display:flex;flex-direction:column;gap:10px;width:390px;max-width:100%}\n.pdlg label.ck{justify-content:flex-start}\n.dlg label[hidden]{display:none}\n#lpv{background:var(--bg);border:1px solid var(--bd);border-radius:6px;height:340px;display:flex;align-items:center;justify-content:center;overflow:hidden}\n#lpv .lw{outline:1px dashed var(--ac);outline-offset:-1px;background:#fff;position:relative;overflow:hidden}\n#lpv .lw .sheet{position:absolute;left:0;top:0;transform-origin:0 0;box-shadow:none}\n.sheet.bl .cell img{object-fit:cover!important}\n/* manual crop extras */\n#cpoly{fill:none}#cdim{fill:#0008;fill-rule:evenodd}#cgrid{stroke:#fff7;stroke-width:1;fill:none}\n.pt.sel{background:#ffb703}\n.mh{position:absolute;width:20px;height:20px;margin:-10px 0 0 -10px;background:#fff;border:3px solid var(--ac);border-radius:6px;box-sizing:border-box;touch-action:none;cursor:grab;font:12px/14px system-ui;color:var(--ac);text-align:center;line-height:14px}\n.mh.mc{width:28px;height:28px;margin:-14px 0 0 -14px;border-radius:50%;font-size:16px;line-height:22px}\n#cloupe{position:absolute;left:10px;top:44px;z-index:3;width:130px;height:130px;border:2px solid #fff;border-radius:50%;background:#000;pointer-events:none;display:none}\n#cpw{position:absolute;top:44px;right:10px;z-index:3;background:#000b;color:#fff;font-size:11px;padding:4px;border-radius:6px;text-align:center;pointer-events:none}\n#cprev{display:block;max-width:150px;max-height:180px;background:#fff;margin-top:3px}\n@media (max-width:760px){#cpw{top:40px;right:6px}#cprev{max-width:90px;max-height:110px}#cloupe{width:100px;height:100px;left:6px}}\n</style>\n</head><body>\n<header>\n <h1>CNIC &amp; Photo Print</h1>\n <button data-m=\"cnic\">CNIC A4</button><button data-m=\"photo\">A4</button>\n <span class=\"sp\"></span>\n <button id=\"undo\" title=\"Ctrl+Z\">Undo</button><button id=\"redo\" title=\"Ctrl+Y\">Redo</button>\n <button id=\"zo\" title=\"Zoom out\">−</button><button id=\"zl\" title=\"Reset zoom\">100%</button><button id=\"zi\" title=\"Zoom in\">+</button><button id=\"prev\">Preview</button><button class=\"pri\" id=\"print\" title=\"Ctrl+P\">Print</button>\n</header>\n<main>\n <div class=\"stage\" id=\"stage\"><div class=\"zw\" id=\"zw\"></div></div>\n <aside>\n  <div class=\"r\"><span>Paper size</span><select id=\"paper\"><option value=\"4x6\">4×6 in</option><option value=\"5x7\">5×7 in</option><option value=\"A4\">A4</option><option value=\"Letter\">Letter</option><option value=\"Legal\">Legal</option><option value=\"Other\">Custom</option></select></div>\n  <hr>\n  <div class=\"r\" id=\"rRows\"><span>Rows per page</span><span style=\"display:flex;gap:4px;align-items:center\"><button id=\"rowM\" title=\"Remove a row\" style=\"padding:2px 9px\">−</button><select id=\"rows\"></select><button id=\"rowP\" title=\"Add a row\" style=\"padding:2px 9px\">+</button></span></div>\n  <div class=\"r\" id=\"rCols\"><span>Columns per page</span><select id=\"cols\"></select></div>\n  <div class=\"ro\" id=\"ppp\"></div>\n  <div class=\"r\"><span>Filename</span><select id=\"name\"><option value=\"0\">Off</option><option value=\"1\">On</option></select></div>\n  <div class=\"r\" id=\"rGap\"><span>Intervals (mm)</span><input type=\"number\" id=\"gap\" min=\"0\" max=\"30\" step=\"1\" style=\"width:70px\"></div>\n  <div class=\"r\"><span>Page</span><select id=\"orient\"><option value=\"p\">Portrait</option><option value=\"l\">Landscape</option></select></div>\n  <hr>\n  <div class=\"r\"><button id=\"pp\">◀</button><b id=\"pgl\"></b><button id=\"pn\">▶</button></div>\n  <div class=\"bt\"><button id=\"addpg\">+ Add page</button><button id=\"delpg\">Delete page</button></div>\n  <hr>\n  <label class=\"c\"><input type=\"checkbox\" id=\"outline\"> Draw outline for photo</label>\n  <label class=\"c\"><input type=\"checkbox\" id=\"rotate\"> Auto-Rotate by 90 degrees</label>\n  <div class=\"bt\"><button id=\"gray\">Grayscale</button><button id=\"sepia\">Sepia</button><button id=\"reset\">Reset</button></div>\n  <hr>\n  <label class=\"c\"><input type=\"checkbox\" id=\"enh\"> Auto-enhance to 4K on upload</label>\n  <div class=\"bt\"><button id=\"pasteBtn\">📋 Paste image</button></div>\n  <hr>\n  <div class=\"bt\" id=\"rFill\"><button id=\"fill\">Copy 1st to all</button></div>\n  <div class=\"bt\"><button id=\"clear\">Clear all photos</button></div>\n  <hr>\n  <div class=\"sc\"><b>Shortcuts</b><br>Print: Ctrl+P · Copy: Ctrl+C<br>Cut: Ctrl+X · Paste: Ctrl+V<br>Undo: Ctrl+Z · Redo: Ctrl+Y<br>Ctrl+V also uploads any image you copied (screenshot, web image, file).<br>Click a box to select it. Drag &amp; drop files onto boxes too.<br>Crop button on a photo = adjust crop (Enter = Apply, Esc = Cancel).</div>\n </aside>\n</main>\n\n<div class=\"ov\" id=\"pv\" hidden>\n <div class=\"bar\">\n  <b id=\"pvT\">Print preview</b>\n  <label><input type=\"checkbox\" id=\"outline2\"> Outline</label>\n  <span class=\"sp\"></span>\n  <button id=\"pvSet\">Print settings</button><button class=\"pri\" id=\"doPrint\">Print</button><button id=\"pvClose\">Close</button>\n </div>\n <div class=\"holder\" id=\"holder\"><div class=\"zw\" id=\"pzw\"></div></div>\n <div class=\"note\" id=\"pnote\"></div>\n</div>\n\n<div class=\"ov\" id=\"cm\" hidden>\n <div class=\"note\">Drag the blue corners · square handles slide an edge · ✥ moves the whole crop · keys 1-4 pick a corner, arrows nudge (Shift = bigger) · Ctrl+scroll zooms. The small preview shows the result.</div>\n <canvas id=\"cloupe\" width=\"130\" height=\"130\"></canvas>\n <div id=\"cpw\"><div>Corrected result</div><canvas id=\"cprev\" width=\"1\" height=\"1\"></canvas></div>\n <div class=\"cw\" id=\"cwrap\"><div id=\"cbox\"><img id=\"cimg\" alt=\"\"><svg id=\"csv\"><path id=\"cdim\"/><path id=\"cgrid\"/><polygon id=\"cpoly\"/></svg><b class=\"mh\" data-k=\"4\"></b><b class=\"mh\" data-k=\"5\"></b><b class=\"mh\" data-k=\"6\"></b><b class=\"mh\" data-k=\"7\"></b><b class=\"mh mc\" data-k=\"8\">✥</b><b class=\"pt\" data-k=\"0\"></b><b class=\"pt\" data-k=\"1\"></b><b class=\"pt\" data-k=\"2\"></b><b class=\"pt\" data-k=\"3\"></b></div></div>\n <div class=\"bar cbar\">\n  <label>Straighten <input type=\"range\" id=\"cAng\" min=\"-45\" max=\"45\" step=\"0.1\" value=\"0\" style=\"width:120px;vertical-align:middle\"> <b id=\"cAngV\" style=\"display:inline-block;min-width:46px\">0.0°</b></label>\n  <button id=\"cRotL\" title=\"Rotate left 90°\">⟲ Left</button><button id=\"cRotR\" title=\"Rotate right 90°\">Right ⟳</button><button id=\"cFlip\">⇋ Flip</button>\n  <span><button id=\"cZo\" title=\"Zoom out\">−</button><button id=\"cZf\" title=\"Fit to screen\">Fit</button><button id=\"cZi\" title=\"Zoom in\">+</button></span>\n  <span><button id=\"cUndo\" title=\"Undo point move (Ctrl+Z)\">↶ Undo</button><button id=\"cRedo\" title=\"Redo (Ctrl+Y)\">↷ Redo</button></span>\n  <span><button id=\"cGrow\" title=\"Grow the crop outward a little\">Expand</button><button id=\"cShr\" title=\"Shrink the crop inward a little\">Shrink</button></span>\n  <label title=\"Crop to an exact shape (stretches the result to this ratio)\">Ratio <select id=\"cRatio\"><option value=\"0\">Free</option><option value=\"1.5852\">ID card 85.6×54</option><option value=\"1.4142\">A4 / A-series</option><option value=\"1.2941\">Letter</option><option value=\"1.5\">4×6</option><option value=\"1.3333\">3:4</option><option value=\"1\">Square</option></select></label>\n  <label title=\"After you drop a corner, jump to the nearest sharp corner\"><input type=\"checkbox\" id=\"cSnap\"> Snap</label>\n  <button id=\"cAuto\">Auto detect</button><button id=\"cFull\">Reset</button>\n  <span class=\"sp\"></span>\n  <button id=\"cCancel\">Cancel</button><button class=\"pri\" id=\"cApply\">Apply</button>\n </div>\n</div>\n<div class=\"ov\" id=\"pd\" hidden style=\"align-items:center;justify-content:center;z-index:30\"><div class=\"dlg pdlg\">\n <div class=\"pcol\">\n <b style=\"font-size:16px\">Print settings</b>\n <label>Printer <span style=\"display:flex;gap:4px\"><select id=\"printer\" style=\"max-width:170px\"></select><button id=\"prAdd\" title=\"Add printer name\" style=\"padding:2px 9px\">+</button><button id=\"prDel\" title=\"Remove selected printer\" style=\"padding:2px 9px\">−</button></span></label>\n <label>Paper size <select id=\"paper2\"><option value=\"4x6\">4×6 in (101.6 × 152.4 mm)</option><option value=\"5x7\">5×7 in (127 × 177.8 mm)</option><option value=\"A4\">A4 (210 × 297 mm)</option><option value=\"Letter\">Letter (215.9 × 279.4 mm)</option><option value=\"Legal\">Legal (215.9 × 355.6 mm)</option><option value=\"Other\">Custom…</option></select></label>\n <label id=\"oth\" hidden>Custom W × H (mm)<span><input type=\"number\" id=\"cw\" style=\"width:60px\"> × <input type=\"number\" id=\"ch\" style=\"width:60px\"></span></label>\n <label>Paper type <select id=\"qual\"><option>Plain</option><option>Glossy</option><option>Matte</option><option>Premium Glossy</option></select></label>\n <label>Print quality <select id=\"pq\"><option>Draft</option><option>Standard</option><option>High</option><option>Best Photo</option></select></label>\n <label>Orientation <select id=\"orient2\"><option value=\"p\">Portrait</option><option value=\"l\">Landscape</option></select></label>\n <label>Colour <select id=\"colour\"><option value=\"colour\">Colour</option><option value=\"bw\">Black &amp; white</option></select></label>\n <label class=\"ck\"><span><input type=\"checkbox\" id=\"bless\"> Borderless (fill page, crops edges — no stretching)</span></label>\n <label>Margins (mm) <input type=\"number\" id=\"mar\" min=\"0\" max=\"50\" step=\"0.5\" placeholder=\"Auto\" style=\"width:72px\"></label>\n <label><span><input type=\"radio\" name=\"pr\" value=\"cur\" checked> Current page</span></label>\n <label><span><input type=\"radio\" name=\"pr\" value=\"all\"> All pages</span></label>\n <label><span><input type=\"radio\" name=\"pr\" value=\"cus\"> Custom pages</span><input id=\"prt\" placeholder=\"e.g. 1,3-5\" style=\"width:110px\"></label>\n <div class=\"sc\" id=\"pinfo\"></div>\n <div class=\"sc\" id=\"sizeinfo\"></div>\n <div class=\"sc\" id=\"phelp\"></div>\n <div class=\"bt\"><button class=\"pri\" id=\"pdOk\">Print…</button><button id=\"exp\">Export 300 DPI</button><button id=\"pdNo\">Cancel</button></div>\n </div>\n <div class=\"pcol\"><b>Live preview</b><div id=\"lpv\"></div><div class=\"sc\" id=\"lpvn\"></div></div>\n</div></div>\n<input type=\"file\" id=\"fi\" accept=\"image/*,.pdf,application/pdf\" multiple hidden>\n<div id=\"toast\"></div>\n\n<script>\nconst $=s=>document.querySelector(s),PX=3.7795;\nconst PAPER={'4x6':[101.6,152.4],'5x7':[127,177.8],A4:[210,297],Letter:[215.9,279.4],Legal:[215.9,355.6]};\nconst DEF={cnic:[5,2],photo:[1,1]};\nlet S={mode:'cnic',rows:5,cols:2,gap:4,outline:true,rotate:true,filter:'none',name:false,paper:'A4',cw:200,ch:200,quality:'Plain',pq:'High',margin:'',bless:false,books:{cnic:{pages:[[]],pg:0},photo:{pages:[[]],pg:0}},orient:'p',colour:'colour',sel:-1};\nlet U=[],R=[],clip=null,lastUp=null,tgt=0,RC=new Map(),Z=1;const PR={mode:'cur',txt:''};\nconst MN={cnic:'CNIC A4',photo:'A4'};\nObject.defineProperty(S,'pages',{get(){return S.books[S.mode].pages},set(v){S.books[S.mode].pages=v}});\nObject.defineProperty(S,'pg',{get(){return S.books[S.mode].pg},set(v){S.books[S.mode].pg=v}});\nObject.defineProperty(S,'slots',{get(){return S.pages[S.pg]},set(v){S.pages[S.pg]=v}});\nconst cpy=b=>({pg:b.pg,pages:b.pages.map(p=>p.slice())});\nconst snap=()=>{const{sel,books,...r}=S;return{...r,books:{cnic:cpy(books.cnic),photo:cpy(books.photo)}}};\nconst rest=o=>{const{books,...r}=o;Object.assign(S,r);S.books={cnic:cpy(books.cnic),photo:cpy(books.photo)}};\nconst mut=f=>{U.push(snap());if(U.length>60)U.shift();R=[];f();render()};\nconst undo=()=>{if(U.length){R.push(snap());rest(U.pop());render()}};\nconst redo=()=>{if(R.length){U.push(snap());rest(R.pop());render()}};\nconst count=()=>S.rows*S.cols;\nconst PN={'4x6':'4×6 in','5x7':'5×7 in',Other:'Custom'},pName=()=>PN[S.paper]||S.paper;\nconst dims=()=>{const d=S.paper==='Other'?[S.cw,S.ch]:PAPER[S.paper];return S.orient==='l'?[Math.max(...d),Math.min(...d)]:[Math.min(...d),Math.max(...d)]};\nconst toast=m=>{const t=$('#toast');t.textContent=m;t.style.opacity=1;clearTimeout(t._t);t._t=setTimeout(()=>t.style.opacity=0,2200)};\nconst loadImg=u=>new Promise((ok,no)=>{const i=new Image();i.onload=()=>ok(i);i.onerror=no;i.src=u});\nconst firstEmpty=()=>{for(let i=0;i<count();i++)if(!S.slots[i])return i;return 0};\nconst nextEmpty=i=>{for(let j=i+1;j<count();j++)if(!S.slots[j])return j;for(let j=0;j<=i&&j<count();j++)if(!S.slots[j])return j;return -1};\n\n/* ---------- geometry ---------- */\nfunction geom(pw,ph){\n const cn=S.mode==='cnic',g=S.gap,m=S.margin===''?null:+S.margin,out=[];\n const BL=S.bless;\n const side=BL?0:m!=null?m:cn&&S.cols==2?8:S.cols==2?38.1:S.cols>=3?5.08:10,top=BL?0:m!=null?m:cn?6:10;\n let cw,ch,y0;\n if(BL){const gg=0;cw=pw/S.cols;ch=ph/S.rows;y0=0;const o=[];for(let r=0;r<S.rows;r++)for(let c=0;c<S.cols;c++)o.push({x:c*cw,y:r*ch,w:cw,h:ch});return o}\n if(S.paper==='4x6'){cw=30.48;ch=22.86;y0=(ph-(S.rows*ch+(S.rows-1)*g))/2}\n else{cw=(pw-2*side-(S.cols-1)*g)/S.cols;ch=(ph-2*top-(S.rows-1)*g)/S.rows;\n  if(S.mode==='cnic'){ch=Math.min(ch,cw*54/85.6);cw=ch*85.6/54}\n  y0=m!=null?(ph-(S.rows*ch+(S.rows-1)*g))/2:top}\n const x0=(pw-(S.cols*cw+(S.cols-1)*g))/2;\n for(let r=0;r<S.rows;r++)for(let c=0;c<S.cols;c++)out.push({x:x0+c*(cw+g),y:y0+r*(ch+g),w:cw,h:ch});\n return out}\n\n/* ---------- sheet ---------- */\nfunction rot(s,c){\n if(!S.rotate||S.mode!=='cnic'||(c.w>c.h)===(s.w>s.h))return s.src;\n if(RC.has(s.src))return RC.get(s.src)||s.src;\n RC.set(s.src,null);\n loadImg(s.src).then(im=>{const k=newC(im.height,im.width),x=k.getContext('2d');x.translate(k.width/2,k.height/2);x.rotate(Math.PI/2);x.drawImage(im,-im.width/2,-im.height/2);return blobURL(k)}).then(u=>{RC.set(s.src,u);render()});\n return s.src}\nfunction sheet(ed,sl=S.slots){\n const[pw,ph]=dims(),sh=document.createElement('div');\n sh.className='sheet'+(S.bless?' bl':'');sh.style.width=pw+'mm';sh.style.height=(ed?ph:ph-0.8)+'mm';\n geom(pw,ph).forEach((c,i)=>{\n  if(i>=count())return;const s=sl[i];if(!s&&!ed)return;\n  const d=document.createElement('div');d.className='cell'+(ed?' ed':'')+(ed&&S.sel===i?' sel':'');d.dataset.i=i;\n  Object.assign(d.style,{left:c.x+'mm',top:c.y+'mm',width:c.w+'mm',height:c.h+'mm'});\n  if(S.mode==='photo'){d.style.justifyContent='center';d.style.alignItems='center'}\n  if(s){\n   const im=new Image();im.src=rot(s,c);\n   {const f=S.colour==='bw'||S.filter==='gray'?'grayscale(1)':S.filter==='sepia'?'sepia(1)':'';if(f)im.style.filter=f}\n   if(S.outline)im.classList.add('ol');if(S.mode==='photo'&&!S.bless){const k=Math.min(c.w/s.w,(c.h-(S.name?4:0))/s.h);im.style.cssText+=`flex:none;width:${s.w*k}mm;height:${s.h*k}mm`}\n   d.append(im);\n   if(S.name){const p=document.createElement('div');p.className='cap';p.textContent=s.name;d.append(p)}\n   if(ed)d.insertAdjacentHTML('beforeend','<div class=\"tb\"><button data-a=\"crop\">Crop</button><button data-a=\"auto\">Auto</button><button data-a=\"del\">✕</button></div>');\n  }else if(c.w<50)d.innerHTML='<div class=\"up\"><button data-a=\"pick\" style=\"font-size:3mm;padding:1mm 2.5mm;border-width:.3mm;border-radius:1mm\">+ Upload</button></div>';else d.innerHTML='<div class=\"up\"><div class=\"cf\" data-a=\"pick\"><span>Choose file</span>No file chosen</div><button data-a=\"pick\">Upload a file</button></div>';\n  sh.append(d)});\n return sh}\nconst fit=(wrap,pw,box)=>{wrap.style.zoom=Math.max(.15,Math.min(.7,(box.clientWidth-34)/(pw*PX)*.6))*Z};\n\nfunction render(){\n $('#rows').value=S.rows;$('#cols').value=S.cols;$('#name').value=S.name?1:0;$('#gap').value=S.gap;\n $('#outline').checked=$('#outline2').checked=S.outline;$('#rotate').checked=S.rotate;$('#enh').checked=ENH.on;\n $('#gray').classList.toggle('on',S.filter==='gray');$('#sepia').classList.toggle('on',S.filter==='sepia');\n document.querySelectorAll('[data-m]').forEach(b=>b.classList.toggle('on',b.dataset.m===S.mode));\n \n $('#ppp').textContent=count()+' photos per page';\n $('#undo').disabled=!U.length;$('#redo').disabled=!R.length;\n $('#paper').value=$('#paper2').value=S.paper;$('#bless').checked=S.bless;$('#mar').disabled=S.bless;$('#qual').value=S.quality;$('#pq').value=S.pq;$('#mar').value=S.margin;{const[pw,ph]=dims(),g0=geom(pw,ph),c0=g0[0],L=g0[g0.length-1],over=c0&&(c0.x<0||c0.y<0||L.x+L.w>pw+.01||L.y+L.h>ph+.01);$('#sizeinfo').innerHTML=`Page ${pw.toFixed(1)} × ${ph.toFixed(1)} mm · box ${c0?c0.w.toFixed(1)+' × '+c0.h.toFixed(1)+' mm':''}`+(over?'<br><b style=\"color:#d33\">Boxes do not fit — reduce rows/columns or interval.</b>':'')}$('#oth').hidden=S.paper!=='Other';$('#cw').value=S.cw;$('#ch').value=S.ch;\n $('#orient').value=$('#orient2').value=S.orient;$('#colour').value=S.colour;$('#pgl').textContent=`${S.pg+1} / ${S.pages.length}`;$('#zl').textContent=Math.round(Z*100)+'%';$('#pvT').textContent='Print preview — '+MN[S.mode];\n const zw=$('#zw');zw.replaceChildren(sheet(true));fit(zw,dims()[0],$('#stage'));\n if(!$('#pv').hidden)paintPv();if(!$('#pd').hidden)paintLpv()}\n\nfunction paintLpv(){\n const[pw,ph]=dims(),L=pgList(),p=L.length?L[0]:S.pg,box=$('#lpv'),BW=box.clientWidth-24||300,BH=box.clientHeight-24||300;\n const k=Math.min(BW/(pw*PX),BH/(ph*PX)),w=document.createElement('div');w.className='lw';w.style.width=pw*PX*k+'px';w.style.height=ph*PX*k+'px';\n const sh=sheet(false,S.pages[p]||[]);sh.style.height=ph+'mm';sh.style.transform=`scale(${k})`;w.append(sh);box.replaceChildren(w);\n $('#lpvn').textContent=`Showing page ${p+1} of ${L.length||1} selected · true proportions ${pw.toFixed(1)}:${ph.toFixed(1)} mm`;\n const W=Math.round(pw/25.4*300),H=Math.round(ph/25.4*300);\n $('#pinfo').textContent=`${MN[S.mode]} layout · Page ${pw.toFixed(1)} × ${ph.toFixed(1)} mm · Margins ${S.bless?'none (borderless)':S.margin===''?'auto':S.margin+' mm'} · Export ${W} × ${H} px @ 300 DPI`;\n $('#phelp').innerHTML=`<b>Printer: ${PRN.cur}</b><br>Clicking Print opens your system print dialog — select <b>${PRN.cur}</b> there. Browsers cannot set driver options directly, so in the dialog: set <b>Scale 100% / Actual size</b>, paper size <b>${pName()}</b>${S.bless?', <b>Borderless</b> on':''}, and under <i>Preferences / More settings</i> pick Media type <b>${S.quality}</b>, Quality <b>${S.pq}</b>${S.colour==='bw'?', <b>Grayscale</b>':''}.`}\nfunction pgList(){const n=S.pages.length;if(PR.mode==='all')return[...Array(n).keys()];if(PR.mode==='cur')return[S.pg];const o=[];PR.txt.split(',').forEach(t=>{const m=t.trim().match(/^(\\d+)(?:-(\\d+))?$/);if(m)for(let a=+m[1];a<=+(m[2]||m[1]);a++)if(a>=1&&a<=n&&!o.includes(a-1))o.push(a-1)});return o.sort((a,b)=>a-b)}\nfunction paintPv(){\n const[pw,ph]=dims();$('#pst').textContent=`@page{size:${pw}mm ${ph}mm;margin:0}`;\n const z=$('#pzw'),L=pgList();z.replaceChildren();\n L.forEach(p=>{const s=sheet(false,S.pages[p]);s.classList.add('pg');s.style.marginBottom='12px';z.append(s)});\n fit(z,pw,$('#holder'));\n const n=L.reduce((a,p)=>a+S.pages[p].slice(0,count()).filter(Boolean).length,0);\n $('#pnote').textContent=n?`${L.length} page(s) · ${n} photo(s) · ${MN[S.mode]} · ${pName()} ${S.orient==='l'?'landscape':'portrait'} · ${S.quality} paper · ${S.pq} — pick the same paper type in your printer dialog.`:'No photos in the selected pages — upload photos first.'}\n\n/* ---------- export 300 DPI ---------- */\nasync function exportPages(){\n const[pw,ph]=dims(),D=300/25.4,W=Math.round(pw/25.4*300),H=Math.round(ph/25.4*300),G=geom(pw,ph);\n const best=S.pq==='Best Photo',q={Draft:.7,Standard:.85,High:.92}[S.pq]||.92,L=[...S.pages.keys()];\n const list=L.filter(p=>S.pages[p].slice(0,count()).some(Boolean));if(!list.length)return toast('No photos to export');\n for(let n=0;n<50&&rotBusy();n++)await new Promise(r=>setTimeout(r,100));\n for(const p of list){\n  const c=newC(W,H),x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,W,H);x.imageSmoothingQuality='high';\n  const f=S.colour==='bw'||S.filter==='gray'?'grayscale(1)':S.filter==='sepia'?'sepia(1)':'none';\n  for(let i=0;i<count();i++){const s=S.pages[p][i],b=G[i];if(!s||!b)continue;\n   const im=await loadImg(rot(s,b)),cap=S.name?4:0,bh=b.h-cap,k=(S.bless?Math.max:Math.min)(b.w/im.naturalWidth,bh/im.naturalHeight),iw=im.naturalWidth*k,ih=im.naturalHeight*k,ix=b.x+(b.w-iw)/2,iy=b.y+(bh-ih)/2;\n   x.save();x.beginPath();x.rect(b.x*D,b.y*D,b.w*D,b.h*D);x.clip();x.filter=f;x.drawImage(im,ix*D,iy*D,iw*D,ih*D);x.restore();\n   if(S.outline){x.strokeStyle='#000';x.lineWidth=.35*D;x.strokeRect((ix+.175)*D,(iy+.175)*D,(iw-.35)*D,(ih-.35)*D)}\n   if(S.name){x.fillStyle='#000';x.font=`${2.8*D}px system-ui,Arial`;x.textAlign='center';x.textBaseline='middle';x.fillText(s.name,(b.x+b.w/2)*D,(b.y+bh+2)*D,b.w*D)}}\n  const blob=await new Promise(r=>c.toBlob(r,best?'image/png':'image/jpeg',best?undefined:q)),u=URL.createObjectURL(blob),a=document.createElement('a');\n  a.href=u;a.download=`${MN[S.mode].replace(/\\s+/g,'_')}_${S.paper}_page${p+1}_300dpi.${best?'png':'jpg'}`;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),30000);\n  await new Promise(r=>setTimeout(r,300))}\n toast(`Exported ${list.length} page(s) at ${W} × ${H} px`)}\n\n/* ---------- helpers ---------- */\nconst newC=(w,h)=>{const c=document.createElement('canvas');c.width=Math.max(1,Math.round(w));c.height=Math.max(1,Math.round(h));return c};\nconst blobURL=(c,q=.95)=>new Promise((ok,no)=>c.toBlob(b=>b?ok(URL.createObjectURL(b)):no(Error('blob')),'image/jpeg',q));\nconst cl=(v,a,b)=>v<a?a:v>b?b:v;\nconst tick=()=>new Promise(r=>setTimeout(r,16));\n/* print-ready size: about 600 DPI for the current box size, between 2400 and 3840 px */\nconst capPx=()=>{const[pw,ph]=dims(),g=geom(pw,ph)[0]||{w:100,h:100};return Math.round(cl(Math.max(g.w,g.h)/25.4*600,2400,3840))};\nfunction capC(c){const k=Math.min(1,capPx()/Math.max(c.width,c.height));if(k>=1)return c;const o=newC(c.width*k,c.height*k),x=o.getContext('2d');x.imageSmoothingQuality='high';x.drawImage(c,0,0,o.width,o.height);return o}\n\n/* ---------- auto crop (detects the card / photo on a plain background) ---------- */\nfunction autoCrop(c){\n const k=Math.min(1,500/Math.max(c.width,c.height)),w=Math.max(4,Math.round(c.width*k)),h=Math.max(4,Math.round(c.height*k));\n const t=newC(w,h),x=t.getContext('2d');x.drawImage(c,0,0,w,h);\n const d=x.getImageData(0,0,w,h).data,p=(i,j)=>(j*w+i)*4,ring=[];\n for(let i=0;i<w;i++)ring.push(p(i,0),p(i,h-1));for(let j=0;j<h;j++)ring.push(p(0,j),p(w-1,j));\n const med=n=>{const a=ring.map(q=>d[q+n]).sort((m,o)=>m-o);return a[a.length>>1]};\n const bg=[med(0),med(1),med(2)],rc=new Uint16Array(h),cc=new Uint16Array(w);\n for(let j=0;j<h;j++)for(let i=0;i<w;i++){const q=p(i,j);if(Math.abs(d[q]-bg[0])+Math.abs(d[q+1]-bg[1])+Math.abs(d[q+2]-bg[2])>60){rc[j]++;cc[i]++}}\n let y0=0,y1=h-1,x0=0,x1=w-1;\n while(y0<h&&rc[y0]<w*.02)y0++;while(y1>y0&&rc[y1]<w*.02)y1--;\n while(x0<w&&cc[x0]<h*.02)x0++;while(x1>x0&&cc[x1]<h*.02)x1--;\n if((x1-x0)*(y1-y0)<.08*w*h)return null;\n const pad=.01*Math.max(w,h);x0=Math.max(0,x0-pad);y0=Math.max(0,y0-pad);x1=Math.min(w-1,x1+pad);y1=Math.min(h-1,y1+pad);\n return{x:x0/k,y:y0/k,w:(x1-x0)/k,h:(y1-y0)/k}}\nfunction cropC(c,r){const o=newC(r.w,r.h);o.getContext('2d').drawImage(c,r.x,r.y,r.w,r.h,0,0,o.width,o.height);return o}\n/* ---------- auto quad: finds the 4 corners of a tilted document / card on a busy background ----------\n   gray -> blur -> Otsu threshold -> largest blob (tried light + dark) -> convex hull -> 4 extreme corners */\nfunction hullOf(P){\n P.sort((a,b)=>a[0]-b[0]||a[1]-b[1]);\n const cr=(o,a,b)=>(a[0]-o[0])*(b[1]-o[1])-(a[1]-o[1])*(b[0]-o[0]),lo=[],up=[];\n for(const p of P){while(lo.length>1&&cr(lo[lo.length-2],lo[lo.length-1],p)<=0)lo.pop();lo.push(p)}\n for(let i=P.length-1;i>=0;i--){const p=P[i];while(up.length>1&&cr(up[up.length-2],up[up.length-1],p)<=0)up.pop();up.push(p)}\n lo.pop();up.pop();return lo.concat(up)}\nconst polyA=H=>{let a=0;for(let i=0;i<H.length;i++){const p=H[i],q=H[(i+1)%H.length];a+=p[0]*q[1]-q[0]*p[1]}return Math.abs(a)/2};\nfunction autoQuad(c){\n const k=Math.min(1,320/Math.max(c.width,c.height)),w=Math.max(8,Math.round(c.width*k)),h=Math.max(8,Math.round(c.height*k)),n=w*h;\n const t=newC(w,h),x=t.getContext('2d');x.drawImage(c,0,0,w,h);\n const d=x.getImageData(0,0,w,h).data,g=new Uint8ClampedArray(n*4);\n for(let i=0;i<n;i++){const v=(d[i*4]*77+d[i*4+1]*150+d[i*4+2]*29)>>8;g[i*4]=g[i*4+1]=g[i*4+2]=v;g[i*4+3]=255}\n const b=blur(g,w,h,2),hist=new Uint32Array(256);\n for(let i=0;i<n;i++)hist[b[i*4]]++;\n let sum=0;for(let i=0;i<256;i++)sum+=i*hist[i];\n let wB=0,sB=0,best=-1,th=128;\n for(let i=0;i<256;i++){wB+=hist[i];if(!wB)continue;const wF=n-wB;if(!wF)break;sB+=i*hist[i];const mB=sB/wB,mF=(sum-sB)/wF,v=wB*wF*(mB-mF)*(mB-mF);if(v>best){best=v;th=i}}\n let top=null;\n for(const pol of[true,false]){\n  const m=new Uint8Array(n),seen=new Uint8Array(n);\n  for(let i=0;i<n;i++)m[i]=(b[i*4]>th)===pol?1:0;\n  for(let s=0;s<n;s++){\n   if(!m[s]||seen[s])continue;\n   const st=[s],px=[];seen[s]=1;let edge=0;\n   while(st.length){const p=st.pop();px.push(p);const cx=p%w,cy=(p/w)|0;\n    if(cx===0||cy===0||cx===w-1||cy===h-1)edge++;\n    if(cx>0&&m[p-1]&&!seen[p-1]){seen[p-1]=1;st.push(p-1)}\n    if(cx<w-1&&m[p+1]&&!seen[p+1]){seen[p+1]=1;st.push(p+1)}\n    if(cy>0&&m[p-w]&&!seen[p-w]){seen[p-w]=1;st.push(p-w)}\n    if(cy<h-1&&m[p+w]&&!seen[p+w]){seen[p+w]=1;st.push(p+w)}}\n   const A=px.length;if(A<.1*n||A>.97*n||edge>.5*(w+h))continue;\n   const mn=new Int16Array(h).fill(9999),mx=new Int16Array(h).fill(-1);\n   for(const p of px){const cx=p%w,cy=(p/w)|0;if(cx<mn[cy])mn[cy]=cx;if(cx>mx[cy])mx[cy]=cx}\n   const P=[];for(let y=0;y<h;y++)if(mx[y]>=0){P.push([mn[y],y],[mx[y]+1,y+1])}\n   const H=hullOf(P),sol=A/Math.max(1,polyA(H)),score=A*sol*sol;\n   if(sol>.6&&(!top||score>top.score))top={score,H}}}\n if(!top)return null;\n const H=top.H,f=(a,b)=>H.reduce((r,p)=>b(p)>b(r)?p:r,H[0]);\n const q=[f(0,p=>-(p[0]+p[1])),f(0,p=>p[0]-p[1]),f(0,p=>p[0]+p[1]),f(0,p=>p[1]-p[0])];\n if(polyA(q)<.08*n)return null;\n return q.map(p=>[p[0]/k,p[1]/k])}\n/* slot built from a detected quad: perspective-flattened, re-editable in the crop tool */\nasync function mkQuad(orig,c,q,name){\n const cs={mode:'persp',rot:0,ang:0,flip:false,q:q.map(p=>[p[0]/c.width,p[1]/c.height])};\n return mkq(orig,warp(c,q),name,{cs})}\nasync function mkAuto(orig,c,name){const q=autoQuad(c);return q?mkQuad(orig,c,q,name):mk(orig,c,autoCrop(c),name)}\n/* a slot = {orig: enhanced full photo, src: print-ready crop, w,h,name, cs: crop settings so it can be re-edited} */\nasync function mkq(orig,cc,name,extra){const c=capC(cc);return{orig,src:await blobURL(c),w:c.width,h:c.height,name,...extra}}\nasync function mk(orig,c,r,name){\n const cs={mode:'rect',rot:0,ang:0,flip:false,ratio:0,rect:r?{x:r.x/c.width,y:r.y/c.height,w:r.w/c.width,h:r.h/c.height}:{x:0,y:0,w:1,h:1}};\n return mkq(orig,r?cropC(c,r):c,name,{cs})}\nfunction warp(c,q,max){\n const d=(a,b)=>Math.hypot(a[0]-b[0],a[1]-b[1]);let W=Math.max(d(q[0],q[1]),d(q[3],q[2])),H=Math.max(d(q[0],q[3]),d(q[1],q[2]));\n const k=Math.min(1,(max||capPx())/Math.max(W,H));W=Math.max(1,Math.round(W*k));H=Math.max(1,Math.round(H*k));\n const[[x0,y0],[x1,y1],[x2,y2],[x3,y3]]=q,dx1=x1-x2,dx2=x3-x2,dx3=x0-x1+x2-x3,dy1=y1-y2,dy2=y3-y2,dy3=y0-y1+y2-y3;\n const den=dx1*dy2-dy1*dx2||1e-9,g=(dx3*dy2-dy3*dx2)/den,h=(dx1*dy3-dy1*dx3)/den,A=x1-x0+g*x1,B=x3-x0+h*x3,D=y1-y0+g*y1,E=y3-y0+h*y3;\n const sw=c.width,sh=c.height,sd=c.getContext('2d').getImageData(0,0,sw,sh).data,o=newC(W,H);\n const ox=o.getContext('2d'),od=ox.createImageData(W,H),T=od.data;\n for(let j=0;j<H;j++)for(let i=0;i<W;i++){\n  const u=(i+.5)/W,v=(j+.5)/H,w=g*u+h*v+1,x=(A*u+B*v+x0)/w-.5,y=(D*u+E*v+y0)/w-.5,xi=Math.floor(x),yi=Math.floor(y),fx=x-xi,fy=y-yi;\n  const xa=cl(xi,0,sw-1),xb=cl(xi+1,0,sw-1),ya=cl(yi,0,sh-1),yb=cl(yi+1,0,sh-1),i00=(ya*sw+xa)*4,i10=(ya*sw+xb)*4,i01=(yb*sw+xa)*4,i11=(yb*sw+xb)*4,q4=(j*W+i)*4;\n  for(let n=0;n<3;n++)T[q4+n]=sd[i00+n]*(1-fx)*(1-fy)+sd[i10+n]*fx*(1-fy)+sd[i01+n]*(1-fx)*fy+sd[i11+n]*fx*fy;\n  T[q4+3]=255}\n ox.putImageData(od,0,0);return o}\nconst fullC=async u=>{const im=await loadImg(u),c=newC(im.naturalWidth,im.naturalHeight);c.getContext('2d').drawImage(im,0,0);return c};\n\n/* ---------- file loading ---------- */\nconst isImg=f=>/^image\\//i.test(f.type||'')||/pdf/i.test(f.type||'')||/\\.(jpe?g|png|pdf|webp|gif|bmp|avif)$/i.test(f.name||'');\nasync function toCanvas(f){\n if(/pdf/i.test(f.type)||/\\.pdf$/i.test(f.name||'')){\n  if(!window.pdfjsLib)throw Error('pdf');\n  pdfjsLib.GlobalWorkerOptions.workerSrc='vendor/pdf.worker.min.js';\n  const d=await pdfjsLib.getDocument({data:await f.arrayBuffer()}).promise,pg=await d.getPage(1),v1=pg.getViewport({scale:1}),v=pg.getViewport({scale:3000/Math.max(v1.width,v1.height)});\n  const c=newC(v.width,v.height),x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);\n  await pg.render({canvasContext:x,viewport:v}).promise;return c}\n const u=URL.createObjectURL(f),im=await loadImg(u),k=Math.min(1,4096/Math.max(im.naturalWidth,im.naturalHeight));\n const c=newC(im.naturalWidth*k,im.naturalHeight*k),x=c.getContext('2d');\n x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.imageSmoothingQuality='high';x.drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);return c}\n\n/* ---------- auto enhance: clean + upscale to 4K (3840 px long edge) + natural detail ---------- */\nconst ENHANCE_PROMPT=\"Enhance the image to ultra-high definition with maximum clarity and realistic detail. Remove blur, noise, grain, color fading, and compression artifacts while preserving the subject's exact identity, proportions, and natural appearance. Restore sharp focus with refined micro-details in skin, hair strands, fabric texture, and background surfaces. Maintain authentic skin texture with natural pores and tonal variation, avoiding over-smoothing, artificial sharpening halos, or plastic effects. Hard rule: Do not modify facial structure, facial features, expression, hairstyle, body shape, pose, clothing, age, or identity in any way.\";\nconst ENH={on:true},FOURK=3840;\nconst CF=(()=>{try{const x=newC(1,1).getContext('2d');x.filter='blur(1px)';return x.filter==='blur(1px)'}catch(e){return false}})();\nfunction blur(src,w,h,r){\n const t=new Uint8ClampedArray(src.length),o=new Uint8ClampedArray(src.length),m=2*r+1,cl=(v,a)=>v<0?0:v>a?a:v;\n for(let y=0;y<h;y++)for(let c=0;c<3;c++){let s=0;const b=y*w*4+c;for(let k=-r;k<=r;k++)s+=src[b+cl(k,w-1)*4];\n  for(let x=0;x<w;x++){t[b+x*4]=s/m;s+=src[b+cl(x+r+1,w-1)*4]-src[b+cl(x-r,w-1)*4]}}\n for(let x=0;x<w;x++)for(let c=0;c<3;c++){let s=0;const b=x*4+c,st=w*4;for(let k=-r;k<=r;k++)s+=t[b+cl(k,h-1)*st];\n  for(let y=0;y<h;y++){o[b+y*st]=s/m;s+=t[b+cl(y+r+1,h-1)*st]-t[b+cl(y-r,h-1)*st]}}\n return o}\n/* blurred copy of a canvas (GPU blur when the browser supports it, JS box blur otherwise) */\nfunction blurPx(c,r){\n const w=c.width,h=c.height;\n if(CF){const t=newC(w,h),x=t.getContext('2d');x.filter='blur('+r+'px)';x.drawImage(c,0,0);x.filter='none';return x.getImageData(0,0,w,h).data}\n return blur(c.getContext('2d').getImageData(0,0,w,h).data,w,h,Math.max(1,Math.round(r)))}\n/* step 1: restore faded colour (auto levels) and calm sensor noise in flat areas, before upscaling */\nfunction cleanC(c){\n const w=c.width,h=c.height,n=w*h,x=c.getContext('2d'),id=x.getImageData(0,0,w,h),d=id.data,hist=new Uint32Array(256);\n for(let i=0;i<n;i++)hist[(d[i*4]*77+d[i*4+1]*150+d[i*4+2]*29)>>8]++;\n let lo=0,hi=255,a=0;const t=n*.004;\n for(;lo<255;lo++){a+=hist[lo];if(a>t)break}\n a=0;for(;hi>0;hi--){a+=hist[hi];if(a>t)break}\n if(hi-lo>40){const k=255/(hi-lo);for(let i=0;i<n*4;i++)if((i&3)!==3)d[i]=(d[i]-lo)*k}\n x.putImageData(id,0,0);\n const b1=blurPx(c,1),thr=Math.max(w,h)<1600?14:10;\n for(let i=0;i<n*4;i++){if((i&3)===3)continue;const df=d[i]-b1[i];if(Math.abs(df)<thr)d[i]-=df*.5}\n x.putImageData(id,0,0)}\n/* step 2: step-wise high-quality upscale (max 1.5x per step keeps edges clean) */\nfunction upTo(c,L){\n let cur=c;\n while(Math.max(cur.width,cur.height)<L-1){\n  const k=Math.min(1.5,L/Math.max(cur.width,cur.height)),n=newC(cur.width*k,cur.height*k),x=n.getContext('2d');\n  x.imageSmoothingEnabled=true;x.imageSmoothingQuality='high';x.drawImage(cur,0,0,n.width,n.height);cur=n}\n return cur}\n/* step 3: edge-aware unsharp mask - threshold + overshoot limit = no halos, no noise boost */\nfunction sharpC(c,amt,rad){\n const w=c.width,h=c.height,x=c.getContext('2d'),id=x.getImageData(0,0,w,h),d=id.data,b=blurPx(c,rad),m=Math.ceil(rad*3)+1,LIM=36;\n for(let y=m;y<h-m;y++){let i=(y*w+m)*4;for(let xx=m;xx<w-m;xx++,i+=4)for(let n=0;n<3;n++){\n  const e=d[i+n]-b[i+n];if(e>2||e<-2)d[i+n]+=amt*(e>LIM?LIM:e<-LIM?-LIM:e)}}\n x.putImageData(id,0,0)}\nasync function enhance(c,say=()=>{}){\n const L0=Math.max(c.width,c.height);\n say('Cleaning');await tick();cleanC(c);\n let o=c;\n if(L0<FOURK){say('Upscaling to 4K');await tick();o=upTo(c,FOURK)}\n say('Restoring detail');await tick();\n const s=Math.max(1,Math.max(o.width,o.height)/L0);\n sharpC(o,Math.min(1.1,.5+.12*s),Math.min(3,.7+.3*s));\n return o}\n\nasync function addFiles(fs,idx){\n fs=[...fs].filter(isImg);\n if(!fs.length)return toast('Please choose JPG, PNG, WebP or PDF files');\n const out=[];\n for(const f of fs){\n  const nm=f.name||'pasted image';\n  try{\n   toast('Loading '+nm+'…');await tick();\n   let c=await toCanvas(f);\n   if(ENH.on)c=await enhance(c,m=>toast(m+' '+nm+'…'));\n   const orig=await blobURL(c);\n   out.push(await mkAuto(orig,c,nm))\n  }catch(e){console.error(e);toast('Could not read '+nm)}}\n if(!out.length)return;\n const placed=[];\n mut(()=>{let p=S.pg,i=idx;out.forEach((s,n)=>{if(n){i++;for(;;){if(i>=count()){p++;i=0;S.pages[p]=S.pages[p]||[]}if(!S.pages[p][i])break;i++}}S.pages[p][i]=s;placed.push({p,i})});const L=placed[placed.length-1];S.sel=L&&L.p===S.pg?nextEmpty(L.i):-1});\n lastUp=out[out.length-1];\n toast((ENH.on?'Photo added — enhanced to 4K & auto-cropped':'Photo added — auto-cropped')+'. Ctrl+C then Ctrl+V fills the next box.')}\n\n/* ---------- crop editor: ONE tool - 4 corner points + straighten / rotate / flip / zoom ---------- */\nlet cI=0,cBase=null,cPv=null,cPvT=null,cRot=0,cAng=0,cFlip=false,cZoom=1,cFitW=1,cTok=0,cBusy=false;\nconst cp=[[0,0],[0,0],[0,0],[0,0]];let cK=1,cD=-1,cCur=null,pend=null;\nconst bounds=(iw,ih,deg)=>{const t=deg*Math.PI/180,c=Math.abs(Math.cos(t)),s=Math.abs(Math.sin(t));return[iw*c+ih*s,iw*s+ih*c]};\n/* image rotated by (90° steps + straighten angle), mirrored if flipped, white where the rotation leaves gaps; k = scale */\nfunction tx(img,iw,ih,k){\n const deg=cRot+cAng,[W,H]=bounds(iw,ih,deg),o=newC(W*k,H*k),x=o.getContext('2d');\n x.fillStyle='#fff';x.fillRect(0,0,o.width,o.height);\n x.setTransform(k,0,0,k,0,0);x.translate(W/2,H/2);x.rotate(deg*Math.PI/180);x.scale(cFlip?-1:1,1);\n x.imageSmoothingQuality='high';x.drawImage(img,-iw/2,-ih/2,iw,ih);return o}\nconst norm=()=>{const im=$('#cimg'),w=im.clientWidth,h=im.clientHeight;return cp.map(p=>[p[0]/w,p[1]/h])};\nfunction place(n){const im=$('#cimg'),w=im.clientWidth,h=im.clientHeight;n.forEach((p,i)=>cp[i]=[p[0]*w,p[1]*h]);drawQ()}\nlet cSel=0,cDrag=null,ph=[],pf=[],cRat=0,lastNudge=0,cSm=null,pvRaf=0,autoOk=false;\nfunction drawQ(){\n const im=$('#cimg'),w=im.clientWidth,h=im.clientHeight,mid=k=>{const a=cp[k],b=cp[(k+1)%4];return[(a[0]+b[0])/2,(a[1]+b[1])/2]};\n document.querySelectorAll('.pt').forEach((p,i)=>{p.style.left=cp[i][0]+'px';p.style.top=cp[i][1]+'px';p.classList.toggle('sel',i===cSel)});\n document.querySelectorAll('.mh').forEach(p=>{const k=+p.dataset.k,m=k===8?[cp.reduce((s,q)=>s+q[0],0)/4,cp.reduce((s,q)=>s+q[1],0)/4]:mid(k-4);p.style.left=m[0]+'px';p.style.top=m[1]+'px'});\n const pts=cp.map(p=>p.join(',')).join(' ');\n $('#cpoly').setAttribute('points',pts);\n $('#cdim').setAttribute('d',`M0,0H${w}V${h}H0Z M${cp.map(p=>p.join(',')).join(' L')}Z`);\n const L=(a,b,t)=>[a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t];let g='';\n for(const t of[1/3,2/3]){g+=`M${L(cp[0],cp[1],t)} L${L(cp[3],cp[2],t)} M${L(cp[0],cp[3],t)} L${L(cp[1],cp[2],t)} `}\n $('#cgrid').setAttribute('d',g);\n if(!pvRaf)pvRaf=requestAnimationFrame(updPrev)}\nconst ratioFit=(W,H)=>!cRat?[W,H]:W>=H?[W,Math.max(1,Math.round(W/cRat))]:[Math.max(1,Math.round(H/cRat)),H];\nconst fitR=c=>{const[nw,nh]=ratioFit(c.width,c.height);if(nw===c.width&&nh===c.height)return c;const o=newC(nw,nh),x=o.getContext('2d');x.imageSmoothingQuality='high';x.drawImage(c,0,0,nw,nh);return o};\n/* live \"corrected result\" preview, redrawn while the points move */\nfunction updPrev(){\n pvRaf=0;const cv=$('#cprev'),im=$('#cimg');if($('#cm').hidden||!cPvT||!im.clientWidth)return;\n if(!cSm||cSm.src!==cPvT){const k=Math.min(1,360/Math.max(cPvT.width,cPvT.height)),s=newC(cPvT.width*k,cPvT.height*k);s.getContext('2d').drawImage(cPvT,0,0,s.width,s.height);cSm={src:cPvT,c:s,k}}\n const f=cPvT.width/im.clientWidth*cSm.k,q=cp.map(p=>[p[0]*f,p[1]*f]);\n if(Math.hypot(q[0][0]-q[1][0],q[0][1]-q[1][1])<4||Math.hypot(q[0][0]-q[3][0],q[0][1]-q[3][1])<4)return;\n const o=fitR(warp(cSm.c,q,220));cv.width=o.width;cv.height=o.height;cv.getContext('2d').drawImage(o,0,0)}\n/* undo / redo of point moves (stored relative to the picture so zoom doesn't matter) */\nconst pushH=()=>{if(!cBase)return;const n=JSON.stringify(norm());if(ph.length&&ph[ph.length-1]===n)return;ph.push(n);if(ph.length>60)ph.shift();pf=[]};\nconst undoP=()=>{if(!ph.length||!cBase)return;pf.push(JSON.stringify(norm()));place(JSON.parse(ph.pop()))};\nconst redoP=()=>{if(!pf.length||!cBase)return;ph.push(JSON.stringify(norm()));place(JSON.parse(pf.pop()))};\nfunction growQ(f){if(!cBase)return;pushH();const im=$('#cimg'),w=im.clientWidth,h=im.clientHeight,cx=cp.reduce((s,p)=>s+p[0],0)/4,cy=cp.reduce((s,p)=>s+p[1],0)/4;cp.forEach((p,i)=>cp[i]=[cl(cx+(p[0]-cx)*f,0,w),cl(cy+(p[1]-cy)*f,0,h)]);drawQ()}\nfunction nudge(dx,dy,big){\n if(!cBase)return;if(Date.now()-lastNudge>800)pushH();lastNudge=Date.now();\n const im=$('#cimg'),st=im.clientWidth/cPvT.width*(big?5:1),p=cp[cSel];\n cp[cSel]=[cl(p[0]+dx*st,0,im.clientWidth),cl(p[1]+dy*st,0,im.clientHeight)];drawQ()}\n/* magnifier while dragging */\nfunction showLoupe(){\n const lp=$('#cloupe');if(!cDrag||!cPvT){lp.style.display='none';return}\n const im=$('#cimg'),sc=cPvT.width/im.clientWidth,k=cDrag.k,S0=lp.width;let x,y;\n if(k<4)[x,y]=cp[k];else if(k<8){const a=cp[k-4],b=cp[(k-3)%4];x=(a[0]+b[0])/2;y=(a[1]+b[1])/2}else{x=cp.reduce((s,p)=>s+p[0],0)/4;y=cp.reduce((s,p)=>s+p[1],0)/4}\n const rs=Math.max(12,26*sc),sx=x*sc-rs/2,sy=y*sc-rs/2,c=lp.getContext('2d'),m=S0/rs;\n c.fillStyle='#000';c.fillRect(0,0,S0,S0);c.imageSmoothingEnabled=false;\n try{c.drawImage(cPvT,sx,sy,rs,rs,0,0,S0,S0)}catch(e){}\n c.beginPath();cp.forEach((p,i)=>{const X=(p[0]*sc-sx)*m,Y=(p[1]*sc-sy)*m;i?c.lineTo(X,Y):c.moveTo(X,Y)});c.closePath();c.strokeStyle='#1d6fe0';c.lineWidth=2;c.stroke();\n c.strokeStyle='#fff';c.lineWidth=1;c.beginPath();c.moveTo(S0/2,S0/2-9);c.lineTo(S0/2,S0/2+9);c.moveTo(S0/2-9,S0/2);c.lineTo(S0/2+9,S0/2);c.stroke();\n lp.style.display='block'}\n/* snap a corner to the strongest nearby corner response (Shi-Tomasi) */\nfunction snapCorner(k){\n const im=$('#cimg'),sc=cPvT.width/im.clientWidth,cx=Math.round(cp[k][0]*sc),cy=Math.round(cp[k][1]*sc),R=Math.max(6,Math.round(14*sc)),m=2;\n const x0=Math.max(2,cx-R-m),y0=Math.max(2,cy-R-m),x1=Math.min(cPvT.width-3,cx+R+m),y1=Math.min(cPvT.height-3,cy+R+m),W=x1-x0+1,H=y1-y0+1;\n if(W<2*m+3||H<2*m+3)return;\n const d=cPvT.getContext('2d').getImageData(x0-1,y0-1,W+2,H+2).data,sw=W+2,gr=i=>d[i*4]*.3+d[i*4+1]*.59+d[i*4+2]*.11,ix=new Float32Array(W*H),iy=new Float32Array(W*H);\n for(let y=0;y<H;y++)for(let x=0;x<W;x++){const i=(y+1)*sw+x+1;ix[y*W+x]=gr(i+1)-gr(i-1);iy[y*W+x]=gr(i+sw)-gr(i-sw)}\n let best=0,bx=-1,by=-1;\n for(let y=m;y<H-m;y++)for(let x=m;x<W-m;x++){\n  let a=0,b=0,c=0;for(let j=-m;j<=m;j++)for(let i=-m;i<=m;i++){const u=ix[(y+j)*W+x+i],v=iy[(y+j)*W+x+i];a+=u*u;b+=u*v;c+=v*v}\n  const lam=(a+c)/2-Math.sqrt(((a-c)/2)**2+b*b),dist=Math.hypot(x+x0-cx,y+y0-cy),sco=lam*(1-.6*Math.min(1,dist/R));\n  if(sco>best){best=sco;bx=x+x0;by=y+y0}}\n if(bx>=0&&best>2000){cp[k]=[bx/sc,by/sc];toast('Snapped to corner')}}\nfunction setQ(r,sw){const im=$('#cimg'),w=im.clientWidth,h=im.clientHeight,f=r?w/sw:0;\n (r?[[r.x,r.y],[r.x+r.w,r.y],[r.x+r.w,r.y+r.h],[r.x,r.y+r.h]].map(p=>[p[0]*f,p[1]*f]):[[0,0],[w,0],[w,h],[0,h]]).forEach((p,i)=>cp[i]=p);drawQ()}\nconst autoQ=()=>{if(!cPvT)return;const q=autoQuad(cPvT);\n if(q){const im=$('#cimg'),f=im.clientWidth/cPvT.width;q.forEach((p,i)=>cp[i]=[p[0]*f,p[1]*f]);drawQ()}\n else setQ(autoCrop(cPvT),cPvT.width)};\nfunction applyZoom(){\n const im=$('#cimg');\n if(cZoom===1){im.style.width='';im.style.maxWidth='';im.style.maxHeight=''}\n else{im.style.maxWidth='none';im.style.maxHeight='none';im.style.width=Math.round(cFitW*cZoom)+'px'}\n cK=bounds(cBase.width,cBase.height,cRot+cAng)[0]/im.clientWidth}\nasync function showRot(){\n ph=[];pf=[];\n const t=++cTok,im=$('#cimg');\n cPvT=tx(cPv,cBase.width,cBase.height,cPv.width/cBase.width);\n im.style.width='';im.style.maxWidth='';im.style.maxHeight='';\n im.src=cPvT.toDataURL('image/jpeg',.9);\n try{await im.decode()}catch(e){}\n if(t!==cTok)return;\n cFitW=im.clientWidth;applyZoom();\n if(pend){const n=pend;pend=null;place(n)}else autoQ()}\n/* change rotation / angle / flip but keep the 4 points where they were (relative to the picture) */\nfunction geo(f){if(!cBase)return;const n=norm();f();pend=n;showRot()}\nfunction turnP(d){\n if(!cBase)return;const n=norm();\n pend=d>0?[[1-n[3][1],n[3][0]],[1-n[0][1],n[0][0]],[1-n[1][1],n[1][0]],[1-n[2][1],n[2][0]]]:[[n[1][1],1-n[1][0]],[n[2][1],1-n[2][0]],[n[3][1],1-n[3][0]],[n[0][1],1-n[0][0]]];\n cRot=(cRot+d*90+360)%360;showRot()}\nfunction setZoom(z){if(!cBase)return;const n=norm();cZoom=cl(z,1,8);applyZoom();place(n)}\nconst cb=$('#cbox');\n/* corners (0-3) move freely, square handles (4-7) slide an edge along its normal, ✥ (8) moves the whole crop */\ncb.onpointerdown=e=>{\n const t=e.target.closest('.pt,.mh');if(!t)return;const k=+t.dataset.k;pushH();\n cDrag={k,x:e.clientX,y:e.clientY,p:cp.map(p=>p.slice()),w:$('#cimg').clientWidth,h:$('#cimg').clientHeight};cD=k;if(k<4)cSel=k;\n cb.setPointerCapture(e.pointerId);e.preventDefault();drawQ();showLoupe()};\ncb.onpointermove=e=>{\n if(!cDrag)return;const{k,p,w,h}=cDrag;let dx=e.clientX-cDrag.x,dy=e.clientY-cDrag.y,idx;\n if(k<4)idx=[k];else if(k===8)idx=[0,1,2,3];\n else{idx=[k-4,(k-3)%4];const a=p[idx[0]],b=p[idx[1]],L=Math.hypot(b[0]-a[0],b[1]-a[1])||1,nx=-(b[1]-a[1])/L,ny=(b[0]-a[0])/L,dd=dx*nx+dy*ny;dx=dd*nx;dy=dd*ny}\n if(k>3&&k<8){let s=1;for(const i of idx){\n   if(dx>0)s=Math.min(s,(w-p[i][0])/dx);else if(dx<0)s=Math.min(s,-p[i][0]/-dx);\n   if(dy>0)s=Math.min(s,(h-p[i][1])/dy);else if(dy<0)s=Math.min(s,-p[i][1]/-dy)}\n  dx*=Math.max(0,s);dy*=Math.max(0,s)}\n else for(const i of idx){dx=cl(dx,-p[i][0],w-p[i][0]);dy=cl(dy,-p[i][1],h-p[i][1])}\n idx.forEach(i=>cp[i]=[p[i][0]+dx,p[i][1]+dy]);drawQ();showLoupe()};\ncb.onpointerup=cb.onpointercancel=()=>{\n if(!cDrag)return;const k=cDrag.k;cDrag=null;cD=-1;\n if(k<4&&$('#cSnap').checked&&cPvT)snapCorner(k);\n showLoupe();drawQ()};\n$('#cUndo').onclick=undoP;$('#cRedo').onclick=redoP;\n$('#cGrow').onclick=()=>growQ(1.02);$('#cShr').onclick=()=>growQ(.98);\n$('#cRatio').onchange=e=>{cRat=+e.target.value;drawQ()};\n$('#cwrap').addEventListener('wheel',e=>{if(e.ctrlKey||e.metaKey){e.preventDefault();setZoom(cZoom*(e.deltaY<0?1.15:1/1.15))}},{passive:false});\nfunction closeCrop(){cTok++;cDrag=null;$('#cloupe').style.display='none';$('#cm').hidden=true;cBase=cPv=cPvT=cCur=null}\nasync function openCrop(i){\n const s=S.slots[i];if(!s)return false;\n cI=i;const t=++cTok;$('#cm').hidden=false;clearTimeout($('#toast')._t);$('#toast').style.opacity=0;\n try{\n  cBase=await fullC(s.orig);if(t!==cTok)return false;\n  const k=Math.min(1,1600/Math.max(cBase.width,cBase.height));\n  if(k<1){cPv=newC(cBase.width*k,cBase.height*k);const x=cPv.getContext('2d');x.imageSmoothingQuality='high';x.drawImage(cBase,0,0,cPv.width,cPv.height)}else cPv=cBase;\n  const st=s.cs||{};cRot=st.rot||0;cAng=st.ang||0;cFlip=!!st.flip;cZoom=1;cRat=st.ratio||0;$('#cRatio').value=String(cRat);cSel=0;$('#cAng').value=cAng;$('#cAngV').textContent=cAng.toFixed(1)+'°';pend=null;\n  if(st.mode==='persp'&&st.q)pend=st.q.map(p=>p.slice());\n  else if(st.rect&&!cRot){const r=st.rect;pend=[[r.x,r.y],[r.x+r.w,r.y],[r.x+r.w,r.y+r.h],[r.x,r.y+r.h]]}\n  await showRot();return true\n }catch(e){console.error(e);toast('Could not open the crop tool');$('#cm').hidden=true;return false}}\n$('#cRotL').onclick=()=>turnP(-1);\n$('#cRotR').onclick=()=>turnP(1);\n$('#cAng').oninput=e=>{const v=+e.target.value;$('#cAngV').textContent=v.toFixed(1)+'°';geo(()=>cAng=v)};\n$('#cAng').ondblclick=()=>{$('#cAng').value=0;$('#cAngV').textContent='0.0°';geo(()=>cAng=0)};\n$('#cFlip').onclick=()=>geo(()=>cFlip=!cFlip);\n$('#cZo').onclick=()=>setZoom(cZoom/1.3);\n$('#cZi').onclick=()=>setZoom(cZoom*1.3);\n$('#cZf').onclick=()=>setZoom(1);\n$('#cAuto').onclick=()=>{pushH();autoQ()};\n$('#cFull').onclick=()=>{if(!cBase)return;cRot=0;cAng=0;cFlip=false;cZoom=1;$('#cAng').value=0;$('#cAngV').textContent='0.0°';pend=[[0,0],[1,0],[1,1],[0,1]];showRot()};\n$('#cCancel').onclick=closeCrop;\n$('#cApply').onclick=async()=>{\n if(cBusy||!cBase)return;cBusy=true;const b=$('#cApply');b.disabled=true;\n try{\n  const s=S.slots[cI];if(!s)return closeCrop();\n  toast('Applying…');await tick();\n  const[W,H]=bounds(cBase.width,cBase.height,cRot+cAng),kk=Math.min(1,5000/Math.max(W,H)),f=cK*kk;\n  const q=cp.map(p=>[p[0]*f,p[1]*f]);\n  if(Math.hypot(q[0][0]-q[1][0],q[0][1]-q[1][1])<10||Math.hypot(q[0][0]-q[3][0],q[0][1]-q[3][1])<10)return toast('Crop area is too small');\n  const n0=norm();cCur=tx(cBase,cBase.width,cBase.height,kk);\n  const n=await mkq(s.orig,fitR(warp(cCur,q)),s.name,{cs:{mode:'persp',rot:cRot,ang:cAng,flip:cFlip,q:n0,ratio:cRat}});\n  mut(()=>S.slots[cI]=n);closeCrop();toast('Applied')\n }catch(e){console.error(e);toast('Could not apply — try again')}\n finally{cBusy=false;b.disabled=false}};\n/* ---------- UI wiring ---------- */\ndocument.querySelectorAll('[data-m]').forEach(b=>b.onclick=()=>mut(()=>{S.mode=b.dataset.m;[S.rows,S.cols]=DEF[S.mode];S.sel=-1}));\nconst sel=(id,f)=>$(id).onchange=e=>mut(()=>f(e.target));\nfor(let i=1;i<=20;i++)$('#rows').add(new Option(i+' Row',i));\nfor(let i=1;i<=4;i++)$('#cols').add(new Option(i+' Col',i));\nsel('#rows',t=>S.rows=+t.value);\n$('#rowP').onclick=()=>{if(S.rows<20)mut(()=>S.rows++);else toast('Maximum 20 rows')};\n$('#rowM').onclick=()=>{if(S.rows>1)mut(()=>S.rows--)};sel('#cols',t=>S.cols=+t.value);sel('#name',t=>S.name=t.value==='1');\nsel('#gap',t=>S.gap=Math.max(0,Math.min(30,+t.value||0)));\nsel('#outline',t=>S.outline=t.checked);sel('#outline2',t=>S.outline=t.checked);sel('#rotate',t=>S.rotate=t.checked);\nsel('#paper',t=>S.paper=t.value);sel('#paper2',t=>S.paper=t.value);sel('#bless',t=>S.bless=t.checked);sel('#pq',t=>S.pq=t.value);sel('#mar',t=>S.margin=t.value===''?'':Math.max(0,Math.min(50,+t.value||0)));$('#exp').onclick=exportPages;sel('#qual',t=>S.quality=t.value);sel('#orient',t=>S.orient=t.value);sel('#orient2',t=>S.orient=t.value);sel('#colour',t=>S.colour=t.value);\nsel('#cw',t=>S.cw=Math.max(50,+t.value||200));sel('#ch',t=>S.ch=Math.max(50,+t.value||200));\n$('#gray').onclick=()=>mut(()=>S.filter=S.filter==='gray'?'none':'gray');\n$('#sepia').onclick=()=>mut(()=>S.filter=S.filter==='sepia'?'none':'sepia');\n$('#reset').onclick=()=>mut(()=>{[S.rows,S.cols]=DEF[S.mode];Object.assign(S,{gap:4,outline:true,rotate:true,filter:'none',name:false})});\n$('#fill').onclick=()=>{const f=S.slots[0]||S.slots.find(Boolean);if(!f)return toast('Upload a photo first');mut(()=>{for(let i=0;i<count();i++)S.slots[i]=f})};\n$('#clear').onclick=()=>mut(()=>{S.pages=[[]];S.pg=0;S.sel=-1});\n$('#undo').onclick=undo;$('#redo').onclick=redo;\nconst openPd=()=>{$('#pd').hidden=false;paintLpv()};\nconst rotBusy=()=>[...RC.values()].some(v=>v===null);\nlet autoPv=false;\nasync function doPrint(){\n autoPv=$('#pv').hidden;$('#pd').hidden=true;$('#pv').hidden=false;paintPv();\n for(let n=0;n<50&&rotBusy();n++)await new Promise(r=>setTimeout(r,100));\n await Promise.all([...document.querySelectorAll('#pzw img')].map(i=>i.decode().catch(()=>{})));\n setTimeout(()=>window.print(),250)}\n$('#print').onclick=doPrint;$('#doPrint').onclick=doPrint;$('#prev').onclick=()=>{$('#pv').hidden=false;paintPv()};\n$('#pvSet').onclick=openPd;\n$('#pvClose').onclick=()=>$('#pv').hidden=true;\nconst LS={get(k){try{return localStorage.getItem(k)}catch(e){return null}},set(k,v){try{localStorage.setItem(k,v)}catch(e){}}};\nconst PRN=(()=>{let l;try{l=JSON.parse(LS.get('cnicPrinters'))}catch(e){}if(!Array.isArray(l)||!l.length)l=['Epson L3350','Canon','HP','Brother','Microsoft Print to PDF'];return{list:l,cur:LS.get('cnicPrinter')||l[0]}})();\nfunction fillPrn(){const p=$('#printer');if(!PRN.list.includes(PRN.cur))PRN.cur=PRN.list[0]||'System default';p.innerHTML=PRN.list.map(n=>`<option>${n.replace(/</g,'&lt;')}</option>`).join('');p.value=PRN.cur;LS.set('cnicPrinters',JSON.stringify(PRN.list));LS.set('cnicPrinter',PRN.cur)}\nfunction prnChanged(){fillPrn();if(typeof paintLpv==='function')try{paintLpv()}catch(e){}try{$('#pd').hidden||openPd()}catch(e){}}\nfillPrn();$('#printer').onchange=e=>{PRN.cur=e.target.value;prnChanged()};\n$('#prAdd').onclick=()=>{let n='';try{n=(prompt('Printer name (as shown in your system):')||'').trim()}catch(e){};if(n){if(!PRN.list.includes(n))PRN.list.push(n);PRN.cur=n;prnChanged()}};\n$('#prDel').onclick=()=>{if(PRN.list.length<2)return;PRN.list=PRN.list.filter(n=>n!==PRN.cur);PRN.cur=PRN.list[0];prnChanged()};\n$('#pdOk').onclick=doPrint;$('#pdNo').onclick=()=>$('#pd').hidden=true;\ndocument.querySelectorAll('[name=pr]').forEach(r=>r.onchange=()=>{PR.mode=r.value;paintLpv();if(!$('#pv').hidden)paintPv()});\n$('#prt').oninput=e=>{PR.txt=e.target.value;PR.mode='cus';document.querySelector('[name=pr][value=cus]').checked=true;paintLpv();if(!$('#pv').hidden)paintPv()};\n$('#pp').onclick=()=>{if(S.pg>0){S.pg--;S.sel=-1;render()}};\n$('#pn').onclick=()=>{if(S.pg<S.pages.length-1){S.pg++;S.sel=-1;render()}};\n$('#addpg').onclick=()=>mut(()=>{S.pages.splice(S.pg+1,0,[]);S.pg++;S.sel=-1});\n$('#delpg').onclick=()=>{if(S.pages.length<2)return toast('At least one page is needed');mut(()=>{S.pages.splice(S.pg,1);S.pg=Math.min(S.pg,S.pages.length-1)})};\nconst zm=v=>{Z=Math.max(.3,Math.min(3,v));render()};\n$('#zo').onclick=()=>zm(Z-.15);$('#zi').onclick=()=>zm(Z+.15);$('#zl').onclick=()=>zm(1);\n\n$('#stage').addEventListener('click',e=>{\n const cell=e.target.closest('.cell');if(!cell)return;const i=+cell.dataset.i,a=e.target.closest('[data-a]')?.dataset.a;\n if(a==='pick'){tgt=i;$('#fi').click();return}\n if(a==='crop'){S.sel=i;return openCrop(i)}\n if(a==='auto'){const s=S.slots[i];fullC(s.orig).then(async c=>{const q=autoQuad(c),r=q?null:autoCrop(c);if(!q&&!r)return toast('Could not detect edges — use Crop');const n=q?await mkQuad(s.orig,c,q,s.name):await mk(s.orig,c,r,s.name);mut(()=>S.slots[i]=n)});return}\n if(a==='del'){mut(()=>S.slots[i]=null);return}\n S.sel=i;render()});\n$('#fi').onchange=e=>{addFiles(e.target.files,tgt);e.target.value=''};\n$('#stage').addEventListener('dragover',e=>e.preventDefault());\n$('#stage').addEventListener('drop',e=>{e.preventDefault();const c=e.target.closest('.cell'),ix=c?+c.dataset.i:firstEmpty();\n addFiles(e.dataTransfer.files,ix)});\n\n\n\nconst MARK='__CNIC_TOOL_CLIP__',inField=t=>['INPUT','SELECT','TEXTAREA'].includes(t.tagName),overlayOpen=()=>!!document.querySelector('.ov:not([hidden])');\nfunction copyMark(){try{const t=document.createElement('textarea');t.value=MARK;t.style.cssText='position:fixed;opacity:0';document.body.append(t);t.select();document.execCommand('copy');t.remove()}catch(e){}}\nconst pasteClip=i=>mut(()=>{S.slots[i]=clip;S.sel=nextEmpty(i)});\nasync function fetchImg(u){const r=await fetch(u),b=await r.blob();if(!/^image\\//i.test(b.type))throw Error('not an image');return new File([b],'pasted-image.'+(b.type.split('/')[1]||'png').replace('jpeg','jpg'),{type:b.type})}\naddEventListener('keydown',e=>{\n if(!$('#cm').hidden){\n  if(e.key==='Escape')$('#cCancel').click();\n  else if(e.key==='Enter'&&!['SELECT','INPUT','BUTTON'].includes(e.target.tagName)){e.preventDefault();$('#cApply').click()}\n  else if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='z'&&e.target.tagName!=='INPUT'){e.preventDefault();e.shiftKey?redoP():undoP()}\n  else if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='y'){e.preventDefault();redoP()}\n  else if(!['INPUT','SELECT'].includes(e.target.tagName)){\n   if(/^[1-4]$/.test(e.key)){cSel=+e.key-1;drawQ()}\n   else if(e.key.startsWith('Arrow')){e.preventDefault();nudge(e.key==='ArrowLeft'?-1:e.key==='ArrowRight'?1:0,e.key==='ArrowUp'?-1:e.key==='ArrowDown'?1:0,e.shiftKey)}}\n  return}\n if(!(e.ctrlKey||e.metaKey))return;const k=e.key.toLowerCase(),tg=e.target.tagName;\n if(k==='p'){e.preventDefault();doPrint();return}\n if(inField(e.target)||overlayOpen())return;\n if(k==='z'){e.preventDefault();undo()}else if(k==='y'){e.preventDefault();redo()}\n else if(k==='c'||k==='x'){let s=S.slots[S.sel];if(!s&&k==='c')s=lastUp;if(!s)return toast('Upload a photo first');e.preventDefault();clip=s;copyMark();\n  if(k==='x'&&S.slots[S.sel])mut(()=>S.slots[S.sel]=null);toast(k==='c'?'Copied — press Ctrl+V to paste in the next box':'Cut')}});\n/* Ctrl+V: paste an image copied from anywhere (screenshot, web page \"Copy image\", file copied in Explorer / Gallery, image link) */\naddEventListener('paste',e=>{\n if(inField(e.target)||overlayOpen())return;\n const dt=e.clipboardData;if(!dt)return;\n const i=S.sel>=0?S.sel:firstEmpty(),files=[];\n for(const it of dt.items||[])if(it.kind==='file'){const f=it.getAsFile();if(f)files.push(f)}\n if(!files.length)for(const f of dt.files||[])files.push(f);\n const html=dt.getData('text/html')||'',txt=(dt.getData('text/plain')||'').trim();\n e.preventDefault();\n if(files.some(isImg))return addFiles(files,i);\n if(txt===MARK&&clip)return pasteClip(i);\n const m=html.match(/<img[^>]+src=[\"']([^\"']+)[\"']/i),u=m?m[1].replace(/&amp;/g,'&'):/^(https?:\\/\\/|data:image\\/)/i.test(txt)?txt:'';\n if(u)return fetchImg(u).then(f=>addFiles([f],i)).catch(()=>toast('Could not read the copied image — save it, then upload'));\n if(clip)return pasteClip(i);\n toast('No image in clipboard — copy an image first')});\n$('#pasteBtn').onclick=async()=>{\n const i=S.sel>=0?S.sel:firstEmpty();\n try{\n  const items=await navigator.clipboard.read(),files=[];\n  for(const it of items){const t=it.types.find(x=>x.startsWith('image/'));if(t){const b=await it.getType(t);files.push(new File([b],'pasted-image.'+t.split('/')[1],{type:t}))}}\n  if(files.length)return addFiles(files,i)\n }catch(e){}\n if(clip)return pasteClip(i);\n toast('Press Ctrl+V to paste (on phone: long-press a box → Paste)')};\n$('#enh').onchange=e=>{ENH.on=e.target.checked};\naddEventListener('resize',render);\naddEventListener('afterprint',()=>{if(autoPv){autoPv=false;$('#pv').hidden=true}});\naddEventListener('beforeprint',()=>{if($('#pv').hidden){$('#pv').hidden=false;paintPv()}});\nrender();\n</script></body></html>\n","dis":"This tool gives for Documents Print and Enhance "},{"title":"PDF EDIT","code":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>PDF Edit: Edit PDF Text, Logos and Pages in Your Browser</title>\n<meta name=\"description\" content=\"Edit PDF text, logos, images and pages in your browser. PDF Edit keeps your file on your device. Download as PDF, PNG or JPG.\">\n<meta name=\"robots\" content=\"index, follow, max-image-preview:large, max-snippet:-1\">\n<meta name=\"application-name\" content=\"PDF Edit\">\n<meta name=\"theme-color\" content=\"#0f7a4d\">\n<link rel=\"canonical\" id=\"canon\" href=\"\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:site_name\" content=\"PDF Edit\">\n<meta property=\"og:title\" content=\"PDF Edit: Edit PDF Text, Logos and Pages in Your Browser\">\n<meta property=\"og:description\" content=\"Edit PDF text, logos, images and pages in your browser. PDF Edit keeps your file on your device. Download as PDF, PNG or JPG.\">\n<meta property=\"og:url\" id=\"ogurl\" content=\"\">\n<meta name=\"twitter:card\" content=\"summary\">\n<meta name=\"twitter:title\" content=\"PDF Edit: Edit PDF Text, Logos and Pages in Your Browser\">\n<meta name=\"twitter:description\" content=\"Edit PDF text, logos, images and pages in your browser. PDF Edit keeps your file on your device. Download as PDF, PNG or JPG.\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"WebApplication\", \"name\": \"PDF Edit\", \"description\": \"A browser-based PDF editor for changing text, moving or replacing logos and images, and reordering pages. Files stay on the user's device.\", \"applicationCategory\": \"UtilitiesApplication\", \"operatingSystem\": \"Any operating system with a modern web browser\", \"browserRequirements\": \"Requires JavaScript\", \"inLanguage\": \"en\", \"featureList\": [\"Edit text in a PDF\", \"Move, resize, crop, replace or delete images and logos\", \"Grab any area of a page to move it\", \"Add text boxes, images and shapes\", \"Reorder, duplicate, delete and add pages\", \"Layer ordering for added items\", \"Compare with the original page\", \"Download as PDF, PNG or JPG\", \"Undo\", \"Open password-protected PDFs by entering the password\", \"Convert Letter-size pages to Legal size when downloading\"]}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"HowTo\", \"name\": \"How to edit a PDF in your browser with PDF Edit\", \"step\": [{\"@type\": \"HowToStep\", \"position\": 1, \"name\": \"Upload your PDF or JPG\", \"text\": \"Select Upload PDF or JPG, or drop a PDF or JPG/PNG photo onto the page. It opens as a new project in your browser.\"}, {\"@type\": \"HowToStep\", \"position\": 2, \"name\": \"Let it split into pieces\", \"text\": \"Text becomes editable lines, and pictures and logos become movable images. You can add text boxes, images and shapes.\"}, {\"@type\": \"HowToStep\", \"position\": 3, \"name\": \"Compare with the original\", \"text\": \"Use the Original button to hide your edits and check that tables and other elements have not shifted.\"}, {\"@type\": \"HowToStep\", \"position\": 4, \"name\": \"Edit and download\", \"text\": \"Change text, images, pages and layers, then download the result as a PDF, or save a page as PNG or JPG.\"}]}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"FAQPage\", \"mainEntity\": [{\"@type\": \"Question\", \"name\": \"How do I edit a PDF with PDF Edit?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Upload your PDF or a JPG/PNG photo, click any line of text on the page and type to change it, then download the result as a PDF. To change a logo or picture, click it to make it movable, or use Grab area to draw a box around it.\"}}, {\"@type\": \"Question\", \"name\": \"Does PDF Edit upload my file to a server?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"No. Your PDF is opened and edited inside your browser, and the finished file is created on your device. The page loads its PDF code libraries from a public code host, but your document is not sent anywhere.\"}}, {\"@type\": \"Question\", \"name\": \"Do I need an account to use PDF Edit?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"No. There is nothing to sign up for. Open the page, upload a PDF and start editing.\"}}, {\"@type\": \"Question\", \"name\": \"Can I edit logos and images in a PDF?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Yes. Pictures already in the PDF can be clicked, moved, resized or deleted. Logos or QR codes drawn as vector shapes can be picked up with the Grab area tool. You can also add new images, replace them and crop them.\"}}, {\"@type\": \"Question\", \"name\": \"Which formats can I download?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"You can download the edited document as a PDF. You can also save the current page as a PNG or a JPG image.\"}}, {\"@type\": \"Question\", \"name\": \"Why does my edited text look different from the original?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Edited text is saved with built-in standard fonts (Helvetica, Times or Courier) so it works in every PDF viewer. The font, size, colour, bold and italic can be changed, but the original font file is not reused.\"}}, {\"@type\": \"Question\", \"name\": \"Can PDF Edit change a scanned PDF?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Not directly. A scanned page is a picture, so there is no text to click. You can add new text boxes on top, cover areas with a shape, or place images over it.\"}}, {\"@type\": \"Question\", \"name\": \"Can I edit a password-protected PDF?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"Yes. Upload the file and PDF Edit asks for its password. Enter it to open the PDF. The password is only used in your browser, and the copy you download is saved without a password.\"}}, {\"@type\": \"Question\", \"name\": \"Can I use PDF Edit to change official documents such as e-stamps?\", \"acceptedAnswer\": {\"@type\": \"Answer\", \"text\": \"No. Only edit documents you own or have permission to change. Official documents with IDs, QR codes or other registry checks, such as e-stamps, must not have their details altered. Ask the issuing authority for a corrected copy instead.\"}}]}</script>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Instrument+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"PDF Edit for Beginners\", \"description\": \"Learn PDF Edit step by step from an 8-year practitioner: edit text, move logos, add images, fix pages, unlock password PDFs and avoid costly beginner mistakes.\", \"author\": {\"@type\": \"Organization\", \"name\": \"PDF Edit\"}, \"dateModified\": \"2026-10-31\", \"mainEntityOfPage\": \"#pdf-edit-beginners-guide\"}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"How to Fix a PDF in 10 Minutes with PDF Edit\", \"description\": \"Fix a PDF in minutes with PDF Edit: change text, replace a logo, reorder pages and download a clean copy. A short practical guide for beginners.\", \"author\": {\"@type\": \"Organization\", \"name\": \"PDF Edit\"}, \"dateModified\": \"2026-10-31\", \"mainEntityOfPage\": \"#fix-pdf-fast\"}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Open a Password PDF and Convert Letter to Legal in PDF Edit\", \"description\": \"Open a password-protected PDF in PDF Edit, edit it and convert Letter pages to Legal size before download. Simple steps and common mistakes.\", \"author\": {\"@type\": \"Organization\", \"name\": \"PDF Edit\"}, \"dateModified\": \"2026-10-31\", \"mainEntityOfPage\": \"#unlock-legal-pdf\"}</script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js\"></script>\n<style>\n:root{\n  --ink:#0f2e22; --muted:#5a7768; --paper:#f5faf6; --card:#ffffff; --line:#d8ecdf;\n  --violet:#0f8f55; --teal:#15b878; --coral:#2f9e68; --soft:#e7f6ec; --work:#eef8f1; --onviolet:#fff;\n}\n@media (prefers-color-scheme: dark){\n  :root{ --ink:#eaf7ef; --muted:#9ecab0; --paper:#0b1a12; --card:#102a1c; --line:#1f4330; --violet:#34d488; --teal:#42e0a0; --coral:#2fbf7a; --soft:#133826; --work:#0a1710; --onviolet:#06160e; }\n}\n*{box-sizing:border-box}\n[hidden]{display:none!important}\nhtml,body{height:100%}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:\"Instrument Sans\",system-ui,sans-serif;font-size:15px;line-height:1.45}\nh1,h2,h3{font-family:\"Bricolage Grotesque\",\"Instrument Sans\",system-ui,sans-serif;margin:0;line-height:1.1}\nbutton,select,input{font:inherit;color:inherit}\nbutton{cursor:pointer}\n:focus-visible{outline:3px solid var(--teal);outline-offset:2px}\n\n/* ---------- start screen ---------- */\n#start{min-height:100%;display:flex;flex-direction:column}\n.hero{background:linear-gradient(120deg,#17c17a 0%,#0f8f55 55%,#0a5c38 100%);color:#fff;padding:56px 22px 64px;position:relative;overflow:hidden}\n.hero::after{content:\"\";position:absolute;inset:0;background:radial-gradient(circle at 85% 20%,rgba(255,255,255,.22),transparent 55%);pointer-events:none}\n.hero .in{max-width:900px;margin:0 auto}\n.hero h1{font-size:clamp(2.3rem,7vw,4.2rem);font-weight:800;letter-spacing:-.02em;max-width:13ch}\n.hero p{max-width:50ch;font-size:1.1rem;margin:16px 0 28px}\n.drop{display:flex;align-items:center;gap:18px;flex-wrap:wrap}\n.btn-up{background:#fff;color:#0a5c38;border:0;border-radius:12px;padding:14px 24px;font-weight:600;font-size:1.05rem;box-shadow:0 2px 0 rgba(0,0,0,.15)}\n.btn-up:hover{background:#eafff3}\n.drop small{opacity:.92}\nbody.dragging .hero{outline:4px dashed #fff;outline-offset:-14px}\n.steps{max-width:900px;margin:0 auto;padding:40px 22px 20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:22px;list-style:none;counter-reset:s}\n.steps li{counter-increment:s;padding-top:6px}\n.steps li::before{content:counter(s);display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--violet));color:#fff;font-family:\"Bricolage Grotesque\",sans-serif;font-weight:800;margin-bottom:10px;box-shadow:0 3px 10px rgba(15,143,85,.25)}\n.steps b{display:block;font-family:\"Bricolage Grotesque\",sans-serif;font-size:1.15rem;margin-bottom:4px}\n.steps span{color:var(--muted)}\n.fine{max-width:900px;margin:0 auto;padding:10px 22px 50px;color:var(--muted);font-size:.9rem}\n#libErr{background:#ffe3e3;color:#7a1010;padding:12px 22px;font-weight:600}\n\n\n.hero h1{max-width:16ch}\n.hero .name{font-family:\"Bricolage Grotesque\",sans-serif;font-weight:800;font-size:1.3rem;margin-bottom:18px}\n.sec{max-width:900px;margin:0 auto;padding:34px 22px 6px;width:100%}\n.sec h2{font-size:clamp(1.5rem,4vw,2.1rem);font-weight:800;letter-spacing:-.01em;margin-bottom:12px}\n.sec p{max-width:68ch;margin:0 0 12px}\n.answer{border-left:5px solid var(--teal);background:var(--card);padding:14px 18px;border-radius:0 12px 12px 0;max-width:72ch;font-size:1.05rem}\n.feat{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px;margin:0}\n.feat div{border-left:4px solid var(--violet);padding:2px 0 2px 14px}\n.feat dt{font-family:\"Bricolage Grotesque\",sans-serif;font-weight:800;font-size:1.1rem}\n.feat dd{margin:2px 0 0;color:var(--muted)}\n.tw{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--card)}\n.sec table{border-collapse:collapse;width:100%;min-width:560px}\n.sec th,.sec td{text-align:left;padding:10px 14px;border-bottom:1px solid var(--line);vertical-align:top}\n.sec th{background:var(--soft);font-family:\"Bricolage Grotesque\",sans-serif}\n.sec tr:last-child td{border-bottom:0}\n.uses{columns:2;column-gap:30px;padding-left:20px;margin:0}\n.uses li{margin-bottom:6px;break-inside:avoid}\n.faq details{border:1px solid var(--line);background:var(--card);border-radius:12px;margin-bottom:10px;padding:0 16px}\n.faq summary{cursor:pointer;font-weight:600;padding:13px 0;list-style:none;display:flex;justify-content:space-between;gap:12px}\n.faq summary::-webkit-details-marker{display:none}\n.faq summary::after{content:\"+\";font-weight:800;color:var(--violet)}\n.faq details[open] summary::after{content:\"−\"}\n.faq details p{margin:0 0 14px;color:var(--muted)}\n.keys{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;margin:0}\n.keys dt kbd{background:var(--soft);border:1px solid var(--line);border-radius:6px;padding:1px 8px;font-family:inherit;font-weight:600}\n.keys dd{margin:0;color:var(--muted)}\nfooter.site{max-width:900px;margin:0 auto;padding:30px 22px 50px;color:var(--muted);font-size:.9rem;width:100%}\n@media (max-width:620px){.uses{columns:1}}\n/* ---------- app shell ---------- */\n#app{height:100vh;display:grid;grid-template-columns:168px 1fr 270px;grid-template-rows:56px 1fr;grid-template-areas:\"top top top\" \"pages work props\"}\n.top{grid-area:top;display:flex;align-items:center;gap:8px;padding:0 12px;background:linear-gradient(100deg,#15b878,#0f8f55 55%,#0a5c38);color:#fff;overflow-x:auto}\n.brand{font-family:\"Bricolage Grotesque\",sans-serif;font-weight:800;font-size:1.25rem;margin-right:6px}\n#fname{max-width:18ch;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:.92;margin-right:6px}\n.grp{display:flex;gap:4px;padding:3px;background:rgba(255,255,255,.18);border-radius:10px}\n.top button{background:transparent;border:0;color:#fff;border-radius:8px;padding:6px 11px;font-weight:600;white-space:nowrap}\n.top button:hover{background:rgba(255,255,255,.22)}\n.top button[aria-pressed=\"true\"]{background:#fff;color:#0a5c38}\n.top button:disabled{opacity:.5;cursor:default}\n.top .sp{flex:1}\n.top .dl{background:#fff;color:#0a5c38}\n.top .dl:hover{background:#eafff3}\n.zoomv{min-width:3.4em;text-align:center;font-weight:600}\n#pages{grid-area:pages;background:var(--card);border-right:1px solid var(--line);overflow:auto;padding:12px 10px}\n.thumb{margin-bottom:14px;border-radius:8px}\n.tpic{display:block;width:100%;padding:3px;border:2px solid var(--line);background:var(--paper);border-radius:8px}\n.thumb.on .tpic{border-color:var(--violet)}\n.tpic canvas{display:block;margin:0 auto;background:#fff}\n.tbar{display:flex;align-items:center;justify-content:space-between;margin-top:4px;font-size:.85rem;color:var(--muted)}\n.tact{display:flex;gap:2px}\n.tact button{border:0;background:transparent;border-radius:6px;padding:2px 6px;color:var(--muted)}\n.tact button:hover{background:var(--soft);color:var(--ink)}\n#addPage{width:100%;padding:8px;border:1.5px dashed var(--line);background:transparent;border-radius:8px;color:var(--muted);font-weight:600}\n#addPage:hover{border-color:var(--violet);color:var(--violet)}\n#work{grid-area:work;background:var(--work);overflow:auto;padding:28px;position:relative}\n#stage{position:relative;margin:0 auto;box-shadow:0 4px 22px rgba(20,10,60,.28);background:#fff}\n#cv{display:block}\n#layer{position:absolute;left:0;top:0;transform-origin:0 0}\nbody.t-text #layer{cursor:text}\nbody.t-shape #layer{cursor:crosshair}\n.o{position:absolute;white-space:pre;color:transparent;cursor:text;outline:1px dashed transparent;border-radius:1px;overflow:visible}\n.o:hover{outline-color:var(--violet)}\n.o.edited,.o:focus{color:var(--c,#000);background:var(--bg,#fff)}\n.o:focus,.o.sel{outline:2px solid var(--violet)}\n.el{position:absolute}\n.el:hover{outline:1px dashed var(--violet)}\n.el.sel{outline:2px solid var(--violet)}\n.el .txt{white-space:pre;min-width:24px;outline:none;line-height:1.2;color:var(--c,#111);cursor:text}\n.el img{display:block;width:100%;height:100%;pointer-events:none;user-select:none;-webkit-user-drag:none}\n.el.rect,.el.image{cursor:move}\n.pic{position:absolute;cursor:pointer;outline:2px dashed transparent}\n.pic:hover{outline-color:var(--teal);background:rgba(20,169,196,.14)}\n.marq{position:absolute;border:2px dashed var(--teal);background:rgba(20,169,196,.16);pointer-events:none}\nbody.t-grab #layer{cursor:crosshair}\nbody.t-grab .pic,body.t-grab .o,body.t-grab .el{pointer-events:none}\n.move,.resize{position:absolute;display:none;background:var(--violet);touch-action:none}\n.move{left:-2px;top:-17px;width:22px;height:15px;border-radius:4px 4px 0 0;cursor:move}\n.move::after{content:\"\";position:absolute;inset:4px 5px;border-top:2px solid #fff;border-bottom:2px solid #fff}\n.resize{right:-6px;bottom:-6px;width:12px;height:12px;border-radius:3px;cursor:nwse-resize}\n.el.sel .move{display:block}\n.el.sel .resize{display:block}\n#props{grid-area:props;background:var(--card);border-left:1px solid var(--line);overflow:auto;padding:16px}\n#props h2{font-size:1.2rem;margin-bottom:12px}\n#props p,#props li{color:var(--muted);font-size:.92rem}\n#props ul{padding-left:18px;margin:6px 0 14px}\n#props h3{font-size:.95rem;margin:16px 0 6px}\n.f{display:block;margin-bottom:10px}\n.f>span{display:block;font-size:.85rem;color:var(--muted);margin-bottom:3px}\n.f input[type=number],.f select{width:100%;padding:7px 8px;border:1px solid var(--line);border-radius:8px;background:var(--paper)}\n.f input[type=color]{width:100%;height:36px;padding:2px;border:1px solid var(--line);border-radius:8px;background:var(--paper)}\n.f input[type=range]{width:100%}\n.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n.four{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.seg{display:flex;gap:6px;margin-bottom:10px}\n.seg button,.pb{border:1px solid var(--line);background:var(--paper);border-radius:8px;padding:7px 12px;font-weight:600}\n.seg button[aria-pressed=\"true\"]{background:var(--violet);color:var(--onviolet);border-color:var(--violet)}\n.pb:hover{border-color:var(--violet)}\n.pb.danger{color:#c0261f}\n.pbs{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}\n#dlOverlay{position:fixed;inset:0;background:rgba(10,20,14,.45);display:grid;place-items:center;z-index:55;padding:16px}\n#dlDialog{background:var(--card);color:var(--ink);width:100%;max-width:380px;border-radius:16px;box-shadow:0 14px 44px rgba(0,0,0,.3);overflow:hidden;max-height:90vh;display:flex;flex-direction:column}\n.dlHead{display:flex;align-items:center;gap:12px;padding:16px 18px;border-bottom:1px solid var(--line)}\n.dlHead button{background:transparent;border:0;font-size:1.1rem;color:var(--ink);border-radius:8px;padding:4px 8px}\n.dlHead button:hover{background:var(--soft)}\n.dlHead h2{font-size:1.1rem}\n.dlBody{padding:18px;overflow-y:auto}\n.dlLabel{display:block;font-weight:700;font-size:.92rem;margin:14px 0 8px}\n.dlLabel:first-child{margin-top:0}\n.dlTypes{display:flex;flex-direction:column;gap:8px}\n.dlType{display:flex;align-items:center;gap:12px;text-align:left;border:1.5px solid var(--line);background:var(--paper);border-radius:12px;padding:10px 12px;width:100%}\n.dlType[aria-checked=\"true\"]{border-color:var(--violet);box-shadow:0 0 0 1px var(--violet) inset}\n.dlIco{flex:0 0 auto;width:38px;height:38px;border-radius:8px;background:var(--soft);color:var(--violet);display:grid;place-items:center;font-size:.72rem;font-weight:800}\n.dlName{flex:1;font-weight:600;display:flex;flex-direction:column;gap:1px}\n.dlName em{font-style:normal;font-weight:400;color:var(--muted);font-size:.82rem}\n.dlBadge{background:var(--violet);color:var(--onviolet);font-size:.72rem;font-weight:700;border-radius:999px;padding:3px 9px;white-space:nowrap}\n.dlSize{display:flex;align-items:center;gap:12px}\n.dlSize input[type=range]{flex:1}\n.dlSize span{min-width:2.6em;text-align:right;font-weight:600}\n.dlNote{color:var(--muted);font-size:.85rem;margin:14px 0 0}\n.dlGo{margin:0 18px 18px;background:var(--violet);color:var(--onviolet);border:0;border-radius:12px;padding:14px;font-weight:700;font-size:1.02rem}\n.dlGo:hover{filter:brightness(1.05)}\n#toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:var(--ink);color:var(--paper);padding:10px 18px;border-radius:10px;max-width:90vw;z-index:50;font-weight:500;box-shadow:0 4px 18px rgba(0,0,0,.3)}\n#busy{position:fixed;inset:0;background:rgba(20,16,60,.55);display:grid;place-items:center;color:#fff;font-family:\"Bricolage Grotesque\",sans-serif;font-size:1.5rem;z-index:60}\n@media (max-width:900px){\n  #app{height:auto;min-height:100vh;grid-template-columns:1fr;grid-template-rows:56px auto 70vh auto;grid-template-areas:\"top\" \"pages\" \"work\" \"props\"}\n  #pages{display:flex;gap:10px;border-right:0;border-bottom:1px solid var(--line)}\n  .thumb{min-width:110px;margin:0}\n  #addPage{min-width:90px}\n  #work{padding:14px}\n}\n@media (prefers-reduced-motion:no-preference){ .hero h1{animation:rise .6s ease both} @keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}} }\n\n#pwOverlay{position:fixed;inset:0;background:rgba(10,20,14,.55);display:grid;place-items:center;z-index:70;padding:16px}\n#pwDialog{background:var(--card);color:var(--ink);width:100%;max-width:380px;border-radius:16px;box-shadow:0 14px 44px rgba(0,0,0,.3);overflow:hidden}\n#pwDialog .pwBody{padding:20px 18px 6px}\n#pwDialog h2{font-size:1.1rem;margin:0 0 6px}\n#pwDialog p{margin:0 0 12px;color:var(--muted);font-size:.9rem;word-break:break-word}\n#pwInput{width:100%;box-sizing:border-box;padding:11px 12px;border:1.5px solid var(--line);border-radius:10px;background:var(--paper);color:var(--ink);font-size:1rem}\n#pwInput:focus{outline:2px solid var(--violet);outline-offset:1px}\n#pwErr{color:#c0261f;font-weight:600;font-size:.88rem;margin:8px 0 0}\n.pwShow{display:flex;align-items:center;gap:8px;margin:10px 0 0;font-size:.88rem;color:var(--muted)}\n.pwBtns{display:flex;gap:10px;padding:14px 18px 18px}\n.pwBtns button{flex:1;border-radius:12px;padding:12px;font-weight:700;font-size:1rem;border:1.5px solid var(--line);background:transparent;color:var(--ink)}\n.pwBtns button#pwOk{background:var(--violet);color:var(--onviolet);border-color:var(--violet)}\n.dlCheck{display:flex;align-items:flex-start;gap:10px;margin:16px 0 0;font-weight:600;font-size:.92rem;cursor:pointer}\n.dlCheck input{margin-top:3px;width:18px;height:18px;flex:0 0 auto;accent-color:var(--violet)}\n.dlCheck em{display:block;font-style:normal;font-weight:400;color:var(--muted);font-size:.82rem;margin-top:2px}\n.art h3{font-size:1.25rem;font-weight:700;margin:22px 0 8px}.art ul,.gl{max-width:68ch;margin:0 0 12px;padding-left:22px}.art li,.gl li{margin-bottom:6px}.byline{color:var(--muted);font-size:.88rem}.art a,.gl a{color:var(--violet);font-weight:600}.art{border-top:1px solid var(--line);margin-top:18px}\n</style>\n</head>\n<body>\n\n<div id=\"start\">\n  <div id=\"libErr\" hidden>The editing libraries could not load. Check your internet connection and reload this page.</div>\n  <header class=\"hero\">\n    <div class=\"in\">\n      <span style=\"display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.2);backdrop-filter:blur(2px);border:1px solid rgba(255,255,255,.35);border-radius:999px;padding:6px 14px;font-weight:600;font-size:.85rem;margin-bottom:16px\">No sign-up · Files stay on your device</span>\n      <div class=\"name\">PDF Edit</div>\n      <h1>Edit PDF text, logos and pages in your browser</h1>\n      <p>Upload a PDF or a JPG/PNG photo, change its text, images and pages, then download it as a PDF, JPG or PNG. Your file stays on your device.</p>\n      <div class=\"drop\">\n        <button class=\"btn-up\" id=\"upBtn\" type=\"button\">Upload PDF or JPG</button>\n        <small>or drop a PDF or JPG anywhere on this page</small>\n      </div>\n    </div>\n  </header>\n  <div class=\"content\">\n  <section class=\"sec\" aria-labelledby=\"what\">\n    <h2 id=\"what\">What is PDF Edit?</h2>\n    <p class=\"answer\"><strong>PDF Edit is a browser-based PDF editor that lets you change the text, images, logos and pages of a PDF inside your browser.</strong> You upload a PDF, edit it on screen, and download the result as a PDF, or save a page as a PNG or JPG. Your document is processed on your device and is not sent to a server.</p>\n  </section>\n\n  <section class=\"sec\" aria-labelledby=\"how\">\n    <h2 id=\"how\">How to edit a PDF in 4 steps</h2>\n    <ol class=\"steps\" style=\"padding:8px 0 0\">\n      <li><b>Upload your PDF or JPG</b><span>Select Upload PDF or JPG, or drop a PDF or JPG/PNG photo onto the page. It opens as a new project in your browser.</span></li><li><b>Let it split into pieces</b><span>Text becomes editable lines, and pictures and logos become movable images. You can add text boxes, images and shapes.</span></li><li><b>Compare with the original</b><span>Use the Original button to hide your edits and check that tables and other elements have not shifted.</span></li><li><b>Edit and download</b><span>Change text, images, pages and layers, then download the result as a PDF, or save a page as PNG or JPG.</span></li>\n    </ol>\n  </section>\n\n  <section class=\"sec\" aria-labelledby=\"can\">\n    <h2 id=\"can\">What you can edit</h2>\n    <dl class=\"feat\">\n      <div><dt>Text</dt><dd>Change the words, font, size, colour, bold and italic, and add new text boxes.</dd></div>\n      <div><dt>Images and logos</dt><dd>Move, resize, crop, replace or delete pictures. Grab area picks up logos and QR codes drawn as shapes.</dd></div>\n      <div><dt>Pages</dt><dd>Reorder, duplicate, delete or add blank pages.</dd></div>\n      <div><dt>Layers</dt><dd>Send added items backward or bring them forward so the right one shows on top.</dd></div>\n      <div><dt>Shapes</dt><dd>Add boxes with any colour and opacity, or use white to cover something.</dd></div>\n      <div><dt>Compare and undo</dt><dd>Hide your edits to see the original page, and undo any step.</dd></div>\n    </dl>\n  </section>\n\n  <section class=\"sec\" aria-labelledby=\"limits\">\n    <h2 id=\"limits\">What works and what to know</h2>\n    <div class=\"tw\"><table>\n      <thead><tr><th>Task</th><th>Supported</th><th>Good to know</th></tr></thead>\n      <tbody>\n        <tr><td>Edit existing text</td><td>Yes</td><td>Saved in Helvetica, Times or Courier. Horizontal text only.</td></tr>\n        <tr><td>Move or delete a logo</td><td>Yes</td><td>The old spot is covered with the page colour, so plain backgrounds work best.</td></tr>\n        <tr><td>Add or replace images</td><td>Yes</td><td>PNG, JPG and most browser image formats.</td></tr>\n        <tr><td>Reorder or delete pages</td><td>Yes</td><td>Undo is available for every change.</td></tr>\n        <tr><td>Scanned PDFs</td><td>Partly</td><td>There is no text recognition, so add new text boxes on top.</td></tr>\n        <tr><td>Password-protected PDFs</td><td>Yes</td><td>Enter the password when you upload. The downloaded copy has no password.</td></tr>\n        <tr><td>Download</td><td>PDF, PNG, JPG</td><td>PNG and JPG save the current page.</td></tr>\n      </tbody>\n    </table></div>\n  </section>\n\n  <section class=\"sec\" aria-labelledby=\"uses\">\n    <h2 id=\"uses\">Common uses</h2>\n    <ul class=\"uses\">\n      <li>Fix a typo in a CV or cover letter</li>\n      <li>Update a date or price on a flyer</li>\n      <li>Swap a logo on your own brochure</li>\n      <li>Remove a page from a report</li>\n      <li>Reorder slides exported as a PDF</li>\n      <li>Add a note or label to a form</li>\n      <li>Cover private details before sharing</li>\n      <li>Turn a page into a PNG or JPG</li>\n    </ul>\n  </section>\n\n  <section class=\"sec faq\" aria-labelledby=\"faq\">\n    <h2 id=\"faq\">Frequently asked questions</h2>\n    <details><summary>How do I edit a PDF with PDF Edit?</summary><p>Upload your PDF or a JPG/PNG photo, click any line of text on the page and type to change it, then download the result as a PDF. To change a logo or picture, click it to make it movable, or use Grab area to draw a box around it.</p></details>\n<details><summary>Does PDF Edit upload my file to a server?</summary><p>No. Your PDF is opened and edited inside your browser, and the finished file is created on your device. The page loads its PDF code libraries from a public code host, but your document is not sent anywhere.</p></details>\n<details><summary>Do I need an account to use PDF Edit?</summary><p>No. There is nothing to sign up for. Open the page, upload a PDF and start editing.</p></details>\n<details><summary>Can I edit logos and images in a PDF?</summary><p>Yes. Pictures already in the PDF can be clicked, moved, resized or deleted. Logos or QR codes drawn as vector shapes can be picked up with the Grab area tool. You can also add new images, replace them and crop them.</p></details>\n<details><summary>Which formats can I download?</summary><p>You can download the edited document as a PDF. You can also save the current page as a PNG or a JPG image.</p></details>\n<details><summary>Why does my edited text look different from the original?</summary><p>Edited text is saved with built-in standard fonts (Helvetica, Times or Courier) so it works in every PDF viewer. The font, size, colour, bold and italic can be changed, but the original font file is not reused.</p></details>\n<details><summary>Can PDF Edit change a scanned PDF?</summary><p>Not directly. A scanned page is a picture, so there is no text to click. You can add new text boxes on top, cover areas with a shape, or place images over it.</p></details>\n<details><summary>Can I edit a password-protected PDF?</summary><p>Yes. Upload the file and PDF Edit asks for its password. Enter it to open the PDF. The password is only used in your browser, and the copy you download is saved without a password.</p></details>\n<details><summary>Can I use PDF Edit to change official documents such as e-stamps?</summary><p>No. Only edit documents you own or have permission to change. Official documents with IDs, QR codes or other registry checks, such as e-stamps, must not have their details altered. Ask the issuing authority for a corrected copy instead.</p></details>\n  </section>\n\n  <section class=\"sec\" aria-labelledby=\"priv\">\n    <h2 id=\"priv\">Privacy and responsible use</h2>\n    <p>Your PDF stays in your browser while you edit. Only edit documents you own or have permission to change. Official documents with IDs, QR codes or other checks against a registry, such as e-stamps, must not have their details altered.</p>\n  </section>\n\n  <section class=\"sec\" aria-labelledby=\"keys\">\n    <h2 id=\"keys\">Keyboard shortcuts</h2>\n    <dl class=\"keys\">\n      <dt><kbd>Ctrl</kbd> + <kbd>Z</kbd></dt><dd>Undo (Cmd + Z on Mac)</dd>\n      <dt><kbd>Delete</kbd></dt><dd>Delete the selected item, or clear the selected text</dd>\n      <dt><kbd>Esc</kbd></dt><dd>Deselect and return to the Select tool</dd>\n      <dt><kbd>Enter</kbd></dt><dd>Finish editing a line of page text</dd>\n    </dl>\n  </section>\n</div>\n<noscript><p class=\"fine\">PDF Edit needs JavaScript to open and edit PDF files in your browser.</p></noscript>\n\n<section class=\"sec\" id=\"guides\" aria-labelledby=\"gh\"><h2 id=\"gh\">PDF Edit guides and tutorials</h2>\n<ul class=\"gl\"><li><a href=\"#pdf-edit-beginners-guide\">PDF Edit for Beginners</a></li><li><a href=\"#fix-pdf-fast\">How to Fix a PDF in 10 Minutes with PDF Edit</a></li><li><a href=\"#unlock-legal-pdf\">Open a Password PDF and Convert Letter to Legal</a></li></ul></section>\n\n<article class=\"sec art\" id=\"pdf-edit-beginners-guide\" itemscope itemtype=\"https://schema.org/Article\">\n<h2 itemprop=\"headline\">PDF Edit for Beginners</h2>\n<p class=\"byline\">By the PDF Edit team · 8 years of hands-on PDF editing · Updated 31 October 2026</p>\n<p>I have been editing PDF files for eight years, and I still remember my first day. A customer sent me an invoice with one wrong phone number. I thought it would take two minutes. It took two hours, because I did not understand how a PDF is built. This guide is the one I wish I had read back then. It teaches a complete beginner how to use PDF Edit, a free browser-based PDF editor, from the first upload to the final download. I will also share the mistakes I made with real examples, so you can skip them.</p>\n\n<h3>Why you can trust this PDF Edit guide</h3>\n<p>Everything below comes from daily work with PDF Edit and from the way the tool actually behaves. I do not promise magic. PDF Edit changes text, moves logos and images, adds shapes and reorders pages, and it also has clear limits, which I explain honestly. When something does not work well, I say so. That honesty is what builds trust, and it is the first lesson of this guide: know what your tool can and cannot do before you promise anything to a client.</p>\n\n<h3>What is PDF Edit and who is it for?</h3>\n<p>PDF Edit is a free online editor that opens in your web browser. You upload a PDF, or a JPG or PNG photo, and it opens as a new project. Text becomes editable lines. Pictures and logos become images you can move. You can add your own text boxes, images and shapes, change the order of the pages, and download the result as a PDF. You can also save a single page as a PNG or JPG image.</p>\n<p>Who uses PDF Edit? Students who need to fix a form, shop owners who must correct an invoice, office workers who update a letter, and property dealers who change a name on a draft. If you can use a web browser, you can use PDF Edit. There is no account to create and nothing to install. Your file is opened and edited inside your browser, and the finished file is created on your own device, so your document is not sent to a server.</p>\n\n<h3>Before you start: understand how a PDF works</h3>\n<p>This is the lesson that cost me the most time. A PDF is not a Word document. A Word file stores paragraphs that flow. A PDF stores the position of every piece of text and every picture on a fixed page. That is why a PDF looks the same on every device, and it is also why editing is harder than in a word processor.</p>\n<p>PDF Edit solves this by splitting a page into pieces. Each line of text becomes a box you can click. Each picture becomes an object. Vector logos or QR codes drawn as shapes can be picked up with the Grab area tool. Once you understand that PDF Edit works with lines and objects, not with flowing paragraphs, everything else makes sense.</p>\n<p>There are two kinds of PDF, and you should check which one you have. A digital PDF was created from a program such as Word, so it contains real text. A scanned PDF is only a photo of paper, so there is no text to click. PDF Edit cannot recognise text in a scan, but you can still add new text boxes on top, cover an area with a shape, or place an image over it. I will come back to this in the mistakes section, because I once spent an hour clicking on a scan.</p>\n\n<h3>Step 1: Upload your file to PDF Edit</h3>\n<p>Open PDF Edit and choose Upload PDF or JPG, or simply drop a file onto the page. The file opens as a new project in your browser. Give it a moment if the document is large.</p>\n<p>If your PDF is protected with a password, PDF Edit now asks for it in a small box. Type the password and press Open. If you type it wrongly, PDF Edit tells you and asks again. You can tick Show password to check what you typed. If you cancel, nothing is lost. The copy you download later is saved without a password, which is something to remember before you share it.</p>\n<p>You can also upload a JPG or PNG photo. PDF Edit turns it into a one-page document so you can add text, shapes or images and then download it as a PDF. I use this for photos of signed pages that need a label added.</p>\n\n<h3>Step 2: Edit text in PDF Edit</h3>\n<p>Click any line of text on the page and type to change it. In the properties panel you can change the font family, size, colour, bold and italic. Edited text is saved with the built-in standard fonts: Helvetica, Times or Courier. This keeps the file working in every PDF viewer, but it also means the original font file is not reused. Your edited line may look slightly different from the lines around it.</p>\n<p>When you change a line, PDF Edit covers the old text with a rectangle in the page colour and writes the new text on top. On a plain white page this is invisible. On a coloured or patterned background you may see the patch. That is why the Original button exists, and I will explain it in Step 7.</p>\n<p>One more detail from experience: PDF Edit handles horizontal text. Vertical or rotated text is not a good fit. Also, the standard fonts cannot draw every character. If you type a character that the fonts do not support, it is saved as a question mark, and PDF Edit warns you after the download. Smart quotes and long dashes are replaced with simple ones automatically.</p>\n\n<h3>Step 3: Move, resize, replace or delete images and logos</h3>\n<p>Pictures already inside the PDF can be clicked, moved, resized, cropped, replaced or deleted. Click the logo and it becomes movable. Drag it to a new place, pull a corner to resize it, or choose replace to swap in a new file. When you move or delete a picture, PDF Edit covers the old spot with the page colour, so plain backgrounds work best.</p>\n<p>A real example: a small company changed its name and needed its price list updated within an hour. I opened the price list in PDF Edit, clicked the old logo, replaced it with the new file and resized it to match the old width. Then I edited the heading text. The whole job took about ten minutes, and the client never saw the old brand again.</p>\n\n<h3>Step 4: Use Grab area for logos drawn as shapes</h3>\n<p>Not every logo is a picture. Some logos and QR codes are drawn as vector shapes, so clicking does nothing. For these, use the Grab area tool. Draw a box around the area, and PDF Edit lets you pick that part of the page up and move it. Beginners often think PDF Edit is broken when a logo will not move. It is not broken. The logo is simply a drawing, and Grab area is the right tool.</p>\n\n<h3>Step 5: Add text boxes, images and shapes</h3>\n<p>PDF Edit lets you add new items to any page. A text box is perfect for a date, a note or a label. An image can be a signature photo or a stamp you own. A shape, such as a filled rectangle, can cover an area. Added items have layers, so you can bring one forward or send it back. If your new text hides behind a rectangle, change the layer order and it will appear.</p>\n<p>For scanned documents this is the main way to work. You cannot click the scanned text, but you can place a rectangle over a mistake and type the correction in a new text box on top.</p>\n\n<h3>Step 6: Manage pages in PDF Edit</h3>\n<p>The page list on the left lets you reorder pages, duplicate them, delete them and add blank pages. This is very useful when a client sends pages in the wrong order or when you need to remove a page that should not be shared. Drag the thumbnail to a new place, or use the page actions. Every change can be undone.</p>\n\n<h3>Step 7: Compare your edits with the original</h3>\n<p>This is my favourite habit. Press the Original button to hide your edits and see the first version of the page. Press it again to bring your edits back. By switching between the two, you can check that tables, lines and other elements have not shifted. I never send a file before doing this comparison. It takes ten seconds and has saved me many times.</p>\n\n<h3>Step 8: Download from PDF Edit as PDF, PNG or JPG</h3>\n<p>Open the Download dialog and choose your file type. PDF downloads the whole document with every page. PNG and JPG save only the page you are viewing, and you can set the quality and the size. For printing and sharing documents, PDF is the best choice. For a quick image to send in a chat, use JPG.</p>\n<p>If you made a mistake, use Undo. PDF Edit remembers many steps, so you can go back without starting again. Finally, check the downloaded file in your normal PDF viewer before you send it to anyone.</p>\n\n<h3>Convert Letter pages to Legal size with PDF Edit</h3>\n<p>Many offices in Pakistan and elsewhere print on Legal paper, which is 8.5 by 14 inches, while many files come as Letter, which is 8.5 by 11 inches. PDF Edit can fix this on download. If your file has Letter pages, the Download dialog shows a box: Convert Letter pages to Legal size. It is ticked by default. PDF Edit keeps your content where it is and adds the extra three inches of blank space at the bottom of the page. Pages in other sizes, such as A4, are left alone. This applies to PDF downloads, not to PNG or JPG images.</p>\n<p>I learned this the hard way. A client once printed forty pages on Legal paper, and every page was shrunk with thick margins because the file was Letter. We wasted paper and time. Now I tick this box before every print job.</p>\n\n<h3>Five mistakes I made with PDF Edit (so you do not have to)</h3>\n<p><strong>Mistake 1: Trying to edit a scan.</strong> My client sent a photographed contract and I kept clicking the text. Nothing happened, because a scan is only a picture. Now I check first. If I cannot click a line, I add a text box and a cover shape instead.</p>\n<p><strong>Mistake 2: Not comparing with the original.</strong> Early on, I edited an invoice and sent it immediately. The table had shifted by a few pixels and a column looked wrong. The client noticed before I did. That is why I now use the Original button every single time.</p>\n<p><strong>Mistake 3: Expecting the same font.</strong> I changed one word in a letter and was surprised that it looked different. PDF Edit saves edited text in Helvetica, Times or Courier. If the rest of the page uses another font, I edit the whole line so it looks consistent, or I choose the closest family.</p>\n<p><strong>Mistake 4: Forgetting that the downloaded file has no password.</strong> I once unlocked a client file, edited it and emailed it without thinking. The original was protected for a reason. Now I always ask myself whether the copy should be shared freely.</p>\n<p><strong>Mistake 5: Editing documents that must not be edited.</strong> I will say this clearly. Official documents with IDs, QR codes or registry checks, such as e-stamps, must never have their details changed. Only edit files you own or have permission to change. If an official paper has a mistake, ask the issuing office for a corrected copy. This is the most important rule of responsible PDF editing, and I follow it without exception.</p>\n\n<h3>Is PDF Edit safe and private?</h3>\n<p>Your PDF is opened and edited inside your browser. The finished file is created on your device. The page loads its PDF code libraries from a public code host, but your document itself is not sent anywhere. There is nothing to sign up for. Opening a password-protected file loads one extra helper library the first time, and your password is only used in your browser to unlock the file.</p>\n\n<h3>Quick checklist for every PDF Edit job</h3>\n<ul>\n<li>Check whether your PDF is digital or scanned.</li>\n<li>Upload it to PDF Edit and enter the password if asked.</li>\n<li>Edit text lines, then move or replace images and logos.</li>\n<li>Use Grab area for vector logos and QR drawings you own.</li>\n<li>Add text boxes or shapes where there is nothing to click.</li>\n<li>Press Original and compare every page.</li>\n<li>Tick the Letter to Legal box if you will print on Legal paper.</li>\n<li>Download the PDF and open it in another viewer to check.</li>\n</ul>\n\n<h3>Frequently asked beginner questions about PDF Edit</h3>\n<p><strong>Do I need an account?</strong> No. Open PDF Edit, upload a file and start editing.</p>\n<p><strong>Can I edit a password-protected PDF?</strong> Yes. PDF Edit asks for the password when you upload the file.</p>\n<p><strong>Why does my edited text look different?</strong> Edited text uses Helvetica, Times or Courier so it works everywhere. You can change the size, colour, bold and italic.</p>\n<p><strong>Which formats can I download?</strong> PDF for the whole document, and PNG or JPG for the current page.</p>\n\n<h3>Real examples: three jobs I finished with PDF Edit</h3>\n<p><strong>The wrong date on a certificate copy.</strong> A teacher needed a practice worksheet with a new date. I opened it in PDF Edit, clicked the date line, typed the new one and matched the size and colour to the surrounding text. Then I pressed Original to confirm that nothing else had moved. Total time: four minutes. The lesson is that small jobs are the best use of PDF Edit, because you do not need heavy software for a single correction.</p>\n<p><strong>The rental agreement with pages in the wrong order.</strong> A landlord scanned eight pages and the scanner mixed them up. Instead of scanning again, I dragged the page thumbnails into the right order and deleted a duplicate page. PDF Edit let me undo twice when I dropped a page in the wrong place. The landlord thought I had rebuilt the whole file, but I had only used the page list.</p>\n<p><strong>The flyer with an outdated phone number.</strong> The number sat on a coloured banner. When I edited the line, the patch behind the new text was slightly lighter than the banner. I fixed it by choosing the background colour that matched, and then I checked the result with the Original button. This taught me that coloured backgrounds need extra attention, and that a quick comparison always shows the problem before your client does.</p>\n\n<h3>Tips to work faster in PDF Edit</h3>\n<p>After thousands of files, I have a few habits that make PDF Edit feel effortless. First, zoom in before you edit small text, because a clear view prevents mis-clicks. Second, change one thing at a time and look at the page after each change, because Undo is easiest when the mistake is fresh. Third, use Ctrl+Z or the Undo button instead of fixing a mistake by hand. Fourth, press Escape to deselect an object when you are done, so you do not move it by accident. Fifth, keep the original file untouched, because PDF Edit always creates a new download and your first file stays safe.</p>\n<p>Also think about file size. If you add a very large photo, the PDF becomes heavy. Resize large images before you place them, or accept the bigger file if quality matters more than size. For files that you will email, I prefer smaller images. For files that you will print, I prefer sharper ones.</p>\n\n<h3>Choosing the right font in PDF Edit</h3>\n<p>Because PDF Edit saves edited text with Helvetica, Times or Courier, your font choice matters. Helvetica is a clean sans-serif and suits modern documents, invoices and forms. Times is a serif and suits letters, agreements and formal papers. Courier is a monospaced font and suits codes, numbers and anything that must line up. When I edit a letter that was originally in a serif font, I choose Times so that the changed line blends with the rest. When I edit a form or a price list, I choose Helvetica. If the match still looks odd, I edit the neighbouring words in the same line so that the whole line uses one font. This simple habit makes edits almost impossible to spot.</p>\n\n<h3>What PDF Edit cannot do, and what to use instead</h3>\n<p>I want you to know the limits before you start, because honest expectations save time. PDF Edit does not recognise text in scanned pages, so scans need new text boxes and cover shapes. It works best with horizontal text. It does not reuse the original font file. A new password cannot be added by PDF Edit, so if you need a protected copy, add the password in a separate program after you download. And PDF Edit is not meant for official records. If you need to change a government document, a bank statement or an e-stamp, the correct path is to ask the issuing authority. Using PDF Edit responsibly is part of being a trusted professional, and clients remember that.</p>\n<p>When a job is beyond these limits, I say so at once. A client once asked me to change a printed stamp paper. I refused and explained why, and I told him where to request a new copy. He was unhappy for a day, and thankful a week later when a colleague faced trouble for altering a similar document. Honesty protects you as much as it protects other people.</p>\n\n<h3>Printing your edited PDF Edit file correctly</h3>\n<p>Many beginners finish editing and then lose time at the printer. Before printing, open the downloaded PDF in a normal viewer and check every page. Confirm the paper size. If your printer uses Legal paper, remember to tick the Letter to Legal box in the Download dialog. Choose actual size in the print dialog, not fit to page, so your margins stay correct. Print one test page first. These small checks cost one minute and can save a whole stack of paper.</p>\n\n<h3>Final thoughts on learning PDF Edit</h3>\n<p>After eight years, my advice is simple. Respect the tool and its limits. Use PDF Edit for what it does well: fixing text, moving logos, adding items and organising pages. Always compare with the original, keep the paper size in mind, and never alter official documents. If you follow these habits, you will avoid nearly every mistake I made, and you will finish jobs in minutes instead of hours. Open PDF Edit, try a practice file first, and build your confidence one step at a time. Read our short guides on <a href=\"#fix-pdf-fast\">fixing a PDF fast</a> and <a href=\"#unlock-legal-pdf\">unlocking and Legal size</a> next.</p>\n<p class=\"backlink\">← <a href=\"#start\">Back to PDF Edit: upload your PDF and start editing</a> · <a href=\"#guides\">All PDF Edit guides</a></p>\n</article>\n\n<article class=\"sec art\" id=\"fix-pdf-fast\" itemscope itemtype=\"https://schema.org/Article\">\n<h2 itemprop=\"headline\">How to Fix a PDF in 10 Minutes with PDF Edit</h2>\n<p class=\"byline\">By the PDF Edit team · Updated 31 October 2026</p>\n<p>Need a quick correction? PDF Edit lets you change a wrong name, swap a logo or reorder pages without installing anything. First, upload the file to PDF Edit. Click the line of text you want to change and type the new words. Pick Helvetica, Times or Courier, set the size and colour, and check the result.</p>\n<h3>Replace a logo with PDF Edit</h3>\n<p>Click the logo, choose replace and select your new image. Resize it so it fits the old space. If the logo is a drawing and does not react to a click, use Grab area, draw a box around it and move it. Plain backgrounds give the cleanest result because PDF Edit covers the old spot with the page colour.</p>\n<h3>Reorder and clean pages</h3>\n<p>Drag pages in the left list to a new position, duplicate a page, delete one you do not need or add a blank page. Use Undo if you change your mind.</p>\n<h3>Check and download</h3>\n<p>Press Original to compare your edits with the first version, then download the PDF. One mistake to avoid: do not edit official papers such as e-stamps. Ask the issuing authority for a corrected copy. For the full walkthrough, read the <a href=\"#pdf-edit-beginners-guide\">complete PDF Edit beginner guide</a>.</p>\n<p class=\"backlink\">← <a href=\"#start\">Back to PDF Edit: upload your PDF and start editing</a> · <a href=\"#guides\">All PDF Edit guides</a></p>\n</article>\n\n<article class=\"sec art\" id=\"unlock-legal-pdf\" itemscope itemtype=\"https://schema.org/Article\">\n<h2 itemprop=\"headline\">Open a Password PDF and Convert Letter to Legal in PDF Edit</h2>\n<p class=\"byline\">By the PDF Edit team · Updated 31 October 2026</p>\n<p>Two common problems have a simple answer in PDF Edit. The first is a PDF that asks for a password. The second is a Letter-size file that must be printed on Legal paper.</p>\n<h3>Open a password-protected PDF in PDF Edit</h3>\n<p>Upload the file. PDF Edit shows a password box. Enter the password and press Open. A wrong password shows an error and you can try again. After unlocking, edit as normal. The downloaded copy has no password, so protect or share it carefully.</p>\n<h3>Convert Letter to Legal size</h3>\n<p>When you open the Download dialog, PDF Edit shows how many pages are Letter size and offers to convert them to Legal (8.5 × 14 in). Your content stays in place and the extra space is added at the bottom. A4 and other sizes are not changed. Only PDF downloads are converted.</p>\n<h3>Common mistake</h3>\n<p>Forgetting to tick the Legal box before printing leads to shrunk pages and wasted paper. Check the box, then download. Learn more in the <a href=\"#pdf-edit-beginners-guide\">PDF Edit beginner guide</a>.</p>\n<p class=\"backlink\">← <a href=\"#start\">Back to PDF Edit: upload your PDF and start editing</a> · <a href=\"#guides\">All PDF Edit guides</a></p>\n</article>\n\n<footer class=\"site\"><strong>PDF Edit</strong> – edit PDF text, logos, images and pages online. <a href=\"#guides\" style=\"color:inherit\">Guides</a>. Last updated 31 October 2026.</footer>\n</div>\n\n<div id=\"app\" hidden>\n  <div class=\"top\" role=\"toolbar\" aria-label=\"Editor tools\">\n    <span class=\"brand\">PDF Edit</span>\n    <span id=\"fname\"></span>\n    <div class=\"grp\" role=\"group\" aria-label=\"Tools\">\n      <button id=\"tSelect\" type=\"button\" aria-pressed=\"true\">Select</button>\n      <button id=\"tText\" type=\"button\" aria-pressed=\"false\">Text</button>\n      <button id=\"tImage\" type=\"button\">Image</button>\n      <button id=\"tGrab\" type=\"button\" aria-pressed=\"false\" title=\"Drag a box around a logo, QR code or any part of the page to move, resize or delete it\">Grab area</button>\n      <button id=\"tShape\" type=\"button\" aria-pressed=\"false\">Shape</button>\n    </div>\n    <div class=\"grp\" role=\"group\" aria-label=\"History and view\">\n      <button id=\"bUndo\" type=\"button\">Undo</button>\n      <button id=\"bCompare\" type=\"button\" aria-pressed=\"false\" title=\"Hide your edits to see the original page\">Original</button>\n    </div>\n    <div class=\"grp\" role=\"group\" aria-label=\"Zoom\">\n      <button id=\"zOut\" type=\"button\" aria-label=\"Zoom out\">−</button>\n      <span class=\"zoomv\" id=\"zVal\">100%</span>\n      <button id=\"zIn\" type=\"button\" aria-label=\"Zoom in\">+</button>\n    </div>\n    <span class=\"sp\"></span>\n    <div class=\"grp\" role=\"group\" aria-label=\"Download\">\n      <button id=\"dOpen\" class=\"dl\" type=\"button\" aria-haspopup=\"dialog\" aria-expanded=\"false\">Download</button>\n    </div>\n  </div>\n\n  <aside id=\"pages\" aria-label=\"Pages\"><div id=\"thumbs\"></div><button id=\"addPage\" type=\"button\">Add blank page</button></aside>\n\n  <main id=\"work\"><div id=\"stage\"><canvas id=\"cv\"></canvas><div id=\"layer\"></div></div></main>\n\n  <aside id=\"props\" aria-label=\"Properties\"><div id=\"propsBody\"></div></aside>\n</div>\n\n<input type=\"file\" id=\"fileIn\" accept=\"application/pdf,.pdf,image/jpeg,image/png,.jpg,.jpeg,.png\" hidden>\n<input type=\"file\" id=\"imgIn\" accept=\"image/*\" hidden>\n<input type=\"file\" id=\"imgRep\" accept=\"image/*\" hidden>\n\n<div id=\"dlOverlay\" hidden>\n  <div id=\"dlDialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"dlTitle\" tabindex=\"-1\">\n    <div class=\"dlHead\">\n      <button id=\"dlClose\" type=\"button\" aria-label=\"Close\">←</button>\n      <h2 id=\"dlTitle\">Download</h2>\n    </div>\n    <div class=\"dlBody\">\n      <span class=\"dlLabel\">File type</span>\n      <div class=\"dlTypes\" role=\"radiogroup\" aria-label=\"File type\">\n        <button type=\"button\" class=\"dlType\" data-type=\"pdf\" role=\"radio\" aria-checked=\"true\">\n          <span class=\"dlIco\">PDF</span><span class=\"dlName\">PDF<em>Best for documents and printing</em></span><span class=\"dlBadge\">Suggested</span>\n        </button>\n        <button type=\"button\" class=\"dlType\" data-type=\"jpg\" role=\"radio\" aria-checked=\"false\">\n          <span class=\"dlIco\">JPG</span><span class=\"dlName\">JPG<em>Best for sharing</em></span>\n        </button>\n        <button type=\"button\" class=\"dlType\" data-type=\"png\" role=\"radio\" aria-checked=\"false\">\n          <span class=\"dlIco\">PNG</span><span class=\"dlName\">PNG<em>Best for images with transparency</em></span>\n        </button>\n      </div>\n\n      <div id=\"dlImgOpts\" hidden>\n        <span class=\"dlLabel\">Quality</span>\n        <div class=\"seg\" id=\"dlQuality\">\n          <button type=\"button\" data-q=\"0.6\">Low</button>\n          <button type=\"button\" data-q=\"0.85\" aria-pressed=\"true\">Medium</button>\n          <button type=\"button\" data-q=\"1\">High</button>\n        </div>\n        <span class=\"dlLabel\">Size</span>\n        <div class=\"dlSize\">\n          <input type=\"range\" id=\"dlScale\" min=\"1\" max=\"4\" step=\"0.5\" value=\"2\">\n          <span id=\"dlScaleVal\">2×</span>\n        </div>\n        <p class=\"dlNote\">This downloads the page you’re viewing, page <span id=\"dlPageNo\">1</span>.</p>\n      </div>\n      <label class=\"dlCheck\" id=\"dlLegalRow\" hidden><input type=\"checkbox\" id=\"dlLegal\" checked><span>Convert Letter pages to Legal size (8.5 × 14 in)<em id=\"dlLegalCount\"></em></span></label>\n      <p class=\"dlNote\" id=\"dlPdfNote\">This downloads the whole document, every page.</p>\n    </div>\n    <button id=\"dlGo\" class=\"dlGo\" type=\"button\">Download</button>\n  </div>\n</div>\n\n<div id=\"pwOverlay\" hidden>\n  <div id=\"pwDialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"pwTitle\">\n    <div class=\"pwBody\">\n      <h2 id=\"pwTitle\">Password required</h2>\n      <p>This PDF is protected. Enter the password to open <strong id=\"pwFile\"></strong>.</p>\n      <input type=\"password\" id=\"pwInput\" autocomplete=\"off\" autocapitalize=\"off\" spellcheck=\"false\" aria-label=\"PDF password\" aria-describedby=\"pwErr\">\n      <p id=\"pwErr\" role=\"alert\" hidden>Incorrect password. Please try again.</p>\n      <label class=\"pwShow\"><input type=\"checkbox\" id=\"pwShow\"> Show password</label>\n    </div>\n    <div class=\"pwBtns\"><button type=\"button\" id=\"pwCancel\">Cancel</button><button type=\"button\" id=\"pwOk\">Open</button></div>\n  </div>\n</div>\n\n<div id=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n<div id=\"busy\" hidden>Working…</div>\n\n<script>\n(function(){\n\"use strict\";\nconst $=s=>document.querySelector(s);\nif(typeof pdfjsLib===\"undefined\"||typeof PDFLib===\"undefined\"){ $(\"#libErr\").hidden=false; }\nelse{ pdfjsLib.GlobalWorkerOptions.workerSrc=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js\"; }\nconst {PDFDocument,StandardFonts,rgb}=window.PDFLib||{};\n\nconst FAM={Helvetica:'Helvetica, Arial, sans-serif',Times:'\"Times New Roman\", Times, serif',Courier:'\"Courier New\", Courier, monospace'};\nconst FAMLABEL={Helvetica:\"Sans (Helvetica)\",Times:\"Serif (Times)\",Courier:\"Mono (Courier)\"};\nconst PDFFONT={\n  Helvetica:[\"Helvetica\",\"HelveticaBold\",\"HelveticaOblique\",\"HelveticaBoldOblique\"],\n  Times:[\"TimesRoman\",\"TimesRomanBold\",\"TimesRomanItalic\",\"TimesRomanBoldItalic\"],\n  Courier:[\"Courier\",\"CourierBold\",\"CourierOblique\",\"CourierBoldOblique\"]\n};\n\nlet srcBytes=null,pdfDoc=null,pages=[],cur=0,zoom=1.2,tool=\"select\",sel=null,comparing=false,fileName=\"document\";\nlet undoStack=[],nextId=1,lostChars=0;\nconst vps=new Map(),thumbCache=new Map(),imgStore={};\nconst nid=()=>nextId++;\nconst stage=$(\"#stage\"),cv=$(\"#cv\"),layer=$(\"#layer\");\nconst dpr=()=>Math.min(window.devicePixelRatio||1,2);\n\n/* ---------- helpers ---------- */\nlet toastT;\nfunction toast(msg){const t=$(\"#toast\");t.textContent=msg;t.hidden=false;clearTimeout(toastT);toastT=setTimeout(()=>t.hidden=true,5200);}\nfunction busy(on){$(\"#busy\").hidden=!on;}\nfunction esc(s){return String(s).replace(/[&<>\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));}\nfunction snapshot(){return JSON.stringify(pages.map(p=>({id:p.id,src:p.src,w:p.w,h:p.h,items:p.items,els:p.els,pics:p.pics})));}\nfunction pushSnap(s){undoStack.push(s);if(undoStack.length>60)undoStack.shift();updateUndo();}\nfunction pushUndo(){pushSnap(snapshot());}\nfunction updateUndo(){$(\"#bUndo\").disabled=!undoStack.length;}\nfunction hexToRgb(h){const n=parseInt(h.slice(1),16);return rgb(((n>>16)&255)/255,((n>>8)&255)/255,(n&255)/255);}\nfunction curPage(){return pages[cur];}\nfunction selObj(){const p=curPage();if(!p||sel==null)return null;return (p.items||[]).find(i=>i.id===sel)||p.els.find(e=>e.id===sel)||null;}\nfunction nodeFor(id){return layer.querySelector('[data-id=\"'+id+'\"]');}\n\n/* ---------- opening a file ---------- */\nconst IMG_TYPES=/\\.(jpe?g|png|webp|gif|bmp)$/i;\nfunction readAsImage(file){\n  return new Promise((res,rej)=>{\n    const fr=new FileReader();\n    fr.onload=()=>{const im=new Image();im.onload=()=>res({url:fr.result,im});im.onerror=()=>rej(new Error(\"bad image\"));im.src=fr.result;};\n    fr.onerror=()=>rej(new Error(\"read failed\"));fr.readAsDataURL(file);\n  });\n}\nasync function imageToPdfBytes(file){\n  const {url,im}=await readAsImage(file);\n  let mime=file.type,data=url;\n  if(mime!==\"image/png\"&&mime!==\"image/jpeg\"){\n    const c=document.createElement(\"canvas\");c.width=im.naturalWidth;c.height=im.naturalHeight;\n    c.getContext(\"2d\").drawImage(im,0,0);data=c.toDataURL(\"image/png\");mime=\"image/png\";\n  }\n  const bytes=b64ToBytes(data),doc=await PDFDocument.create();\n  const img=mime===\"image/jpeg\"?await doc.embedJpg(bytes):await doc.embedPng(bytes);\n  const page=doc.addPage([img.width,img.height]);\n  page.drawImage(img,{x:0,y:0,width:img.width,height:img.height});\n  return await doc.save();\n}\n/* ---------- password-protected PDFs ---------- */\nfunction askPassword(name,wrong){\n  return new Promise(res=>{\n    const ov=$(\"#pwOverlay\"),inp=$(\"#pwInput\");\n    $(\"#pwFile\").textContent=name;$(\"#pwErr\").hidden=!wrong;\n    inp.value=\"\";inp.type=\"password\";$(\"#pwShow\").checked=false;\n    ov.hidden=false;setTimeout(()=>inp.focus(),30);\n    function done(v){ov.hidden=true;$(\"#pwOk\").onclick=$(\"#pwCancel\").onclick=inp.onkeydown=null;$(\"#pwShow\").onchange=null;res(v);}\n    $(\"#pwOk\").onclick=()=>{if(!inp.value){inp.focus();return;}done(inp.value);};\n    $(\"#pwCancel\").onclick=()=>done(null);\n    $(\"#pwShow\").onchange=e=>{inp.type=e.target.checked?\"text\":\"password\";inp.focus();};\n    inp.onkeydown=e=>{\n      if(e.key===\"Enter\"){e.preventDefault();$(\"#pwOk\").click();}\n      else if(e.key===\"Escape\"){e.preventDefault();done(null);}\n    };\n  });\n}\nasync function openPdfDoc(bytes,name){\n  let pw;\n  for(;;){\n    const task=pdfjsLib.getDocument({data:bytes.slice(),password:pw});\n    try{return {doc:await task.promise,password:pw||\"\"};}\n    catch(e){\n      if(e&&e.name===\"PasswordException\"){\n        try{task.destroy();}catch(_){}\n        busy(false);\n        const v=await askPassword(name,e.code===2);   /* code 2 = wrong password */\n        if(v===null){const c=new Error(\"cancelled\");c.cancelled=true;throw c;}\n        pw=v;busy(true);\n      }else throw e;\n    }\n  }\n}\nasync function needsDecrypt(bytes){\n  try{await PDFDocument.load(bytes,{updateMetadata:false});return false;}\n  catch(e){return /encrypt/i.test((e&&e.message)||\"\")||(e&&e.name===\"EncryptedPDFError\");}\n}\n/* pdf-lib cannot read encrypted files, so a fork that can decrypt is loaded only when needed. */\nconst DECRYPT_LIB=[\"https://cdn.jsdelivr.net/npm/@cantoo/pdf-lib@2/dist/pdf-lib.min.js\",\"https://unpkg.com/@cantoo/pdf-lib@2/dist/pdf-lib.min.js\"];\nlet decryptLib=null;\nfunction loadScript(src){\n  return new Promise((res,rej)=>{\n    const sc=document.createElement(\"script\");sc.src=src;\n    sc.onload=res;sc.onerror=()=>{sc.remove();rej(new Error(\"script failed\"));};\n    document.head.appendChild(sc);\n  });\n}\nasync function getDecryptLib(){\n  if(decryptLib)return decryptLib;\n  const orig=window.PDFLib;\n  try{\n    for(const u of DECRYPT_LIB){\n      try{window.PDFLib=undefined;await loadScript(u);if(window.PDFLib&&window.PDFLib.PDFDocument){decryptLib=window.PDFLib;break;}}\n      catch(e){/* try next host */}\n    }\n  }finally{window.PDFLib=orig;}   /* keep the normal editing library untouched */\n  if(!decryptLib){const e=new Error(\"decrypt library unavailable\");e.userMsg=\"Couldn’t unlock this PDF. The unlock helper needs an internet connection to load. Check your connection and try again.\";throw e;}\n  return decryptLib;\n}\nasync function decryptBytes(bytes,pw){\n  const L=await getDecryptLib();\n  const d=await L.PDFDocument.load(bytes,{password:pw,updateMetadata:false});\n  const out=new Uint8Array(await d.save());\n  if(await needsDecrypt(out)){const e=new Error(\"still encrypted\");e.userMsg=\"Couldn’t unlock this PDF for editing.\";throw e;}\n  return out;\n}\n\nasync function openFile(file){\n  if(!file)return;\n  const isPdf=file.type===\"application/pdf\"||/\\.pdf$/i.test(file.name);\n  const isImg=file.type.startsWith(\"image/\")||IMG_TYPES.test(file.name);\n  if(!isPdf&&!isImg){toast(\"Choose a PDF or an image (JPG, PNG) file.\");return;}\n  busy(true);\n  try{\n    let bytes,doc,unlocked=false;\n    if(isPdf){\n      bytes=new Uint8Array(await file.arrayBuffer());\n      const r=await openPdfDoc(bytes,file.name);doc=r.doc;\n      if(await needsDecrypt(bytes)){bytes=await decryptBytes(bytes,r.password);unlocked=true;}\n    }else{\n      bytes=await imageToPdfBytes(file);\n      doc=await pdfjsLib.getDocument({data:bytes.slice()}).promise;\n    }\n    srcBytes=bytes;pdfDoc=doc;\n    pages=[];vps.clear();thumbCache.clear();undoStack=[];sel=null;cur=0;comparing=false;\n    for(let i=1;i<=pdfDoc.numPages;i++){\n      const pg=await pdfDoc.getPage(i),vp=pg.getViewport({scale:1}),id=nid();\n      vps.set(id,vp);pages.push({id,src:i-1,w:vp.width,h:vp.height,items:null,els:[],pics:null});\n    }\n    fileName=file.name.replace(/\\.[^.]+$/i,\"\");\n    $(\"#fname\").textContent=file.name;\n    $(\"#start\").hidden=true;$(\"#app\").hidden=false;\n    setTool(\"select\");updateUndo();$(\"#bCompare\").setAttribute(\"aria-pressed\",\"false\");\n    fitZoom();renderThumbs();showPage(0);\n    toast(isImg?\"Opened as a page you can edit. Add text, shapes or images, then download.\":\n      unlocked?\"Password accepted. The PDF is open for editing. The downloaded copy will not have a password.\":\n      \"Opened. Compare it with your original: tables and other elements can shift. Use Original to hide your edits.\");\n  }catch(err){\n    if(err&&err.cancelled)return;\n    console.error(err);\n    toast((err&&err.userMsg)||(isImg?\"Couldn’t open that image.\":\"Couldn’t open this PDF. The file may be damaged.\"));\n  }finally{busy(false);}\n}\n\n/* ---------- zoom ---------- */\nfunction fitZoom(){\n  const p=curPage();\n  const w=$(\"#work\").clientWidth-56,h=$(\"#work\").clientHeight-56;\n  const byW=w/p.w,byH=h/p.h;\n  zoom=Math.max(.5,Math.min(3,Math.min(byW,byH)));\n  updateZoomLabel();\n}\nfunction updateZoomLabel(){$(\"#zVal\").textContent=Math.round(zoom*100)+\"%\";}\nfunction setZoom(z){zoom=Math.max(.4,Math.min(3,z));updateZoomLabel();renderPage();}\n\n/* ---------- page rendering (serialised) ---------- */\nlet renderToken=0,renderChain=Promise.resolve(),activeTask=null;\nfunction renderPage(){\n  const t=++renderToken;\n  if(activeTask){try{activeTask.cancel();}catch(e){}}\n  renderChain=renderChain.then(()=>doRender(t)).catch(e=>console.error(e));\n  return renderChain;\n}\nasync function doRender(t){\n  if(t!==renderToken)return;\n  const p=curPage();if(!p)return;\n  const W=p.w*zoom,H=p.h*zoom,d=dpr();\n  stage.style.width=W+\"px\";stage.style.height=H+\"px\";\n  layer.style.width=p.w+\"px\";layer.style.height=p.h+\"px\";layer.style.transform=\"scale(\"+zoom+\")\";\n  cv.width=Math.round(W*d);cv.height=Math.round(H*d);cv.style.width=W+\"px\";cv.style.height=H+\"px\";\n  const ctx=cv.getContext(\"2d\",{willReadFrequently:true});\n  ctx.fillStyle=\"#fff\";ctx.fillRect(0,0,cv.width,cv.height);\n  if(p.src!==null){\n    const pg=await pdfDoc.getPage(p.src+1);\n    if(t!==renderToken)return;\n    activeTask=pg.render({canvasContext:ctx,viewport:pg.getViewport({scale:zoom*d})});\n    try{await activeTask.promise;}catch(e){if(e&&e.name===\"RenderingCancelledException\")return;throw e;}\n    if(t!==renderToken)return;\n  }\n  if(p.items===null)p.items=await loadItems(p);\n  if(p.pics===null)p.pics=await loadPics(p);\n  if(t!==renderToken)return;\n  analyseItems(p);\n  renderLayer();\n}\nasync function loadItems(p){\n  const pg=await pdfDoc.getPage(p.src+1),vp=vps.get(p.id);\n  const tc=await pg.getTextContent(),out=[];\n  for(const it of tc.items){\n    if(!it.str||!it.str.trim())continue;\n    const m=pdfjsLib.Util.transform(vp.transform,it.transform);\n    const size=Math.hypot(m[0],m[1]);\n    if(size<2||m[0]<=0||Math.abs(m[1])>0.03*size)continue;\n    out.push({id:nid(),type:\"orig\",str:it.str,orig:it.str,x:m[4],y:m[5]-size*0.9,w:Math.max(it.width,size*0.5),h:size*1.2,bx:m[4],by:m[5],size:size,color:\"#000000\",bold:false,italic:false,family:\"Helvetica\",edited:false,bg:null});\n  }\n  return out;\n}\nfunction toHex(r,g,b){return \"#\"+[r,g,b].map(v=>Math.max(0,Math.min(255,Math.round(v))).toString(16).padStart(2,\"0\")).join(\"\");}\nfunction analyse(x,y,w,h){\n  const fallback={bg:\"#ffffff\",text:\"#000000\"};\n  try{\n    const ctx=cv.getContext(\"2d\",{willReadFrequently:true}),s=zoom*dpr();\n    const px=Math.max(0,Math.floor((x-2)*s)),py=Math.max(0,Math.floor((y-2)*s));\n    const pw=Math.min(cv.width-px,Math.ceil((w+4)*s)),ph=Math.min(cv.height-py,Math.ceil((h+4)*s));\n    if(pw<3||ph<3)return fallback;\n    const d=ctx.getImageData(px,py,pw,ph).data,hist=new Map();\n    const add=(xx,yy)=>{\n      const i=(yy*pw+xx)*4,k=((d[i]>>4)<<8)|((d[i+1]>>4)<<4)|(d[i+2]>>4);\n      const e=hist.get(k)||[0,0,0,0];e[0]++;e[1]+=d[i];e[2]+=d[i+1];e[3]+=d[i+2];hist.set(k,e);\n    };\n    for(let xx=0;xx<pw;xx++){add(xx,0);add(xx,ph-1);}\n    for(let yy=1;yy<ph-1;yy++){add(0,yy);add(pw-1,yy);}\n    let best=null;hist.forEach(e=>{if(!best||e[0]>best[0])best=e;});\n    const br=best[1]/best[0],bgc=best[2]/best[0],bb=best[3]/best[0];\n    let far=0,fr=0,fg=0,fb=0;\n    for(let yy=0;yy<ph;yy++)for(let xx=0;xx<pw;xx++){\n      const i=(yy*pw+xx)*4,dr=d[i]-br,dg=d[i+1]-bgc,db=d[i+2]-bb,dist=dr*dr+dg*dg+db*db;\n      if(dist>far){far=dist;fr=d[i];fg=d[i+1];fb=d[i+2];}\n    }\n    let text;\n    if(far<3600)text=(0.299*br+0.587*bgc+0.114*bb)>140?\"#000000\":\"#ffffff\";\n    else text=toHex(fr,fg,fb);\n    return {bg:toHex(br,bgc,bb),text:text};\n  }catch(e){return fallback;}\n}\nfunction analyseItems(p){\n  for(const it of p.items){\n    if(it.an)continue;it.an=true;\n    const r=analyse(it.x,it.y,it.w,it.h);it.bg=r.bg;\n    if(!it.styled)it.color=r.text;\n  }\n}\nasync function loadPics(p){\n  const out=[];if(p.src===null)return out;\n  try{\n    const pg=await pdfDoc.getPage(p.src+1),vp=vps.get(p.id),ol=await pg.getOperatorList(),O=pdfjsLib.OPS,T=pdfjsLib.Util.transform;\n    let ctm=vp.transform.slice();const stack=[];\n    for(let i=0;i<ol.fnArray.length;i++){\n      const fn=ol.fnArray[i],a=ol.argsArray[i];\n      if(fn===O.save)stack.push(ctm.slice());\n      else if(fn===O.restore){if(stack.length)ctm=stack.pop();}\n      else if(fn===O.transform)ctm=T(ctm,a);\n      else if(fn===O.paintFormXObjectBegin){stack.push(ctm.slice());if(a&&a[0])ctm=T(ctm,a[0]);}\n      else if(fn===O.paintFormXObjectEnd){if(stack.length)ctm=stack.pop();}\n      else if(fn===O.paintImageXObject||fn===O.paintInlineImageXObject||fn===O.paintImageMaskXObject||fn===O.paintJpegXObject){\n        const xs=[],ys=[];\n        [[0,0],[1,0],[0,1],[1,1]].forEach(c=>{xs.push(ctm[0]*c[0]+ctm[2]*c[1]+ctm[4]);ys.push(ctm[1]*c[0]+ctm[3]*c[1]+ctm[5]);});\n        const x=Math.min.apply(null,xs),y=Math.min.apply(null,ys),w=Math.max.apply(null,xs)-x,h=Math.max.apply(null,ys)-y;\n        if(w<8||h<8||w*h>0.85*p.w*p.h)continue;\n        if(out.some(o=>Math.abs(o.x-x)<2&&Math.abs(o.y-y)<2&&Math.abs(o.w-w)<2&&Math.abs(o.h-h)<2))continue;\n        out.push({id:nid(),x:x,y:y,w:w,h:h,lifted:false});\n      }\n    }\n  }catch(e){console.warn(\"Could not scan images\",e);}\n  return out;\n}\nasync function liftRegion(x,y,w,h,pc){\n  const p=curPage();if(!p||p.src===null){toast(\"Nothing to grab on a blank page.\");return;}\n  x=Math.max(0,x);y=Math.max(0,y);w=Math.min(w,p.w-x);h=Math.min(h,p.h-y);\n  if(w<4||h<4)return;\n  busy(true);\n  try{\n    const pg=await pdfDoc.getPage(p.src+1),sc=Math.min(8,Math.max(2,900/Math.max(w,h)));\n    const c=document.createElement(\"canvas\");c.width=Math.max(1,Math.round(w*sc));c.height=Math.max(1,Math.round(h*sc));\n    const ctx=c.getContext(\"2d\");ctx.fillStyle=\"#fff\";ctx.fillRect(0,0,c.width,c.height);\n    await pg.render({canvasContext:ctx,viewport:pg.getViewport({scale:sc,offsetX:-x*sc,offsetY:-y*sc})}).promise;\n    const bg=analyse(x,y,w,h).bg,key=nid();\n    imgStore[key]={url:c.toDataURL(\"image/png\"),mime:\"image/png\",w:c.width,h:c.height};\n    pushUndo();\n    if(pc)pc.lifted=true;\n    p.els.push({id:nid(),type:\"rect\",x:x-0.5,y:y-0.5,w:w+1,h:h+1,fill:bg,opacity:1,cover:true});\n    const el={id:nid(),type:\"image\",x:x,y:y,w:w,h:h,img:key};\n    p.els.push(el);setTool(\"select\");renderLayer();select(el.id);\n    toast(\"Image lifted. Drag it to move, use the corner to resize, or delete it. The old spot is covered with the page colour.\");\n  }catch(e){console.error(e);toast(\"Couldn’t grab that area.\");}\n  finally{busy(false);}\n}\nfunction picNode(pc){\n  const n=document.createElement(\"div\");n.className=\"pic\";n.title=\"Click to edit this image\";\n  n.style.left=pc.x+\"px\";n.style.top=pc.y+\"px\";n.style.width=pc.w+\"px\";n.style.height=pc.h+\"px\";\n  n.addEventListener(\"pointerdown\",e=>{if(tool!==\"select\")return;e.preventDefault();e.stopPropagation();liftRegion(pc.x,pc.y,pc.w,pc.h,pc);});\n  return n;\n}\n\n/* ---------- overlay layer ---------- */\nfunction styleText(n,o){\n  n.style.fontSize=o.size+\"px\";n.style.fontFamily=FAM[o.family];\n  n.style.fontWeight=o.bold?\"700\":\"400\";n.style.fontStyle=o.italic?\"italic\":\"normal\";\n  n.style.setProperty(\"--c\",o.color);\n  if(o.type===\"orig\")n.style.setProperty(\"--bg\",o.bg||\"#fff\");\n}\nfunction setEditable(n,plain){\n  try{n.contentEditable=plain?\"plaintext-only\":\"true\";}catch(e){n.contentEditable=\"true\";}\n  if(n.contentEditable!==\"plaintext-only\"&&n.contentEditable!==\"true\")n.contentEditable=\"true\";\n}\nfunction renderLayer(){\n  layer.innerHTML=\"\";\n  const p=curPage();if(!p||comparing||!p.items)return;\n  (p.pics||[]).forEach(pc=>{if(!pc.lifted)layer.appendChild(picNode(pc));});\n  p.items.forEach(it=>layer.appendChild(origNode(it)));\n  p.els.forEach(el=>layer.appendChild(elNode(el)));\n}\nfunction origNode(it){\n  const n=document.createElement(\"div\");\n  n.className=\"o\"+(it.edited?\" edited\":\"\")+(sel===it.id?\" sel\":\"\");\n  n.dataset.id=it.id;setEditable(n,true);n.spellcheck=false;n.textContent=it.str;\n  n.style.left=it.x+\"px\";n.style.top=it.y+\"px\";n.style.minWidth=it.w+\"px\";n.style.height=it.h+\"px\";n.style.lineHeight=it.h+\"px\";\n  styleText(n,it);\n  n.addEventListener(\"focus\",()=>{n._snap=snapshot();select(it.id);});\n  n.addEventListener(\"input\",()=>{it.str=n.textContent;it.edited=true;n.classList.add(\"edited\");});\n  n.addEventListener(\"blur\",()=>{\n    if(n._snap&&snapshot()!==n._snap){pushSnap(n._snap);}\n    if(it.str===it.orig&&!it.styled){it.edited=false;n.classList.remove(\"edited\");}\n  });\n  n.addEventListener(\"keydown\",e=>{if(e.key===\"Enter\"){e.preventDefault();n.blur();}if(e.key===\"Escape\")n.blur();});\n  n.addEventListener(\"paste\",e=>{e.preventDefault();const t=(e.clipboardData.getData(\"text/plain\")||\"\").replace(/\\s+/g,\" \");document.execCommand(\"insertText\",false,t);});\n  return n;\n}\nfunction elNode(el){\n  const n=document.createElement(\"div\");\n  n.className=\"el \"+el.type+(sel===el.id?\" sel\":\"\");n.dataset.id=el.id;\n  n.style.left=el.x+\"px\";n.style.top=el.y+\"px\";\n  if(el.type===\"text\"){\n    const t=document.createElement(\"div\");t.className=\"txt\";setEditable(t,true);t.spellcheck=false;t.textContent=el.text;styleText(t,el);\n    t.addEventListener(\"focus\",()=>{t._snap=snapshot();select(el.id);});\n    t.addEventListener(\"input\",()=>{el.text=t.innerText.replace(/\\n$/,\"\");});\n    t.addEventListener(\"blur\",()=>{if(t._snap&&snapshot()!==t._snap)pushSnap(t._snap);});\n    t.addEventListener(\"paste\",e=>{e.preventDefault();document.execCommand(\"insertText\",false,e.clipboardData.getData(\"text/plain\"));});\n    n.appendChild(t);\n    const mv=document.createElement(\"div\");mv.className=\"move\";mv.title=\"Drag to move\";\n    mv.addEventListener(\"pointerdown\",e=>startDrag(e,el,\"move\"));n.appendChild(mv);\n    n.addEventListener(\"pointerdown\",()=>{if(sel!==el.id)select(el.id);});\n  }else{\n    n.style.width=el.w+\"px\";n.style.height=el.h+\"px\";\n    if(el.type===\"image\"){const im=document.createElement(\"img\");im.alt=\"\";im.src=imgStore[el.img].url;n.appendChild(im);}\n    else{n.style.background=el.fill;n.style.opacity=el.opacity;}\n    const rs=document.createElement(\"div\");rs.className=\"resize\";rs.title=\"Drag to resize\";\n    rs.addEventListener(\"pointerdown\",e=>startDrag(e,el,\"resize\"));n.appendChild(rs);\n    n.addEventListener(\"pointerdown\",e=>{if(tool!==\"select\")return;if(e.target===rs)return;select(el.id);startDrag(e,el,\"move\");});\n  }\n  return n;\n}\nfunction startDrag(e,el,mode){\n  e.preventDefault();e.stopPropagation();select(el.id);\n  const sx=e.clientX,sy=e.clientY,ox=el.x,oy=el.y,ow=el.w,oh=el.h,snap=snapshot();let moved=false;\n  const node=nodeFor(el.id);\n  function mv(ev){\n    const dx=(ev.clientX-sx)/zoom,dy=(ev.clientY-sy)/zoom;\n    if(!moved){if(Math.abs(dx)+Math.abs(dy)<1)return;moved=true;pushSnap(snap);}\n    if(mode===\"move\"){el.x=ox+dx;el.y=oy+dy;node.style.left=el.x+\"px\";node.style.top=el.y+\"px\";}\n    else{\n      el.w=Math.max(12,ow+dx);\n      el.h=el.type===\"image\"?el.w*oh/ow:Math.max(12,oh+dy);\n      node.style.width=el.w+\"px\";node.style.height=el.h+\"px\";\n    }\n  }\n  function up(){window.removeEventListener(\"pointermove\",mv);window.removeEventListener(\"pointerup\",up);}\n  window.addEventListener(\"pointermove\",mv);window.addEventListener(\"pointerup\",up);\n}\nlayer.addEventListener(\"pointerdown\",e=>{\n  if(e.target!==layer)return;\n  const r=layer.getBoundingClientRect(),x=(e.clientX-r.left)/zoom,y=(e.clientY-r.top)/zoom;\n  if(tool===\"grab\"){startMarquee(e,x,y);return;}\n  if(tool===\"text\"){e.preventDefault();addText(x,y);}\n  else if(tool===\"shape\"){e.preventDefault();addRect(x-70,y-30);}\n  else select(null);\n});\nfunction startMarquee(e,x0,y0){\n  e.preventDefault();\n  const m=document.createElement(\"div\");m.className=\"marq\";layer.appendChild(m);\n  const r=layer.getBoundingClientRect();let x=x0,y=y0,w=0,h=0;\n  function mv(ev){\n    const cx=Math.max(0,Math.min(curPage().w,(ev.clientX-r.left)/zoom)),cy=Math.max(0,Math.min(curPage().h,(ev.clientY-r.top)/zoom));\n    x=Math.min(x0,cx);y=Math.min(y0,cy);w=Math.abs(cx-x0);h=Math.abs(cy-y0);\n    m.style.left=x+\"px\";m.style.top=y+\"px\";m.style.width=w+\"px\";m.style.height=h+\"px\";\n  }\n  function up(){window.removeEventListener(\"pointermove\",mv);window.removeEventListener(\"pointerup\",up);m.remove();\n    if(w>6&&h>6)liftRegion(x,y,w,h,null);else toast(\"Drag a box around the part you want to move.\");}\n  window.addEventListener(\"pointermove\",mv);window.addEventListener(\"pointerup\",up);\n}\nfunction select(id){\n  sel=id;\n  layer.querySelectorAll(\".sel\").forEach(n=>n.classList.remove(\"sel\"));\n  if(id!=null){const n=nodeFor(id);if(n)n.classList.add(\"sel\");}\n  renderProps();\n}\n\n/* ---------- adding things ---------- */\nfunction setTool(t){\n  tool=t;\n  document.body.classList.remove(\"t-text\",\"t-shape\",\"t-grab\");\n  if(t===\"text\")document.body.classList.add(\"t-text\");\n  if(t===\"shape\")document.body.classList.add(\"t-shape\");\n  if(t===\"grab\")document.body.classList.add(\"t-grab\");\n  $(\"#tGrab\").setAttribute(\"aria-pressed\",t===\"grab\");\n  $(\"#tSelect\").setAttribute(\"aria-pressed\",t===\"select\");\n  $(\"#tText\").setAttribute(\"aria-pressed\",t===\"text\");\n  $(\"#tShape\").setAttribute(\"aria-pressed\",t===\"shape\");\n}\nfunction addText(x,y){\n  pushUndo();\n  const el={id:nid(),type:\"text\",x:x,y:y,text:\"Type here\",size:18,color:\"#111111\",bold:false,italic:false,family:\"Helvetica\"};\n  curPage().els.push(el);setTool(\"select\");renderLayer();select(el.id);\n  const t=nodeFor(el.id).querySelector(\".txt\");t.focus();\n  const r=document.createRange();r.selectNodeContents(t);const s=getSelection();s.removeAllRanges();s.addRange(r);\n}\nfunction addRect(x,y){\n  pushUndo();\n  const el={id:nid(),type:\"rect\",x:x,y:y,w:140,h:60,fill:\"#0f8f55\",opacity:1};\n  curPage().els.push(el);setTool(\"select\");renderLayer();select(el.id);\n}\nfunction readImage(file){\n  return new Promise((res,rej)=>{\n    const fr=new FileReader();\n    fr.onload=()=>{\n      const url=fr.result,im=new Image();\n      im.onerror=()=>rej(new Error(\"bad image\"));\n      im.onload=()=>{\n        let data=url,mime=file.type;\n        if(mime!==\"image/png\"&&mime!==\"image/jpeg\"){\n          const c=document.createElement(\"canvas\");c.width=im.naturalWidth;c.height=im.naturalHeight;\n          c.getContext(\"2d\").drawImage(im,0,0);data=c.toDataURL(\"image/png\");mime=\"image/png\";\n        }\n        const key=nid();imgStore[key]={url:data,mime:mime,w:im.naturalWidth,h:im.naturalHeight};res(key);\n      };\n      im.src=url;\n    };\n    fr.onerror=()=>rej(new Error(\"read failed\"));fr.readAsDataURL(file);\n  });\n}\nasync function addImage(file){\n  try{\n    const key=await readImage(file),im=imgStore[key],p=curPage();\n    const w=Math.min(p.w*0.4,im.w),h=w*im.h/im.w;\n    pushUndo();\n    const el={id:nid(),type:\"image\",x:(p.w-w)/2,y:(p.h-h)/2,w:w,h:h,img:key};\n    p.els.push(el);renderLayer();select(el.id);\n  }catch(e){toast(\"That image couldn’t be read.\");}\n}\nasync function replaceImage(el,file){\n  try{const key=await readImage(file);pushUndo();const im=imgStore[key];el.img=key;el.h=el.w*im.h/im.w;renderLayer();select(el.id);}\n  catch(e){toast(\"That image couldn’t be read.\");}\n}\nasync function cropImage(el,l,t,r,b){\n  const im=imgStore[el.img];\n  const img=await new Promise((res,rej)=>{const i=new Image();i.onload=()=>res(i);i.onerror=rej;i.src=im.url;});\n  const sx=im.w*l/100,sy=im.h*t/100,sw=im.w*(1-(l+r)/100),sh=im.h*(1-(t+b)/100);\n  if(sw<2||sh<2){toast(\"That crop leaves nothing of the image.\");return;}\n  const c=document.createElement(\"canvas\");c.width=Math.round(sw);c.height=Math.round(sh);\n  c.getContext(\"2d\").drawImage(img,sx,sy,sw,sh,0,0,c.width,c.height);\n  const key=nid();imgStore[key]={url:c.toDataURL(\"image/png\"),mime:\"image/png\",w:c.width,h:c.height};\n  pushUndo();\n  const fx=el.w/im.w,fy=el.h/im.h;\n  el.x+=sx*fx;el.y+=sy*fy;el.w=sw*fx;el.h=sh*fy;el.img=key;\n  renderLayer();select(el.id);\n}\n\n/* ---------- properties panel ---------- */\nconst TIPS=`<h2>Edit this page</h2>\n<h3>Text</h3><ul><li>Click any text on the page and type to change it.</li><li>Use <b>Text</b> in the toolbar, then click the page, to add a new text box.</li></ul>\n<h3>Logos and pictures</h3><ul><li>Click a logo or picture already in the PDF (it outlines in blue when you hover) to make it movable, resizable or deletable.</li><li>For a logo or QR code that isn’t picked up, use <b>Grab area</b> and drag a box around it.</li></ul>\\n<h3>Add new items</h3><ul><li><b>Image</b> adds a picture you can move, resize, crop and replace.</li><li><b>Shape</b> adds a box. Use it to cover something, or set it to white to white-out.</li></ul>\n<h3>Pages</h3><ul><li>Reorder, duplicate or delete pages in the left column, or add a blank one.</li></ul>\n<h3>Layers</h3><ul><li>Select an added item, then send it backward or bring it forward.</li></ul>`;\nfunction field(label,inner){return '<label class=\"f\"><span>'+label+'</span>'+inner+'</label>';}\nfunction renderProps(){\n  const box=$(\"#propsBody\"),o=selObj();\n  if(!o){box.innerHTML=TIPS;return;}\n  let h=\"\";\n  if(o.type===\"orig\"||o.type===\"text\"){\n    h+=\"<h2>\"+(o.type===\"orig\"?\"Page text\":\"Text box\")+\"</h2>\";\n    h+=field(\"Font\",'<select id=\"pFam\">'+Object.keys(FAM).map(k=>'<option value=\"'+k+'\"'+(o.family===k?\" selected\":\"\")+\">\"+FAMLABEL[k]+\"</option>\").join(\"\")+\"</select>\");\n    h+='<div class=\"two\">'+field(\"Size\",'<input id=\"pSize\" type=\"number\" min=\"4\" max=\"300\" step=\"1\" value=\"'+Math.round(o.size*10)/10+'\">')+field(\"Colour\",'<input id=\"pCol\" type=\"color\" value=\"'+o.color+'\">')+\"</div>\";\n    h+='<div class=\"seg\"><button id=\"pB\" type=\"button\" aria-pressed=\"'+!!o.bold+'\" aria-label=\"Bold\"><b>B</b></button><button id=\"pI\" type=\"button\" aria-pressed=\"'+!!o.italic+'\" aria-label=\"Italic\"><i>I</i></button></div>';\n  }else if(o.type===\"image\"){\n    h+=\"<h2>Image</h2>\";\n    h+='<div class=\"pbs\"><button class=\"pb\" id=\"pRep\" type=\"button\">Replace image</button></div>';\n    h+='<h3>Crop (% to cut)</h3><div class=\"four\">'+field(\"Left\",'<input id=\"cL\" type=\"number\" min=\"0\" max=\"90\" value=\"0\">')+field(\"Top\",'<input id=\"cT\" type=\"number\" min=\"0\" max=\"90\" value=\"0\">')+field(\"Right\",'<input id=\"cR\" type=\"number\" min=\"0\" max=\"90\" value=\"0\">')+field(\"Bottom\",'<input id=\"cB\" type=\"number\" min=\"0\" max=\"90\" value=\"0\">')+'</div><div class=\"pbs\"><button class=\"pb\" id=\"pCrop\" type=\"button\">Apply crop</button></div>';\n    h+=\"<p>Drag the corner handle to resize. The proportions stay locked.</p>\";\n  }else if(o.type===\"rect\"){\n    h+=\"<h2>Shape</h2>\";\n    h+=field(\"Fill colour\",'<input id=\"pFill\" type=\"color\" value=\"'+o.fill+'\">');\n    h+=field(\"Opacity\",'<input id=\"pOp\" type=\"range\" min=\"0.05\" max=\"1\" step=\"0.05\" value=\"'+o.opacity+'\">');\n    h+='<div class=\"pbs\"><button class=\"pb\" id=\"pWhite\" type=\"button\">Set to white</button></div>';\n  }\n  if(o.type!==\"orig\"){\n    h+='<h3>Layer</h3><div class=\"pbs\"><button class=\"pb\" id=\"lFront\" type=\"button\">To front</button><button class=\"pb\" id=\"lFwd\" type=\"button\">Forward</button><button class=\"pb\" id=\"lBwd\" type=\"button\">Backward</button><button class=\"pb\" id=\"lBack\" type=\"button\">To back</button></div>';\n  }else{\n    h+=\"<p>Edited page text is placed under any items you add.</p>\";\n  }\n  h+='<div class=\"pbs\"><button class=\"pb danger\" id=\"pDel\" type=\"button\">'+(o.type===\"orig\"?\"Remove this text\":\"Delete\")+\"</button></div>\";\n  box.innerHTML=h;\n  const on=(id,ev,fn)=>{const n=$(\"#\"+id);if(n)n.addEventListener(ev,fn);};\n  on(\"pFam\",\"change\",e=>styleEdit(o,x=>x.family=e.target.value));\n  on(\"pSize\",\"change\",e=>{const v=parseFloat(e.target.value);if(v>=4)styleEdit(o,x=>x.size=v);});\n  on(\"pCol\",\"change\",e=>styleEdit(o,x=>x.color=e.target.value));\n  on(\"pB\",\"click\",e=>{styleEdit(o,x=>x.bold=!x.bold);e.currentTarget.setAttribute(\"aria-pressed\",!!o.bold);});\n  on(\"pI\",\"click\",e=>{styleEdit(o,x=>x.italic=!x.italic);e.currentTarget.setAttribute(\"aria-pressed\",!!o.italic);});\n  on(\"pFill\",\"change\",e=>{pushUndo();o.fill=e.target.value;renderLayer();select(o.id);});\n  on(\"pOp\",\"change\",e=>{pushUndo();o.opacity=parseFloat(e.target.value);renderLayer();select(o.id);});\n  on(\"pWhite\",\"click\",()=>{pushUndo();o.fill=\"#ffffff\";o.opacity=1;renderLayer();select(o.id);});\n  on(\"pRep\",\"click\",()=>$(\"#imgRep\").click());\n  on(\"pCrop\",\"click\",()=>cropImage(o,+$(\"#cL\").value||0,+$(\"#cT\").value||0,+$(\"#cR\").value||0,+$(\"#cB\").value||0));\n  on(\"lFront\",\"click\",()=>moveLayer(o,\"front\"));on(\"lFwd\",\"click\",()=>moveLayer(o,\"fwd\"));\n  on(\"lBwd\",\"click\",()=>moveLayer(o,\"bwd\"));on(\"lBack\",\"click\",()=>moveLayer(o,\"back\"));\n  on(\"pDel\",\"click\",deleteSel);\n}\nfunction styleEdit(o,fn){\n  pushUndo();fn(o);\n  if(o.type===\"orig\"){o.edited=true;o.styled=true;}\n  const n=nodeFor(o.id);\n  if(n){\n    const t=o.type===\"text\"?n.querySelector(\".txt\"):n;\n    styleText(t,o);\n    if(o.type===\"orig\")n.classList.add(\"edited\");\n  }\n}\nfunction moveLayer(o,dir){\n  const a=curPage().els,i=a.indexOf(o);if(i<0)return;\n  pushUndo();a.splice(i,1);\n  if(dir===\"front\")a.push(o);else if(dir===\"back\")a.unshift(o);\n  else if(dir===\"fwd\")a.splice(Math.min(a.length,i+1),0,o);else a.splice(Math.max(0,i-1),0,o);\n  renderLayer();select(o.id);\n}\nfunction deleteSel(){\n  const o=selObj();if(!o)return;\n  pushUndo();\n  if(o.type===\"orig\"){o.str=\"\";o.edited=true;renderLayer();select(o.id);return;}\n  const a=curPage().els;a.splice(a.indexOf(o),1);sel=null;renderLayer();renderProps();\n}\n\n/* ---------- page management ---------- */\nfunction showPage(i){\n  cur=Math.max(0,Math.min(pages.length-1,i));sel=null;\n  document.querySelectorAll(\".thumb\").forEach((t,k)=>t.classList.toggle(\"on\",k===cur));\n  renderProps();renderPage();\n  const t=document.querySelectorAll(\".thumb\")[cur];if(t&&t.scrollIntoView)t.scrollIntoView({block:\"nearest\"});\n}\nlet thumbChain=Promise.resolve();\nfunction renderThumbs(){\n  const box=$(\"#thumbs\");box.innerHTML=\"\";\n  pages.forEach((p,i)=>{\n    const d=document.createElement(\"div\");d.className=\"thumb\"+(i===cur?\" on\":\"\");\n    d.innerHTML='<button class=\"tpic\" type=\"button\" aria-label=\"Go to page '+(i+1)+'\"><canvas></canvas></button><div class=\"tbar\"><span>'+(i+1)+'</span><span class=\"tact\"><button type=\"button\" data-a=\"up\" aria-label=\"Move page up\" title=\"Move up\">▲</button><button type=\"button\" data-a=\"down\" aria-label=\"Move page down\" title=\"Move down\">▼</button><button type=\"button\" data-a=\"dup\" aria-label=\"Duplicate page\" title=\"Duplicate\">⧉</button><button type=\"button\" data-a=\"del\" aria-label=\"Delete page\" title=\"Delete\">✕</button></span></div>';\n    const c=d.querySelector(\"canvas\"),tw=116,ts=tw/p.w;\n    c.width=tw*2;c.height=Math.max(1,Math.round(p.h*ts*2));c.style.width=tw+\"px\";c.style.height=(p.h*ts)+\"px\";\n    drawThumb(p,c);\n    d.querySelector(\".tpic\").addEventListener(\"click\",()=>showPage(i));\n    d.querySelectorAll(\"[data-a]\").forEach(b=>b.addEventListener(\"click\",()=>pageAction(b.dataset.a,i)));\n    box.appendChild(d);\n  });\n}\nfunction drawThumb(p,c){\n  const ctx=c.getContext(\"2d\");ctx.fillStyle=\"#fff\";ctx.fillRect(0,0,c.width,c.height);\n  if(p.src===null)return;\n  thumbChain=thumbChain.then(async()=>{\n    let off=thumbCache.get(p.src);\n    if(!off){\n      off=document.createElement(\"canvas\");off.width=c.width;off.height=c.height;\n      const octx=off.getContext(\"2d\");octx.fillStyle=\"#fff\";octx.fillRect(0,0,off.width,off.height);\n      const pg=await pdfDoc.getPage(p.src+1);\n      await pg.render({canvasContext:octx,viewport:pg.getViewport({scale:c.width/p.w})}).promise;\n      thumbCache.set(p.src,off);\n    }\n    ctx.drawImage(off,0,0,c.width,c.height);\n  }).catch(e=>console.error(e));\n}\nfunction cloneEntry(p){\n  const q=JSON.parse(JSON.stringify({id:p.id,src:p.src,w:p.w,h:p.h,items:p.items,els:p.els,pics:p.pics}));\n  q.id=nid();if(vps.has(p.id))vps.set(q.id,vps.get(p.id));\n  (q.items||[]).forEach(x=>x.id=nid());(q.pics||[]).forEach(x=>x.id=nid());q.els.forEach(x=>x.id=nid());return q;\n}\nfunction pageAction(a,i){\n  if(a===\"up\"||a===\"down\"){\n    const j=a===\"up\"?i-1:i+1;if(j<0||j>=pages.length)return;\n    pushUndo();[pages[i],pages[j]]=[pages[j],pages[i]];\n    if(cur===i)cur=j;else if(cur===j)cur=i;renderThumbs();\n  }else if(a===\"dup\"){\n    pushUndo();pages.splice(i+1,0,cloneEntry(pages[i]));renderThumbs();showPage(i+1);\n  }else if(a===\"del\"){\n    if(pages.length<2){toast(\"A PDF needs at least one page.\");return;}\n    pushUndo();pages.splice(i,1);renderThumbs();showPage(Math.min(cur>i?cur-1:cur,pages.length-1));\n  }\n}\nfunction addBlank(){\n  const p=curPage();pushUndo();\n  const q={id:nid(),src:null,w:p.w,h:p.h,items:[],els:[],pics:[]};\n  pages.splice(cur+1,0,q);renderThumbs();showPage(cur+1);\n}\nfunction undo(){\n  if(!undoStack.length)return;\n  pages=JSON.parse(undoStack.pop());updateUndo();\n  cur=Math.min(cur,pages.length-1);sel=null;renderThumbs();showPage(cur);\n}\n\n/* ---------- export ---------- */\nconst SUBS={\"\\u2018\":\"'\",\"\\u2019\":\"'\",\"\\u201C\":'\"',\"\\u201D\":'\"',\"\\u2013\":\"-\",\"\\u2014\":\"-\",\"\\u2026\":\"...\",\"\\u00A0\":\" \"};\nfunction clean(s){\n  s=s.replace(/[\\u2018\\u2019\\u201C\\u201D\\u2013\\u2014\\u2026\\u00A0]/g,c=>SUBS[c]);\n  return s.replace(/[^\\x20-\\x7E\\xA1-\\xFF\\u2022\\u20AC]/g,()=>{lostChars++;return \"?\";});\n}\nfunction b64ToBytes(dataUrl){const b=atob(dataUrl.split(\",\")[1]),u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return u;}\n/* Letter (8.5x11 in = 612x792 pt) -> Legal (8.5x14 in = 612x1008 pt). Extra space is added at the bottom of the page. */\nfunction letterOrient(p){\n  const w=Math.round(p.w),h=Math.round(p.h),near=(a,b)=>Math.abs(a-b)<=3;\n  if(near(w,612)&&near(h,792))return \"portrait\";\n  if(near(w,792)&&near(h,612))return \"landscape\";\n  return null;\n}\nfunction toLegal(page,p,orient){\n  const rot=((page.getRotation().angle%360)+360)%360;\n  const b=page.getCropBox();\n  const extra=orient===\"portrait\"?1008-p.h:1008-p.w;\n  /* which edge of the stored page box is the bottom (portrait) or right (landscape) of the displayed page */\n  const edge=(orient===\"portrait\"?{0:\"yMin\",90:\"xMax\",180:\"yMax\",270:\"xMin\"}:{0:\"xMax\",90:\"yMax\",180:\"xMin\",270:\"yMin\"})[rot];\n  let x=b.x,y=b.y,w=b.width,h=b.height;\n  if(edge===\"yMin\"){y-=extra;h+=extra;}\n  else if(edge===\"yMax\"){h+=extra;}\n  else if(edge===\"xMin\"){x-=extra;w+=extra;}\n  else if(edge===\"xMax\"){w+=extra;}\n  else return;\n  page.setMediaBox(x,y,w,h);page.setCropBox(x,y,w,h);\n}\nasync function buildPdf(opts){\n  const legal=!!(opts&&opts.legal);\n  lostChars=0;\n  const src=await PDFDocument.load(srcBytes,{ignoreEncryption:true}),out=await PDFDocument.create();\n  const fonts={},imgs={};\n  async function font(fam,b,i){\n    const key=fam+(b?1:0)+(i?1:0);\n    if(!fonts[key])fonts[key]=await out.embedFont(StandardFonts[PDFFONT[fam][(b?1:0)+(i?2:0)]]);\n    return fonts[key];\n  }\n  for(const p of pages){\n    let page;\n    if(p.src===null)page=out.addPage([p.w,p.h]);\n    else{const cp=await out.copyPages(src,[p.src]);page=out.addPage(cp[0]);}\n    if(legal){const o=letterOrient(p);if(o)toLegal(page,p,o);}\n    const vp=vps.get(p.id);\n    const toPdf=(x,y)=>vp&&p.src!==null?vp.convertToPdfPoint(x,y):[x,p.h-y];\n    for(const it of (p.items||[])){\n      if(!it.edited)continue;\n      const f=await font(it.family,it.bold,it.italic),txt=clean(it.str);\n      const tw=txt?f.widthOfTextAtSize(txt,it.size):0,w=Math.max(it.w,tw);\n      const a=toPdf(it.x-1,it.y-1),b=toPdf(it.x+w+1,it.y+it.h+1);\n      page.drawRectangle({x:Math.min(a[0],b[0]),y:Math.min(a[1],b[1]),width:Math.abs(b[0]-a[0]),height:Math.abs(b[1]-a[1]),color:hexToRgb(it.bg||\"#ffffff\"),borderWidth:0});\n      if(txt.trim()){const bp=toPdf(it.bx,it.by);page.drawText(txt,{x:bp[0],y:bp[1],size:it.size,font:f,color:hexToRgb(it.color)});}\n    }\n    for(const el of p.els){\n      if(el.type===\"text\"){\n        const f=await font(el.family,el.bold,el.italic),lines=el.text.split(/\\r?\\n/);\n        lines.forEach((ln,k)=>{\n          const t=clean(ln);if(!t)return;\n          const bp=toPdf(el.x,el.y+el.size*0.93+k*el.size*1.2);\n          page.drawText(t,{x:bp[0],y:bp[1],size:el.size,font:f,color:hexToRgb(el.color)});\n        });\n      }else if(el.type===\"rect\"){\n        const a=toPdf(el.x,el.y),b=toPdf(el.x+el.w,el.y+el.h);\n        page.drawRectangle({x:Math.min(a[0],b[0]),y:Math.min(a[1],b[1]),width:Math.abs(b[0]-a[0]),height:Math.abs(b[1]-a[1]),color:hexToRgb(el.fill),opacity:el.opacity,borderWidth:0});\n      }else if(el.type===\"image\"){\n        const im=imgStore[el.img];\n        if(!imgs[el.img]){const by=b64ToBytes(im.url);imgs[el.img]=im.mime===\"image/jpeg\"?await out.embedJpg(by):await out.embedPng(by);}\n        const a=toPdf(el.x,el.y),b=toPdf(el.x+el.w,el.y+el.h);\n        page.drawImage(imgs[el.img],{x:Math.min(a[0],b[0]),y:Math.min(a[1],b[1]),width:Math.abs(b[0]-a[0]),height:Math.abs(b[1]-a[1])});\n      }\n    }\n  }\n  return await out.save();\n}\nfunction saveBlob(blob,name){\n  const a=document.createElement(\"a\");a.href=URL.createObjectURL(blob);a.download=name;\n  document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),5000);\n}\nfunction warnLost(){if(lostChars)toast(lostChars+\" character\"+(lostChars>1?\"s\":\"\")+\" can’t be saved with the built-in fonts and became ?.\");}\nasync function downloadPdf(){\n  busy(true);\n  try{\n    const legal=!$(\"#dlLegalRow\").hidden&&$(\"#dlLegal\").checked,n=legal?pages.filter(p=>letterOrient(p)).length:0;\n    const bytes=await buildPdf({legal});\n    saveBlob(new Blob([bytes],{type:\"application/pdf\"}),fileName+\"-edited.pdf\");\n    if(lostChars)warnLost();\n    else if(n)toast(n+\" Letter page\"+(n>1?\"s\":\"\")+\" converted to Legal size.\");\n  }\n  catch(e){console.error(e);toast(\"Couldn’t build the PDF. The file may be protected or damaged.\");}\n  finally{busy(false);}\n}\nasync function downloadImage(kind,scale,quality){\n  busy(true);\n  try{\n    const bytes=await buildPdf(),doc=await pdfjsLib.getDocument({data:bytes.slice()}).promise,pg=await doc.getPage(cur+1);\n    const vp=pg.getViewport({scale:scale}),c=document.createElement(\"canvas\");c.width=Math.round(vp.width);c.height=Math.round(vp.height);\n    const ctx=c.getContext(\"2d\");\n    if(kind===\"jpg\"){ctx.fillStyle=\"#fff\";ctx.fillRect(0,0,c.width,c.height);}\n    await pg.render({canvasContext:ctx,viewport:vp}).promise;\n    const mime=kind===\"jpg\"?\"image/jpeg\":\"image/png\";\n    const blob=await new Promise(r=>c.toBlob(r,mime,kind===\"jpg\"?quality:undefined));\n    saveBlob(blob,fileName+\"-page\"+(cur+1)+\".\"+kind);warnLost();\n  }catch(e){console.error(e);toast(\"Couldn’t export this page as an image.\");}\n  finally{busy(false);}\n}\n\n/* ---------- download dialog ---------- */\nlet dlType=\"pdf\",dlQuality=0.85,dlLetterN=0;\nfunction dlOpen(){\n  $(\"#dlPageNo\").textContent=cur+1;\n  $(\"#dlScaleVal\").textContent=$(\"#dlScale\").value+\"×\";\n  dlLetterN=pages.filter(p=>letterOrient(p)).length;\n  $(\"#dlLegalCount\").textContent=dlLetterN?dlLetterN+\" of \"+pages.length+\" page\"+(pages.length>1?\"s are\":\" is\")+\" Letter size. Extra blank space is added at the bottom.\":\"\";\n  dlSetType(dlType);\n  $(\"#dlOverlay\").hidden=false;\n  $(\"#dOpen\").setAttribute(\"aria-expanded\",\"true\");\n  $(\"#dlDialog\").focus();\n}\nfunction dlClose(){$(\"#dlOverlay\").hidden=true;$(\"#dOpen\").setAttribute(\"aria-expanded\",\"false\");}\nfunction dlSetType(t){\n  dlType=t;\n  document.querySelectorAll(\".dlType\").forEach(b=>b.setAttribute(\"aria-checked\",String(b.dataset.type===t)));\n  $(\"#dlImgOpts\").hidden=(t===\"pdf\");\n  $(\"#dlPdfNote\").hidden=(t!==\"pdf\");\n  $(\"#dlLegalRow\").hidden=(t!==\"pdf\"||!dlLetterN);\n  $(\"#dlGo\").textContent=\"Download\";\n}\ndocument.querySelectorAll(\".dlType\").forEach(b=>b.addEventListener(\"click\",()=>dlSetType(b.dataset.type)));\ndocument.querySelectorAll(\"#dlQuality button\").forEach(b=>b.addEventListener(\"click\",e=>{\n  document.querySelectorAll(\"#dlQuality button\").forEach(x=>x.setAttribute(\"aria-pressed\",\"false\"));\n  e.currentTarget.setAttribute(\"aria-pressed\",\"true\");dlQuality=parseFloat(e.currentTarget.dataset.q);\n}));\n$(\"#dlScale\").addEventListener(\"input\",e=>{$(\"#dlScaleVal\").textContent=e.target.value+\"×\";});\n$(\"#dlClose\").addEventListener(\"click\",dlClose);\n$(\"#dlOverlay\").addEventListener(\"click\",e=>{if(e.target.id===\"dlOverlay\")dlClose();});\ndocument.addEventListener(\"keydown\",e=>{if(e.key===\"Escape\"&&!$(\"#dlOverlay\").hidden)dlClose();});\n$(\"#dlGo\").addEventListener(\"click\",async()=>{\n  if(!pages.length)return;\n  dlClose();\n  if(dlType===\"pdf\")await downloadPdf();\n  else await downloadImage(dlType,parseFloat($(\"#dlScale\").value),dlQuality);\n});\n\n/* ---------- wiring ---------- */\n$(\"#upBtn\").addEventListener(\"click\",()=>$(\"#fileIn\").click());\n$(\"#fileIn\").addEventListener(\"change\",e=>{openFile(e.target.files[0]);e.target.value=\"\";});\n$(\"#tSelect\").addEventListener(\"click\",()=>setTool(\"select\"));\n$(\"#tText\").addEventListener(\"click\",()=>setTool(tool===\"text\"?\"select\":\"text\"));\n$(\"#tGrab\").addEventListener(\"click\",()=>setTool(tool===\"grab\"?\"select\":\"grab\"));\n$(\"#tShape\").addEventListener(\"click\",()=>setTool(tool===\"shape\"?\"select\":\"shape\"));\n$(\"#tImage\").addEventListener(\"click\",()=>$(\"#imgIn\").click());\n$(\"#imgIn\").addEventListener(\"change\",e=>{if(e.target.files[0])addImage(e.target.files[0]);e.target.value=\"\";});\n$(\"#imgRep\").addEventListener(\"change\",e=>{const o=selObj();if(o&&o.type===\"image\"&&e.target.files[0])replaceImage(o,e.target.files[0]);e.target.value=\"\";});\n$(\"#bUndo\").addEventListener(\"click\",undo);\n$(\"#bCompare\").addEventListener(\"click\",e=>{comparing=!comparing;e.currentTarget.setAttribute(\"aria-pressed\",comparing);renderLayer();});\n$(\"#zIn\").addEventListener(\"click\",()=>setZoom(zoom+.15));\n$(\"#zOut\").addEventListener(\"click\",()=>setZoom(zoom-.15));\n$(\"#addPage\").addEventListener(\"click\",addBlank);\n$(\"#dOpen\").addEventListener(\"click\",dlOpen);\ndocument.addEventListener(\"keydown\",e=>{\n  const t=e.target,editing=t&&(t.isContentEditable||/^(INPUT|SELECT|TEXTAREA)$/.test(t.tagName));\n  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()===\"z\"&&!editing){e.preventDefault();undo();}\n  else if((e.key===\"Delete\"||e.key===\"Backspace\")&&!editing&&sel!=null){e.preventDefault();deleteSel();}\n  else if(e.key===\"Escape\"&&!editing){select(null);setTool(\"select\");}\n});\n[\"dragenter\",\"dragover\"].forEach(ev=>window.addEventListener(ev,e=>{e.preventDefault();document.body.classList.add(\"dragging\");}));\n[\"dragleave\",\"drop\"].forEach(ev=>window.addEventListener(ev,e=>{e.preventDefault();document.body.classList.remove(\"dragging\");}));\nlet resizeT;\nwindow.addEventListener(\"resize\",()=>{\n  if(!pages.length)return;\n  clearTimeout(resizeT);\n  resizeT=setTimeout(()=>{fitZoom();renderPage();},150);\n});\nwindow.addEventListener(\"drop\",e=>{const f=e.dataTransfer&&e.dataTransfer.files[0];if(f)openFile(f);});\nrenderProps();\nif(/^https?:$/.test(location.protocol)){const u=location.href.split(\"#\")[0];$(\"#canon\").href=u;$(\"#ogurl\").content=u;}\n})();\n</script>\n</body>\n</html>\n","dis":"This tool is help for edit PDF "}],"docs":[],"pages":[{"slug":"about","title":"About Us","pub":true,"foot":true,"body":"Discover Property Opportunities in DHA Multan, Pakistan\n\nDHA Multan is a prominent residential and real estate destination in Multan, Punjab, Pakistan. Our website helps families, property buyers, investors, and businesses explore property opportunities and access useful real estate information about DHA Multan and its surrounding areas.\n\nWe aim to make property research simpler by bringing together property listings, area guides, real estate calculators, and Newsflash articles in one convenient place. These resources help visitors compare available options, understand property-related information, explore neighbourhoods, and make more informed decisions before arranging a property visit.\n\nOur Mission\n\nOur mission is to make real estate information easier to access, understand, and use. We aim to provide a straightforward online experience where visitors can explore property opportunities, learn about local areas, and stay informed about relevant real estate developments.\n\nWhat You Can Explore\n **Area Guides:** Learn about DHA Multan, its sectors, surrounding areas, and location-related information.\n- **Real Estate Calculators:** Use helpful tools to support property research and financial planning.\n- **Newsflash and Updates:** Read property-related articles, news, and relevant development updates.\n- **Property Research Resources:** Find information that helps you prepare for property visits and evaluate your options.\n\n Why Explore DHA Multan?\n\nDHA Multan offers a planned residential environment in South Punjab, with residential and commercial property options and community amenities. The official DHA Multan website provides information about projects, development updates, plot categories, facilities, and other relevant services.\n\nWhether you are researching residential plots, exploring commercial property opportunities, or learning more about the area, our website aims to help you find relevant information in one place.\n\n Our Commitment\n\nWe are committed to presenting property information clearly and making real estate research more convenient for our visitors. We encourage buyers and investors to verify current prices, property availability, ownership details, payment terms, approvals, and other important information through the appropriate official channels before making a transaction.\n\nExplore our property resources, area guides, calculators, and latest articles to learn more about DHA Multan and the local real estate market.\n\n**Disclaimer:** Property information, prices, availability, and development details may change. Verify important information independently before making a purchase or investment decision."},{"slug":"contact","title":"Contact Us","pub":true,"foot":true,"body":" Contact Us – DHA Multan\n\n\nHave a question about property listings, residential plots, commercial properties, or real estate information in DHA Multan? We are here to help.\n\nContact us for inquiries about property opportunities, area guides, real estate resources, calculators, and property-related updates. Our aim is to help visitors find relevant information and make more informed decisions when exploring real estate in DHA Multan, Multan, Punjab, Pakistan.\n\nOur Contact Information\n\n**Phone Number:** 03053220402\n\n**Email Address:** arslanjaz00402@gmail.com\n\n**Office Address:** DHA Multan Phase 1, Sector H, Near DHA Site Office, Multan, Punjab, Pakistan.\n\nHow We Can Help\n\nYou can contact us regarding:\n\n- Property listings and real estate inquiries.\n- Residential and commercial property information.\n- DHA Multan area and sector guides.\n- Property-related news and development updates.\n- Questions about our website, calculators, and other resources.\n- General feedback, corrections, or suggestions.\n\nSend Us a Message\n\nHave a specific question? Use the contact form on this page to send your name, email address, subject, and message. Please provide accurate contact details so we can respond if a reply is appropriate.\n\nDo not include passwords, bank details, or sensitive identity information in your message.\n\nVisit Our Location\n\n**DHA Multan Phase 1, Sector H, Near DHA Site Office, Multan, Punjab, Pakistan.**\n\nIf you plan to visit, please verify the exact location and any access requirements before travelling.\n\nStay Connected\n\nWe welcome genuine inquiries and feedback from property buyers, investors, families, and visitors researching DHA Multan. Contact us by phone or email for assistance with the information and resources available on our website.\n"},{"slug":"privacy-policy","title":"Privacy Policy","pub":true,"foot":true,"body":"Last updated: 28 October 2026\n\nThis Privacy Policy explains what information Maskan Estates (\"we\") collects when you use this website, how we use it and the choices you have.\n\n1. Information we collect\n- Information you send us, such as your name, email address or phone number when you contact us.\n- Technical data collected automatically, such as your browser type, device, pages visited and approximate location derived from your IP address.\n- Cookies and similar technologies (see our Cookie Policy).\n\n2. How we use information\nWe use information to answer your messages, run and improve the website, keep it secure, and show advertising.\n\n3. Advertising (Google AdSense)\nThird-party vendors, including Google, use cookies to serve ads based on your previous visits to this and other websites. Google's use of advertising cookies enables it and its partners to serve ads based on your visits to this site and/or other sites on the Internet. You can opt out of personalised advertising at https://www.google.com/settings/ads, or opt out of some third-party vendors' cookies at https://www.aboutads.info/choices. Learn how Google uses data at https://policies.google.com/technologies/partner-sites.\n\n4. Sharing\nWe do not sell your personal information. We share data only with service providers that help us run the site (hosting and advertising) or when the law requires it.\n\n5. Retention\nWe keep messages only as long as needed to respond and for our records, and then delete them.\n\n6. Your rights\nYou can ask us to access, correct or delete personal information we hold about you by contacting us using the details on our Contact page.\n\n7. Children\nThis website is not directed at children under 13 and we do not knowingly collect their information.\n\n8. Changes\nWe may update this policy. The date at the top shows the latest version.\n\nContact: see our Contact page.","_old":"We collect only the information you give us and standard analytics data.\n\nThird-party vendors, including Google, use cookies to serve ads based on your visits to this and other sites. You can opt out through Google Ad Settings.\n\nYou can accept or decline cookies from the banner shown on your first visit."},{"slug":"terms-and-conditions","title":"Terms & Conditions","pub":true,"foot":true,"body":"Last updated: 28 October 2026\n\nBy using this website you agree to these terms. If you do not agree, please do not use the site.\n\n1. Information only\nListings, prices, measurements, calculators and articles are provided for general information. They may contain errors and can change without notice. Always verify details with the seller, the relevant authority, your bank or a qualified property lawyer before making a decision.\n\n2. No professional advice\nNothing on this site is legal, tax, financial or investment advice.\n\n3. Third-party content and links\nNewsflash articles summarise public notices from third parties. We are not affiliated with them and are not responsible for external websites we link to.\n\n4. Acceptable use\nYou may not copy, scrape or resell site content, upload harmful code, or try to access the admin area or other systems without permission.\n\n5. Intellectual property\nSite design, text and original content belong to Maskan Estates unless stated otherwise.\n\n6. Limitation of liability\nTo the extent the law allows, we are not liable for losses arising from the use of this website or reliance on its content.\n\n7. Changes\nWe may update these terms at any time. Continued use means you accept the updated terms.\n\n8. Governing law\nThese terms are governed by the laws of Pakistan.","_old":"By using this site you agree to these terms. Listings, prices and measurements are provided by sellers and may change without notice.\n\nYou may not copy or resell site content without written permission."},{"slug":"disclaimer","title":"Disclaimer","pub":true,"foot":true,"body":"Information on this site is general in nature and is not legal, tax or financial advice.\n\nNewsflash articles summarise public notices from third parties. We are not affiliated with DHA Multan. Always confirm terms with the issuing authority.\n\nCalculators give estimates only. Confirm figures with your bank and a qualified property lawyer."},{"slug":"cookie-policy","title":"Cookie Policy","pub":true,"foot":true,"body":"Last updated: 28 October 2026\nCookies are small text files stored on your device by websites you visit.\n\nCookies we use\n- Essential: remember your cookie choice. These do not identify you.\n- Advertising: Google AdSense and its partners may set cookies to show and measure ads, including personalised ads based on your visits to this and other sites.\n\nYour choices\nUse the \"Cookie settings\" link in the footer to change your choice at any time. You can also block or delete cookies in your browser settings, and opt out of personalised Google ads at https://www.google.com/settings/ads.\n\nVisitors in the EEA, UK and Switzerland are shown Google's consent message before personalised ads are used."},{"slug":"earnings-disclosure","title":"Earnings & AdSense Disclosure","pub":true,"foot":false,"body":"This site displays Google AdSense advertisements. We earn revenue when visitors view or click ads.\n\nAds do not influence our listings or articles."}],"arts":[{"slug":"safeguard-your-asset","title":"Safeguard your Asset","year":"2026","cat":"News ","sum":"Safeguard your Asset: learn how DHA Multan's 100% surcharge waiver on 50% overdue ADC worked, who qualified, key sectors and steps to protect your plot ballot.","body":"<h2>Safeguard your Asset: DHA Multan's 100% Surcharge Waiver on 50% Overdue Additional Development Charges Explained</h2><p><strong>Quick answer:</strong> To safeguard your asset in DHA Multan under the January 2026 facilitation scheme, a member holding an active plot in an eligible possession sector had to pay 50% of the overdue Additional Development Charges (ADC), together with any previously overdue development charges. In return, DHA Multan offered a 100% waiver of surcharge and protected the plot's location ballot from cancellation. The announcement was dated 23 January 2026 and the offer was valid until 31 March 2026.</p><p><strong>Important note on timing:</strong> That validity window has now closed. This guide explains how the scheme worked, why it mattered, and what plot owners should do today to safeguard your asset, whether you are dealing with an old dues file or planning ahead for the next facilitation announcement. Always confirm the current position directly with DHA Multan before paying anything.</p><h2>Why Safeguard your Asset Is the Most Important Question for Plot Owners</h2><p>In ten years of writing about and advising on plot files in Punjab's housing societies, I have noticed that one mistake costs families more money than any market crash: ignoring dues until a penalty piles up. A plot is not like a bank deposit that sits quietly. It is an asset with obligations attached, and when those obligations are missed, the cost grows every month through surcharge.</p><p>That is why the phrase \"Safeguard your Asset\" appears at the very top of the DHA Multan newsflash. The authority was not merely announcing a discount. It was telling members that their plots, their location ballots and years of instalments were at risk, and that a window had opened to protect them at a reduced cost.</p><p>If you own a plot in a possession sector, or you are advising a family member who does, the practical goal is simple: safeguard your asset by clearing the right dues, in the right order, with the right paperwork, before a deadline turns a manageable balance into a cancelled ballot.</p><h2>What Did DHA Multan Announce on 23 January 2026?</h2><p>According to the newsflash issued under the banner \"Paradise of South Punjab,\" DHA Multan responded to continuous requests from valued members by offering a facilitation scheme titled \"Safeguard your Asset: Pay 50% &amp; Get 100% Relief.\" The headline offer was a 100% surcharge waiver upon clearance of 50% of overdue Additional Development Charges.</p><p>The scheme covered:</p><ul><li>50% of overdue Additional Development Charges, including all previously overdue development charges, if any.</li><li>Possession sectors only.</li><li>Protection against cancellation of the plot's location ballot, meaning the conversion of a plot into an open file.</li></ul><p>A careful reader should notice one detail that is often misunderstood. The \"100% relief\" refers to the surcharge, the late payment penalty. It does not mean that 100% of the development charges were forgiven, and it does not mean that members paid only half of what they owed in total. Members paid half of the overdue Additional Development Charges, and the surcharge on those overdue amounts was fully waived.</p><p>The authority described the measure as one designed \"not only to provide maximum financial relief\" but also to help members regularise their instalment plans. That second purpose matters. A waiver is only useful if the member then stays current, which is why the scheme was tied to compliance with the stated criteria.</p><h2>Offer Highlights at a Glance</h2><table><tbody><tr><th><p>Item</p></th><th><p>Details</p></th></tr><tr><td><p>Announcement date</p></td><td><p>23 January 2026</p></td></tr><tr><td><p>Validity</p></td><td><p>Until 31 March 2026</p></td></tr><tr><td><p>Main benefit</p></td><td><p>100% waiver of surcharge</p></td></tr><tr><td><p>Payment required</p></td><td><p>50% of overdue Additional Development Charges</p></td></tr><tr><td><p>Additional condition</p></td><td><p>Clearance of all previously overdue development charges, if any</p></td></tr><tr><td><p>Second benefit</p></td><td><p>Securing the plot's location ballot from cancellation</p></td></tr><tr><td><p>Applicable sectors</p></td><td><p>Possession sectors: M, Q, R, H, U, A, V, I, N, B1 and G</p></td></tr><tr><td><p>Refund policy</p></td><td><p>Surcharge already paid is neither refunded nor adjusted</p></td></tr></tbody></table><p>This table is the fastest way to understand the scheme. If you only remember three points, remember these: it applied to active plots, it applied to possession sectors, and surcharge already paid could not be claimed back.</p><h2>Who Was Eligible? Understanding the Possession Sectors</h2><p>The newsflash is clear that the scheme applied to active plots in possession sectors only, listing Sectors M, Q, R, H, U, A, V, I, N, B1 and G. Many members lose time because they assume every DHA plot qualifies. Eligibility has two parts.</p><p>First, the sector must be on the possession list. A plot in a sector that had not reached possession stage was outside this particular scheme.</p><p>Second, the plot must be active. Plots that had already been cancelled, transferred into a dispute, or placed under a different status could not simply ride on this offer. If you are unsure of your file status, the first step to safeguard your asset is to ask the society for an updated account statement that shows your plot status, dues and surcharge separately.</p><h2>Understanding the Terms: ADC, Surcharge and Location Ballot</h2><p>Before deciding anything, it helps to understand the three terms that drive this scheme.</p><p><strong>Additional Development Charges (ADC):</strong> These are charges collected from members to fund the development of roads, utilities and common infrastructure in a sector. They are normally paid in instalments according to a schedule set when the plot is allotted or as later notified by the authority.</p><p><strong>Surcharge:</strong> This is the penalty added when an instalment is paid late. Over time it can become a large amount, sometimes a surprising fraction of the original dues. A surcharge waiver therefore has real monetary value.</p><p><strong>Location ballot:</strong> In many housing societies, the exact physical location of a plot is decided by ballot when development reaches the relevant stage. Your location ballot is what ties your file to a specific, identifiable piece of land. If it is cancelled for non-payment, the plot can revert to an open file, meaning you still hold a claim but lose your specific location and your position in the queue.</p><p>Why does this matter? Because location drives value. A corner plot or a plot facing a park can carry a premium. An open file has to wait for a new allocation, which may place it in a less desirable block, and sometimes with a delay of months or years. To safeguard your asset in the truest sense, you are protecting not just a file number but a specific location you were once allotted.</p><h2>How the Scheme Helped Members Avoid Open File Conversion</h2><p>The newsflash specifically states that the facilitation measure allowed members to \"avoid cancellation of plot location ballot,\" meaning conversion of the plot into an open file. This is the most valuable but least discussed part of the scheme.</p><p>Consider what an open file means in practice. The investor's original location is gone. Resale becomes harder because buyers prefer files with a confirmed location. Banks and financing partners may treat the file differently. And the owner may face further documentation steps to restore the plot to its earlier standing, if restoration is even allowed.</p><p>Therefore, when people ask me whether paying 50% was worth it, my answer begins with the ballot, not the discount. The surcharge waiver saves money. Securing the location ballot protects the asset itself. Both are needed to safeguard your asset, and the scheme offered both in a single payment.</p><h2>Real-Life Style Examples: How This Plays Out for Families</h2><p>The following scenarios are illustrative composites based on patterns I have seen repeatedly while helping plot owners understand dues notices. The names and amounts are examples, not records of specific individuals, and your own figures will differ. They are included to show the reasoning, not to promise any outcome.</p><h3>Example 1: The Overseas Member in Dubai</h3><p>Imagine a member working in Dubai who bought a plot through a family representative. Instalment reminders were going to an old postal address, and two ADC instalments were missed. By the time the member checked, a surcharge had accumulated on top of the unpaid dues.</p><p>Suppose the overdue ADC was Rs 1,000,000 and the surcharge was Rs 250,000 (illustrative figures only). Under a scheme like the one announced in January 2026, the member would pay 50% of the overdue ADC, which is Rs 500,000, and the Rs 250,000 surcharge would be waived. The member's real saving is the surcharge, and the larger benefit is that the location ballot would not be cancelled.</p><p>The lesson: update your contact details with the society so notices reach you. That is the cheapest step to safeguard your asset from abroad.</p><h3>Example 2: The Retired Teacher with a Single Plot</h3><p>Picture a retired teacher who invested her savings in one plot as security for her children. Her income is fixed and she delayed an instalment during a medical expense. She did not realise that the delay was attracting surcharge every month.</p><p>For her, the facilitation measure would have reduced the cash required immediately. Instead of finding the entire overdue balance plus surcharge, she needed to arrange half of the overdue ADC and clear any older development charges. For someone on a limited budget, that difference can decide whether the plot is kept or lost.</p><p>The lesson: ask the society to break down your dues line by line before you decide how much to arrange. Clarity helps you safeguard your asset without borrowing at unfavourable terms.</p><h3>Example 3: The Investor Who Waited for a Better Offer</h3><p>A small investor held several files and deliberately delayed payment, expecting a waiver announcement. In some years it came; in others it did not. When a deadline passed without payment, one of his files moved towards cancellation risk and the waiver no longer applied to it.</p><p>The lesson: waiting for relief is a gamble. Facilitation schemes are time-bound, conditional and not guaranteed to be repeated on the same terms. A disciplined investor treats the due date as the real deadline and the waiver as a bonus, not a plan.</p><h2>Step-by-Step: How to Safeguard your Asset When Dues Are Overdue</h2><p>This process reflects how I advise members to approach any overdue file, including under a scheme like the January 2026 offer.</p><ol><li><strong>Confirm your plot status.</strong> Ask DHA Multan for a written account statement that shows the plot is active, the sector, the instalments paid, and the amount overdue.</li><li><strong>Separate the components.</strong> Ask for the overdue Additional Development Charges, any older overdue development charges, and the surcharge, each as a separate line.</li><li><strong>Check whether a current facilitation scheme exists.</strong> Do not rely on social media posts or agents. Confirm at the DHA Multan main office on Muhammad Ali Jinnah Avenue, Sector H, or via the helpline 061-111-111-199, and verify validity dates in writing.</li><li><strong>Calculate the cash required.</strong> Under the January 2026 structure, this meant 50% of overdue ADC plus any previously overdue development charges. Surcharge already paid was not refunded.</li><li><strong>Pay through authorised channels only.</strong> Use the official bank accounts or counters named by the authority. Never hand cash to an agent without an official receipt.</li><li><strong>Keep proof.</strong> Save the payment slip, receipt and updated statement. Ask for confirmation that the surcharge has been waived and the location ballot is secure.</li></ol><p>These six steps are the practical core of how to safeguard your asset. Notice that none of them require legal complexity. They require attention, documents and timely action.</p><h2>What the 50% Condition Really Meant</h2><p>A frequent misunderstanding is that 50% payment cleared the entire overdue balance. The newsflash says otherwise. The criteria required payment of only 50% of overdue Additional Development Charges and clearance of previously overdue development charges, if any.</p><p>In plain language, there were two layers. One layer was older overdue development charges, which had to be fully cleared. The other layer was the overdue ADC, where half was payable under the scheme to unlock the waiver. The remaining half of ADC does not disappear by magic; it continues to be governed by the society's schedule and rules, so members should ask how and when the balance is to be paid.</p><p>Answer engines and readers often ask a simple question: \"Do I still owe money after paying 50%?\" The honest answer is that you should obtain a written statement of the remaining balance and its due dates. The purpose of the scheme was to clear the penalty and secure the ballot, not to erase the underlying development obligation.</p><h2>The Fine Print: Surcharge Already Paid Is Not Refunded</h2><p>The note at the bottom of the newsflash contains two points worth highlighting. First, the scheme applied to active plots in possession sectors only. Second, surcharge already paid would be neither refunded nor adjusted.</p><p>This is fair in principle but painful in practice for members who paid surcharge shortly before the announcement. If you paid surcharge last month and a waiver is announced this month, the waiver does not retroactively reduce what you paid. The better strategy is to keep a record of dates and amounts so you understand how the cut-off worked for your file.</p><p>It also shows why proactive payment is a form of protection. If you can pay on schedule, you avoid surcharge altogether. If you cannot, ask early whether a payment plan is available, because the earlier you act, the less penalty accumulates. That is one more practical way to safeguard your asset before a crisis begins.</p><h2>Common Mistakes That Put Your Plot at Risk</h2><p>Over the years I have seen the same errors appear again and again.</p><ul><li><strong>Relying on an agent's verbal promise.</strong> Always insist on written confirmation from the society.</li><li><strong>Paying the wrong amount.</strong> If you pay less than the scheme requires, the waiver may not apply, and you may lose the benefit.</li><li><strong>Ignoring older dues.</strong> The scheme required previously overdue development charges to be cleared too. Paying only the latest instalment can leave the file non-compliant.</li><li><strong>Missing the deadline by a few days.</strong> Time-bound offers rarely have grace periods. Treat the last date as a hard stop.</li><li><strong>Not updating contact details.</strong> Notices go to the address on file. If it is wrong, you may miss both the dues reminder and the scheme announcement.</li><li><strong>Assuming every sector qualifies.</strong> Check the list of possession sectors before making plans.</li></ul><p>Every one of these mistakes is avoidable. Avoiding them is the daily discipline behind any plan to safeguard your asset.</p><h2>Is Paying 50% Worth It? A Practical Decision Framework</h2><p>When members ask me whether to take a waiver offer, I do not give a yes or no without context. I walk them through a simple framework.</p><p><strong>1. How large is the surcharge?</strong> If the surcharge is small, the saving is small. If it is large, the waiver is a major benefit.</p><p><strong>2. How important is the location?</strong> If you purchased a plot specifically for its position near a park, boulevard or commercial area, protecting the ballot is worth far more than the surcharge saving.</p><p><strong>3. Can you arrange the cash without harmful borrowing?</strong> Taking a high-interest loan to pay a waiver amount can defeat the purpose. If you must borrow, compare the cost against the surcharge you would otherwise face.</p><p><strong>4. What is your plan for the balance?</strong> A waiver is not a finish line. Build a realistic schedule for the remaining dues.</p><p><strong>5. Do you plan to build, hold or sell?</strong> Builders need clean files to submit plans. Sellers need clean files to attract buyers. Long-term holders need clean files to avoid future surprises.</p><p>For most active possession-sector owners, the answer was yes. Protecting the ballot and removing the penalty are strong reasons to safeguard your asset when the conditions are manageable.</p><h2>Why a Clean File Raises Resale Value</h2><p>Buyers in Multan's property market have become more careful. They ask for a <a href=\"https://www.fbr.gov.pk\" target=\"_blank\" rel=\"noopener\">no-dues certificate</a>, a clear statement, and confirmation that the plot's location is secure. A file with unresolved surcharge or a cancelled ballot invites price negotiation, and sometimes it simply fails to sell.</p><p>A clean file, in contrast, signals reliability. It reduces the time between listing and closing, because the buyer's lawyer finds fewer issues. In my experience, a member who clears dues and keeps proof usually negotiates from a position of strength.</p><p>This is another reason the phrase \"safeguard your asset\" is more than a slogan. It describes a habit that has a direct effect on what the asset is worth when you finally need to sell, transfer or build.</p><h2>Safeguard your Asset When You Live Overseas</h2><p>Overseas Pakistanis form a large share of plot investors in South Punjab. They face particular risks: delayed notices, time-zone gaps, and reliance on relatives or agents. To safeguard your asset from abroad, I recommend four habits.</p><p>First, appoint a trusted representative with a proper power of attorney, and give the society the representative's contact details along with your own. Second, request email or SMS notifications for every dues notice. Third, schedule an annual file review, even if you believe everything is paid. Fourth, keep digital copies of every receipt, transfer letter and statement in a cloud folder that a family member can access in an emergency.</p><p>These steps cost almost nothing, yet they prevent most of the situations in which surcharge accumulates unnoticed.</p><h2>Building Trust: How to Verify Any Offer Before You Pay</h2><p>Good decisions rely on verified information. When a surcharge waiver is advertised, I recommend a simple verification routine that reflects the principles of experience, expertise, authoritativeness and trustworthiness (EEAT).</p><ul><li><strong>Check the source.</strong> The offer should come from DHA Multan's official channels, such as its main office, <a href=\"https://www.dhamultan.org\" target=\"_blank\" rel=\"noopener\">official website at dhamultan.org</a>, or verified social media pages.</li><li><strong>Check the date and validity.</strong> A genuine notice states its issue date and end date. The January 2026 notice stated a validity until 31 March 2026.</li><li><strong>Check the criteria in writing.</strong> Make sure the percentage, sectors and conditions match what you are told verbally.</li><li><strong>Check the payment channel.</strong> Only pay into official accounts or at official counters, and keep receipts.</li><li><strong>Check for hidden conditions.</strong> Ask whether the offer excludes certain plot categories or earlier payments.</li></ul><p>A few minutes of verification can save lakhs of rupees. It is the most dependable way to safeguard your asset from fraud and misinformation.</p><h2>What Plot Owners Should Do Now That the Offer Has Ended</h2><p>If you read about this scheme after 31 March 2026, you may feel you missed an opportunity. That feeling is understandable, but it is not the end of the road. Here is what I suggest.</p><p><strong>Request an updated statement.</strong> Find out exactly where your file stands today, including any surcharge accrued since the window closed.</p><p><strong>Ask about payment plans.</strong> Societies often have standard procedures for instalment rescheduling. Ask whether one applies to your case.</p><p><strong>Watch for future notices.</strong> Facilitation measures sometimes return in modified forms. Following official channels helps you act quickly.</p><p><strong>Do not delay out of hope.</strong> Waiting for a new waiver can allow more surcharge to build up. If you can pay now, calculate whether paying sooner is cheaper than hoping.</p><p><strong>Consult a qualified professional.</strong> For complex files, such as inherited plots, multiple owners, or transfers, speak with a property lawyer or the society's official help desk.</p><p>The central point remains the same: to safeguard your asset, act on verified information and keep your file compliant.</p><h2>Frequently Asked Questions</h2><h3>What was the DHA Multan 50% overdue ADC offer?</h3><p>It was a facilitation scheme announced on 23 January 2026 that offered a 100% surcharge waiver when members paid 50% of overdue Additional Development Charges, along with clearance of any previously overdue development charges, for plots in eligible possession sectors.</p><h3>Which sectors were included?</h3><p>The newsflash listed Sectors M, Q, R, H, U, A, V, I, N, B1 and G, all possession sectors.</p><h3>Until when was the offer valid?</h3><p>The stated validity was until 31 March 2026.</p><h3>Does the scheme cancel the remaining 50% of ADC?</h3><p>No. The scheme waived the surcharge. Members should obtain a written statement of the remaining balance and its schedule from the society.</p><h3>What happens to the location ballot if I do not pay?</h3><p>According to the newsflash, the scheme was designed to help members avoid cancellation of the plot location ballot, which would convert the plot into an open file. Non-compliance could therefore put the ballot at risk.</p><h3>Will surcharge I already paid be refunded?</h3><p>No. The newsflash states that surcharge already paid is neither refunded nor adjusted.</p><h3>How can I safeguard your asset if I cannot pay in full?</h3><p>Contact the society early, ask for a written breakdown of dues, and enquire about any payment arrangement. Acting early reduces the surcharge that accumulates and keeps more options open.</p><h3>Where can I get official information?</h3><p>The newsflash lists the DHA Multan main office at Muhammad Ali Jinnah Avenue, Sector H, with the helpline 061-111-111-199, along with suboffices in Islamabad, Lahore and Karachi, and the website dhamultan.org.</p><h2>Safeguard your Asset: A Final Checklist</h2><p>Use this checklist whenever you review a plot file, whether or not a facilitation scheme is running.</p><ul><li>Confirm your plot is active and in which sector it falls.</li><li>Obtain a written statement separating ADC, older development charges and surcharge.</li><li>Verify any offer in writing, including dates and conditions.</li><li>Pay only through authorised channels and keep every receipt.</li><li>Update your contact details with the society.</li><li>Review your file at least once a year.</li><li>Plan the remaining balance so that you do not fall behind again.</li></ul><p>Working through this list takes an afternoon, yet it can protect an asset worth millions of rupees. That is the simplest definition of how to safeguard your asset.</p><h2>Conclusion: Safeguard your Asset Before the Next Deadline</h2><p>The DHA Multan newsflash of 23 January 2026 was more than a discount. It was a reminder that plot ownership carries ongoing responsibilities, and that a missed instalment can quietly threaten a location ballot you worked hard to secure. By offering a 100% surcharge waiver against payment of 50% of overdue Additional Development Charges, and by tying the benefit to clearance of older dues, the scheme gave eligible members a structured path back to compliance.</p><p>Whether you used that scheme or are reading about it now, the lessons are timeless. Keep your documents in order, verify every offer with the source, ask for written breakdowns, and never confuse a waiver with a final settlement. Most of all, treat your plot as the long-term asset it is. Safeguard your asset with consistent attention, and it will serve your family far better than any last-minute rescue.</p><p>Disclaimer: This article is for general information based on the DHA Multan newsflash dated 23 January 2026. It is not legal or financial advice. Terms, validity and eligibility are decided solely by DHA Multan, so please confirm current details with the authority before making any payment.</p>","date":"","src":"https://www.dhamultan.org/Newsflash","pub":true,"tick":false,"home":true,"img":"/media/e5f705fa865109e4.webp","imgs":[]},{"slug":"dha-farmhouses-development-update-oct-2026","title":"DHA Farmhouses Development Update Oct 2026","year":"2026","cat":"DHA Farmhouses","sum":"DHA Farmhouses Development Update Oct 2026.Learn how to verify updates, avoid costly mistakes and invest smartly.","body":"DHA Farmhouses Development Update Oct 2026\n\nIf you are searching for the DHA Farmhouses Development Update Oct 2026, you are probably one of three people. You are a first-time buyer who heard that farmhouses are “the next big thing.” Or you are an overseas Pakistani who wants a safe place to park savings. Or you are a small investor who keeps seeing screenshots on WhatsApp and doesn’t know what is real.\n\nI have worked in Pakistani real estate for ten years, mostly with society files, plots and farmland. I have bought well and I have also made expensive mistakes. In this guide I’ll explain the DHA Farmhouses Development Update Oct 2026 in plain language, show you how to verify any update yourself, and share the errors that cost me and my clients money, so you don’t repeat them.\n\nWhy the DHA Farmhouses Development Update Oct 2026 Matters to Beginners\n\nFarmhouse projects move differently from ordinary residential plots. Plots are measured in marla and kanal. Farmhouses are measured in kanal, acres or thousands of square yards, so one wrong decision costs much more. A small mistake on a 5 marla plot is painful. The same mistake on a 4 kanal farmhouse can set you back years.\n\nThat is why a DHA Farmhouses Development Update Oct 2026 is more than news. It tells you whether land is demarcated, whether roads are being built, whether utilities are planned, and whether possession is realistic. A beginner who learns to read these signals can avoid most scams and most disappointment.\n\nOne honest warning first. Development information changes quickly, and different DHA cities (Karachi, Lahore, Multan, Bahawalpur, Gujranwala and others) run their projects on separate timelines. Anyone who gives you one “universal” DHA Farmhouses Development Update Oct 2026 for every city is guessing. Always ask: which DHA, which sector, which phase?\n\nWho Am I, and Why Should You Trust This Guide?\n\nTrust matters more than keywords, so here is my background. I started in this field as a junior dealer’s assistant, carrying files between offices and learning how transfers and ballots work. Over ten years I moved into advisory work: helping families check documents, compare projects and understand payment plans.\n\nI am not DHA’s official spokesperson and I do not speak for any authority. What I offer is experience: what I saw go right, what went wrong, and what I now check before recommending anything. Where I mention a figure for this month, I tell you to confirm it from DHA’s official notice. If a source can’t show you an official document, treat its claim as a rumour.\n\nDHA Farmhouses Basics: What You Are Actually Buying\n\nBefore you read any DHA Farmhouses Development Update Oct 2026, understand the product.\n\nA DHA farmhouse project usually offers large parcels, often a few thousand square yards or several kanal, in a planned area with roads, boundaries and sometimes a built structure. Some launches sell open land. Others sell constructed farmhouses. For example, DHA Oasis in DHA City Karachi was marketed with constructed farmhouses on 2,000, 2,500 and 3,000 square yard sizes. Chatter around DHA Bahawalpur has also pointed to possible 2 kanal and 4 kanal farmhouse offerings.\n\nHere is what beginners often don’t realise:\n\nOpen land and constructed farmhouses are different products. One carries construction timelines and quality risk. The other carries development and possession risk.\nPayment plans, development charges and possession dates are separate things. Paying your instalments doesn’t automatically mean you can build or move in.\nBallot, allocation and possession are three different stages. You can hold a file and still be far from a usable property.\nFarmhouse land usually has rules. Permitted construction, boundary walls and commercial use may be restricted.\n\nIf you understand these four points, you are already ahead of many new buyers when you read the DHA Farmhouses Development Update Oct 2026.\n\nHow to Read the DHA Farmhouses Development Update Oct 2026 Like a Professional\n\nWhen an update arrives, ignore the headline and look for these seven signals.\n\n1. Is the update from an official source? Look for DHA’s official website, official social pages or a notice you can verify through the marketing office. A forwarded image with no source is not an update.\n\n2. Does it name the exact sector and phase? “Development is going on at full speed” means nothing. “Earthwork completed on roads in Sector X” means something.\n\n3. Does it show completion percentages or dates? Real updates give measurable progress. Vague praise is marketing.\n\n4. Is there a possession or balloting date? If there is none, the project may still be at an early stage.\n\n5. Does it mention utilities? Water, electricity, sewerage and gas are separate works. A road with no utilities is not a finished farmhouse zone.\n\n6. Are there pictures with context? Photos should show a location and a date, ideally matching a map.\n\n7. Are there new charges? Development charges, transfer fees and extension fees can change the true cost of the file.\n\nUse this seven-point test on every DHA Farmhouses Development Update Oct 2026 you come across, whether it is a news article, a video or a dealer’s message. If three or more signals are missing, wait.\n\nThe Official Update for This Month: What to Verify\n\nAt the time of writing, I am not publishing invented numbers. The right way to confirm this month’s position is simple. Collect these items from official sources:\n\nLatest development progress: [add verified figure and date]\nCurrent balloting or allocation status: [add verified status]\nPayment plan and instalment schedule: [add verified schedule]\nDevelopment charges: [add verified amount, if announced]\nPossession timeline: [add verified timeline]\n\nWhen you fill in these fields from an official notice, you have a real DHA Farmhouses Development Update Oct 2026 instead of an opinion. I recommend writing the source and date beside every figure in a notebook. You will thank yourself when a dealer later claims “DHA said something different.”\n\nMy First Mistake: Trusting a Verbal Update\n\nThis is the story that taught me the most. Early in my career I trusted a dealer who told me, in a confident voice, that development in a particular farmhouse area was “almost complete.” I passed that message to a client, a salaried professional who was saving carefully. The client invested.\n\nMonths later we visited the site. The roads existed on paper but not on the ground. The “almost complete” area was still waiting for basic works. The client was not defrauded in a legal sense, but the timeline I had repeated was simply wrong, and the client’s money stayed locked longer than planned.\n\nLesson: Never repeat a verbal update. Today, before I say anything about a DHA Farmhouses Development Update Oct 2026, I ask for the notice, the date and the sector. If the dealer can’t provide them, I don’t pass the information on. A confident voice is not a source.\n\nMy Second Mistake: Confusing a Ballot With Possession\n\nThe second mistake was about vocabulary, and it was expensive. A family I advised celebrated when their file came out in a ballot. They assumed they could start building plans within weeks. I let that assumption stand because I didn’t explain the stages clearly.\n\nIn reality, the steps after a ballot included clearing dues, completing documents and waiting for development to reach the stage where possession is granted. The family had already hired an architect and paid fees. Those fees were wasted for a long time because the land wasn’t ready.\n\nLesson: Learn the sequence and teach it to every client:\n\nRegistration or booking\nBallot or allocation\nPayment of land cost and charges\nDevelopment of the area\nDemarcation and possession\nApproval of drawings and construction\n\nA good DHA Farmhouses Development Update Oct 2026 should tell you which of these steps is active. If an update says “ballot held” but is silent on development and possession, treat the farmhouse as a long-term holding, not a near-term home.\n\nMy Third Mistake: Ignoring Total Cost\n\nThe third mistake came from focusing on the headline price. I once compared two farmhouse options and recommended the cheaper file. I had looked at the booking price but not the full cost: development charges, transfer fees, boundary wall and the cost of utilities and access.\n\nWhen the total was added up, the “cheaper” option ended up costing more over time. Because I hadn’t done the arithmetic, my client was surprised, and so was I.\n\nLesson: Build a total-cost sheet for any farmhouse before you decide. Include:\n\nLand or farmhouse price\nRegistration or booking fee\nInstalments and any surcharge\nDevelopment charges\nTransfer fee and taxes\nConstruction or boundary wall cost\nUtilities and maintenance\n\nFor DHA Gujranwala open ballot files, for example, development charges were published as a multi-year payment schedule on top of the land cost. That shows why you must read the charges separately and not assume the first number is the full number. Apply the same habit when you read this month’s DHA Farmhouses Development Update Oct 2026.\n\nMy Fourth Mistake: Chasing Rumours of Launches\n\nFarmhouse rumours spread fast. Posts about “new 2 kanal and 4 kanal farmhouses” have appeared around several DHA projects, and some of them were no more than speculation. In my early years I treated one such rumour as a fact and told a client to prepare funds quickly.\n\nThe launch, if it came at all, did not match the rumour. The client had sold another asset in a hurry, and the timing cost them.\n\nLesson: Rumour is not a launch. A launch has an official announcement, a form or procedure, a fee and a date. Until then, any DHA Farmhouses Development Update Oct 2026 that claims a launch without those details is incomplete. Never sell or move money on a rumour.\n\nA Practical Verification Checklist (Save This)\n\nUse this short checklist for every update, every time.\n\nSource check\n\nIs it from an official DHA channel or notice?\nCan you contact the DHA marketing or customer office to confirm?\nIs the notice dated, and is it recent?\n\nLocation check\n\nWhich city, sector and phase?\nIs the area shown on an approved layout?\nHave you visited the site, or sent someone you trust?\n\nDocument check\n\nDo you have the allotment, ballot or booking documents?\nDo names, file numbers and dates match everywhere?\nIs there any pending dues or dispute attached?\n\nMoney check\n\nAre all charges listed in writing?\nAre payments made only to official accounts, never to a personal account?\nDo you hold receipts for every payment?\n\nTime check\n\nIs there a stated possession or construction timeline?\nHave timelines been extended before in this project?\n\nIf you can’t tick most of these boxes, the DHA Farmhouses Development Update Oct 2026 you are reading isn’t strong enough to base a decision on.\n\nStep-by-Step Plan for a Complete Beginner\n\nIf you are starting from zero, here is the path I give to new clients.\n\nStep 1: Set your purpose. Do you want a weekend home, farming income, a long-term hold or a resale? Each purpose points to a different location and plan.\n\nStep 2: Set your budget honestly. Include the hidden costs listed above. A farmhouse you can’t afford to finish is a stressful asset.\n\nStep 3: Choose the city and project. Compare DHA projects only on facts: location, approved layout, development progress and track record on possession.\n\nStep 4: Read the latest official update. This is where the DHA Farmhouses Development Update Oct 2026 comes in. Collect the official notice, then compare it with the previous month’s update to see real movement.\n\nStep 5: Visit the site. Walk the roads, check boundaries and ask about utilities. Photos can hide a lot.\n\nStep 6: Verify documents. Confirm everything with the official office, not only with the seller.\n\nStep 7: Start small, or wait. If you are unsure, hold off. A missed opportunity is cheaper than a wrong purchase.\n\nFarmhouse vs Plot: Which Is Better for a New Investor?\n\nBeginners often ask me this, so let me answer it plainly.\n\nA residential plot is usually easier to resell because many buyers can afford it. A farmhouse has a smaller pool of buyers, so it can take longer to sell. In return, farmhouses offer space, privacy and lifestyle value that plots can’t match.\n\nIf your goal is quick profit, a plot or a smaller product is usually the safer start. If your goal is lifestyle and a long horizon, a farmhouse can make sense. Either way, the DHA Farmhouses Development Update Oct 2026 should influence timing. A farmhouse in an area with visible, verified progress is a very different bet from one that is only on a map.\n\nI’m not a licensed financial adviser, and this is not financial or legal advice. Before you commit large sums, talk to a qualified lawyer and, if needed, a financial adviser.\n\nCommon Red Flags in Any Farmhouse Update\n\nWatch for these warning signs:\n\nPressure to pay today “before the price goes up”\nPayment requests to a personal bank account\nNo written proof of the sector, phase or file status\nPictures that look like stock photos or belong to another project\nClaims of guaranteed profit\nPromises of possession with no date\nUpdates that arrive only through forwarded messages\n\nWhen I see two or more of these together, I walk away. Any serious DHA Farmhouses Development Update Oct 2026 can survive questions. If it can’t, it isn’t worth your savings.\n\nWhat Overseas Pakistanis Should Know\n\nOverseas buyers face an extra challenge: distance. You can’t easily check the site, so you depend on others. My advice is to appoint someone you trust, ask for dated photos and videos from the actual location, and use official payment channels only. Some DHA projects have accepted overseas registration fees in foreign currency, so always confirm the current rule directly with the official office before sending money.\n\nReading each DHA Farmhouses Development Update Oct 2026 with a calm, document-first approach protects you from the “emotional buying” that distance can create.\n\nFrequently Asked Questions\n\nWhat is the DHA Farmhouses Development Update Oct 2026?\nIt is the latest progress report on DHA farmhouse projects as of October 2026: development status, balloting or allocation, payment plans and possession timelines. Because each DHA city runs its own project, always confirm which sector and phase an update refers to.\n\nWhere can I find an official DHA farmhouse update?\nCheck the official website and verified social pages of the specific DHA city, and confirm by calling the official marketing or customer service office. Do not rely on forwarded images alone.\n\nAre DHA farmhouses a safe investment?\nNo investment is risk-free. DHA is a well-known name, but risks such as delays, extra charges and low resale demand still exist. Verify documents and read the official update before paying.\n\nHow long does it take to get possession of a DHA farmhouse?\nIt depends on the project and its development stage. Timelines can change, so ask for the current written timeline rather than relying on a past promise.\n\nCan a beginner buy a DHA farmhouse safely?\nYes, if you follow a process: set a budget, verify the source, check documents, visit the site and calculate the total cost. Avoid rushing.\n\nWhat is the biggest mistake beginners make?\nTrusting a verbal update. Always ask for the official notice, the date and the exact sector.\n\nShould I buy now or wait for the next update?\nThere is no universal answer. If the current update shows clear, verified progress and the price fits your budget, buying may make sense. If key details are missing, waiting is reasonable.\n\nKey Takeaways (Quick Summary)\nThe DHA Farmhouses Development Update Oct 2026 is only useful if it comes from an official source and names the sector, phase and progress.\nLearn the difference between booking, ballot, development, possession and construction.\nAlways build a total-cost sheet, not just a price comparison.\nRumours of launches are not launches.\nVisit the site, verify documents and pay only through official channels.\nFinal Words From My Ten Years in the Field\n\nEvery mistake I described in this guide came from one habit: trusting too quickly. The farmhouse market rewards patient people who verify. It punishes people who rely on excitement.\n\nSo when the next DHA Farmhouses Development Update Oct 2026 lands in your inbox or on your phone, slow down. Ask where it came from, check the date, confirm the sector and read the fine print. If it passes those tests, you have real information. If not, you have noise.","date":"","src":"https://youtu.be/jz_1ybJCb2Y?si=bm1IpvCQv4MOHDh4","pub":true,"tick":false,"home":true,"img":"/media/de2a889775e16068.webp","imgs":[]}],"vids":[{"slug":"dha-farmhouses-development-update-october-2026","title":" 𝐅𝐚𝐫𝐦𝐡𝐨𝐮𝐬𝐞 𝐃𝐞𝐯𝐞𝐥𝐨𝐩𝐦𝐞𝐧𝐭 𝐔𝐩𝐝𝐚𝐭𝐞-𝐎𝐜𝐭𝐨𝐛𝐞𝐫 𝟐𝟎𝟐𝟔","url":"https://youtu.be/jz_1ybJCb2Y?si=fjxjkfzVi26I70uR","desc":"# DHA Farmhouses Development Update: A Closer Look at Infrastructure and Site Progress\n\n**DHA Farmhouses Development Update | October 2026**\n\nDHA Farmhouses is presented in the latest development footage as a planned residential environment where land development, road infrastructure, and construction activities are taking shape. The October 2026 video provides an aerial perspective of the project, highlighting its layout, access roads, landscaped or planned open areas, and a prominent structure under construction.\n\nFor prospective buyers and people researching farmhouse properties, the footage offers a visual overview of the development and its evolving surroundings.\n\n## An Aerial View of the DHA Farmhouses Project\n\nThe video opens with aerial footage of an expansive development area featuring defined plots, road networks, and broad stretches of land. The layout provides a clearer perspective on how the site is organized and how different sections connect through internal roads.\n\nThese overhead views help viewers understand the physical scale of the development more effectively than ground-level images alone. They also show the relationship between the plotted areas, road corridors, and surrounding built-up locations.\n\nAs the project develops, further site updates can help interested buyers assess visible construction progress and the changing appearance of the area.\n\n## Road Infrastructure and Site Accessibility\n\nRoad development is one of the most noticeable features in the footage. Several internal roads and wider connecting routes can be seen running through the project area, with intersections and curved road sections defining the layout.\n\nA prominent roundabout featuring a tower-like landmark also appears in the video, serving as a recognizable feature of the development.\n\nRoad networks are an important consideration when evaluating any residential project. Their layout can help prospective buyers understand how different sections of a property development are connected. However, the video alone does not establish the completion status of every road, the quality of the road surfaces, or the availability of direct access to particular destinations.\n\n## Construction Activity and Development Progress\n\nAnother prominent scene shows a large steel-frame structure at an active construction site. The structure indicates that construction work is taking place at the location shown, although its intended use and completion schedule cannot be established from the footage alone.\n\nThe video also presents wide aerial views of plots and roads at different stages of visible development.\n\nTogether, these scenes provide a snapshot of the project's physical appearance at the time the footage was recorded. For anyone following DHA Farmhouses development updates, comparing future footage with earlier site views may help reveal changes in infrastructure and construction activity over time.\n\n## A Planned Residential Environment\n\nThe promotional footage presents DHA Farmhouses as a place designed around residential living. Its on-screen messaging emphasizes the idea of a desirable place to live and highlights a gated environment.\n\nThe plotted layout, internal road network, and open surroundings form the main visual elements of the presentation.\n\nFor prospective residents, important considerations extend beyond the appearance of the site. These include the availability of utilities, access arrangements, security operations, maintenance provisions, applicable development approvals, and the terms governing possession.\n\nSuch details should be verified through official project documentation rather than inferred from promotional imagery.\n\n## What Prospective Buyers Should Check\n\nAnyone considering a farmhouse property should review the project's current status and documentation before making a purchase decision.\n\nKey points to investigate include:\n\n- **Project location:** Confirm the exact location and access routes through official sources.\n- **Development status:** Request an up-to-date site report and clarification of which infrastructure components are complete.\n- **Legal documentation:** Verify applicable approvals, ownership records, and transfer requirements with the relevant authorities.\n- **Plot details:** Confirm plot dimensions, location, price, payment terms, and any additional charges directly with an authorized representative.\n- **Utilities and facilities:** Establish whether electricity, water, sewerage, and other promised services are available, under construction, or planned.\n- **Possession timeline:** Obtain written confirmation of applicable possession terms and expected dates.\n- **Security and maintenance:** Check the actual operating arrangements rather than relying solely on promotional descriptions.\n\nThese checks can help buyers make a more informed assessment of a property and distinguish current on-site conditions from future development plans.\n\n## DHA Farmhouses Development Update: October 2026\n\nThe October 2026 footage provides a visual snapshot of the development, featuring aerial views of plotted land, internal roads, a prominent roundabout, and an ongoing construction site.\n\nIts central theme is the changing physical landscape of the project and its presentation as a potential residential destination.\n\nFor readers tracking farmhouse developments, the most useful next step is to combine visual updates with verified information about project approvals, infrastructure completion, property availability, and possession conditions.\n\n**Conclusion**\n\nDHA Farmhouses is showcased in the video through its plotted layout, road infrastructure, construction activity, and gated-development presentation. These visual elements provide an overview of the site at the time of filming, while the project's precise legal status, available facilities, and delivery commitments require confirmation from official sources.\n\nProspective buyers should use the footage as an initial reference and conduct independent due diligence before making a property decision.\n\n---\n\n## Frequently Asked Questions\n\n### What does the DHA Farmhouses development update show?\n\nThe October 2026 video shows aerial views of plotted land, internal roads, a roundabout with a tower-like landmark, a gated-development setting, and a large structure under construction.\n\n### Is DHA Farmhouses currently under development?\n\nThe footage depicts construction activity and developed road layouts at the time it was recorded. The completion status of the entire project should be confirmed through an official, current development report.\n\n### What infrastructure is visible in the video?\n\nVisible features include internal roads, road intersections, plotted areas, a prominent roundabout, and a large steel-frame structure at a construction site.\n\n### Is DHA Farmhouses a gated residential development?\n\nThe video describes the project as having a gated and secure environment. The current operational status and specific security arrangements should be verified with the project's authorized management.\n\n### How can buyers verify DHA Farmhouses plot details?\n\nBuyers should contact an authorized representative and verify plot dimensions, location, pricing, payment terms, ownership documentation, applicable approvals, and possession conditions before proceeding.\n\n### Does the video confirm plot prices or possession dates?\n\nNo. The footage does not establish specific plot prices, payment plans, possession dates, or investment returns. These details require separate confirmation from reliable, authorized sources.\n\n---\n\n**Editorial note:** This article is based on the supplied video. Project-specific claims that cannot be established from the footage have been framed cautiously rather than presented as confirmed facts.\n","date":"","pub":true,"auto":false}],"vidNav":true,"gal":[],"galNav":true,"seo":{"tpl":"","desc":"Property listings, calculators and Newsflash updates for plot owners and buyers in Lahore, Islamabad and Multan.","og":"","ads":"","head":"<meta name=\"google-site-verification\" content=\"H5tD0hQw9TS2mCM7q5D0AgdmPaXJTpM7ZnQb4wmoE4Q\" />"},"banner":"","notes":[],"perf":{"lazyImg":true,"heroPreload":true,"heroVidMobile":false,"vidPreload":"metadata","pauseHidden":true,"preconnect":true,"edgeCache":60,"deferAds":false,"embedData":true,"sysFonts":false,"imgMaxW":1600,"imgQ":80,"imgFmt":"webp","vidMaxW":1280,"vidKbps":1500}}}