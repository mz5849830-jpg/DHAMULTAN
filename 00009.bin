plate's big spacing/height into the new line */\ndocument.addEventListener('keydown',e=>{\n const x=el(getSelection().anchorNode),c=x&&x.closest&&x.closest('.body,.hz,.aed');if(!c)return;\n if(e.key==='Tab'&&!e.ctrlKey&&!e.metaKey&&!e.altKey){e.preventDefault();document.execCommand('insertText',false,'\\t');if(c.classList.contains('body'))reflow();return}\n if(e.key==='Enter'&&!e.ctrlKey&&!e.metaKey&&!e.altKey){\n  const prev=x.closest('p,li,div');\n  setTimeout(()=>{const y=el(getSelection().anchorNode);let b=y&&y.closest&&y.closest('p,li,div');\n   if(!b||b===c||b===prev||!c.contains(b))return;\n   b.style.height='';b.style.minHeight='';\n   if(!b.dataset.ls)b.style.lineHeight='';\n   if(!b.getAttribute('style'))b.removeAttribute('style');\n   if(c.classList.contains('body'))reflow()},0)}\n},true);\nconst fl=$('#fl');\ndocument.addEventListener('mouseup',e=>{if(e.target.closest&&e.target.closest('#fl'))return;setTimeout(()=>{const s=getSelection();\n if(s.rangeCount&&!s.isCollapsed&&s.anchorNode.parentElement.closest('.body,.hz')){const r=s.getRangeAt(0).getBoundingClientRect();fl.style.display='flex';\n  fl.style.left=Math.max(4,Math.min(r.left,innerWidth-fl.offsetWidth-4))+'px';const t=r.top-fl.offsetHeight-6;fl.style.top=(t<4?r.bottom+6:t)+'px'}else fl.style.display='none'},10)});\nfl.onmousedown=e=>{if(!/SELECT|INPUT/.test(e.target.tagName))e.preventDefault()};\nconst setPt=pt=>{ex('fontSize',7);$$('font[size=\"7\"]').forEach(f=>{f.removeAttribute('size');f.style.fontSize=pt+'pt'});reflow()};\nfl.onclick=e=>{const b=e.target.closest('button');if(!b)return;\n if(b.dataset.c)ex(b.dataset.c);\n else if(b.dataset.g){const n=sel&&sel.startContainer;const x=n&&(n.nodeType==3?n.parentElement:n);if(!x)return;const pt=Math.round(parseFloat(getComputedStyle(x).fontSize)*.75),L2=[8,9,10,11,12,14,16,18,20,24,28,36,48,72];\n  setPt(+b.dataset.g>0?(L2.find(v=>v>pt)||pt):([...L2].reverse().find(v=>v<pt)||pt))}};\n$('#fff').onchange=e=>ex('fontName',e.target.value);\n$('#ffs').onchange=e=>setPt(e.target.value);\n$('#fhc').oninput=e=>ex('hiliteColor',e.target.value);\n$('#fcc').oninput=e=>ex('foreColor',e.target.value);\n$('#fls').onchange=e=>{applyLS(e.target.value);e.target.value=''};\n\n/* link text to a detail field */\nconst PRE={seller:'Seller',purch:'Purchaser',purch2:'Purchaser 2',behalf:'On behalf',dealer:'Dealer/C.E.O',donor:'Donor',donee:'Donee',investor:'Investor'};\nconst FO=GR.flatMap(([t,fs])=>fs.map(([k,l])=>[k,t.replace(/ Details$/,'').replace(/ \\(.*\\)$/,'')+' - '+l])).concat(PARTY.map(q=>[q+'_t',PRE[q]+' - Title (Mr./Mrs.)']));\nconst FOG=GR.map(([t,fs])=>{const o=fs.map(([k,l])=>[k,l.replace(/ \\(.*\\)/,'')]),m=/^(\\w+)_name$/.exec(fs[0][0]);if(m)o.push([m[1]+'_t','Title (Mr./Mrs.)']);return '<optgroup label=\"'+t+'\">'+o.map(([k,l])=>'<option value=\"'+k+'\">'+l+'</option>').join('')+'</optgroup>'}).join('');\nconst FOP='<div class=\"ltabs\">'+GR.map(([t],i)=>'<button type=\"button\" data-lt=\"'+i+'\"'+(i?'':' class=\"on\"')+'>'+t.replace(/ Details$/,'')+'</button>').join('')+'</div>'+GR.map(([t,fs],i)=>{const o=fs.map(([k,l])=>[k,l.replace(/ \\(.*\\)/,'')]),m=/^(\\w+)_name$/.exec(fs[0][0]);if(m)o.push([m[1]+'_t','Title (Mr./Mrs.)']);return '<div class=\"lgrp\" data-g=\"'+i+'\"'+(i?' hidden':'')+'>'+o.map(([k,l])=>'<button type=\"button\" data-lk=\"'+k+'\">'+l+'</button>').join('')+'</div>'}).join('');\nconst FOH=FO.map(([k,l])=>'<option value=\"'+k+'\">'+l+'</option>').join('');\ntb.insertAdjacentHTML('beforeend','<span class=\"sep\"></span><select id=\"lk\" title=\"Select text on a page, then choose the detail it should be linked to\"><option value=\"\">Link selected text to...</option>'+FOH+'</select>');\nfunction mkLink(k,txt,f){const u=/[A-Za-z]/.test(txt)&&txt===txt.toUpperCase()&&!/^(?:cnic|ref_no)/.test(k);const t=document.createElement('template');t.innerHTML='<span class=\"ph pf\" contenteditable=\"false\" data-k=\"'+k+'\" data-m=\"'+(u?'|u':'')+'\" style=\"'+phStyle(f)+'\"></span>';return t.content}\n$('#lk').onchange=e=>{const k=e.target.value;e.target.value='';if(!k)return;restore();const s=getSelection();\n if(!s.rangeCount||s.isCollapsed)return toast('First select some text on a page');\n const r=s.getRangeAt(0),x=el(r.commonAncestorContainer);if(!x||!x.closest||!x.closest('.body,.hz'))return toast('Select text inside a page');\n const t=r.toString(),f0=fmtOf(r.startContainer);r.deleteContents();r.insertNode(mkLink(k,t,f0));sync();toast('Linked to '+(FO.find(f=>f[0]==k)||[,k])[1])};\n$('#fr').insertAdjacentHTML('beforeend','<select id=\"fk\"><option value=\"\">Link found text to...</option>'+FOH+'</select><button id=\"fk2\">Link all matches on all pages</button>');\n$('#fk2').onclick=()=>{const q=$('#fi').value.trim(),k=$('#fk').value;if(!q||!k)return toast('Type the text in Find and choose a detail');\n const re=new RegExp(q.replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&').replace(/\\s+/g,'\\\\s+'),'gi');let c=0;\n $$('.body,.hz').forEach(b=>{const w=document.createTreeWalker(b,NodeFilter.SHOW_TEXT),ns=[];while(w.nextNode())ns.push(w.currentNode);\n  ns.forEach(n=>{if(n.parentElement.closest('.ph'))return;const v=n.nodeValue;re.lastIndex=0;if(!re.test(v))return;re.lastIndex=0;\n   const f=document.createDocumentFragment();let last=0,m;while((m=re.exec(v))){if(m[0]==='')break;f.append(v.slice(last,m.index));f.append(mkLink(k,m[0],fmtOf(n)));last=m.index+m[0].length;c++}f.append(v.slice(last));n.replaceWith(f)})});\n sync();toast(c+' linked');};\n\n/* find & replace */\nconst fr=$('#fr');\nfunction openFr(){fr.style.display='flex';$('#fi').focus()}\n$('#fx').onclick=()=>fr.style.display='none';\n$('#fn').onclick=()=>{if(!window.find($('#fi').value,false,false,true))toast('Not found')};\n$('#fa').onclick=()=>{\n const q=$('#fi').value;if(!q)return;const re=new RegExp(q.replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&'),'gi');let c=0;\n $$('.body,.hz').forEach(b=>{const w=document.createTreeWalker(b,NodeFilter.SHOW_TEXT),ns=[];while(w.nextNode())ns.push(w.currentNode);\n  ns.forEach(n=>{if(n.parentElement.closest('.ph'))return;const t=n.nodeValue.replace(re,()=>{c++;return $('#ri').value});if(t!==n.nodeValue)n.nodeValue=t})});\n toast(c+' replaced');reflow();\n};\n\n/* print (options appear after Print command) */\n$('#pcol').onchange=()=>$('#pages').classList.toggle('gray',$('#pcol').value==='bw');\nfunction doPrint(){\n if(!SELC.size){toast('Select a Document Category first, then choose what to print');$('#catbox').scrollIntoView({block:'center'});setTimeout(()=>{$('#catMenu').classList.add('open');$('#catBtn').setAttribute('aria-expanded','true')},0);return}\n const n=visPages().length,names=CATS.filter(([k])=>SELC.has(k)).map(c=>c[1]);\n if(!n)return toast('The selected category has no pages to print');\n $('#pinfo').textContent='Category: '+names.join(', ')+' - '+n+' page'+(n==1?'':'s')+'. Page numbers below count within this category only.';$('#psz').textContent='Paper size (set from Admin): '+[...new Set(visPages().map(p=>p.dataset.szn))].join(', ');$('#pm').style.display='flex'}\n$('#pcx').onclick=()=>$('#pm').style.display='none';\n$('#pgo').onclick=()=>{\n if(!SELC.size)return toast('Select a Document Category first');szCss();const pgs=visPages(),v=document.querySelector('[name=pr]:checked').value;let keep=[];\n if(v==='all')keep=pgs.map((_,i)=>i);\n else if(v==='cur')keep=[pgs.indexOf(curPage())];\n else $('#pcs').value.split(',').forEach(x=>{const m=x.trim().match(/^(\\d+)(?:\\s*-\\s*(\\d+))?$/);if(m)for(let i=+m[1];i<=+(m[2]||m[1]);i++)keep.push(i-1)});\n keep=keep.filter(i=>i>=0&&i<pgs.length);\n if(!keep.length)return toast(pgs.length?'No valid pages selected':'No pages to print - select a category that has pages');\n $$('.page').forEach(p=>{const i=pgs.indexOf(p);p.classList.toggle('skip',i<0||!keep.includes(i))});\n $('#pm').style.display='none';toast('In the printer dialog choose \"'+$('#ptype').value+'\" paper'+($('#pcol').value==='bw'?' and Color: Black and white':''));\n setTimeout(()=>window.print(),400);\n};\naddEventListener('afterprint',()=>$$('.page').forEach(p=>p.classList.remove('skip')));\n\n/* sample pages: the 10 pages of the reference PDF, inserted automatically (values come from the green details) */\nconst esc=t=>t.replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nconst fill=(s,pf)=>s.replace(/\\{(\\w+)((?:\\|\\w)*)\\}/g,(m,k,mo)=>L[k]?`<span class=\"ph${mo.includes('|p')?' pl':''}${pf?' pf':''}\" contenteditable=\"false\" data-k=\"${k}\" data-m=\"${mo}\"${pf?` style=\"font-weight:${pf.b?700:400};text-decoration:${pf.u?'underline':'none'}\"`:''}></span>`:m);\nfunction toHTML(x){return x.split('\\n').map(l=>{\n if(!l.trim())return'<p><br></p>';\n if(l[0]==='!')return fill(l.slice(1));\n const h=l.match(/^#([cbnltd]) (.*)$/);\n if(h)return`<p class=\"${{c:'c',b:'cb',n:'cn',l:'lb',t:'lt',d:'dp'}[h[1]]}\">${fill(esc(h[2]))}</p>`;\n const li=l.match(/^(\\d+|[a-z])\\. (.*)$/);\n if(li)return`<p class=\"li\"><span class=\"nn\">${li[1]}.</span>${fill(esc(li[2]))}</p>`;\n return`<p>${fill(esc(l))}</p>`}).join('')}\nconst CAL='Calibri,Carlito,\"Segoe UI\",Arial,sans-serif',TNR='\"Times New Roman\",Tinos,Times,serif';\nconst PG=[\n/* 1 */{top:5.79,f:CAL,lh:1.22,t:`#c Undertaking / Affidavit\n#c By The Seller\n\nI, {seller_name} having C.N.I.C No. {seller_cnic} {seller_rel} {seller_relname} Adult, Resident of {seller_res} in possession of my full faculties and senses and of my free will and without any coercion or duress, do hereby solemnly affirm and declare as under:-\n\n1. That I am bona fide member of DHA, Lahore – Multan Chapter vide Registration No. {ref_no} dated __________ and I was Allotted / Transferred a plot of land bearing No. {ref_no} Plot No. {plot_no} Sector {sector} measuring {measuring} {category} situated in DHA Multan.\n2. That by, virtue of the provisions of the law no. 17 of the Authority, I hereby return the original allotment letter no. {ref_no} Dated _________ for cancellation which I have sold to {purch_t} {purch_name} {purch_rel} {purch_relname} having C.N.I.C No. {purch_cnic} Resident of {purch_res} Registered Member of the Authority vide Registration No. {ref_no}. Total sale price of the said plot has been received by me from purchaser and nothing outstands against the Purchaser.\n3. That, having relinquished the said plot to the Defence Housing Authority for further allotment to {purch_t} {purch_name} {purch_rel} {purch_relname} and the possession of the plot be handed over to the said {purch_name} conferring exclusive ownership right possession of the plot upon the above said Transferee / purchaser.\n4. That I affirm and declare that the name of {purch_t} {purch_name} should be entered in the records of the DHA Lahore – Multan Chapter as the owner of the aforesaid property.\n5. That I solemnly declare that I have no right, title or interest in the said property and {purch_t} {purch_name} is the exclusive owner of the same since ______________.\n6. That I further affirm and declare that neither I have entered into an agreement for the sale of plot in question with any other person except the above said purchaser nor any suit is presently pending in any court of competent jurisdiction and no stay order is operative against the said plot. Furthermore said plot is free from all encumbrances. In the event the above statement is found to be false, incorrect or untrue, the deponent shall pay the entire sale consideration with profit etc, to the purchaser.\n7. That I have deposited Advance Tax on DC Value rate on transfer/transfer allocation of above mentioned plot/ file`},\n/* 2 */{top:5.74,f:CAL,lh:1.22,t:`8. That I do hereby undertake to pay any additional amount/taxes related to me as seller imposed as a result of any variation in Dc value or any revision in rates by Govt of Punjab/ Pakistan and DHA Lahore Multan Chapter.\n9. That whatever is stated above is true to the best of my own knowledge and belief.\n10. Reference No. {ref_no} Plot No. {plot_no} Sector {sector} Measuring {measuring} {category} in DHA Multan.\n\n#d DEPONENT\n\n\n#l Verification\n\nVerified on Oath at ____________, this _______________ day of ________________, that the contents of above undertaking/ affidavit are true and correct to the best of my knowledge, information and belief, and that nothing has been concealed therein.\n\n#d DEPONENT\n\n\n#l Certification\n\n!<p class=\"lt\" style=\"line-height:2.2\">I          Mr._________________________________                     S/O__________________________________</p>\n!<p class=\"lt\" style=\"line-height:2.2\">CNIC#_______________________R/O__________________________________________________________</p>\n!<p style=\"line-height:2.2\">______________ hereby certify that the seller {seller_t} {seller_name} {seller_rel} {seller_relname} is personally known to me.</p>\n\n#l Identifier\n\n#t _____________________`},\n/* 3 */{top:6.44,f:CAL,lh:1.22,t:`#c Undertaking / Affidavit\n#c By Purchaser\n\nI, {purch_name} having C.N.I.C No. {purch_cnic} {purch_rel} {purch_relname} Resident of {purch_res} Possession of my full faculties and senses and of my free will and without any coercion or duress, do hereby solemnly affirm, undertake & declare as under:-\n\n1. That I have purchased an Allocation Letter No. {ref_no}, Plot No. {plot_no} Sector {sector} Measuring {measuring} {category} situated at Defence Housing Authority Lahore – Multan Chapter vide Application Form No {ref_no} which is being transferred in my name.\n2. That I the Purchaser Undertake That the Development charges of the above mentioned plot will be paid by me to D.H.A Multan. Further affirm that I agree to pay the variation in Development Charges and plot size on demand.\n3. I will not make any addition / alteration in the building so purchased without prior approval from the Engineering Branch of the Authority. In case any change / Shifting of Electric Poles, Telephone Poles and manhole etc are necessitated as per my requirement, it will be done at my risk and cost, if feasible.\n4. I shall not convert the property to different use(s) or purposes(s)other than that provided or permitted under the regulations.\n5. That I do hereby undertake to pay any additional amount / taxes related to Stamp Duty, CVT, Advanced Tax, Tax immovable Property, Capital Gain Tax / Withholding Tax if accrue as a result of any change in Dc value at later stage or otherwise.\n6. That I am also bound to make the payment of all taxes whatever are imposed by the Government of Punjab / Pakistan and DHA Lahore – Multan Chapter.\n7. I am also bound for Payment of a/m Taxes which are to be paid by the seller or purchaser.\n8. I will ensure that Plot / House Tax / Other dues due to the Govt / DHA Lahore – Multan Chapter have been paid. I Shall not default or fail in payment of taxes and other duties of Central / Provincial Government.\n9. I undertake to pay for any Variation in plot area.\n10. I hereby undertake to abide by all rules, regulations / bye laws of the Defence Housing Authority.\n11. I shall not damage the interest of the Authority and my act or omission shall not be detrimental to the aims and objectives as well as the reputation of the authority.\n12. I shall obey the decision made or instruction issued by the Authority`},\n/* 4 */{top:5.61,f:CAL,lh:1.22,t:`13. I shall not involve in violation of Authority’s Rules or Regulations.\n14. I shall not involve in frivolous litigations with the Authority.\n15. I shall not misuse the dwelling or habitually act in an ungraceful manner or the manner which may cause serious nuisance to my neighbors.\n16. I further undertake I will submit transfer papers at DHA Reception within 30 days from the date of transfer letter in my name, if I fail to do so I would be liable to pay the fine / penalty for late submission as per DHA procedure.\n17. In case of possession of plot, I shall construct the building as per DHA Bye-laws/ Policy, failing which I will pay non constructions penalty as applicable.\n18. My specimen signatures are as under:-\n!<p style=\"height:1in\"></p>\n#t Signature:     __________________            __________________             __________________\n\n#t Name: {purch_name} {purch_rel} {purch_relname}\n\n#t Plot no. {plot_no} Sector {sector} Reference # {ref_no} measuring {measuring} {category}\n\n#t Date: __________________\n\n#d DEPONENT\n\n\n#l Verification\n\nVerified on Oath at ______________, this____________ day of __________, that the contents of above undertaking / affidavit are true and correct to the best of my knowledge, information and belief, and that nothing has been concealed therein.\n\n\n#d DEPONENT`},\n/* 5 */{top:5.26,f:TNR,lh:1.5,t:`#c AFFIDAVIT\n#c UNDERTAKING PURCHASER OUTSTATION\n{behalf_name|u} {behalf_rel} {behalf_relname|u} Having CNIC# {behalf_cnic} resident of {behalf_res|u}. On behalf of Mr./Mrs. {purch_name} {purch_rel} {purch_relname} Having CNIC# {purch_cnic} resident of {purch_res} do hereby solemnly affirm and declare as under:-\n\nI Mr./Mrs. {purch_name} {purch_rel} {purch_relname} do have purchased the plot of land bearing no {ref_no} Sector {sector} Plot no. {plot_no} measuring {measuring|u} {category|u} Defence Housing Authority, Lahore-Multan chapter from {seller_name|u} {seller_rel} {seller_relname|u} having C.N.I.C No {seller_cnic} undertake that original purchaser of above mentioned plot is presently not in Multan due to his commitments, so he cannot sign the transfer papers regarding the above mentioned plot / VILLA in DHA office.\n\n1. I also assure you and undertake {purch_name} {purch_rel} {purch_relname} sign all the necessary documents about transfer of said plot in your office, whenever he comes to Multan .\n2. I further undertake that seller and purchaser are themselves responsible for the sale price of the said plot and will not claim DHA in case of any dispute if arises between seller and purchaser .\n\nThat whatever is stated above is true to the best of my knowledge and belief.\n\n\n\n#d DEPONENT`},\n/* 6 */{top:4.93,f:TNR,lh:1.5,t:`#c AFFIDAVIT\n#c (REPRESENTATIVE OF PURCHASER)\n{behalf_name|u} {behalf_rel} {behalf_relname|u} Having CNIC# {behalf_cnic} resident of {behalf_res|u}. On behalf of I Mr./Mrs. {purch_name} {purch_rel} {purch_relname|u} Having CNIC# {purch_cnic} resident of {purch_res|u} have purchased the plot of land bearing {ref_no} Sector {sector} Plot no. {plot_no} measuring {measuring|u} {category|u} Defence Housing Authority, Lahore-Multan possession of my full faculties and senses and of my free coercion or duress, do hereby solemnly affirm and declare as under:-\n\nSeller {seller_name|u} having C.N.I.C No.{seller_cnic} {seller_rel} {seller_relname|u} Adult, Resident of {seller_res}\n\n1. That I undertake the responsibility that purchaser will pay any of the new taxes or any variation in already existing taxes as introduced by the GOVT in the budget for financial year ___________.\n\n2. That I undertake the responsibility that purchaser will pay a/m taxes which are to be paid by the seller or purchaser.\n\n\n#d DEPONENT`},\n/* 7 */{top:4.93,f:CAL,lh:1.22,t:`#c UNDERTAKING BY DEALERS\n______________________ S/O ______________________ CNIC# ______________________ R/O ______________________ On behalf of I Mr./Mrs. {purch_name|u} {purch_rel} {purch_relname|u} Having CNIC# {purch_cnic} resident of {purch_res|u} have purchased the plot of land bearing no {ref_no} Sector {sector} Plot no. {plot_no} measuring {measuring|u} {category|u} Defence Housing Authority, Lahore-Multan chapter from {seller_name|u} {seller_rel} {seller_relname|u} having C.N.I.C No {seller_cnic} do hereby solemnly affirm and declare as under :\na. I Undertake that the original Purchaser of above mentioned plot is presently not in Pakistan /Multan due to his commitments. I am responsible for further any action and dues of above mention plot file to transfer, buyer signature and thumb .If I and my purchaser not followed above commitment DHA Multan has authority takes any legal action against Ref # {ref_no} and me .Moreover full payment of said file has been transferred to actual seller and I am responsible for any discrepancies later on.\n\n\n\n\n#d DEPONENT\n\n#l Verification\n\n      Verified on Oath at Multan this________ ______day of___ _______________,that the contents of above affidavit are true and correct to the best of my knowledge, information and belief, and that nothing has been concealed therein\n\n\n\n#d DEPONENT`},\n/* 8 */{top:5.58,f:CAL,lh:1.5,t:`!<p class=\"cb\" style=\"font-size:16pt\">Authority Letter</p>\nI, {purch_name|u} {purch_rel} {purch_relname|u} Having CNIC# {purch_cnic} resident of {purch_res|u} Registration /Reference {ref_no} Plot No {plot_no} Sector {sector} Measuring {measuring|u} {category|u}. I grant authority to {behalf_name|u} {behalf_rel} {behalf_relname|u} having C.N.I.C No {behalf_cnic} Resident of {behalf_res|u} to perform transfer procedure at DHA Multan Site Office .I am out of CITY and can’t come for transfer procedure.\n!<p style=\"height:1.5in\"></p>\n#n ________________            ____________________           __________________\n!<p style=\"height:.9in\"></p>\n!<div style=\"margin-left:4.9in;font-weight:700\">__________________<br><br>Regards<br>{purch_name|u|n}</div>`},\n/* 9 */{top:6.01,f:CAL,lh:1.22,t:`#n AGREEMENT TO SELL A PLOT\n#n For Plot No. {plot_no}, Sector {sector}, File Ref No. {ref_no}, Category {measuring|p} {category|p}\n#n DEFENCE HOUSING AUTHORITY (DHA), MULTAN.\nBy this Deed of Agreement made on Date ______________\n#b BETWEEN\n{seller_t} {seller_name} {seller_rel} {seller_relname} CNIC No. {seller_cnic} Resident of {seller_res}, hereinafter called “SELLER” First Party.\n#b AND\n{purch_t} {purch_name} {purch_rel} {purch_relname} CNIC No. {purch_cnic} Resident of {purch_res}, hereinafter called “PURCHASER” Second Party.\n1. That the SELLER affirms that he is the owner of the Plot No. {plot_no}, Sector {sector}, Category {measuring|p} {category|p} situated in Defence Housing Authority (DHA), Multan vide File Ref No {ref_no}.\n\n2. That the SELLER further affirms and confirm that the said Plot is free from all encumbrance, charges, dues and litigation of all sorts and there is no loan against the said property.\n\n3. That the SELLER will make himself available and sign all documents which he is called upon to sign by DHA or Purchaser or in any other Office in future, in connection with transfer of above said Plot in favor of the Purchaser or any of his nominees.\n!<p style=\"height:1.4in\"></p>\n!<div class=\"sg\"><div>__________________________<br>Signature &amp; Thumb Impression<br>(SELLER)</div><div>__________________________<br>Signature &amp; Thumb Impression<br>(PURCHASER)</div></div>`},\n/* 10 */{top:.74,f:CAL,lh:1.22,t:`4. All expenses regarding Transfer i.e. Transfer Fee, Membership Fee, CVT and Stamp Duty in respect of the said plot shall be borne by PURCHASER. Capital Gain Tax and Development Charges (to date) will be paid by SELLER.\n\n5. SELLER is selling and PURCHASER is purchasing the above said Plot at total price of ______________________________ vide Bankers Cheque No. ______________ dated ______________ of ______________________ in favor of “{seller_name}” received from PURCHASER as Total Receipt which is hereby acknowledged by SELLER and there is no remaining amount of said Plot.\n\n6. That the seller will be responsible to clear all the dues of the said property i.e. Cost of Land, Additional Development Charges, land Charges, Non Utilization Charges, Debris Charges, Security Charges and Surcharges imposed by the Authority if any and other surcharges etc. of the said PLOT on or before due date of transfer.\n\n7. SELLER is bound to PURCHASER about original Allocation Letter and SELLER will not apply for Duplicate Allocation Letter in DHA Multan Office.\n\n8. That the terms “Seller” and “Purchaser” hereinbefore used shall include their respective heirs, legal representative, successors, assignees and nominees.\n\nIn WITNESS WHEREOF, the Parties have signed this Deed on the date mentioned above.\n!<p style=\"height:1.5in\"></p>\n!<div class=\"sg\"><div>__________________________<br>Signature &amp; Thumb Impression<br>(SELLER)</div><div>__________________________<br>Signature &amp; Thumb Impression<br>(PURCHASER)</div></div>\n!<p style=\"height:.3in\"></p>\n!<div class=\"sg\"><div style=\"text-align:left;width:42%\">NAME: {seller_name}<br>{seller_rel} {seller_relname}<br>CNIC No. {seller_cnic}</div><div style=\"text-align:left;width:42%\">NAME: {purch_name}<br>{purch_rel} {purch_relname}<br>CNIC No. {purch_cnic}</div></div>\n!<p style=\"height:.9in\"></p>\n!<div class=\"sg\" style=\"justify-content:space-between;text-align:left\"><div style=\"width:44%\">WITNESS No.1<br><br>Signature:_____________________<br><br>NAME:_____________________<br><br>S/O_____________________<br><br>CNIC No.______________</div><div style=\"width:44%\">WITNESS No.2<br><br>Signature:_____________________<br><br>NAME:  _____________________<br><br>S/O  ___________________<br><br>CNIC No. ________________</div></div>`},\n];\nfunction setPage(p,g){const b=p.querySelector('.body');b.innerHTML=g.html!=null?g.html:toHTML(g.t);\n b.style.paddingTop='';g.ml!=null?p.style.setProperty('--ml',g.ml+'in'):p.style.removeProperty('--ml');g.mr!=null?p.style.setProperty('--mr',g.mr+'in'):p.style.removeProperty('--mr');g.tm!=null?p.style.setProperty('--lock',g.tm+'in'):p.style.removeProperty('--lock');if(g.fs)b.style.fontSize=g.fs+'pt';if(g.f)b.style.fontFamily=g.f;if(g.lh)b.style.lineHeight=g.lh;lockPage(p)}\nfunction stored(){try{return JSON.parse(localStorage.getItem('pdt_pages'))}catch(e){return null}}\nfunction builtin(){return PG.map((g,i)=>{const{t,...meta}=g;return{id:'t'+i,tid:i,title:'',html:toHTML(t),meta}})}\nfunction getList(){const s=stored(),P0=window.PDT_PRESET;return Array.isArray(s)&&s.length?ensureIds(s):(P0&&Array.isArray(P0.pages)&&P0.pages.length?ensureIds(JSON.parse(JSON.stringify(P0.pages))):builtin())}\nfunction clearZone(p){const z=p.querySelector('.zone');z.querySelectorAll('canvas,img').forEach(x=>x.remove());z.classList.add('empty');p.classList.remove('has-doc','rz');['.rs','.rr','.tx'].forEach(q=>p.querySelector(q).hidden=true);p.querySelector('.ub').textContent='\\u2B06 Upload PDF / JPG / PNG';p._txt=null;p._rs=null}\nfunction loadEntry(p,e){clearZone(p);p.dataset.pid=e.id||'';p.dataset.cats=(e.cats||[]).join(',');szPage(p,e.meta);setPage(p,{...e.meta,html:e.html});if(e.img){const i=new Image();i.src=e.img;setZone(p,i)}}\nfunction build(){try{localStorage.removeItem('pdt_doc')}catch(e){}$('#pages').innerHTML='';SAVED.forEach(e=>{const p=mk();loadEntry(p,e)});sync();applyCat();const f=$('.page:not(.coff) .body');if(f)f.scrollTop=0}\n\nlet LK=new Set();\nconst ESC=v=>v.replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&');\nfunction link(t){\n const E=Object.entries(D).filter(([k,v])=>v&&v.trim()&&L[k]&&!/_rel$/.test(k)&&!/_t$/.test(k)).map(([k,v])=>[k,v.trim()]);\n const LAB={plot_no:'plot\\\\s*(?:no\\\\.?|number|#)?',sector:'sector',ref_no:'(?:ref(?:erence)?|reg(?:istration)?|file|application\\\\s*form)\\\\.?\\\\s*(?:no\\\\.?|#)?'};\n E.forEach(([k,v])=>{if(v.length<3&&LAB[k])t=t.replace(new RegExp('(\\\\b'+LAB[k]+'\\\\s*[:\\\\-]?\\\\s*)'+ESC(v)+'(?![\\\\w}])','gi'),(m,a)=>{LK.add(k);return a+'{'+k+'}'})});\n const G=E.filter(([k,v])=>v.length>2).sort((a,b)=>b[1].length-a[1].length).map(([k,v])=>{\n  const src=k.endsWith('_cnic')&&/^[\\d\\-\\s]+$/.test(v)?v.replace(/\\D/g,'').split('').join('-?'):ESC(v).replace(/\\s+/g,'\\\\s+');\n  return{k,v,src:(/^\\w/.test(v)?'(?<!\\\\w)':'')+src+(/\\w$/.test(v)?'(?!\\\\w)':'')}});\n if(G.length)t=t.replace(new RegExp('\\\\{\\\\w+(?:\\\\|\\\\w)*\\\\}|'+G.map(x=>'('+x.src+')').join('|'),'gi'),(m,...a)=>{\n  if(m[0]==='{')return m;const g=G[a.slice(0,G.length).findIndex(x=>x!==undefined)];if(!g)return m;\n  LK.add(g.k);return'{'+g.k+(m===m.toUpperCase()&&m!==m.toLowerCase()&&g.v!==g.v.toUpperCase()?'|u':'')+'}'});\n t=t.replace(/(\\{(\\w+?)_name(?:\\|\\w)*\\})([\\s,]*)(S\\/O|D\\/O|W\\/O|F\\/O|M\\/O|H\\/O|son of|daughter of|wife of|father of|mother of|husband of|guardian|widow of|representative of)([\\s,]*)(?=\\{\\2_relname)/gi,(m,a,p,s1,r,s2)=>{LK.add(p+'_rel');return a+s1+'{'+p+'_rel}'+s2});\n t=t.replace(/\\b(?:Mr|Mrs|Miss|Ms)\\.?(?:\\/(?:Mr|Mrs|Miss|Ms)\\.?)?(\\s*)(?=\\{(\\w+?)_name)/gi,(m,sp,p)=>{LK.add(p+'_t');return'{'+p+'_t}'+sp});\n return t}\nconst med=a=>{a=[...a].sort((x,y)=>x-y);return a.length?a[a.length>>1]:0};\n/* read a sample PDF keeping its layout: margins, centred headings, numbering, blank lines, bold, font size */\n/* find underlines drawn in the PDF (thin lines / thin filled rectangles) so they can be matched to text */\nasync function pdfUL(pg){\n const O=pdfjsLib.OPS,segs=[];let ol;try{ol=await pg.getOperatorList()}catch(e){return segs}\n const mul=(a,b)=>[a[0]*b[0]+a[1]*b[2],a[0]*b[1]+a[1]*b[3],a[2]*b[0]+a[3]*b[2],a[2]*b[1]+a[3]*b[3],a[4]*b[0]+a[5]*b[2]+b[4],a[4]*b[1]+a[5]*b[3]+b[5]];\n let m=[1,0,0,1,0,0];const stk=[];let pend=[];\n const P=(x,y)=>[m[0]*x+m[2]*y+m[4],m[1]*x+m[3]*y+m[5]];\n const PT=[O.stroke,O.closeStroke,O.fill,O.eoFill,O.fillStroke,O.eoFillStroke,O.closeFillStroke,O.closeEOFillStroke].filter(x=>x!==undefined);\n const add=(p,q)=>{if(Math.abs(p[1]-q[1])<2.5&&Math.abs(p[0]-q[0])>2)pend.push({x1:Math.min(p[0],q[0]),x2:Math.max(p[0],q[0]),y:(p[1]+q[1])/2})};\n ol.fnArray.forEach((fn,i)=>{const a=ol.argsArray[i];\n  if(fn===O.save)stk.push(m);\n  else if(fn===O.restore){if(stk.length)m=stk.pop()}\n  else if(fn===O.transform)m=mul(a,m);\n  else if(fn===O.paintFormXObjectBegin){stk.push(m);if(a&&a[0])m=mul(a[0],m)}\n  else if(fn===O.paintFormXObjectEnd){if(stk.length)m=stk.pop()}\n  else if(fn===O.constructPath){const ops=a[0],c=a[1];let k=0,cx=0,cy=0;\n   ops.forEach(o=>{\n    if(o===O.moveTo){cx=c[k];cy=c[k+1];k+=2}\n    else if(o===O.lineTo){const x=c[k],y=c[k+1];k+=2;add(P(cx,cy),P(x,y));cx=x;cy=y}\n    else if(o===O.curveTo)k+=6;\n    else if(o===O.curveTo2||o===O.curveTo3)k+=4;\n    else if(o===O.rectangle){const x=c[k],y=c[k+1],w=c[k+2],h=c[k+3];k+=4;add(P(x,y),P(x+w,y+h))}\n   })}\n  else if(PT.includes(fn)){segs.push(...pend);pend=[]}\n  else if(fn===O.endPath)pend=[];\n });\n return segs}\n/* read a sample PDF keeping its layout AND its character formatting (bold / italic / underline per word), margins, centred headings, numbering, blank lines, font size */\nasync function pdfPage(pg){\n  await pdfInit();\n  const vp=pg.getViewport({scale:1}),W=vp.width,H=vp.height,tc=await pg.getTextContent(),fc={};\n  let ul=[];try{ul=await pdfUL(pg)}catch(e){console.error(e)}\n  const ids=[...new Set(tc.items.map(i=>i.fontName).filter(Boolean))],FI={};\n  await Promise.all(ids.map(id=>new Promise(res=>{let done=0;const fin=v=>{if(!done){done=1;FI[id]=v;res()}};setTimeout(()=>fin(null),1500);try{pg.commonObjs.get(id,fin)}catch(e){fin(null)}})));\n  const fo=id=>fc[id]||(fc[id]=(()=>{const o={b:false,i:false,serif:false},ft=FI[id],st=tc.styles[id]||{};\n   if(ft){const nm=(ft.name||'')+' '+(ft.fallbackName||'')+' '+(ft.loadedName||'');o.b=/bold|black|heavy|demi|semibd|[-,_ ]bd\\b/i.test(nm)||!!ft.bold||!!ft.black||+ft.weight>=600;o.i=/italic|oblique|[-,_ ]it\\b/i.test(nm)||!!ft.italic;o.serif=/times|serif|georgia|garamond|cambria|book|roman/i.test(nm)&&!/sans/i.test(nm)}\n   else o.serif=/serif/.test(st.fontFamily||'')&&!/sans/.test(st.fontFamily||'');return o})());\n  const isU=(x,y,w,h)=>w>0&&ul.some(s=>{const d=y-s.y;return d>=-.03*h&&d<=.3*h&&Math.min(s.x2,x+w)-Math.max(s.x1,x)>=w*.6});\n  const its=tc.items.filter(i=>typeof i.str==='string'&&i.str!=='').map(i=>{const h=Math.abs(i.transform[3])||i.height||10;return{s:i.str,x:i.transform[4],y:i.transform[5],w:i.width,h,fid:i.fontName,f:fo(i.fontName),u:isU(i.transform[4],i.transform[5],i.width,h)}}).sort((a,b)=>b.y-a.y||a.x-b.x);\n  {const st={};its.forEach(it=>{const n=it.s.trim().length;if(n>1&&it.w>0&&it.h>0){const q=st[it.fid]||(st[it.fid]={c:0,r:0,f:it.f});q.c+=n;q.r+=it.w/it.h}});\n   const L2=Object.values(st).filter(q=>q.c>=4).map(q=>({...q,a:q.r/q.c})).sort((a,b)=>b.c-a.c),base=L2.find(q=>!q.f.b&&!q.f.i);\n   if(base)L2.forEach(q=>{if(q!==base&&!q.f.b&&!q.f.i&&q.f.serif===base.f.serif&&q.a>base.a*1.06)q.f.b=true})}\n  const rows=[];its.forEach(it=>{const r=rows[rows.length-1];if(r&&Math.abs(it.y-r.y)<=Math.max(2,it.h*.4))r.a.push(it);else rows.push({y:it.y,a:[it]})});\n  const lines=rows.map(r=>{r.a.sort((p,q)=>p.x-q.x);const runs=[];let pe=null,le=0,bc=0,tl=0,fs=0,sr=0,pf=null;\n   const add=(s,f)=>{if(!s)return;const l=runs[runs.length-1];if(l&&l.b===f.b&&l.u===f.u&&l.i===f.i)l.s+=s;else runs.push({s,b:f.b,u:f.u,i:f.i})};\n   r.a.forEach(it=>{const fm={b:!!it.f.b,u:!!it.u,i:!!it.f.i};\n    if(!it.s.trim()){if(pe!==null){add(' '.repeat(Math.min(40,Math.max(1,Math.round(it.w/(it.h*.28))))),{b:pf?pf.b:fm.b,i:pf?pf.i:fm.i,u:fm.u});pe=it.x+it.w}return}\n    if(pe!==null){const gap=it.x-pe;let sp=gap>it.h*.12?Math.max(1,Math.round(gap/(it.h*.28))):0;const lr=runs.length?runs[runs.length-1].s:'';if(/\\s$/.test(lr))sp=Math.max(0,sp-1);if(/^\\s/.test(it.s))sp=Math.max(0,sp-1);\n     if(sp)add(' '.repeat(Math.min(sp,40)),pf?{b:pf.b&&fm.b,i:pf.i&&fm.i,u:pf.u&&fm.u}:fm)}\n    add(it.s,fm);pf=fm;pe=it.x+it.w;le=pe;const l=it.s.trim().length;tl+=l;if(fm.b)bc+=l;if(it.f.serif)sr+=l;if(it.h>fs)fs=it.h});\n   while(runs.length&&!runs[runs.length-1].s.trim())runs.pop();\n   if(runs.length)runs[runs.length-1].s=runs[runs.length-1].s.replace(/\\s+$/,'');\n   const s=runs.map(x=>x.s).join('');\n   return{y:r.y,x0:(r.a.find(z=>z.s.trim())||r.a[0]).x,x1:le,fs,runs,s,b:tl>0&&bc/tl>.6,serif:tl>0&&sr/tl>.5}}).filter(l=>l.s.trim());\n  if(!lines.length)return{text:'',meta:{}};\n  const fm=med(lines.map(l=>l.fs))||11,diffs=[];for(let i=1;i<lines.length;i++){const d=lines[i-1].y-lines[i].y;if(d>0)diffs.push(d)}\n  const sm=diffs.filter(d=>d<fm*2.2),pitch=med(sm.length?sm:diffs)||fm*1.2,lh=Math.min(2.2,Math.max(1.1,pitch/fm));\n  const bd=lines.filter(l=>l.s.length>25),ref=bd.length?bd:lines,minX=Math.min(...ref.map(l=>l.x0)),maxX=Math.max(...ref.map(l=>l.x1)),wd=Math.max(1,maxX-minX);\n  const out=[];let prev=null,cur=null;const flush=()=>{if(cur){out.push(cur);cur=null}};\n  lines.forEach(l=>{\n   const ctr=Math.abs((l.x0+l.x1)/2-W/2)<W*.04&&l.x0-minX>wd*.04&&l.x1-l.x0<wd*.9;\n   const rgt=!ctr&&l.x0-minX>wd*.5&&l.s.length<30;\n   const num=!ctr&&!rgt&&/^(\\d{1,2}|[a-z])[.)]\\s+/.test(l.s);\n   const gap=prev?(prev.y-l.y)/pitch:0,full=prev&&prev.x1>=maxX-wd*.06;\n   if(prev&&gap>1.5){flush();const k=Math.min(6,Math.round(gap)-1);for(let i=0;i<k;i++)out.push({blank:1})}\n   if(cur&&!ctr&&!rgt&&!num&&full&&gap<=1.5&&!prev.ctr&&!prev.rgt&&!cur.hd&&!cur.sp){\n    const a=cur.runs[cur.runs.length-1],b=l.runs[0];cur.runs.push({s:' ',b:a.b&&b.b,u:a.u&&b.u,i:a.i&&b.i});l.runs.forEach(r=>cur.runs.push({...r}));cur.t+=' '+l.s.trim()}\n   else{flush();cur={t:l.s,runs:l.runs.map(r=>({...r})),b:l.b,fs:l.fs,ctr,rgt,num,ind:l.x0-minX,hd:l.b&&l.s.length<40&&!num&&!ctr&&!rgt,sp:/\\s{4,}/.test(l.s)}}\n   prev={y:l.y,x1:l.x1,ctr,rgt};\n  });flush();\n  /* runs -> HTML: every run keeps its own bold / italic / underline; details found in the text become linked fields with the SAME formatting */\n  const rh=runs=>{const m=[];runs.forEach(r=>{const l=m[m.length-1];if(l&&l.b===r.b&&l.u===r.u&&l.i===r.i)l.s+=r.s;else m.push({...r})});\n   return m.map(r=>{let h=fill(esc(link(r.s)),{b:r.b,u:r.u});if(r.i)h='<i>'+h+'</i>';if(r.u)h='<u>'+h+'</u>';if(r.b)h='<b>'+h+'</b>';return h}).join('')};\n  const strip=(runs,n)=>{const r=runs.map(x=>({...x}));while(n>0&&r.length){if(r[0].s.length<=n){n-=r[0].s.length;r.shift()}else{r[0].s=r[0].s.slice(n);n=0}}if(r.length)r[0].s=r[0].s.replace(/^\\s+/,'');return r};\n  const sc=612/W,html=out.map(q=>{\n   if(q.blank)return'!<p><br></p>';\n   let cls='',st='',inner;\n   const m=q.num&&q.t.match(/^(\\d{1,2}|[a-z])[.)]\\s+(.*)$/);\n   if(m){cls='li';inner='<span class=\"nn\">'+m[1]+'.</span>'+rh(strip(q.runs,q.t.length-m[2].length))}else inner=rh(q.runs);\n   if(q.ctr)cls='cn';else if(q.rgt)st+='text-align:right;';\n   else if(!m){if(q.hd||q.sp)cls='lt';if(q.ind>wd*.04)st+='margin-left:calc(var(--pw)*'+(q.ind/W).toFixed(4)+');'}\n   if(Math.abs(q.fs-fm)>fm*.12)st+='font-size:'+(q.fs*sc).toFixed(1)+'pt;';\n   return'!<p'+(cls?' class=\"'+cls+'\"':'')+(st?' style=\"'+st+'\"':'')+'>'+inner+'</p>'});\n  const cl=(v,a,b)=>Math.min(b,Math.max(a,v));\n  return{text:html.join('\\n'),meta:{rt:+cl((H-lines[0].y-fm*(.9+(lh-1)/2))/H,.02,.6).toFixed(4),rl:+cl(minX/W,.1,.3).toFixed(4),rr:+cl((W-maxX)/W,.1,.3).toFixed(4),fs:Math.round(fm*sc*2)/2,lh:+lh.toFixed(2),f:lines.filter(l=>l.serif).length>lines.length/2?TNR:CAL}};\n}\n\n/* ===== save / reopen ===== */\nfunction readDoc(){try{return JSON.parse(localStorage.getItem('pdt_doc'))}catch(e){return null}}\nvar DOC0=readDoc(),svT;\nfunction saveDoc(quiet){try{const pages=$$('.page').map(p=>{const b=p.querySelector('.body');return{pid:p.dataset.pid||'',cats:p.dataset.cats||'',ps:p.getAttribute('style')||'',bs:b.getAttribute('style')||'',html:b.innerHTML}});\n DOC0={v:1,pages};localStorage.setItem('pdt_doc',JSON.stringify(DOC0));if(quiet!==true)toast('Saved - formatting is kept when you reopen')}catch(e){toast('Could not save: '+(e.message||e))}}\nfunction scheduleSave(){clearTimeout(svT);svT=setTimeout(()=>saveDoc(true),800)}\ndocument.addEventListener('input',e=>{if(e.target.closest&&e.target.closest('#pages'))scheduleSave()});\nfunction restoreDoc(){const d=DOC0;if(!d||!Array.isArray(d.pages)||!d.pages.length)return;\n $('#pages').innerHTML='';\n d.pages.forEach(g=>{const p=mk(),b=p.querySelector('.body');p.dataset.pid=g.pid;p.dataset.cats=g.cats;if(g.ps)p.setAttribute('style',g.ps);{const se=SAVED.find(x=>x.id===g.pid);szPage(p,se&&se.meta)}b.setAttribute('style',g.bs||'');b.innerHTML=fixTypos(g.html);lockPage(p)});\n sync();applyCat()}\n/* shortcuts */\nconst KM={f:openFr,h:openFr,o:()=>{target=curPage();$('#file').click()},s:()=>saveDoc(),p:doPrint,j:()=>document.execCommand('justifyFull'),l:()=>document.execCommand('justifyLeft'),e:()=>document.execCommand('justifyCenter'),r:()=>document.execCommand('justifyRight')};\ndocument.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&!e.altKey&&KM[e.key.toLowerCase()]){e.preventDefault();KM[e.key.toLowerCase()]()}});\nfunction askC(msg){return new Promise(res=>{\n let m=document.getElementById('cfm');\n if(!m){document.body.insertAdjacentHTML('beforeend','<div id=\"cfm\" class=\"modal adx no-print\" style=\"z-index:130\" role=\"alertdialog\" aria-modal=\"true\"><div class=\"lgc\" style=\"width:min(460px,100%)\"><h2 style=\"font-size:18px\">Please confirm</h2><div id=\"cfmt\" style=\"white-space:pre-wrap;max-height:50vh;overflow:auto;color:var(--tx)\"></div><div class=\"row\" style=\"justify-content:flex-end\"><button id=\"cfmn\">Cancel</button><button class=\"pri\" id=\"cfmy\">OK</button></div></div></div>');m=document.getElementById('cfm')}\n document.getElementById('cfmt').textContent=msg;m.style.display='flex';\n const done=v=>{m.style.display='none';document.removeEventListener('keydown',kd,true);res(v)},\n  kd=e=>{if(e.key==='Escape'){e.preventDefault();e.stopPropagation();done(false)}};\n document.addEventListener('keydown',kd,true);\n document.getElementById('cfmy').onclick=()=>done(true);document.getElementById('cfmn').onclick=()=>done(false);document.getElementById('cfmy').focus()})}\nlet tt;function toast(m){const t=$('#toast');t.textContent=m;t.style.display='block';clearTimeout(tt);tt=setTimeout(()=>t.style.display='none',3500)}\n\n/* ===== ADMIN PANEL ===== */\nconst AU='Arslanjaz3220',AH='28by2y9mm9v';\nconst H=s=>{let a=0xdeadbeef,b=0x41c6ce57;for(let i=0;i<s.length;i++){const c=s.charCodeAt(i);a=Math.imul(a^c,2654435761);b=Math.imul(b^c,1597334677)}a=Math.imul(a^a>>>16,2246822507)^Math.imul(b^b>>>13,3266489909);b=Math.imul(b^b>>>16,2246822507)^Math.imul(a^a>>>13,3266489909);return(4294967296*(2097151&b)+(a>>>0)).toString(36)};\ntry{localStorage.removeItem('pdt_pw')}catch(e){}\nconst pwH=()=>{const P0=window.PDT_PRESET&&window.PDT_PRESET.pwh;try{return localStorage.getItem('pdt_pw')||P0||AH}catch(e){return P0||AH}};\nlet LIST=[],CL=[],asel=null,rpI=-1,edI=-1;\n/* ---- persistence: server (all users) when the included server.js is running, otherwise this browser only ---- */\nconst clone=x=>JSON.parse(JSON.stringify(x)),uid=()=>'p'+Date.now().toString(36)+Math.random().toString(36).slice(2,8);\nconst apiPath=n=>{try{return new URL(n,location.href).pathname}catch(e){return '/'+n}};\nconst API=apiPath('api/config'),APIPW=apiPath('api/password'),canSrv=/^https?:$/.test(location.protocol);\nlet SAVED=[],savedStr='',REV=0,srvOk=false,saving=false,resetting=false,adminOn=false,lastWhere='';\nconst TYPOS=[[/\\brecodes\\b/g,'records'],[/\\bherby\\b/g,'hereby'],[/\\bid feasible\\b/g,'if feasible'],[/\\bof of\\b/g,'of'],[/PURHASER/g,'PURCHASER'],[/Derbies Charges/g,'Debris Charges']];\nconst fixTypos=h=>typeof h==='string'?TYPOS.reduce((t,[r,x])=>t.replace(r,x),h):h;\nfunction noPhase(h){if(typeof h!=='string'||!/data-a?k=\"phase\"/.test(h))return h;h=h.replace(/\\s*\\b(?:in\\s+)?phase\\s*(?:-\\s*)?<span[^>]*data-a?k=\"phase\"[^>]*><\\/span>/gi,'').replace(/<span[^>]*data-a?k=\"phase\"[^>]*><\\/span>/gi,'');return h.replace(/,\\s*,/g,',')}\nfunction pullCats(list){list.forEach(e=>{if(e&&e.szdef){if(SZ[e.szdef])SZG=e.szdef;delete e.szdef}if(e&&e.catdefs){const c=e.catdefs;delete e.catdefs;if(Array.isArray(c)&&c.length&&c.every(x=>Array.isArray(x)&&x[0]&&x[1]))setCats(c)}})}\nfunction withCats(list,cats,sz){return list.map((e,i)=>i===0?{...e,catdefs:cats||CATS,szdef:sz||SZG}:e)}\nfunction ensureIds(list){pullCats(list);const okc=adminOn?CL:CATS;list.forEach(e=>{e.html=fixTypos(noPhase(e.html));if(e.orig&&e.orig.html)e.orig.html=fixTypos(noPhase(e.orig.html));if(Array.isArray(e.cats))e.cats=e.cats.filter(c=>okc.some(q=>q[0]===c))});const T=builtin(),used=new Set(list.map(e=>e.tid).filter(x=>x!=null));\n list.forEach(e=>{if(e.tid==null&&!e.img){const k=T.findIndex((t,i)=>!used.has(i)&&t.html===e.html);if(k>=0){e.tid=k;used.add(k)}}if(!e.id)e.id=e.tid!=null?'t'+e.tid:uid();if(e.tid==null&&!e.orig)e.orig={title:e.title||'',html:e.html,meta:clone(e.meta||{})}});\n const seen=new Set();list.forEach(e=>{if(seen.has(e.id))e.id=uid();seen.add(e.id)});return list}\nconst catsDirty=()=>adminOn&&(JSON.stringify(CL)!==JSON.stringify(CATS)||SZD!==SZG),isDirty=()=>JSON.stringify(LIST)!==savedStr||catsDirty();\nfunction pendCount(){const m=new Map(SAVED.map(e=>[e.id,JSON.stringify(e)]));let n=0;LIST.forEach(e=>{if(m.get(e.id)!==JSON.stringify(e))n++;m.delete(e.id)});n+=m.size;if(catsDirty())n++;if(!n&&isDirty())n=1;return n}\nfunction showSt(t,bad){const s=$('#ast');if(s){s.textContent=t;s.className='pill'+(bad?' bad':'')}}\nfunction upd(){if(!adminOn)return;const n=pendCount();$('#asa').classList.toggle('dirty',!!n);\n showSt(n?n+' change(s) not saved yet':'No unsaved changes'+(lastWhere?' (last save: '+lastWhere+')':''));$('#ast').classList.add(n?'warn':'ok')}\nfunction setBusy(){const b=$('#asa'),r=$('#rsb');b.disabled=saving||resetting;r.disabled=saving||resetting;b.textContent=saving?'Saving...':'Save All Changes';r.textContent=resetting?'Resetting...':'Reset selected pages'}\nconst saveList=()=>{ensureIds(LIST);upd();return true};\nfunction validate(list){const e=[];if(!Array.isArray(list)||!list.length)return['There must be at least one page'];\n list.forEach((x,i)=>{const n='Page '+(i+1)+': ';if(!x||typeof x.html!=='string')e.push(n+'content is missing');\n  else if(/<script|<iframe|<[^>]+\\son\\w+\\s*=|javascript:/i.test(x.html))e.push(n+'contains script or unsafe code');\n  if(x&&x.img&&!/^data:image\\//.test(x.img))e.push(n+'background image is invalid');\n  if(x&&x.meta!=null&&typeof x.meta!=='object')e.push(n+'layout settings are invalid');\n  if(x&&x.meta&&x.meta.sz!=null&&!(x.meta.sz==='custom'?(x.meta.sw>=2&&x.meta.sw<=30&&x.meta.sh>=2&&x.meta.sh<=40):!!SZ[x.meta.sz]))e.push(n+'paper size is invalid');\n  if(x&&x.cats!=null&&!(Array.isArray(x.cats)&&x.cats.every(c=>CL.some(q=>q[0]===c))))e.push(n+'category link is invalid')});\n if(JSON.stringify(list).length>30e6)e.push('Total size is too large (over 30 MB)');return e}\nasync function persist(list,cats,sz){cats=cats||CATS;const out=withCats(list,cats,sz);\n if(canSrv){let r=null;\n  try{const c=new AbortController(),t=setTimeout(()=>c.abort(),20000);r=await fetch(API,{method:'PUT',headers:{'Content-Type':'application/json','x-admin':pwH()},body:JSON.stringify({pages:out,cats:cats,rev:REV}),signal:c.signal});clearTimeout(t)}catch(e){r=null}\n  if(r&&r.ok){let d=null,v=null;\n   try{d=await r.json();v=await(await fetch(API,{cache:'no-store'})).json()}catch(e){if(srvOk)throw new Error('The server did not answer correctly. Nothing was confirmed saved.');d=null}\n   if(d&&v){if(JSON.stringify(v.pages)!==JSON.stringify(out))throw new Error('The server did not store the changes correctly');\n    REV=d.rev;srvOk=true;try{localStorage.setItem('pdt_pages',JSON.stringify(out))}catch(e){}return'server'}}\n  /* only a backend that has answered before (srvOk) can reject a save; a plain static host just means \"save on this device\" */\n  if(srvOk){\n   if(r&&r.status===409)throw new Error('Another administrator saved newer changes. Reload this page and try again.');\n   if(r&&(r.status===401||r.status===403))throw new Error('The server rejected the admin password.');\n   if(r&&r.status!==404&&r.status!==405)throw new Error('Server error ('+r.status+').');\n   throw new Error('The server could not be reached. Nothing was saved.');\n  }\n }\n const s=JSON.stringify(out);\n try{localStorage.setItem('pdt_pages',s);if(localStorage.getItem('pdt_pages')!==s)throw 0}catch(e){throw new Error('This browser could not store the changes (storage full or blocked). Try smaller uploads.')}\n return'device'}\nconst whereMsg=w=>w==='server'?'saved on the server - available to all users':'saved on THIS device only (no server connected) - other users will not see it';\nasync function loadRemote(){if(!canSrv)return;try{const r=await fetch(API,{cache:'no-store'});if(!r.ok)return;const d=await r.json();srvOk=true;REV=d.rev||0;if(Array.isArray(d.cats)&&d.cats.length)setCats(d.cats);\n if(d.pwh)try{localStorage.setItem('pdt_pw',d.pwh)}catch(e){}\n if(Array.isArray(d.pages)&&d.pages.length){const z0=SZG,s=JSON.stringify(ensureIds(d.pages));if(s!==savedStr||SZG!==z0){SAVED=JSON.parse(s);savedStr=s;try{localStorage.setItem('pdt_pages',JSON.stringify(withCats(SAVED)))}catch(e){}build()}}applyCat()}catch(e){}}\naddEventListener('beforeunload',e=>{if(saving||resetting||(adminOn&&isDirty())){e.preventDefault();e.returnValue=''}});\nasync function saveAll(){\n if(saving||resetting)return;\n if(!isDirty())return toast('There are no unsaved changes');\n const er=validate(LIST);if(er.length){showSt('Not saved: '+er[0],true);return toast('NOT saved - '+er.slice(0,3).join('; '))}\n if(!await askC('Save all pending changes and apply them to the website?\\n\\nThe sample pages in the tool will reload; text typed directly on those pages will be lost.'))return;\n saving=true;setBusy();showSt('Saving...');\n const snap=clone(LIST),csnap=clone(CL);\n try{const w=await persist(snap,csnap,SZD);SZG=SZD;SAVED=snap;savedStr=JSON.stringify(snap);setCats(csnap);CL=clone(csnap);lastWhere=w==='server'?'server':'this device only';build();upd();renderL();toast('Saved - '+whereMsg(w))}\n catch(e){showSt('NOT saved: '+e.message,true);toast('NOT saved - '+e.message)}\n finally{saving=false;setBusy()}}\n\nconst tOf=e=>(e.title||e.html.replace(/<[^>]*>/g,' ').replace(/\\s+/g,' ').trim()||'(blank page)').slice(0,70);\nconst svg=d=>'<svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">'+d+'</svg>';\nconst IC={doc:svg('<path d=\"M7 3h7l4 4v14H7z\"/><path d=\"M14 3v4h4\"/><path d=\"M10 12h5M10 16h5\"/>'),edit:svg('<path d=\"M4 20h4L19 9l-4-4L4 16z\"/><path d=\"M13 7l4 4\"/>'),upl:svg('<path d=\"M12 16V5\"/><path d=\"M7 10l5-5 5 5\"/><path d=\"M5 19h14\"/>'),\n up:svg('<path d=\"M12 19V6\"/><path d=\"M6 11l6-6 6 6\"/>'),dn:svg('<path d=\"M12 5v13\"/><path d=\"M6 13l6 6 6-6\"/>'),del:svg('<path d=\"M4 7h16\"/><path d=\"M9 7V4h6v3\"/><path d=\"M6 7l1 13h10l1-13\"/><path d=\"M10 11v5M14 11v5\"/>'),\n plus:svg('<path d=\"M12 5v14M5 12h14\"/>'),lock:svg('<rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"2\"/><path d=\"M8 11V8a4 4 0 018 0v3\"/>'),key:svg('<circle cx=\"8\" cy=\"15\" r=\"3.5\"/><path d=\"M10.5 12.5L20 3M16 7l3 3\"/>'),\n undo:svg('<path d=\"M9 7L4 12l5 5\"/><path d=\"M4 12h10a6 6 0 010 8h-3\"/>'),redo:svg('<path d=\"M15 7l5 5-5 5\"/><path d=\"M20 12H10a6 6 0 000 8h3\"/>'),\n al:svg('<path d=\"M4 6h16M4 10h10M4 14h16M4 18h10\"/>'),ac:svg('<path d=\"M4 6h16M7 10h10M4 14h16M7 18h10\"/>'),ar:svg('<path d=\"M4 6h16M10 10h10M4 14h16M10 18h10\"/>'),aj:svg('<path d=\"M4 6h16M4 10h16M4 14h16M4 18h16\"/>')};\ndocument.body.insertAdjacentHTML('beforeend',`<div id=\"lg\" class=\"modal adx no-print\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"lgt\"><div class=\"lgc\"><h2 id=\"lgt\">Administrator sign in</h2><p>Manage the sample pages and templates.</p>\n<label class=\"f\">User name<input id=\"lu\" autocomplete=\"username\"></label><label class=\"f\">Password<input id=\"lp\" type=\"password\" autocomplete=\"current-password\"></label><div id=\"lm\" role=\"alert\"></div>\n<div class=\"row\" style=\"justify-content:flex-end\"><button id=\"lcx\">Cancel</button><button class=\"pri\" id=\"lgo\">Sign in</button></div></div></div>\n<div id=\"adm\" class=\"modal adx no-print\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"adt\"><div class=\"adm-shell\">\n<div class=\"adm-hd\"><div><h2 id=\"adt\">Page Administration</h2><div class=\"sub\">Sample pages, templates and layout for the Property Documentation Tool</div></div><span class=\"sp\"></span><span id=\"ast\" class=\"pill\" role=\"status\" aria-live=\"polite\"></span><button class=\"pri\" id=\"asa\">Save All Changes</button><button id=\"adl\" title=\"Download index.html with all saved settings built in (if the tool is opened as a local file you will be asked to choose index.html once)\">${IC.dn} Download updated file</button><button id=\"alo\">Close</button></div>\n<div class=\"adm-body\"><div class=\"col\"><section class=\"card\"><header><h3>Pages</h3><span class=\"mu\" id=\"acnt\"></span><span class=\"sp\"></span><button id=\"aadd\">${IC.plus} Add page</button><button id=\"aup\">${IC.upl} Upload PDF / image</button><button id=\"ars\" class=\"lnk dgt\">Restore all originals</button></header>\n<div class=\"hint\">Edits stay pending until you click Save All Changes. Use {plot_no}, {seller_name} etc. in text, or the \"Link to detail\" list, to connect text to the detail fields.</div><div id=\"al\"></div></section></div>\n<div class=\"col\"><section class=\"card\" id=\"szx\"><header><h3>Paper Size</h3><span class=\"sp\"></span><span class=\"mu\" id=\"szcnt\"></span></header><div class=\"cb\"><p>Choose the default paper size for every page. Any single page can use its own size from the \"Paper size\" list on its row or in its editor. The page preview in the editor and the pages on the website always use the same size. Click Save All Changes to apply.</p><label class=\"f\">Default paper size<select id=\"szd\"></select></label><div class=\"note ok\" id=\"szinfo\"></div><div class=\"row\"><button id=\"sza\">Apply default to every page</button></div></div></section><section class=\"card\"><header><h3>Document Categories</h3><span class=\"sp\"></span><span class=\"mu\" id=\"ccnt\"></span></header><div class=\"cb\"><p>Add, rename or delete categories. They appear in the Document Category list and in every page's category chips. Use the arrows to change their order. Click Save All Changes to apply.</p><div id=\"cl\"></div><div class=\"row\"><input id=\"cnn\" placeholder=\"New category name\" style=\"flex:1;min-width:140px\"><button class=\"pri\" id=\"cna\">${IC.plus} Add</button></div></div></section><section class=\"card danger\" id=\"rsx\"><header><h3>Reset Selected Pages</h3></header><div class=\"cb\">\n<p>Restores each ticked page to its original template. For uploaded or added pages, that is the version as first uploaded or added.</p>\n<ul class=\"kv\"><li><b>Deleted</b>the page's current text, formatting, detail links and uploaded background.</li><li><b>Kept</b>every unticked page, and your other unsaved edits.</li><li><b>Timing</b>applies immediately and cannot be undone. Separate from Save All Changes.</li></ul>\n<div id=\"rl\"></div><div class=\"row\"><button id=\"rsa\">Select all</button><button id=\"rsn\">Clear selection</button><span class=\"sp\"></span><button class=\"dgb\" id=\"rsb\">Reset selected pages</button></div><div id=\"rres\" class=\"note\" role=\"status\"></div></div></section>\n<section class=\"card\"><header><h3>Security</h3><span class=\"sp\"></span><button id=\"cpg\">${IC.key} Change password</button></header>\n<div id=\"apw\" class=\"cb frm2\" style=\"display:none\"><label class=\"f\">Current password<input id=\"po\" type=\"password\"></label><label class=\"f\">New password (min 6 characters)<input id=\"pn\" type=\"password\"></label><label class=\"f\">Confirm new password<input id=\"pc\" type=\"password\"></label><div class=\"row\"><button class=\"pri\" id=\"pws\">Save password</button></div></div></section></div></div>\n<input type=\"file\" id=\"af\" accept=\"application/pdf,image/jpeg,image/png\" hidden></div></div>\n<div id=\"csz\" class=\"modal adx no-print\" style=\"z-index:130\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"cszt\"><div class=\"lgc\" style=\"width:min(380px,100%)\"><h2 id=\"cszt\" style=\"font-size:18px\">Custom paper size</h2><p>Width 2-30 in, height 2-40 in.</p><div class=\"row\"><label class=\"f\" style=\"flex:1\">Width (in)<input id=\"cszw\" type=\"number\" step=\".01\" min=\"2\" max=\"30\"></label><label class=\"f\" style=\"flex:1\">Height (in)<input id=\"cszh\" type=\"number\" step=\".01\" min=\"2\" max=\"40\"></label></div><div id=\"cszm\" role=\"alert\" style=\"color:var(--dg);font-size:12.5px;min-height:1em\"></div><div class=\"row\" style=\"justify-content:flex-end\"><button id=\"cszx\">Cancel</button><button class=\"pri\" id=\"cszo\">Apply</button></div></div></div>\n<div id=\"ed\" class=\"modal adx no-print\" style=\"z-index:90\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"edt\"><div class=\"ed-shell\"><div class=\"ed-hd\"><h2 id=\"edt\">Edit page text</h2></div><div class=\"ed-body\">\n<label class=\"f\">Page title<input id=\"et\" placeholder=\"Optional - shown in the admin list\"></label>\n<div class=\"f\" style=\"display:flex;flex-direction:column;gap:6px;color:var(--mu);font-size:12.5px\">Link this page to category (tick one or more)<span class=\"row\" id=\"ecats\"></span><span>A change made in this box applies to this page in every category it is linked to.</span></div>\n<div class=\"ed-meta\" id=\"emg\"><div class=\"f\" style=\"display:flex;flex-direction:column;gap:5px;color:var(--mu);font-size:12.5px\">Left margin (in)<span class=\"stp\"><button data-m=\"l-\" aria-label=\"Decrease left margin\">&minus;</button><input id=\"eml\" type=\"number\" step=\".1\" min=\"0\" max=\"3\"><button data-m=\"l+\" aria-label=\"Increase left margin\">+</button></span></div>\n<div class=\"f\" style=\"display:flex;flex-direction:column;gap:5px;color:var(--mu);font-size:12.5px\">Right margin (in)<span class=\"stp\"><button data-m=\"r-\" aria-label=\"Decrease right margin\">&minus;</button><input id=\"emr\" type=\"number\" step=\".1\" min=\"0\" max=\"3\"><button data-m=\"r+\" aria-label=\"Increase right margin\">+</button></span></div><div class=\"f\" style=\"display:flex;flex-direction:column;gap:5px;color:var(--mu);font-size:12.5px\">Top margin (in)<span class=\"stp\"><button data-m=\"t-\" aria-label=\"Decrease top margin\">&minus;</button><input id=\"etm\" type=\"number\" step=\".25\" min=\"0\" max=\"9\"><button data-m=\"t+\" aria-label=\"Increase top margin\">+</button></span></div><div class=\"f\" style=\"display:flex;flex-direction:column;gap:5px;color:var(--mu);font-size:12.5px\">Paper size<span class=\"stp\"><select id=\"esz\" aria-label=\"Paper size of this page\"></select><span id=\"eszc\" hidden><input id=\"eszw\" type=\"number\" step=\".01\" min=\"2\" max=\"30\" aria-label=\"Width in inches\"> x <input id=\"eszh\" type=\"number\" step=\".01\" min=\"2\" max=\"40\" aria-label=\"Height in inches\"> in</span></span></div><button id=\"emd\">Default margins</button></div>\n<div class=\"lockn\">${IC.lock}<span>The top space of every page is locked and reserved (4 inches by default). Page text always starts below it - change it with Top margin above.</span></div>\n<div id=\"etb\" class=\"tbr\"><select id=\"eff\" title=\"Font\">${FOPT}</select><select id=\"efs\" title=\"Font size\">${SOPT}</select><select id=\"els\" title=\"Line spacing\">${LSOPT}</select><span class=\"sep2\"></span><button class=\"ib\" data-c=\"bold\" title=\"Bold\"><b>B</b></button><button class=\"ib\" data-c=\"italic\" title=\"Italic\"><i>I</i></button><button class=\"ib\" data-c=\"underline\" title=\"Underline\"><u>U</u></button><span class=\"sep2\"></span><button class=\"ib\" data-c=\"justifyLeft\" title=\"Align left\">${IC.al}</button><button class=\"ib\" data-c=\"justifyCenter\" title=\"Centre\">${IC.ac}</button><button class=\"ib\" data-c=\"justifyRight\" title=\"Align right\">${IC.ar}</button><button class=\"ib\" data-c=\"justifyFull\" title=\"Justify\">${IC.aj}</button><span class=\"sep2\"></span><button class=\"ib\" data-c=\"undo\" title=\"Undo\">${IC.undo}</button><button class=\"ib\" data-c=\"redo\" title=\"Redo\">${IC.redo}</button></div><div id=\"elr\" class=\"lpan\"><div><b>Link selected text to a detail</b> <span class=\"mu\">- select text in the page below, then click a field</span></div>${FOP}</div>\n<div id=\"efit\" class=\"pill\" role=\"status\"></div><div id=\"epg\"><div id=\"epage\" class=\"epage\"><div id=\"elp\" class=\"elp\" contenteditable=\"false\">Locked top space (<span id=\"elpv\"></span> in)</div><div id=\"ea\" class=\"aed\" contenteditable=\"true\" spellcheck=\"false\"></div></div></div></div><div class=\"ed-ft\"><button id=\"ecx\">Cancel</button><button class=\"pri\" id=\"esv\">Save page</button></div></div></div>`);\n$('#admBtn').onclick=()=>{$('#lu').value='';$('#lp').value='';$('#lm').textContent='';$('#lg').style.display='flex';$('#lu').focus()};\n$('#lcx').onclick=()=>$('#lg').style.display='none';\nasync function login(){if($('#lu').value.trim()===AU&&(H('pdt|'+$('#lp').value)===pwH()||H('pdt|'+$('#lp').value)===AH)){$('#lg').style.display='none';toast('Loading...');await remoteReady;LIST=clone(SAVED);CL=clone(CATS);SZD=SZG;adminOn=true;$('#rres').textContent='';renderL();setBusy();$('#adm').style.display='flex'}else $('#lm').textContent='Wrong user name or password'}\n$('#lgo').onclick=login;$('#lp').onkeydown=e=>{if(e.key==='Enter')login()};\n$('#alo').onclick=async()=>{if(saving||resetting)return toast('Please wait - an operation is still running');if(isDirty()&&!await askC('You have unsaved changes. Close the admin panel and DISCARD them?\\n\\nChoose Cancel to go back and click \"Save All Changes\".'))return;LIST=[];CL=[];adminOn=false;$('#adm').style.display='none';$('#apw').style.display='none'};\n$('#asa').onclick=saveAll;\n$('#cpg').onclick=()=>{const p=$('#apw');p.style.display=p.style.display==='flex'?'none':'flex'};\n$('#pws').onclick=async()=>{const o=$('#po').value,n=$('#pn').value,c=$('#pc').value;\n if(H('pdt|'+o)!==pwH())return toast('Current password is wrong');\n if(n.length<6)return toast('New password must be at least 6 characters');\n if(n!==c)return toast('New passwords do not match');\n const nh=H('pdt|'+n);\n if(canSrv&&srvOk){try{const r=await fetch(APIPW,{method:'PUT',headers:{'Content-Type':'application/json','x-admin':pwH()},body:JSON.stringify({pwh:nh})});if(!r.ok)return toast('Password not changed - the server refused it ('+r.status+')')}catch(e){return toast('Password not changed - the server could not be reached')}}\n try{localStorage.setItem('pdt_pw',nh)}catch(e){return toast('Could not save password')}\n ['#po','#pn','#pc'].forEach(q=>$(q).value='');$('#apw').style.display='none';toast('Password changed')};\nfunction renderL0(){const sv=new Map(SAVED.map(e=>[e.id,JSON.stringify(e)])),m=e=>e.meta||{};\n $('#al').innerHTML=LIST.map((e,k)=>{const kind=e.img?'Image page':e.tid!=null?'Template':'Added page',ch=sv.get(e.id)!==JSON.stringify(e),mg=m(e).ml!=null||m(e).mr!=null;\n  return`<div class=\"ar\"><span class=\"n\">${k+1}</span><span class=\"th\">${e.img?`<img src=\"${e.img}\" alt=\"\">`:IC.doc}</span><span class=\"mt\"><span class=\"t\">${esc(tOf(e))}</span><span class=\"sub2\"><span class=\"tag\">${kind}</span>${ch?'<span class=\"tag pend\">Unsaved</span>':''}${mg?`<span class=\"tag\">Margins ${m(e).ml!=null?m(e).ml:.8} / ${m(e).mr!=null?m(e).mr:.8} in</span>`:''}${m(e).tm!=null?`<span class=\"tag\">Top ${m(e).tm} in</span>`:''}<span class=\"tag\">${szName(szOf(m(e),SZD))}${m(e).sz?'':' - default'}</span>${(e.cats||[]).length?'':'<span class=\"tag\">No category</span>'}</span><span class=\"cats\"><span>Category:</span>${CL.map(([c,l])=>`<button type=\"button\" class=\"cch${(e.cats||[]).includes(c)?' on':''}\" data-a=\"ct\" data-c=\"${c}\" data-i=\"${k}\" aria-pressed=\"${(e.cats||[]).includes(c)}\" title=\"Link / unlink this page with ${l}\">${l}</button>`).join('')}</span><span class=\"cats\"><span>Paper size:</span><select class=\"szs\" data-a=\"sz\" data-i=\"${k}\" aria-label=\"Paper size of page ${k+1}\">${szOpts(m(e).sz||'',true)}</select>${m(e).sz==='custom'?'<button type=\"button\" class=\"cch on\" data-a=\"szc\" data-i=\"'+k+'\" title=\"Change custom size\">'+m(e).sw+' x '+m(e).sh+' in</button>':''}</span></span><span class=\"ac\">${e.img?'':`<button class=\"ib\" data-a=\"ed\" data-i=\"${k}\" title=\"Edit text\" aria-label=\"Edit text of page ${k+1}\">${IC.edit}</button>`}<button class=\"ib\" data-a=\"rp\" data-i=\"${k}\" title=\"Replace with an upload\" aria-label=\"Replace page ${k+1}\">${IC.upl}</button><button class=\"ib\" data-a=\"up\" data-i=\"${k}\" title=\"Move up\" aria-label=\"Move page ${k+1} up\"${k?'':' disabled'}>${IC.up}</button><button class=\"ib\" data-a=\"dn\" data-i=\"${k}\" title=\"Move down\" aria-label=\"Move page ${k+1} down\"${k<LIST.length-1?'':' disabled'}>${IC.dn}</button><button class=\"ib dg\" data-a=\"dl\" data-i=\"${k}\" title=\"Delete page\" aria-label=\"Delete page ${k+1}\">${IC.del}</button></span></div>`}).join('');$('#acnt').textContent=LIST.length+' pages'}\nfunction renderR(){$('#rl').innerHTML=LIST.map((e,k)=>{const ok=(e.tid!=null||e.orig)&&SAVED.some(x=>x.id===e.id);return`<label class=\"rrw${ok?'':' off'}\"><input type=\"checkbox\" data-id=\"${e.id}\"${ok?'':' disabled'}><b>${k+1}</b><span class=\"t\">${esc(tOf(e))}</span><small>${ok?(e.tid==null?'original upload':''):'not saved yet'}</small></label>`}).join('')}\nfunction renderL(){renderL0();renderR();renderC();renderSz();upd()}\nconst rmsg=(t,bad)=>{const s=$('#rres');s.textContent=t;s.className='note '+(bad?'bad':'ok');toast(t)};\n$('#rsa').onclick=()=>document.querySelectorAll('#rl input:not(:disabled)').forEach(x=>x.checked=true);\n$('#rsn').onclick=()=>document.querySelectorAll('#rl input').forEach(x=>x.checked=false);\n$('#rsb').onclick=async()=>{\n if(saving||resetting)return;\n const ids=[...document.querySelectorAll('#rl input:checked')].map(x=>x.dataset.id);\n if(!ids.length)return rmsg('Select at least one page to reset.',true);\n const names=ids.map(id=>{const i=LIST.findIndex(e=>e.id===id);return(i+1)+'. '+(i>=0?tOf(LIST[i]):id)}).join('\\n');\n if(!await askC('Reset '+ids.length+' selected page(s) to their original template?\\n\\n'+names+'\\n\\nThis WILL delete each selected page\\'s current text, formatting, detail links and uploaded background and restore the original template.\\nUnselected pages are not changed.\\nIt takes effect immediately and cannot be undone. Your other unsaved edits stay pending.'))return;\n resetting=true;setBusy();$('#rres').textContent='Resetting...';$('#rres').className='note';\n try{const T=builtin(),base=clone(SAVED),done=[];\n  for(const id of ids){const k=base.findIndex(e=>e.id===id);if(k<0)continue;const c=base[k];\n   if(c.tid!=null&&T[c.tid])base[k]={...clone(T[c.tid]),id,cats:c.cats||[]};\n   else if(c.orig)base[k]={...c,title:c.orig.title,html:c.orig.html,meta:clone(c.orig.meta),orig:c.orig};\n   else continue;\n   done.push(id)}\n  if(!done.length)throw new Error('None of the selected pages could be reset (they are not saved yet).');\n  const w=await persist(base);\n  SAVED=base;savedStr=JSON.stringify(SAVED);\n  done.forEach(id=>{const t=SAVED.find(e=>e.id===id),i=LIST.findIndex(e=>e.id===id);if(i>=0)LIST[i]=clone(t);const pg=document.querySelector('.page[data-pid=\"'+id+'\"]');if(pg)loadEntry(pg,t)});\n  sync();renderL();rmsg('Reset '+done.length+' page(s) - '+whereMsg(w)+'.'+(done.length<ids.length?' '+(ids.length-done.length)+' could not be reset.':''))}\n catch(e){rmsg('Reset failed: '+e.message+' No pages were changed.',true)}\n finally{resetting=false;setBusy()}};\n$('#al').onclick=async e=>{const b=e.target.closest('button');if(!b)return;const i=+b.dataset.i,a=b.dataset.a;\n if(a==='ct'){const c=b.dataset.c,t=new Set(LIST[i].cats||[]);t.has(c)?t.delete(c):t.add(c);LIST[i].cats=CL.map(x=>x[0]).filter(x=>t.has(x));saveList();renderL();return}\n if(a==='ed')openEd(i);\n else if(a==='rp'){rpI=i;$('#af').click()}\n else if(a==='up'&&i>0){[LIST[i-1],LIST[i]]=[LIST[i],LIST[i-1]];saveList();renderL()}\n else if(a==='dn'&&i<LIST.length-1){[LIST[i+1],LIST[i]]=[LIST[i],LIST[i+1]];saveList();renderL()}\n else if(a==='dl'){if(LIST.length<2)return toast('At least one page is required');if(await askC('Delete page '+(i+1)+'?')){LIST.splice(i,1);saveList();renderL()}}};\n$('#aup').onclick=()=>{rpI=-1;$('#af').click()};\n$('#aadd').onclick=()=>openEd(-1);\n$('#ars').onclick=async()=>{if(await askC('Restore ALL pages to the original templates?\\n\\nThis only adds to your pending changes - click \"Save All Changes\" to apply it. To reset just some pages use \"Reset Selected Pages\".')){{const old=new Map(LIST.filter(e=>e.tid!=null).map(e=>[e.tid,e.cats||[]]));LIST=builtin().map(e=>({...e,cats:old.get(e.tid)||[]}))}saveList();renderL()}};\nasync function extract(f){\n if(f.type==='application/pdf'){await pdfInit();const pdf=await pdfjsLib.getDocument({data:await f.arrayBuffer()}).promise,out=[];\n  for(let n=1;n<=pdf.numPages;n++){const pg=await pdf.getPage(n);let r=null;try{r=await pdfPage(pg)}catch(x){console.error(x)}\n   if(r&&r.text.trim())out.push({title:'',html:toHTML(r.text),meta:r.meta});\n   else{const vp=pg.getViewport({scale:1.5}),c=document.createElement('canvas');c.width=vp.width;c.height=vp.height;await pg.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;out.push({title:'Scanned page '+n,html:'<p><br></p>',meta:{},img:c.toDataURL('image/jpeg',.7)})}}\n  return out}\n if(/^image\\/(jpeg|png)$/.test(f.type)){const u=URL.createObjectURL(f),im=new Image();im.src=u;await im.decode();const s=Math.min(1,1100/im.width),c=document.createElement('canvas');c.width=im.width*s;c.height=im.height*s;const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height);x.drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);return[{title:f.name,html:'<p><br></p>',meta:{},img:c.toDataURL('image/jpeg',.75)}]}\n toast('Only PDF, JPG and PNG are allowed.');return[]}\n$('#af').onchange=async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;\n try{toast('Reading file...');const es=await extract(f);if(!es.length)return;\n  if(rpI>=0){const kc=LIST[rpI].cats||[];es.forEach(x=>x.cats=[...kc]);LIST.splice(rpI,1,...es)}else LIST.push(...es);\n  if(saveList()){renderL();toast(rpI>=0?'Page replaced':es.length+' page(s) added')}}catch(err){console.error(err);toast('Could not read file: '+(err&&err.message||err))}};\n\n/* ---- admin: paper size ---- */\nconst szOpts=(sel,withDef)=>(withDef?'<option value=\"\">Same as default ('+SZ[SZD][0]+')</option>':'')+SZL.map(([k,l,w,h])=>'<option value=\"'+k+'\"'+(sel===k?' selected':'')+'>'+l+' ('+w+' x '+h+' in)</option>').join('')+(withDef?'<option value=\"custom\"'+(sel==='custom'?' selected':'')+'>Custom size...</option>':'');\nconst mmTxt=s=>Math.round(s.w*25.4)+' x '+Math.round(s.h*25.4)+' mm';\nfunction renderSz(){const own=LIST.filter(e=>e.meta&&e.meta.sz).length,d=szOf({},SZD);\n $('#szd').innerHTML=szOpts(SZD,false);$('#szcnt').textContent=szName(d);\n $('#szinfo').textContent=szName(d)+' = '+mmTxt(d)+'. '+(LIST.length-own)+' page(s) use the default, '+own+' page(s) have their own size.';$('#sza').disabled=!own}\n$('#szd').onchange=e=>{SZD=e.target.value;renderL();toast('Default paper size set to '+szName(szOf({},SZD))+' - click Save All Changes to apply')};\n$('#sza').onclick=async()=>{if(!await askC('Make every page use the default paper size ('+szName(szOf({},SZD))+')?\\n\\nThe own size of each page is removed. This only adds to your pending changes - click Save All Changes to apply it.'))return;\n LIST.forEach(e=>{if(e.meta){delete e.meta.sz;delete e.meta.sw;delete e.meta.sh}});saveList();renderL()};\nlet cszCb=null;\nfunction openCsz(w,h,cb){cszCb=cb;$('#cszw').value=w||8.5;$('#cszh').value=h||11;$('#cszm').textContent='';$('#csz').style.display='flex';$('#cszw').focus()}\n$('#cszx').onclick=()=>{$('#csz').style.display='none';const f=cszCb;cszCb=null;f&&f(null)};\n$('#cszo').onclick=()=>{const w=Math.round(+$('#cszw').value*100)/100,h=Math.round(+$('#cszh').value*100)/100;if(!(w>=2&&w<=30&&h>=2&&h<=40)){$('#cszm').textContent='Enter a width of 2-30 in and a height of 2-40 in';return}$('#csz').style.display='none';const f=cszCb;cszCb=null;f&&f({w,h})};\n$('#al').onchange=e=>{const t=e.target.closest('select[data-a=\"sz\"]');if(!t)return;const i=+t.dataset.i,v=t.value,en=LIST[i];en.meta=en.meta||{};const m=en.meta;\n if(v==='custom'){openCsz(m.sw,m.sh,r=>{if(r){m.sz='custom';m.sw=r.w;m.sh=r.h;saveList()}renderL()});return}\n delete m.sw;delete m.sh;v?m.sz=v:delete m.sz;saveList();renderL()};\nfunction curEsz(){const v=$('#esz').value;return szOf(v==='custom'?{sz:'custom',sw:$('#eszw').value,sh:$('#eszh').value}:{sz:v},SZD)}\nfunction fitChk(){const e=$('#efit');if(!e)return;const s=curEsz(),need=$('#elp').offsetHeight+$('#ea').scrollHeight,ok=need<=s.h*96+1;\n e.className='pill '+(ok?'ok':'warn');e.textContent=ok?'Preview is shown at '+szName(s)+' - the same size as on the website. Text fits on this page.':'Preview is shown at '+szName(s)+'. The text is longer than one page - the extra lines continue on a new page of the same size on the website.'}\nfunction prevSz(){const s=curEsz();szVars($('#epage'),s);$('#epage').style.setProperty('--lkh',($('#elp').style.height||'4in'));fitChk()}\n$('#esz').onchange=()=>{const c=$('#esz').value==='custom';$('#eszc').hidden=!c;if(c&&!(+$('#eszw').value>0)){$('#eszw').value=8.5;$('#eszh').value=11}prevSz()};\n$('#eszw').oninput=$('#eszh').oninput=prevSz;\n$('#ea').addEventListener('input',fitChk);\nfunction openEd(i){edI=i;const e=i>=0?LIST[i]:{title:'',html:'<p><br></p>',meta:{}};\n $('#ecats').innerHTML=CL.map(([k,l])=>'<label class=\"cck\"><input type=\"checkbox\" data-c=\"'+k+'\"'+((e.cats||[]).includes(k)?' checked':'')+'> '+esc(l)+'</label>').join('');\n $('#et').value=e.title||'';setMg(e.meta&&e.meta.ml!=null?e.meta.ml:.8,e.meta&&e.meta.mr!=null?e.meta.mr:.8,e.meta&&e.meta.tm!=null?e.meta.tm:4);{const m0=e.meta||{},ea=$('#ea');ea.style.fontFamily=m0.f||CAL;ea.style.fontSize=(m0.fs||12)+'pt';ea.style.lineHeight=m0.lh||1.22}$('#ea').innerHTML=e.html.replace(/data-k=/g,'data-ak=');{const m1=e.meta||{};$('#esz').innerHTML=szOpts(m1.sz||'',true);$('#eszw').value=m1.sw||'';$('#eszh').value=m1.sh||'';$