n\n\n/* ---- admin: categories, fonts / spacing, download ---- */\nfunction renderC(){$('#cl').innerHTML=CL.map(([k,l],i)=>'<div class=\"row\"><input data-i=\"'+i+'\" value=\"'+esc(l)+'\" style=\"flex:1;min-width:120px\" aria-label=\"Category name\"><span class=\"mu\">'+LIST.filter(e=>(e.cats||[]).includes(k)).length+' pg</span><button class=\"ib\" data-i=\"'+i+'\" data-a=\"up\" title=\"Move up\" aria-label=\"Move category up\"'+(i?'':' disabled')+'>'+IC.up+'</button><button class=\"ib\" data-i=\"'+i+'\" data-a=\"dn\" title=\"Move down\" aria-label=\"Move category down\"'+(i<CL.length-1?'':' disabled')+'>'+IC.dn+'</button><button class=\"ib dg\" data-i=\"'+i+'\" data-a=\"del\" title=\"Delete category\" aria-label=\"Delete category\">'+IC.del+'</button></div>').join('');$('#ccnt').textContent=CL.length+' categories'}\n$('#cl').onchange=e=>{const i=e.target.dataset.i;if(i==null)return;const v=e.target.value.trim();if(!v){e.target.value=CL[i][1];return toast('Name cannot be empty')}CL[i][1]=v;renderL()};\n$('#cl').onclick=async e=>{const b=e.target.closest('button');if(!b||b.disabled)return;const i=+b.dataset.i,a=b.dataset.a;\n if(a==='up'&&i>0){[CL[i-1],CL[i]]=[CL[i],CL[i-1]];renderL();return}\n if(a==='dn'&&i<CL.length-1){[CL[i+1],CL[i]]=[CL[i],CL[i+1]];renderL();return}\n if(a!=='del')return;if(CL.length<2)return toast('At least one category is required');const k=CL[i][0],l=CL[i][1];if(!await askC('Delete category \"'+l+'\"?\\n\\nPages linked to it stay, but lose this category link.'))return;CL.splice(i,1);LIST.forEach(x=>{if(x.cats)x.cats=x.cats.filter(c=>c!==k)});renderL()};\n$('#cna').onclick=()=>{const v=$('#cnn').value.trim();if(!v)return toast('Type a category name');if(CL.some(c=>c[1].toLowerCase()===v.toLowerCase()))return toast('That category already exists');let k;do{k='c'+Date.now().toString(36)+Math.random().toString(36).slice(2,5)}while(CL.some(c=>c[0]===k));CL.push([k,v]);$('#cnn').value='';renderL()};\n$('#cnn').onkeydown=e=>{if(e.key==='Enter')$('#cn