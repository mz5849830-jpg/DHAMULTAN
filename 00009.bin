,td=st.textDecorationLine||st.textDecoration||'',cl=x.classList||{contains:()=>0};\n if(/^(B|STRONG)$/.test(t)||/^(bold|bolder|[6-9]00)$/.test(fw)||cl.contains('c')||cl.contains('cb')||cl.contains('lb')||cl.contains('dp'))b=1;\n if(t==='U'||/underline/.test(td)||cl.contains('c')||cl.contains('lb'))u=1}\n return{b,u}}\nconst phStyle=f=>'font-weight:'+(f&&f.b?700:400)+';text-decoration:'+(f&&f.u?'underline':'none');\nfunction fieldEl(k,m,n){const t=document.createElement('template');t.innerHTML='<span class=\"ph pf\" contenteditable=\"false\" data-k=\"'+k+'\" data-m=\"'+(m||'')+'\" style=\"'+phStyle(fmtOf(n))+'\"></span>';return t.content}\nfunction autoLink(ps){LK=new Set();\n ps.forEach(p=>{const w=document.createTreeWalker(p,NodeFilter.SHOW_TEXT),ns=[];while(w.nextNode())ns.push(w.currentNode);\n  ns.forEach(n=>{const v=n.nodeValue,t=link(v);if(t===v)return;const f=document.createDocumentFragment();\n   t.split(/(\\{\\w+(?:\\|\\w)*\\})/).forEach((x,i)=>{if(!x)return;const m=i%2&&/^\\{(\\w+)((?:\\|\\w)*)\\}$/.exec(x);if(m&&L[m[1]])f.append(fieldEl(m[1],m[2],n));else f.append(x)});n.replaceWith(f)})});\n return LK.size}\nfunction trimPs(ps){const e=p=>!p.textContent.trim()&&!p.querySelector('.ph');while(ps.length&&e(ps[0]))ps.shift();while(ps.length&&e(ps[ps.length-1]))ps.pop();return ps}\nfunction pasteNodes(ps,inline){\n const s=getSelection();if(!s.rangeCount)return;const r=s.getRangeAt(0);r.deleteContents();\n const x=el(r.startContainer),host=x&&x.closest&&x.closest('.body,.hz,#ea');if(!host)return;\n let blk=x;while(blk&&blk.parentElement!==host)blk=blk.parentElement;\n const end=n=>{const q=document.createRange();q.selectNodeContents(n);q.collapse(false);s.removeAllRanges();s.addRange(q)};\n if(inline){const f=document.createDocumentFragment();[...ps[0].childNodes].forEach(n=>f.append(n));const last=f.lastChild;r.insertNode(f);if(last){const q=document.createRange();q.setStartAfter(last);q.collapse(true);s.removeAllRanges();s.addRange(q)}return}\n let last;\n if(!blk){ps.forEach(p=>host.append(p));last=ps[ps.length-1]}\n else{\n  const tr=document.createRange();tr.setStart(r.startContainer,r.startOffset);tr.setEnd(blk,blk.childNodes.length);\n  const tail=document.createElement('p');tail.className=blk.className;tail.style.cssText=blk.style.cssText;tail.append(tr.extractContents());\n  const has=n=>n.textContent.trim()||n.querySelector('.ph');let pos=blk;\n  if(!has(blk)){blk.replaceWith(...ps);pos=ps[ps.length-1]}\n  else{[...ps[0].childNodes].forEach(n=>blk.append(n));ps.slice(1).forEach(p=>{pos.after(p);pos=p})}\n  last=pos;if(has(tail)){pos.after(tail)}\n }\n end(last)}\ndocument.addEventListener('paste',e=>{\n const x=el(getSelection().anchorNode);if(!x||!x.closest||!x.closest('.body,.hz'))return;\n e.preventDefault();\n const html=e.clipboardData.getData('text/html');let ps=[],inline=false;\n if(html&&html.trim()){const r=cleanHTML(html);ps=trimPs(r.ps);inline=ps.length===1}\n if(!ps.length){const t=(e.clipboardData.getData('text/plain')||'').replace(/[\\u00A0\\u1680\\u2000-\\u200B\\u202F\\u205F\\u3000\\uFEFF]/g,' ').replace(/\\t/g,'    ').replace(/\\r\\n?/g,'\\n');\n  ps=trimPs(t.split('\\n').map(l=>{const p=document.createElement('p');if(l)p.textContent=l;else p.innerHTML='<br>';return p}));inline=ps.length===1}\n if(!ps.length)return;\n const nl=autoLink(ps);pasteNodes(ps,inline);\n if(nl){for(const k in A)delete A[k];Object.assign(A,D)}\n sync();if(nl)toast('Pasted. '+nl+' detail field(s) linked to the Property Documentation Tool');\n});\n\n/* upload (per page) */\n$('#file').onchange=e=>{handle(e.target.files[0],target||$$('.page')[0]);e.target.value=''};\nlet pdfReady;function pdfInit(){return pdfReady||(pdfReady=(async()=>{const u='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';try{const t=await(await fetch(u)).text();pdfjsLib.GlobalWorkerOptions.workerSrc=URL.createObjectURL(new Blob([t],{type:'text/javascript'}))}catch(e){pdfjsLib.GlobalWorkerOptions.workerSrc=u}})())}\nfunction applyRs(p){const m=p.querySelector('.zone canvas,.zone img'),r=p._rs||{w:100,h:100,x:0,y:0},st={width:r.w+'%',height:r.h+'%',left:r.x+'%',top:r.y+'%'};\n if(m)Object.assign(m.style,st);const sb=p.querySelector('.sb');if(sb)Object.assign(sb.style,st);\n p.querySelectorAll('.rsp [data-r]').forEach(i=>i.value=r[i.dataset.r])}\nfunction setZone(p,node,txt){\n const z=p.querySelector('.zone');z.querySelectorAll('canvas,img').forEach(x=>x.remove());z.prepend(node);z.classList.remove('empty');p.classList.add('has-doc');p.querySelector('.rs').hidden=false;p.querySelector('.rr').click();\n p._txt=txt||'';p.querySelector('.tx').hidden=!txt;p.querySelector('.ub').textContent='⬆ Replace';\n}\nasync function handle(f,p){\n if(!f||!p)return;\n try{\n  if(f.type==='application/pdf'){\n   toast('Loading PDF…');\n   await pdfInit();\n   const pdf=await pdfjsLib.getDocument({data:await f.arrayBuffer()}).promise;\n   for(let n=1;n<=pdf.numPages;n++){\n    const pg=await pdf.getPage(n),vp=pg.getViewport({scale:2}),c=document.createElement('canvas');\n    c.width=vp.width;c.height=vp.height;await pg.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;\n    let r=null;try{r=await pdfPage(pg)}catch(e){console.error(e)}\n    if(n>1)p=(p.nextElementSibling&&p.nextElementSibling.classList.contains('page'))?p.nextElementSibling:mk(p);\n    setZone(p,c,r&&r.text.trim()?r:null);\n   }\n   toast('PDF placed. Use \"Insert PDF text\" on a page to edit its text.');\n  }else if(/^image\\/(jpeg|png)$/.test(f.type)){\n   const img=new Image();img.src=URL.createObjectURL(f);await img.decode();setZone(p,img);toast('Image placed.');\n  }else return toast('Only PDF, JPG and PNG are allowed.');\n }catch(err){console.error(err);toast('Could not open file: '+(err&&err.message||err))}\n}\n\n/* toolbar */\nconst tb=$('#tb');let sel=null;\ntb.innerHTML=`<select id=\"ff\"><option>Calibri</option></select>\n<select id=\"fs\">${[8,9,10,11,12,14,16,18,20,24,28,36,48,72].map(s=>`<option${s==12?' selected':