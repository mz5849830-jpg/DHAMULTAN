font>\\u003c/p>\\u003cp style=\\\"text-align: left;\\\">\\u003cbr>\\u003c/p>\\u003cp style=\\\"text-align: left;\\\">\\u003cfont style=\\\"font-size: 11pt;\\\">\\u003cbr>\\u003c/font>\\u003c/p>\\u003cp style=\\\"text-align: left; margin-left: 0.5in; text-indent: 0.5in;\\\">\\u003cfont style=\\\"font-size: 11pt;\\\">\\u003cb>DEPONENT 1\\u003c/b>\\u003cb>                                                                                                   \\u003c/b>\\u003cb>DEPONENT 2\\u003c/b>\\u003c/font>\\u003c/p>\\u003cp style=\\\"text-align: left; margin-left: 5in; text-indent: 0.5in;\\\">\\u003cfont style=\\\"font-size: 11pt;\\\">\\u003cbr>\\u003c/font>\\u003c/p>\\u003cp style=\\\"text-align: left; margin-left: 5in; text-indent: 0.5in;\\\">\\u003cfont style=\\\"font-size: 11pt;\\\">\\u003cbr>\\u003c/font>\\u003c/p>\\u003cp style=\\\"text-align: left;\\\">\\u003cu>\\u003cb>\\u003cfont style=\\\"font-size: 11pt;\\\">Verification\\u003c/font>\\u003c/b>\\u003c/u>\\u003c/p>\\u003cp style=\\\"text-align: justify;\\\">\\u003cfont style=\\\"font-size: 11pt;\\\">Verified on Oath at ______________, this____________ day of __________, that the contents of above undertaking / affidavit are true and correct to the best of my knowledge, information and belief, and that nothing has been concealed therein. \\u003c/font>\\u003c/p>\\u003cp style=\\\"text-align: left;\\\">\\u003cfont style=\\\"font-size: 11pt;\\\">\\u003cbr>\\u003c/font>\\u003c/p>\\u003cp style=\\\"text-align: left;\\\">\\u003cfont style=\\\"font-size: 11pt;\\\">\\u003cbr>\\u003c/font>\\u003c/p>\\u003cp style=\\\"text-align: left; margin-left: 0.5in; text-indent: 0.5in;\\\">\\u003cfont style=\\\"font-size: 11pt;\\\">\\u003cb>DEPONENT 1\\u003c/b>\\u003cb>                                   \\u003c/b>\\u003cb>                                \\u003c/b>\\u003cb>                                \\u003c/b>\\u003cb>DEPONENT 2\\u003c/b>\\u003c/font>\\u003c/p>\",\"meta\":{\"f\":\"Calibri,Carlito,\\\"Segoe UI\\\",Arial,sans-serif\",\"lh\":1.22,\"tm\":3.5}}}],\"pwh\":\"28by2y9mm9v\"};/*PDT_END*/</script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js\"></script>\n<style>\n:root{--bg:#eef0f3;--card:#fff;--tx:#1b1f24;--bd:#c9ced6;--pw:816px;--ph:1248px;--lock:4in;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}\n@media(prefers-color-scheme:dark){:root:not([data-theme=\"light\"]){--bg:#1d2025;--card:#2a2e35;--tx:#eceff3;--bd:#454b55}}\n:root[data-theme=\"dark\"]{--bg:#1d2025;--card:#2a2e35;--tx:#eceff3;--bd:#454b55}\n*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}\nbody{margin:0;background:var(--bg);color:var(--tx);font:14px system-ui,-apple-system,Segoe UI,sans-serif}\nmain{max-width:1000px;margin:0 auto;padding:12px}\nh1{font-size:18px;margin:4px 0 10px}\n.box{background:var(--card);border-radius:6px;padding:12px;margin-bottom:12px}\n#up{text-align:center;padding:22px}\n#up.drag{background:rgba(214,40,40,.1)}\n#det{border:2px solid #2a9d3f}\n#doc{border:2px solid #000;padding:0;overflow-x:auto;background:#8a8f98}\n#det fieldset{border:1px solid var(--bd);border-radius:6px;margin:0 0 8px;padding:6px 8px}\n#det legend{font-weight:600;padding:0 4px}#det fieldset[hidden]{display:none}\n.g{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:6px}\ninput,select,button{font:inherit;color:var(--tx);background:var(--card);border:1px solid var(--bd);border-radius:5px;padding:5px 8px}\nbutton{cursor:pointer}button:hover{background:rgba(120,130,150,.18)}\n.pri{background:#2563eb;color:#fff;border-color:#2563eb;padding:9px 16px;font-weight:600}.pri:hover{background:#1d4ed8}\n#tb{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;display:flex;flex-wrap:wrap;gap:4px;align-items:center;background:var(--card);padding:6px;border-bottom:1px solid var(--bd)}\n#tb button{min-width:30px;padding:4px 7px}#tb input[type=color]{width:30px;height:28px;padding:1px}\n.sep{width:1px;height:22px;background:var(--bd);margin:0 2px}\n#pages{width:max-content;margin:0 auto;padding:10px}\n.page{width:var(--pw);height:var(--ph);background:#fff;color:#000;margin:0 auto 14px;position:relative;display:flex;flex-direction:column;box-shadow:0 2px 8px rgba(0,0,0,.35)}\n.hd{position:absolute;left:.3in;bottom:3px;z-index:2;max-width:60%;font:9px/1.3 system-ui,sans-serif;color:#1c6b2c;background:rgba(255,255,255,.85);padding:1px 4px;border-radius:3px;pointer-events:none;user-select:none}.hd:empty{display:none}\n.rm{position:absolute;top:4px;right:6px;z-index:6;padding:0 6px;font-size:12px;background:#fff;color:#900}\n.zone{position:absolute;inset:0;z-index:0;overflow:hidden;background:#fff;user-select:none}.zone.drag{background:#fdecec}.zone canvas,.zone img{position:absolute;left:0;top:0;width:100%;height:100%;object-fit:fill;display:block}\n.zbar{position:absolute;z-index:6;top:4px;right:34px;display:flex;gap:4px}.zbar button{font-size:12px;padding:3px 8px}.zbar .pri{padding:3px 8px;font-size:12px;background:#fff;color:#000;border-color:#999}\n.rsp{display:none;position:absolute;top:100%;right:0;margin-top:4px;background:#fff;color:#000;border:1px solid #999;border-radius:6px;padding:8px;width:230px;flex-direction:column;gap:5px;font-size:12px;box-shadow:0 4px 12px rgba(0,0,0,.3)}.rsp.open{display:flex}.rsp label{display:flex;justify-content:space-between;align-items:center;gap:6px}.rsp input[type=range]{width:130px;padding:0}\n.page{-webkit-print-color-adjust:exact;print-color-adjust:exact}\n.ph.bl{display:inline-block;height:1em;border-bottom:1px solid #000;text-decoration:none;font-weight:400}\n.hz{position:absolute;left:0;right:0;top:0;z-index:2;display:none;overflow:hidden;padding:.4in .3in 0;outline:none;white-space:pre-wrap;font:12pt/1.22 Calibri,Carlito,\"Segoe UI\",Arial,sans-serif;box-sizing:border-box}.page.ht .hz{display:block}.hz p{margin:0;text-align:justify}\n.frm{position:absolute;inset:0;z-index:5;pointer-events:none;display:none}.page.rz .frm{display:block}\n.sb{position:absolute;border:1.5px solid #2563eb;pointer-events:auto;cursor:move;touch-action:none}\n.sb i{position:absolute;width:13px;height:13px;margin:-7px 0 0 -7px;background:#fff;border:1.5px solid #2563eb;border-radius:50%;touch-action:none}\n.sb i[data-h=nw]{left:0;top:0;cursor:nwse-resize}.sb i[data-h=n]{left:50%;top:0;cursor:ns-resize}.sb i[data-h=ne]{left:100%;top:0;cursor:nesw-resize}\n.sb i[data-h=e]{left:100%;top:50%;cursor:ew-resize}.sb i[data-h=se]{left:100%;top:100%;cursor:nwse-resize}.sb i[data-h=s]{left:50%;top:100%;cursor:ns-resize}\n.sb i[data-h=sw]{left:0;top:100%;cursor:nesw-resize}.sb i[data-h=w]{left:0;top:50%;cursor:ew-resize}\n.lk{flex:0 0 var(--lock);height:var(--lock);min-height:var(--lock);max-height:var(--lock);position:relative;z-index:1;user-select:none;-webkit-user-select:none;cursor:default;pointer-events:none}.body{flex:1 1 0;min-height:0;overflow:hidden;padding:0 .3in .2in!important;outline:none;position:relative;z-index:1;white-space:pre-wrap;font:12pt/1.22 Calibri,Carlito,\"Segoe UI\",Arial,sans-serif}\n:root{--mx:.8in}.body,.hz{padding-left:var(--ml,var(--mx))!important;padding-right:var(--mr,var(--mx))!important}.body{tab-size:.5in;-moz-tab-size:.5in}.hz{tab-size:.5in;-moz-tab-size:.5in}.body p{margin:0;text-align:justify}.body .c{text-align:center;font-weight:700;text-decoration:underline}.body .cb{text-align:center;font-weight:700}.body .cn{text-align:center}.body .lb{text-align:left;font-weight:700;text-decoration:underline}.body .lt{text-align:left}.body .dp{text-align:right;font-weight:700;padding-right:1.4in}\n.body .li{margin-left:.5in;text-indent:-.25in}.body .li .nn{display:inline-block;width:.25in;text-indent:0}\n.sg{display:flex;justify-content:space-around;text-align:center}\n.ph{font-weight:700;text-decoration:underline}.ph.pl,.ph[data-k$=\"_rel\"],.ph[data-k$=\"_t\"]{font-weight:400;text-decoration:none}\n#fl{position:fixed;z-index:50;display:none;flex-wrap:wrap;gap:3px;align-items:center;background:#222;padding:4px;border-radius:6px;max-width:min(430px,96vw)}\n#fl button,#fl select{background:#222;color:#fff;border-color:#555;padding:2px 7px}#fl input[type=color]{width:28px;height:26px;padding:1px;background:#222;border-color:#555}#fl .br{flex-basis:100%;height:0}\n#fr{position:fixed;right:12px;top:calc(60px + env(safe-area-inset-top,0px));z-index:60;display:none;flex-direction:column;gap:6px;width:min(280px,90vw);box-shadow:0 4px 16px rgba(0,0,0,.4)}\n#toast{position:fixed;left:50%;bottom:calc(16px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:#222;color:#fff;padding:8px 14px;border-radius:6px;display:none;z-index:99;max-width:90vw}\n.gray{filter:grayscale(1)}@media print{.gray{filter:none!important}}.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;z-index:80}.modal .box{width:min(440px,92vw);display:flex;flex-direction:column;gap:8px;max-height:90vh;overflow:auto;margin:0}textarea{font:inherit;color:var(--tx);background:var(--card);border:1px solid var(--bd);border-radius:5px;padding:5px 8px}\n@media print{\n body{background:#fff}main{padding:0;max-width:none}.no-print,#tb,#fl,#fr,#toast{display:none!important}\n .box{padding:0;margin:0;border:0!important;background:none}#doc{border:0;overflow:visible;background:none}\n #pages{padding:0;width:auto}.page{margin:0;box-shadow:none;break-after:page;page-break-after:always}.page.skip,.modal{display:none!important}\n}\n/* ===== Document Category selector ===== */\n#catbox{position:relative;z-index:30;display:flex;flex-wrap:wrap;gap:10px 14px;align-items:center}\n.cdd{position:relative}\n#catBtn{min-width:270px;display:flex;justify-content:space-between;align-items:center;gap:12px;text-align:left;padding:7px 10px}\n#catMenu{display:none;position:absolute;top:100%;left:0;margin-top:4px;min-width:100%;width:max-content;background:var(--card);border:1px solid var(--bd);border-radius:6px;box-shadow:0 8px 22px rgba(0,0,0,.28);padding:4px}\n#catMenu.open{display:block}\n#catMenu label{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:5px;cursor:pointer;user-select:none}\n#catMenu label:hover{background:rgba(120,130,150,.18)}\n#catMenu input{width:18px;height:18px;padding:0;margin:0;accent-color:#2563eb;cursor:pointer}\n#catMenu label small,#catInfo{opacity:.7;font-size:12px}\n#catMenu .cfoot{display:flex;gap:6px;border-top:1px solid var(--bd);margin-top:4px;padding:6px 6px 2px}\n#catMenu .cfoot button{font-size:12px;padding:3px 9px}\n.page.coff{display:none!important}\n#lg,#adm{z-index:85}.ar{display:flex;gap:6px;align-items:center;border:1px solid var(--bd);border-radius:6px;padding:6px;margin-bottom:6px;flex-wrap:wrap}.ar .n{font-weight:700;min-width:22px}.ar .t{flex:1;min-width:140px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ar img{height:34px;border:1px solid var(--bd)}\n.aed{background:#fff;color:#000;border:1px solid var(--bd);border-radius:5px;min-height:260px;max-height:50vh;overflow:auto;padding:.3in .85in;outline:none;font:12pt/1.22 Calibri,Carlito,\"Segoe UI\",Arial,sans-serif;white-space:pre-wrap}.aed p{margin:0;text-align:justify}.aed .c{text-align:center;font-weight:700;text-decoration:underline}.aed .cb{text-align:center;font-weight:700}.aed .cn{text-align:center}.aed .lb{text-align:left;font-weight:700;text-decoration:underline}.aed .lt{text-align:left}.aed .dp{text-align:right;font-weight:700}.aed .li{margin-left:.5in;text-indent:-.25in}.aed .li .nn{display:inline-block;width:.25in;text-indent:0}.aed .sg{display:flex;justify-content:space-around;text-align:center}\n.aed .ph{display:inline-block;box-sizing:content-box;width:1in;height:1em;overflow:hidden;white-space:nowrap;vertical-align:baseline;border-bottom:1px solid #000;font-weight:400;text-decoration:none}\n.aed .ph[data-ak$=\"_name\"],.aed .ph[data-ak$=\"_relname\"],.aed .ph[data-ak$=\"_cnic\"],.aed .ph[data-ak$=\"_estate\"]{width:2in}.aed .ph[data-ak$=\"_res\"]{width:4in}.aed .ph[data-ak$=\"_rel\"],.aed .ph[data-ak$=\"_t\"]{width:.6in}.aed .ph[data-ak$=\"_reg\"]{width:1.5in}\n.aed .ph:empty::before{content:attr(data-ak);display:block;height:100%;background:#dff5e3;color:#1c6b2c;font:8px/1.9 system-ui,sans-serif;text-align:center;overflow:hidden;text-overflow:ellipsis}\n#lk{display:none!important}\n.body ul,.body ol,.hz ul,.hz ol{margin:0;padding-left:.5in;text-align:justify}.body blockquote{margin:0 0 0 .5in;padding:0}.body li{margin:0}\n.body s,.body strike{text-decoration:line-through}\n.pbk{display:block;height:0;border-top:2px dashed #2563eb;margin:6px 0;position:relative;user-select:none;-webkit-user-select:none}\n.pbk::after{content:'Page break';position:absolute;right:0;top:-9px;font:9px system-ui;color:#2563eb;background:#fff;padding:0 4px}\n@media print{.pbk{display:none!important}}h1{display:flow-root}\n#topPrint{float:right;margin-right:10px;font-size:17px;padding:10px 30px;font-weight:700;border-radius:6px}\n/* ===== Admin console design ===== */\n.adx{--bg:#f1f4f7;--pn:#fff;--pn2:#f6f8fa;--ln:#d8dfe7;--tx:#17212b;--mu:#5b6a7a;--ac:#17795a;--wr:#a96a0c;--wrbg:#fcf1d9;--dg:#b3363e;--dgbg:#fbe8e9;--ok:#126a4e;--okbg:#ddf2e9;--sh:0 28px 70px rgba(8,16,26,.34);font:13.5px/1.45 \"Segoe UI Variable Text\",\"Segoe UI\",system-ui,-apple-system,sans-serif;color:var(--tx)}\n@media(prefers-color-scheme:dark){:root:not([data-theme=\"light\"]) .adx{--bg:#0d1218;--pn:#151c25;--pn2:#1b2430;--ln:#2a3645;--tx:#e8eef4;--mu:#94a3b4;--ac:#23956f;--wr:#e8b455;--wrbg:rgba(232,180,85,.14);--dg:#f08187;--dgbg:rgba(240,129,135,.13);--ok:#62d3a9;--okbg:rgba(98,211,169,.13);--sh:0 28px 70px rgba(0,0,0,.6)}}\n:root[data-theme=\"dark\"] .adx{--bg:#0d1218;--pn:#151c25;--pn2:#1b2430;--ln:#2a3645;--tx:#e8eef4;--mu:#94a3b4;--ac:#23956f;--wr:#e8b455;--wrbg:rgba(232,180,85,.14);--dg:#f08187;--dgbg:rgba(240,129,135,.13);--ok:#62d3a9;--okbg:rgba(98,211,169,.13);--sh:0 28px 70px rgba(0,0,0,.6)}\n.adx.modal{background:rgba(7,11,17,.68);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px)}\n#adm,#ed{align-items:flex-start;overflow:auto;padding:26px 14px}#lg{padding:14px}\n.adx *{box-sizing:border-box}\n.adx button{font:inherit;display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border-radius:7px;border:1px solid var(--ln);background:var(--pn);color:var(--tx);cursor:pointer;line-height:1.2}\n.adx button:hover{background:var(--pn2)}.adx button:disabled{opacity:.5;cursor:not-allowed}\n.adx button:focus-visible,.adx input:focus-visible,.adx select:focus-visible{outline:2px solid var(--ac);outline-offset:1px}\n.adx .pri{background:var(--ac);border-color:var(--ac);color:#fff;font-weight:600;padding:8px 16px}.adx .pri:hover{background:var(--ac);filter:brightness(1.1)}\n.adx #asa.dirty{box-shadow:0 0 0 3px var(--wrbg),0 0 0 4px var(--wr)}\n.adx .dgb{background:var(--dg);border-color:var(--dg);color:#fff;font-weight:600}.adx .dgb:hover{background:var(--dg);filter:brightness(1.08)}\n.adx .lnk{border-color:transparent;background:transparent;color:var(--mu)}.adx .lnk.dgt:hover{color:var(--dg);background:var(--dgbg)}\n.adx .ib{width:30px;height:30px;padding:0;justify-content:center;border-color:transparent;background:transparent;color:var(--mu)}.adx .ib:hover{background:var(--pn2);color:var(--tx)}.adx .ib.dg:hover{color:var(--dg);background:var(--dgbg)}\n.adx input,.adx select{font:inherit;color:var(--tx);background:var(--pn);border:1px solid var(--ln);border-radius:7px;padding:8px 10px;min-width:0}\n.adx input[type=checkbox]{width:16px;height:16px;padding:0;accent-color:var(--ac)}\n.adx input[type=number]{-moz-appearance:textfield;text-align:center}.adx input[type=number]::-webkit-inner-spin-button{display:none}\n.adx label.f{display:flex;flex-direction:column;gap:5px;color:var(--mu);font-size:12.5px}.adx label.f input{color:var(--tx);font-size:14px}\n.adx .cats{display:flex;gap:5px;flex-wrap:wrap;align-items:center;margin-top:2px}.adx .cats>span{font-size:11.5px;color:var(--mu)}\n.adx .cch{padding:2px 10px;font-size:11.5px;border-radius:99px;color:var(--mu);gap:4px}\n.adx .cch.on{background:var(--okbg);color:var(--ok);border-color:transparent;font-weight:600}.adx .cch.on::before{content:\"\\2713\"}\n.adx .cck{display:inline-flex;gap:7px;align-items:center;padding:6px 11px;border:1px solid var(--ln);border-radius:7px;cursor:pointer;color:var(--tx);background:var(--pn);font-size:13.5px}.adx .cck:has(input:checked){border-color:var(--ac);background:var(--okbg);color:var(--ok);font-weight:600}\n.adx .sp{flex:1}.adx .mu{color:var(--mu);font-size:12.5px}\n.lgc{width:min(380px,100%);margin:auto;background:var(--pn);border:1px solid var(--ln);border-radius:12px;box-shadow:var(--sh);padding:26px;display:flex;flex-direction:column;gap:14px}\n.lgc h2,.adm-hd h2,.ed-hd h2{margin:0;font:600 21px/1.2 Georgia,\"Iowan Old Style\",\"Palatino Linotype\",serif}\n.lgc p{margin:-8px 0 2px;color:var(--mu)}#lm{color:var(--dg);font-size:12.5px;min-height:1em}\n.adm-shell,.ed-shell{width:min(1080px,100%);margin:0 auto;background:var(--bg);border:1px solid var(--ln);border-radius:12px;box-shadow:var(--sh)}.ed-shell{width:min(1000px,100%)}\n.adm-hd,.ed-hd{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 20px;background:var(--pn);border-bottom:1px solid var(--ln);border-radius:12px 12px 0 0}\n.adm-hd .sub{color:var(--mu);font-size:12.5px;margin-top:2px}\n.pill{display:inline-flex;align-items:center;gap:7px;padding:5px 11px;border-radius:99px;font-size:12.5px;background:var(--pn2);border:1px solid var(--ln);color:var(--mu);max-width:100%}.pill:empty{display:none}\n.pill::before{content:\"\";flex:none;width:7px;height:7px;border-radius:50%;background:currentColor}\n.pill.ok{color:var(--ok);background:var(--okbg);border-color:transparent}.pill.warn{color:var(--wr);background:var(--wrbg);border-color:transparent}.pill.bad{color:var(--dg);background:var(--dgbg);border-color:transparent}\n.adm-body{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,1fr);gap:18px;padding:18px 20px 22px;align-items:start}\n@media(max-width:900px){.adm-body{grid-template-columns:1fr;padding:14px}.adm-hd,.ed-hd{padding:12px 14px}}\n.col{display:flex;flex-direction:column;gap:18px;min-width:0}\n.card{background:var(--pn);border:1px solid var(--ln);border-radius:10px}.card.danger{border-left:3px solid var(--dg)}\n.card>header{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding:11px 14px;border-bottom:1px solid var(--ln)}.card h3{margin:0;font-size:14.5px;font-weight:650}\n.card .cb{padding:12px 14px;display:flex;flex-direction:column;gap:10px}\n.hint{padding:9px 14px;color:var(--mu);font-size:12.5px;border-bottom:1px solid var(--ln);background:var(--pn2)}\n#adm .ar{display:grid;grid-template-columns:26px 40px minmax(0,1fr) auto;gap:12px;align-items:center;margin:0;padding:10px 14px;border:0;border-bottom:1px solid var(--ln);border-radius:0}#adm .ar:last-child{border-bottom:0}\n#adm .ar .n{min-width:0;text-align:right;color:var(--mu);font-variant-numeric:tabular-nums;font-weight:500}\n#adm .ar .th{width:40px;height:52px;border:1px solid var(--ln);border-radius:4px;background:var(--pn2);display:flex;align-items:center;justify-content:center;overflow:hidden;color:var(--mu)}\n#adm .ar .th img{width:100%;height:100%;object-fit:cover;border:0}\n#adm .ar .mt{min-width:0;display:flex;flex-direction:column;gap:4px}#adm .ar .t{flex:none;min-width:0;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.sub2{display:flex;gap:5px;flex-wrap:wrap}.tag{font-size:11.5px;padding:1px 7px;border-radius:5px;background:var(--pn2);border:1px solid var(--ln);color:var(--mu)}.tag.pend{color:var(--wr);background:var(--wrbg);border-color:transparent}\n.ac{display:flex;gap:2px}\n.card p{margin:0;color:var(--mu);font-size:12.5px}.kv{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:5px;font-size:12.5px;color:var(--mu)}.kv b{color:var(--tx);font-weight:650;margin-right:4px}\n#rl{max-height:250px;overflow:auto;border:1px solid var(--ln);border-radius:8px}\n.rrw{display:grid;grid-template-columns:18px 22px minmax(0,1fr) auto;gap:8px;align-items:center;padding:7px 10px;border-bottom:1px solid var(--ln);cursor:pointer}.rrw:last-child{border-bottom:0}.rrw:hover{background:var(--pn2)}.rrw.off{opacity:.5;cursor:default}\n.rrw b{color:var(--mu);font-weight:500;text-align:right;font-variant-numeric:tabular-nums}.rrw .t{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rrw small{color:var(--mu)}\n.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}\n.note{padding:8px 10px;border-radius:8px;font-size:12.5px}.note:empty{display:none}.note.ok{background:var(--okbg);color:var(--ok)}.note.bad{background:var(--dgbg);color:var(--dg)}\n.frm2{flex-direction:column}\n.ed-body{padding:16px 20px 8px;display:flex;flex-direction:column;gap:12px}.ed-ft{display:flex;gap:8px;justify-content:flex-end;padding:12px 20px 18px}\n.ed-meta{display:flex;gap:10px 22px;flex-wrap:wrap;align-items:flex-end}\n.stp{display:inline-flex;align-items:center;gap:4px}.stp input{width:64px}.stp button{width:30px;height:34px;padding:0;justify-content:center}\n.lockn{display:flex;gap:8px;align-items:center;color:var(--mu);font-size:12.5px;background:var(--pn2);border:1px solid var(--ln);border-radius:8px;padding:8px 10px}\n.tbr{display:flex;gap:2px;flex-wrap:wrap;align-items:center;padding:5px;background:var(--pn);border:1px solid var(--ln);border-radius:8px}.tbr .ib{color:var(--tx)}.tbr .sep2{width:1px;height:20px;background:var(--ln);margin:0 4px}.tbr select{padding:6px 8px;font-size:13px}\n#ea.aed{max-height:none;overflow:visible;border:0;border-radius:0;box-shadow:none;width:100%;min-height:calc(var(--ph) - var(--lkh,4in));padding-top:0;padding-bottom:.2in}\n@media(prefers-reduced-motion:no-preference){.adm-shell,.ed-shell,.lgc{animation:adin .18s ease-out}@keyframes adin{from{opacity:0;transform:translateY(6px)}}}\n#epg{max-height:62vh;overflow:auto;background:#8a8f98;border:1px solid var(--ln);border-radius:8px;padding:10px}.epage{width:var(--pw);min-height:var(--ph);margin:0 auto;background:#fff;color:#000;position:relative;box-shadow:0 2px 8px rgba(0,0,0,.35)}.epage::after{content:\"Page bottom - text below this line continues on the next page\";position:absolute;left:0;right:0;top:calc(var(--ph) - .2in);border-top:1.5px dashed #2563eb;font:10px system-ui,sans-serif;color:#2563eb;text-align:right;padding:2px 6px;pointer-events:none}.aed ul,.aed ol{margin:0;padding-left:.5in;text-align:justify}.aed li{margin:0}.aed s,.aed strike{text-decoration:line-through}.adx .szs{padding:3px 8px;font-size:12px;border-radius:6px;max-width:100%}.adx .stp select{min-width:150px}.adx .stp #eszc{display:inline-flex;gap:5px;align-items:center}.adx .stp #eszc[hidden]{display:none}.adx .stp #eszc input{width:74px}\n.elp{width:100%;height:4in;display:flex;align-items:center;justify-content:center;color:#7a8594;font-size:12px;background:repeating-linear-gradient(45deg,#f1f3f6,#f1f3f6 8px,#e6e9ee 8px,#e6e9ee 16px);border-bottom:1px dashed #9aa4b2;user-select:none}\n.aed .dp{padding-right:1.4in}.aed{tab-size:.5in}\n.lpan{display:flex;flex-direction:row;flex-wrap:wrap;align-items:flex-start;gap:8px;padding:10px;border:1px solid var(--ln);border-radius:8px;background:var(--pn2)}.lpan>div:first-child{flex:0 0 100%}.lgrp{display:flex;flex-wrap:wrap;gap:5px;align-items:center;flex:1 1 auto;border:1px solid var(--ln);border-radius:8px;padding:6px 8px;background:var(--pn)}.lgrp>b{flex:0 0 100%;font-size:12.5px}.adx .lgrp button{padding:4px 10px;font-size:12.5px}.adx .lgrp button:hover{background:var(--ac);color:#fff;border-color:var(--ac)}\n.lpan{flex-direction:column;flex-wrap:nowrap;gap:8px}.lpan>div:first-child{flex:none}.ltabs{display:flex;gap:4px;flex-wrap:wrap;border-bottom:1px solid var(--ln)}.adx .ltabs button{border-radius:7px 7px 0 0;border-bottom:0;color:var(--mu)}.adx .ltabs button.on{background:var(--ac);color:#fff;border-color:var(--ac)}.lgrp{border:0;padding:0;background:none;flex:none}.lgrp[hidden]{display:none}.adx .lgrp button{border-radius:99px}\n#ed{padding:0!important;align-items:stretch!important}#ed .ed-shell{width:100%!important;max-width:none;min-height:100vh;margin:0;border-radius:0;border:0}#ed .ed-hd{border-radius:0}#ed #epg{max-height:calc(100vh - 150px);min-height:60vh}\n</style></head><body>\n<main>\n<h1 class=\"no-print\">Property Documentation Tool <button id=\"admBtn\" style=\"float:right;font-size:12px;font-weight:400\">🔒 Admin</button><button id=\"topPrint\" class=\"pri\" title=\"Print (Ctrl+P)\">🖨 Print</button></h1>\n\n<div id=\"det\" class=\"box no-print\"><div id=\"form\"></div>\n <div id=\"xtog\" style=\"display:flex;flex-wrap:wrap;gap:8px 20px;align-items:center;margin:0 0 8px;padding:6px 8px;border:1px dashed var(--bd);border-radius:6px\"><b>More details - tick to show:</b>\n  <label style=\"display:inline-flex;gap:6px;align-items:center;cursor:pointer\"><input type=\"checkbox\" data-show=\"purch2\" style=\"width:18px;height:18px;padding:0;accent-color:#2563eb\"> Purchaser 2 Details</label>\n  <label style=\"display:inline-flex;gap:6px;align-items:center;cursor:pointer\"><input type=\"checkbox\" data-show=\"behalf\" style=\"width:18px;height:18px;padding:0;accent-color:#2563eb\"> On Behalf Details</label>\n  <label style=\"display:inline-flex;gap:6px;align-items:center;cursor:pointer\"><input type=\"checkbox\" data-show=\"dealer\" style=\"width:18px;height:18px;padding:0;accent-color:#2563eb\"> Dealer/C.E.O Details</label>\n  <label style=\"display:inline-flex;gap:6px;align-items:center;cursor:pointer\"><input type=\"checkbox\" data-show=\"donor\" style=\"width:18px;height:18px;padding:0;accent-color:#2563eb\"> Donor Details</label>\n  <label style=\"display:inline-flex;gap:6px;align-items:center;cursor:pointer\"><input type=\"checkbox\" data-show=\"donee\" style=\"width:18px;height:18px;padding:0;accent-color:#2563eb\"> Donee Details</label>\n  <label style=\"display:inline-flex;gap:6px;align-items:center;cursor:pointer\"><input type=\"checkbox\" data-show=\"investor\" style=\"width:18px;height:18px;padding:0;accent-color:#2563eb\"> Investor Details</label></div>\n <div style=\"display:flex;flex-wrap:wrap;gap:6px;align-items:center\"><button id=\"sv\" class=\"pri\" title=\"Apply these details to all pages (or press Enter in any box)\">Save / Enter</button><button id=\"clr\">Clear details</button></div>\n</div>\n\n<div id=\"catbox\" class=\"box no-print\"><b>Document Category</b>\n <div class=\"cdd\"><button id=\"catBtn\" type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\" title=\"Tick one or more categories - only their pages are shown and printed\"><span id=\"catTxt\">Select category...</span><span aria-hidden=\"true\">▾</span></button>\n  <div id=\"catMenu\" role=\"group\" aria-label=\"Document category\"></div></div>\n <span id=\"catInfo\"></span>\n</div>\n\n<div id=\"doc\">\n <div id=\"tb\"></div>\n <div id=\"catEmpty\" class=\"no-print\" style=\"display:none;padding:34px 16px;text-align:center;background:var(--card);color:var(--tx)\"></div>\n <div id=\"pages\"></div>\n</div>\n<p class=\"no-print\" style=\"text-align:center\"><button id=\"addPg\">+ Add page</button></p>\n</main>\n\n<div id=\"fl\"><select id=\"fff\"><option>Calibri</option><option>Times New Roman</option><option>Aptos</option><option>Arial</option><option>Georgia</option><option>Courier New</option><option>Verdana</option></select><select id=\"ffs\"><option>8</option><option>9</option><option>10</option><option>11</option><option selected=\"\">12</option><option>14</option><option>16</option><option>18</option><option>20</option><option>24</option><option>28</option><option>36</option><option>48</option><option>72</option></select><button data-g=\"1\" title=\"Bigger text\">A⁺</button><button data-g=\"-1\" title=\"Smaller text\">A⁻</button><button data-c=\"removeFormat\" title=\"Clear formatting\">⌫</button><span class=\"br\"></span><button data-c=\"bold\"><b>B</b></button><button data-c=\"italic\"><i>I</i></button><button data-c=\"underline\"><u>U</u></button><button data-c=\"strikeThrough\"><s>S</s></button><input type=\"color\" id=\"fhc\" value=\"#ffff00\" title=\"Highlight\"><input type=\"color\" id=\"fcc\" value=\"#ff0000\" title=\"Text colour\"><button data-c=\"insertUnorderedList\" title=\"Bullets\">•≡</button><button data-c=\"insertOrderedList\" title=\"Numbering\">1≡</button><select id=\"fls\"><option value=\"\">Spacing</option><option>1</option><option>1.15</option><option>1.5</option><option>2</option></select><button data-c=\"justifyLeft\" title=\"Left\">⯇</button><button data-c=\"justifyCenter\" title=\"Center\">≡</button><button data-c=\"justifyRight\" title=\"Right\">⯈</button><button data-c=\"justifyFull\" title=\"Justify\">☰</button></div>\n<div id=\"fr\" class=\"box\"><b>Find &amp; Replace</b><input id=\"fi\" placeholder=\"Find\"><input id=\"ri\" placeholder=\"Replace with\"><div style=\"display:flex;gap:6px\"><button id=\"fn\">Find next</button><button id=\"fa\">Replace all</button><button id=\"fx\">✕</button></div></div>\n<input type=\"file\" id=\"file\" accept=\"application/pdf,image/jpeg,image/png\" hidden=\"\">\n<div id=\"pm\" class=\"modal no-print\"><div class=\"box\"><b>Print</b>\n<div id=\"pinfo\" style=\"font-size:12px;opacity:.75\"></div>\n<label>Paper type <select id=\"ptype\"><option>Plain</option><option>Glossy</option><option>Matte</option><option>Photo</option><option>Card stock</option></select></label>\n<div id=\"psz\" style=\"font-size:13px\"></div>\n<label>Colour <select id=\"pcol\"><option value=\"c\">Colour</option><option value=\"bw\">Black &amp; white</option></select></label>\n<label><input type=\"radio\" name=\"pr\" value=\"all\" checked=\"\"> All pages (of the selected category)</label>\n<label><input type=\"radio\" name=\"pr\" value=\"cur\"> Current page</label>\n<label><input type=\"radio\" name=\"pr\" value=\"cus\"> Custom pages <input id=\"pcs\" placeholder=\"e.g. 1,3-5\" size=\"10\"></label>\n<div style=\"display:flex;gap:6px\"><button class=\"pri\" id=\"pgo\">Print</button><button id=\"pcx\">Cancel</button></div></div></div>\n<div id=\"toast\"></div>\n\n<script>\n/* snapshot of the page exactly as loaded (before any script edits it) - used to build the downloaded copy when the browser cannot re-read the local file */\nconst SRC0='<!doctype html>\\n'+document.documentElement.outerHTML;\nconst $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];\nconst FONTS=[['Calibri','Calibri, Carlito'],['Times New Roman','Times New Roman, Tinos'],['Arial','Arial, Arimo'],['Courier New','Courier New, Cousine'],['Open Sans','Open Sans'],['Roboto','Roboto'],['Lato','Lato'],['Merriweather','Merriweather'],['Noto Sans','Noto Sans'],['Poppins','Poppins'],['Montserrat','Montserrat'],['Georgia','Georgia']];\nconst FOPT=FONTS.map(([l,v])=>'<option value=\"'+v+'\" style=\"font-family:'+v+'\">'+l+'</option>').join('');\nconst SOPT=[8,9,10,11,12,14,16,18,20,24,28,36].map(x=>'<option'+(x==12?' selected':'')+'>'+x+'</option>').join('');\nconst LSOPT='<option value=\"\">Spacing</option>'+['1','1.15','1.5','2','2.5','3'].map(x=>'<option>'+x+'</option>').join('');\nconst GR=[['Plot Details',[['plot_no','Plot No'],['sector','Sector'],['ref_no','Reference No'],['measuring','Measuring'],['category','Category',['Residential','Commercial']]]]];\n[['seller','Seller Details'],['purch','Purchaser Details'],['purch2','Purchaser 2 Details','purch2'],['behalf','On Behalf (Representative)','behalf'],['dealer','Dealer/C.E.O Details','dealer'],['donor','Donor Details','donor'],['donee','Donee Details','donee'],['investor','Investor Details','investor']].forEach(([p,t,need])=>GR.push([t,[[p+'_name','Name'],[p+'_rel','Relation',['S/O','D/O','W/O','F/O','M/O','H/O','Guardian','Widow of','Representative of']],[p+'_relname','Relation Name'],[p+'_cnic','CNIC'],[p+'_res','Residence']].concat(p==='dealer'?[['dealer_estate','Estate Name'],['dealer_reg','REG No']]:[]),need]));\nconst D={},A={},L={},PARTY=['seller','purch','purch2','behalf','dealer','donor','donee','investor'];\n$('#form').innerHTML=GR.map(([t,fs,nd])=>`<fieldset${nd?` data-need=\"${nd}\" hidden`:''}><legend>${t}</legend><div class=\"g\">${fs.map(([k,l,o])=>{L[k]=l;return o?`<select data-f=\"${k}\"><option value=\"\">${l}</option>${o.map(x=>`<option>${x}</option>`).join('')}</select>`:`<input data-f=\"${k}\" placeholder=\"${l}\">`}).join('')}</div></fieldset>`).join('');\nPARTY.forEach(p=>{L[p+'_rel']='Relation';L[p+'_relname']='Relation Name';L[p+'_t']='Title'});\nconst TT=p=>({'S/O':'Mr.','D/O':'Miss','W/O':'Mrs.','F/O':'Mr.','M/O':'Mrs.','H/O':'Mr.','Widow of':'Mrs.','Guardian':'Mr./Mrs.','Representative of':'Mr./Mrs.'})[A[p+'_rel']]||'Mr./Mrs.';\nconst BW={_name:2,_relname:2,_cnic:2,_res:4,_rel:.6,_t:.6,_estate:2,_reg:1.5},bw=k=>{const m=Object.keys(BW).find(x=>k.endsWith(x));return m?BW[m]:1};\n$$('[data-f]').forEach(e=>{e.oninput=()=>{D[e.dataset.f]=e.value};e.onkeydown=ev=>{if(ev.key==='Enter'){ev.preventDefault();save()}}});\nfunction save(){for(const k in A)delete A[k];Object.assign(A,D);sync();toast('Saved - all pages updated')}\n$('#sv').onclick=save;\n$$('#xtog [data-show]').forEach(c=>c.onchange=()=>{const f=$('#det fieldset[data-need=\"'+c.dataset.show+'\"]');if(f){f.hidden=!c.checked;if(c.checked){const i=f.querySelector('input');i&&i.focus()}}});\nfunction sync(){\n $$('[data-k]').forEach(e=>{const k=e.dataset.k,m=e.dataset.m||'';let v=/_t$/.test(k)?TT(k.slice(0,-2)):A[k];v=(v||'').trim();\n  if(!v&&m.includes('n')){e.classList.remove('bl');e.style.width='';e.textContent='';return}\n  if(!v){e.classList.add('bl');e.style.width=bw(k)+'in';e.textContent='';return}\n  e.classList.remove('bl');e.style.width='';\n  if(m.includes('u'))v=v.toUpperCase();if(m.includes('z')&&/^\\d$/.test(v))v='0'+v;e.textContent=v});\n const h=[['Plot',A.plot_no],['Sector',A.sector],['Ref',A.ref_no],['',[A.measuring,A.category].filter(Boolean).join(' ')],['Seller',A.seller_name],['Purchaser',A.purch_name],['Purchaser 2',A.purch2_name],['On behalf',A.behalf_name],['Dealer/C.E.O',A.dealer_name],['Estate',A.dealer_estate],['Reg',A.dealer_reg],['Donor',A.donor_name],['Donee',A.donee_name],['Investor',A.investor_name]].filter(x=>x[1]).map(x=>(x[0]?x[0]+': ':'')+x[1]).join('  |  ');\n $$('.hd').forEach(e=>e.textContent=h);\n szCss();lockAll();reflow();\n}\n$('#clr').onclick=()=>{$$('[data-f]').forEach(e=>e.value='');for(const k in D)delete D[k];for(const k in A)delete A[k];sync()};\n\n/* ===== document categories: tick one or more, only their pages are shown / printed ===== */\nconst DEFCATS=[['normal','Normal Set'],['hiba','Hiba Set'],['open','Open Transfer'],['behalf','On Behalf']],CN={},SELC=new Set();let CATS=[];\nfunction setCats(a){CATS=a.map(x=>[x[0],x[1]]);Object.keys(CN).forEach(k=>delete CN[k]);CATS.forEach(([k,l])=>CN[k]=l);[...SELC].forEach(k=>{if(!CN[k])SELC.delete(k)})}\nsetCats(DEFCATS);\nconst catsOf=p=>(p.dataset.cats||'').split(',').filter(Boolean);\nconst pageOn=p=>!SELC.size||catsOf(p).some(c=>SELC.has(c));\nconst visPages=()=>$$('.page:not(.coff)');\nfunction catCount(k){return (typeof SAVED!=='undefined'?SAVED:[]).filter(e=>(e.cats||[]).includes(k)).length}\nfunction renderCatMenu(){$('#catMenu').innerHTML=CATS.map(([k,l])=>`<label><input type=\"checkbox\" data-c=\"${k}\"${SELC.has(k)?' checked':''}><span>${l}</span> <small>(${catCount(k)} page${catCount(k)==1?'':'s'})</small></label>`).join('')+'<div class=\"cfoot\"><button type=\"button\" id=\"catAll\">Select all</button><button type=\"button\" id=\"catClr\">Clear (show all pages)</button></div>'}\nfunction applyCat(){\n $$('.page').forEach(p=>p.classList.toggle('coff',!pageOn(p)));\n const names=CATS.filter(([k])=>SELC.has(k)).map(c=>c[1]),n=visPages().length;\n $('#catTxt').textContent=names.length?names.join(', '):'Select category...';\n $('#catInfo').textContent=names.