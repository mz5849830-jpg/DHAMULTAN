{"savedAt":1793472280856,"data":{"title":"DHAMULTAN","logo":"D","logoImg":"/logo.png","accent":0,"accentCustom":"","siteBg":"#f6faf7","surface":"#ffffff","nav":[{"label":"Home","route":"home","dd":false},{"label":"Documents","route":"docs","dd":false},{"label":"Videos","route":"videos","dd":false},{"label":"Gallery","route":"gallery","dd":false},{"label":"Newsflash","route":"news","dd":true},{"label":"About","route":"p:about","dd":true},{"label":"Contact","route":"p:contact","dd":true},{"label":"Disclaimer","route":"p:disclaimer","dd":true}],"delay":4000,"slides":[{"t":"Premium Homes at DHA Multan","s":"","img":"/media/73a75a89970b9233.webp","lk":"route","slug":"premium-homes-at-dha-multan","route":"v:dha-farmhouses-development-update-october-2026"}],"boxes":[{"title":"Transfer Fee ","code":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>DHA Multan Transfer Calculator</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;600;800&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--bg:#f1f3f5;--card:#fff;--ink:#14213d;--mute:#667085;--line:#e3e7ec;--acc:#14213d;--acc-ink:#fff;--hi:#b8893a;--soft:#f7f8fa;--tot:#14213d;--tot-ink:#fff;--warn:#9a5b00;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}\n@media (prefers-color-scheme:dark){:root:not([data-theme=\"light\"]){--bg:#0d1117;--card:#161b22;--ink:#e6edf3;--mute:#8b98a8;--line:#262d38;--acc:#d4a853;--acc-ink:#14110a;--hi:#d4a853;--soft:#1b212a;--tot:#1d2633;--tot-ink:#fff;--warn:#e0a84e}}\n:root[data-theme=\"dark\"]{--bg:#0d1117;--card:#161b22;--ink:#e6edf3;--mute:#8b98a8;--line:#262d38;--acc:#d4a853;--acc-ink:#14110a;--hi:#d4a853;--soft:#1b212a;--tot:#1d2633;--tot-ink:#fff;--warn:#e0a84e}\nhtml{scroll-padding-top:env(safe-area-inset-top,0px)}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--ink);font-family:\"Schibsted Grotesk\",system-ui,-apple-system,Segoe UI,sans-serif;line-height:1.45;-webkit-font-smoothing:antialiased}\n.hero{background:#14213d;color:#fff;border-bottom:3px solid #b8893a}\n.hero .in{max-width:980px;margin:0 auto;padding:22px 16px 18px}\n.eyebrow{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:#d4a853;font-weight:600;margin-bottom:4px}\nh1{font-size:1.55rem;font-weight:800;margin:0;letter-spacing:-.01em}\n.sub{color:var(--mute);margin:4px 0 0;font-size:.9rem}.hero .sub{color:#b9c2d3}\n.wrap{max-width:980px;margin:0 auto;padding:16px 16px 36px}\n.panel{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;box-shadow:0 1px 2px rgba(16,24,40,.04)}\n.tabs{display:inline-flex;gap:2px;margin-bottom:14px;padding:3px;background:var(--card);border:1px solid var(--line);border-radius:10px}\n.tabs button{font:inherit;font-size:.88rem;font-weight:600;padding:7px 18px;border-radius:7px;border:0;background:transparent;color:var(--mute);cursor:pointer}\n.tabs button[aria-pressed=true]{background:var(--acc);color:var(--acc-ink)}\n.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px}\nlabel{display:block;font-size:.72rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--mute);margin-bottom:6px}\nselect,input{width:100%;font:inherit;font-size:.95rem;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--soft);color:var(--ink)}\n:focus-visible{outline:2px solid var(--hi);outline-offset:1px}\n.seg{display:flex;border:1px solid var(--line);border-radius:8px;overflow:hidden}\n.seg button{flex:1;font:inherit;font-size:.9rem;font-weight:600;padding:10px;border:0;background:var(--soft);color:var(--mute);cursor:pointer}\n.seg button[aria-pressed=true]{background:var(--acc);color:var(--acc-ink)}\n.seg button+button{border-left:1px solid var(--line)}\n.note{margin-top:12px;font-size:.9rem;color:var(--warn)}\n.sheets{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;margin-top:14px}\n.sheets .panel{padding:0;overflow:hidden}\n.sh{padding:16px 18px 12px;border-bottom:1px solid var(--line);border-top:3px solid var(--hi)}\n.sh .k{font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--hi);font-weight:700}\nh2{font-size:1.1rem;margin:2px 0 0;font-weight:800}\n.tag{font-size:.82rem;color:var(--mute);margin-top:2px}\n.sheets table{margin:0 18px;width:calc(100% - 36px)}\ntable{border-collapse:collapse;font-variant-numeric:tabular-nums}\ntd,th{padding:10px 0;border-bottom:1px solid var(--line);font-size:.92rem;vertical-align:top;text-align:left}\nth{font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}\ntd.r{text-align:right;white-space:nowrap;font-weight:600}\ntr:last-child td{border-bottom:0}\ntd small{display:block;color:var(--mute);font-weight:400;font-size:.78rem}\n.total{display:flex;justify-content:space-between;align-items:baseline;margin:6px 0 0;padding:16px 18px;background:var(--tot);color:var(--tot-ink);font-weight:600}\n.total span:first-child{font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:#b9c2d3}\n.total span:last-child{font-size:1.4rem;font-weight:800;color:#e7c27a}\n.actions{display:flex;gap:8px;justify-content:flex-end;margin-top:14px}\n.btn{font:inherit;font-size:.9rem;font-weight:600;padding:9px 16px;border-radius:8px;border:1px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer}\n.btn.p{background:var(--acc);color:var(--acc-ink);border-color:var(--acc)}\n.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}\n.adm h3{margin:20px 0 8px;font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:var(--hi)}\n.adm td input{padding:6px}\n.msg{font-size:.86rem;margin-top:8px;color:var(--mute)}\n.dcbar{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-top:16px;padding-top:16px;border-top:1px solid var(--line)}\n.dcbar .dc{background:var(--soft);border:1px solid var(--line);border-left:3px solid var(--hi);border-radius:8px;padding:10px 14px}\n.dcbar .dc span{display:block;font-size:.72rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--mute)}\n.dcbar .dc b{display:block;font-size:1.25rem;font-weight:800;font-variant-numeric:tabular-nums;color:var(--ink)}\n.dcbar .dc small{display:block;font-size:.78rem;color:var(--mute)}\n[hidden]{display:none!important}\n@page{size:letter;margin:0}\n#pm{position:fixed;inset:0;background:rgba(10,15,25,.55);display:flex;align-items:center;justify-content:center;z-index:50;padding:16px}\n#pm .box{background:var(--card);border-radius:12px;padding:20px;width:100%;max-width:340px}\n#pm h3{margin:0 0 4px;font-size:1.05rem}#pm p{margin:0 0 14px;color:var(--mute);font-size:.88rem}\n#pm .btn{display:block;width:100%;margin-top:8px;text-align:left}\n#pv{position:fixed;inset:0;background:#4b5563;overflow:auto;z-index:60}\n.pvbar{position:sticky;top:0;z-index:2;display:flex;gap:8px;align-items:center;padding:10px 12px;padding-top:calc(10px + env(safe-area-inset-top,0px));background:#14213d;color:#fff}\n.pvbar b{flex:1;font-size:.95rem}.pvbar .btn{padding:7px 14px}\n.pvmsg{background:#fff3cd;color:#5c4400;font-size:.85rem;padding:8px 12px}\n.pvbody{padding:16px 0 32px}\n.sheet{width:8.5in;min-height:11in;margin:0 auto 16px;padding:2.5in .8in .7in;background:#fff;color:#14213d;box-shadow:0 4px 18px rgba(0,0,0,.35);font-family:\"Schibsted Grotesk\",system-ui,sans-serif;position:relative;font-size:11pt}\n.sheet .lh{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:3px solid #b8893a;padding-bottom:12px}\n.sheet .org{font-size:9pt;letter-spacing:.16em;text-transform:uppercase;color:#b8893a;font-weight:700}\n.sheet h1{font-size:20pt;margin:2px 0 0;color:#14213d}\n.sheet .dt{font-size:9pt;color:#667085;text-align:right}\n.sheet .meta{display:grid;grid-template-columns:repeat(4,1fr);margin:20px 0;border:1px solid #e3e7ec;border-radius:6px}\n.sheet .meta div{padding:10px 12px;border-right:1px solid #e3e7ec}.sheet .meta div:last-child{border-right:0}\n.sheet .meta span{display:block;font-size:7.5pt;letter-spacing:.1em;text-transform:uppercase;color:#667085}\n.sheet .meta b{font-size:11pt}\n.sheet h2{font-size:12pt;margin:0 0 6px;color:#14213d}\n.sheet table{width:100%;border-collapse:collapse;margin:0}\n.sheet td,.sheet th{padding:10px 6px;border-bottom:1px solid #e3e7ec;font-size:10.5pt;color:#14213d;text-align:left}\n.sheet th{font-size:8pt;letter-spacing:.08em;text-transform:uppercase;color:#667085;background:#f7f8fa}\n.sheet th.r,.sheet td.r{text-align:right}\n.sheet td small{display:block;color:#667085;font-size:8.5pt}\n.sheet .tot{display:flex;justify-content:space-between;align-items:center;margin-top:18px;padding:14px 16px;background:#14213d;color:#fff;border-radius:6px}\n.sheet .tot span:first-child{font-size:9pt;letter-spacing:.1em;text-transform:uppercase}\n.sheet .tot span:last-child{font-size:17pt;font-weight:800;color:#e7c27a}\n.sheet .ft{margin-top:18px;font-size:8pt;color:#667085;border-top:1px solid #e3e7ec;padding-top:8px}\n.sheet .bg{position:absolute;left:0;top:0;width:100%;height:100%;object-fit:fill;z-index:0}\n.sheet .ct{position:relative;z-index:1}\n.sheet .ttl{text-align:center;font-size:28pt;font-weight:800;line-height:1.15;margin:0 0 6px;color:#14213d;letter-spacing:-.01em}\n.sheet .dt{text-align:right;margin-bottom:12px}\n#pm .lhbox{border:1px solid var(--line);border-radius:8px;padding:10px;margin-bottom:6px;background:var(--soft)}\n#pm .lhbox b{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--mute)}\n#pm .lhbox div{font-size:.88rem;margin:4px 0}\n#pm .box{max-height:92vh;overflow:auto}\n@media print{\n body>*:not(#pv){display:none!important}\n body{background:#fff}\n #pv{position:static;overflow:visible;background:#fff}\n .pvbar,.pvmsg,.dcbar{display:none!important}\n .pvbody{padding:0}\n .sheet{zoom:1!important;width:8.5in;height:11in;min-height:0;margin:0;box-shadow:none;page-break-after:always;break-after:page;overflow:hidden;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n .sheet:last-child{page-break-after:auto;break-after:auto}\n}\n</style>\n</head>\n<body>\n<header class=\"hero\"><div class=\"in\"><div class=\"eyebrow\">DHA Multan</div><h1>Transfer Cost Calculator</h1><p class=\"sub\">Select category, plot and filer status to see seller and purchaser charges.</p></div></header>\n<div class=\"wrap\">\n<div class=\"tabs\" id=\"tabsBar\"><button id=\"tCalc\" aria-pressed=\"true\">Calculator</button><button id=\"tAdm\" aria-pressed=\"false\">Admin</button></div>\n\n<div id=\"vCalc\">\n <div class=\"panel sel\">\n  <div class=\"grid\">\n   <div><label for=\"fCat\">Category</label><select id=\"fCat\"></select></div>\n   <div><label for=\"fSize\">Plot size</label><select id=\"fSize\"></select></div>\n   <div><label for=\"fSec\">Sector</label><select id=\"fSec\"></select></div>\n   <div><label id=\"lS\">Seller status</label><div class=\"seg\" id=\"gS\" role=\"group\" aria-labelledby=\"lS\"><button aria-pressed=\"true\" data-v=\"F\">Filer</button><button aria-pressed=\"false\" data-v=\"N\">Non-filer</button></div></div>\n   <div><label id=\"lB\">Purchaser status</label><div class=\"seg\" id=\"gB\" role=\"group\" aria-labelledby=\"lB\"><button aria-pressed=\"true\" data-v=\"F\">Filer</button><button aria-pressed=\"false\" data-v=\"N\">Non-filer</button></div></div>\n  </div>\n  <div class=\"dcbar\" id=\"dcBar\" aria-live=\"polite\">\n   <div class=\"dc\"><span>FBR DC rate</span><b id=\"dcF\">-</b><small>Plot value as per FBR</small></div>\n   <div class=\"dc\"><span>E-Stamp DC rate</span><b id=\"dcE\">-</b><small id=\"dcEn\">Plot value as per E-Stamp</small></div>\n  </div>\n </div>\n <div class=\"note\" id=\"oEmpty\" hidden></div>\n <div class=\"sheets\">\n  <section class=\"panel\"><div class=\"sh\"><div class=\"k\">Seller</div><h2>236C advance tax</h2><div class=\"tag\" id=\"oSt\"></div></div><table id=\"oSeller\"></table><div class=\"total\"><span>Seller total</span><span id=\"oSTot\"></span></div></section>\n  <section class=\"panel\"><div class=\"sh\"><div class=\"k\">Purchaser</div><h2>236K tax &amp; fees</h2><div class=\"tag\" id=\"oBt\"></div></div><table id=\"oPurchaser\"></table><div class=\"total\"><span>Purchaser total</span><span id=\"oBTot\"></span></div></section>\n </div>\n <div class=\"actions\"><button class=\"btn p\" id=\"bCopy\">Copy summary</button><button class=\"btn\" id=\"bPrint\">Print</button></div>\n</div>\n\n<div id=\"vAdm\" class=\"panel adm\" hidden>\n <h2>Admin: rates and fees</h2>\n <p class=\"sub\" style=\"margin:4px 0 0\">Changes save for everyone who opens this page.</p>\n <div id=\"aLock\">\n  <form id=\"aForm\" autocomplete=\"off\" style=\"max-width:340px\">\n   <h3 style=\"margin-top:14px\">Admin login</h3>\n   <label for=\"aUser\">Username</label><input id=\"aUser\" autocomplete=\"username\" autocapitalize=\"none\" spellcheck=\"false\">\n   <label for=\"aPass\" style=\"margin-top:10px\">Password</label><input id=\"aPass\" type=\"password\" autocomplete=\"current-password\">\n   <div class=\"row\"><button class=\"btn p\" type=\"submit\">Log in</button></div>\n  </form>\n  <div class=\"msg\" id=\"aLoginMsg\" aria-live=\"polite\"></div>\n </div>\n <div id=\"aBody\" hidden>\n  <div class=\"row\" style=\"margin-top:0\"><button class=\"btn\" id=\"aOut\">Log out</button></div>\n  <h3>Category</h3>\n  <div class=\"grid\"><div><label for=\"aCat\">Category to edit</label><select id=\"aCat\"></select></div><div><label for=\"aCatName\">Category name (rename)</label><input id=\"aCatName\" placeholder=\"Category name\"></div></div>\n  <div class=\"row\"><input id=\"aNewCat\" placeholder=\"New category, e.g. Farmhouse\" style=\"max-width:260px\" aria-label=\"New category name\"><button class=\"btn\" id=\"aAddCat\">Add category</button><button class=\"btn\" id=\"aDelCat\">Delete this category</button></div>\n  <div class=\"msg\">A new category gets the same fields: FBR fee, Nadra, processing, stamp duty, 236C and 236K filer/non-filer rates, plot sizes, PST, DHA transfer fee and sectors with FBR DC / E-Stamp DC.</div>\n  <h3>Taxes and fees for this category</h3>\n  <div class=\"grid\" id=\"aG\"></div>\n  <h3>Plot size</h3>\n  <div class=\"grid\"><div><label for=\"aSize\">Plot size</label><select id=\"aSize\"></select></div><div><label for=\"aPst\">PST tax (Rs.)</label><input id=\"aPst\" type=\"number\" min=\"0\"></div><div><label for=\"aTfr\">DHA transfer fee (Rs.)</label><input id=\"aTfr\" type=\"number\" min=\"0\"></div></div>\n  <div class=\"row\"><input id=\"aNewSize\" placeholder=\"New plot size, e.g. 3 Kanal\" style=\"max-width:260px\" aria-label=\"New plot size name\"><button class=\"btn\" id=\"aAddSize\">Add plot size</button><button class=\"btn\" id=\"aDelSize\">Delete this plot size</button></div>\n  <h3>Sectors for this plot size</h3>\n  <table id=\"aT\"></table>\n  <div class=\"row\"><button class=\"btn\" id=\"aAddSec\">Add sector</button></div>\n  <div class=\"row\"><button class=\"btn p\" id=\"aSave\">Save changes</button><button class=\"btn\" id=\"aReset\">Restore chart defaults</button></div>\n  <div class=\"msg\" id=\"aMsg\" aria-live=\"polite\"></div>\n  <h3>Change username and password</h3>\n  <form id=\"cForm\" autocomplete=\"off\" style=\"max-width:340px\">\n   <label for=\"cOld\">Current password</label><input id=\"cOld\" type=\"password\" autocomplete=\"current-password\">\n   <label for=\"cUser\" style=\"margin-top:10px\">New username (leave as is to keep it)</label><input id=\"cUser\" autocapitalize=\"none\" spellcheck=\"false\" autocomplete=\"off\">\n   <label for=\"cNew\" style=\"margin-top:10px\">New password</label><input id=\"cNew\" type=\"password\" autocomplete=\"new-password\">\n   <label for=\"cNew2\" style=\"margin-top:10px\">Confirm new password</label><input id=\"cNew2\" type=\"password\" autocomplete=\"new-password\">\n   <div class=\"row\"><button class=\"btn p\" type=\"submit\">Update login</button></div>\n  </form>\n  <div class=\"msg\" id=\"cMsg\" aria-live=\"polite\"></div>\n </div>\n</div>\n<p class=\"msg\" style=\"text-align:center;margin-top:16px\">Version 15</p>\n</div>\n\n<div id=\"pm\" hidden><div class=\"box\" role=\"dialog\" aria-label=\"Print options\"><h3>Print</h3><p>Each fee sheet prints on its own Letter page. The top 2.5 in is left blank for your letterhead.</p>\n<div class=\"lhbox\"><b>Letterhead</b><div id=\"lhSt\">None uploaded</div><div class=\"msg\" style=\"margin:0 0 6px\">Tap Upload and pick a JPG or PNG. On a PC you can also drag the image here or paste it with Ctrl+V.</div><label class=\"btn\" for=\"lhFile\" id=\"lhUp\" style=\"cursor:pointer;margin-bottom:0\">Upload letterhead (image)</label><button class=\"btn\" id=\"lhRm\" hidden>Remove letterhead</button><input type=\"file\" id=\"lhFile\" accept=\"image/*,.jpg,.jpeg,.png,.webp\" style=\"position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;pointer-events:none\" tabindex=\"-1\"></div>\n<button class=\"btn\" data-p=\"seller\">Seller Transfer Fee</button><button class=\"btn\" data-p=\"buyer\">Purchaser Transfer Fee</button><button class=\"btn\" data-p=\"both\">Both (separate pages)</button><button class=\"btn\" data-p=\"x\" style=\"text-align:center;margin-top:14px\">Cancel</button></div></div>\n<div id=\"pv\" hidden><div class=\"pvbar\"><b>Print preview &middot; Letter</b><button class=\"btn\" id=\"pvDl\" hidden>Download</button><button class=\"btn p\" id=\"pvPrint\">Print</button><button class=\"btn\" id=\"pvClose\">Close</button></div><div class=\"pvmsg\" id=\"pvMsg\" hidden></div><div class=\"pvbody\" id=\"pvBody\"></div></div>\n<script>\nconst sec=a=>Object.entries(a).map(([k,v])=>({k,f:v[0],e:v[1]}));\nconst G={nadra:1310,proc:15000,sF:2.75,sN:11.5,bF:1.25,bN:10.5,fbrFee:0};\nconst CATS=[\"Residential\",\"Commercial\",\"Villa\",\"Hiba\"];\nconst RES=[\n{n:\"5 Marla\",pst:12500,tfr:80350,s:sec({\"P&T\":[1620000,1511135],\"V\":[1466250,1367715],\"E2\":[1250000,1166000]})},\n{n:\"8 Marla\",pst:20000,tfr:100350,s:sec({\"V\":[2346000,2188344]})},\n{n:\"10 Marla\",pst:25000,tfr:110350,s:sec({\"B1\":[3272500,3052580],\"E1\":[2500000,2332000],\"U\":[2500000,2332000]})},\n{n:\"1 Kanal\",pst:50000,tfr:150350,s:sec({\"A\":[5440000,5074420],\"B2\":[5440000,5074420],\"D\":[5000000,4664000],\"E\":[5000000,4664000],\"F\":[5000000,4664000],\"G\":[5000000,4664000],\"U\":[5000000,4664000],\"H\":[5610000,5233000],\"I\":[6545000,6105160],\"J\":[6545000,6105160],\"K\":[6000000,5596800],\"L\":[4000000,null],\"M\":[7735000,7215200],\"N\":[5950000,5550160],\"O\":[5400000,5037120],\"Q\":[6100000,5690080],\"R\":[6100000,5690080],\"S\":[4400000,4104320],\"W1\":[2800000,2611840],\"W2\":[2800000,2611840],\"X\":[3400000,3171520],\"Y\":[3400000,3171520]})},\n{n:\"2 Kanal\",pst:100000,tfr:250350,s:sec({\"A\":[10880000,10148840],\"N\":[10880000,10148840]})}];\nconst clone=o=>JSON.parse(JSON.stringify(o));\nconst DEFAULT={cats:CATS.map(n=>({n,g:{...G},sizes:n==\"Residential\"?clone(RES):[]}))};\nlet isEditor=false,loggedIn=false,tries=0,lockUntil=0,\n adminCred={user:\"arslanjaz3220\",salt:\"E8ASI0CqikGb8umZ0PT/lg==\",hash:\"+1psBTf0lCmEF4dOhLq9QvvviLLJiK9IiJYomaSnBj8=\"},\n CFG=clone(DEFAULT),draft=null,dbRef=null,credRef=null,sS=\"F\",sB=\"F\",aCi=0,aIdx=0;\nconst $=id=>document.getElementById(id);\nconst fmt=n=>\"Rs. \"+Math.round(n).toLocaleString(\"en-US\");\nconst fmtPlain=n=>\"Rs. \"+Math.round(n);\nconst SD_PCT=2,SD_FIXED=4116; // fixed stamp duty: 2% of E-Stamp DC + Rs. 4116\nconst row=(a,b,s)=>`<tr><td>${a}${s?`<small>${s}</small>`:\"\"}</td><td class=\"r\">${b}</td></tr>`;\nconst esc=s=>String(s).replace(/[&<>\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\n// accept old saved data (single category) and make sure all four categories exist\nfunction normalize(d){\n  let cats;\n  if(d&&Array.isArray(d.cats))cats=clone(d.cats);\n  else if(d&&d.g&&Array.isArray(d.sizes))cats=[{n:\"Residential\",g:clone(d.g),sizes:clone(d.sizes)}];\n  else cats=[];\n  if(!cats.length)cats=clone(DEFAULT.cats);\n  cats.forEach(c=>{c.g={...G,...c.g};c.sizes=c.sizes||[]});\n  return {cats};\n}\n// ---- Calculator ----\nfunction curCat(){return CFG.cats.find(c=>c.n===$(\"fCat\").value)||CFG.cats[0]}\nfunction fillCat(){\n  const p=$(\"fCat\").value;\n  $(\"fCat\").innerHTML=CFG.cats.map(c=>`<option>${esc(c.n)}</option>`).join(\"\");\n  if(CFG.cats.some(c=>c.n===p))$(\"fCat\").value=p;\n  fillSize();\n}\nfunction fillSize(){\n  const c=curCat(),p=$(\"fSize\").value;\n  $(\"fSize\").innerHTML=c.sizes.map(z=>`<option>${esc(z.n)}</option>`).join(\"\");\n  if(c.sizes.some(z=>z.n===p))$(\"fSize\").value=p;\n  fillSec();\n}\nfunction fillSec(){\n  const c=curCat(),z=c.sizes.find(x=>x.n===$(\"fSize\").value)||c.sizes[0],p=$(\"fSec\").value;\n  $(\"fSec\").innerHTML=z?z.s.map(x=>`<option>${esc(x.k)}</option>`).join(\"\"):\"\";\n  if(z&&z.s.some(x=>x.k===p))$(\"fSec\").value=p;\n  calc();\n}\nfunction calc(){\n  try{\n  const c=curCat(),g=c.g,z=c.sizes.find(x=>x.n===$(\"fSize\").value)||c.sizes[0];\n  const s=z&&(z.s.find(x=>x.k===$(\"fSec\").value)||z.s[0]);\n  if(!z||!s){\n    $(\"oEmpty\").hidden=false;$(\"oEmpty\").textContent=\"No plots added for \"+c.n+\" yet. The admin can add sizes, sectors and rates in the Admin tab.\";\n    [\"oSeller\",\"oPurchaser\"].forEach(i=>$(i).innerHTML=\"\");[\"oSt\",\"oBt\"].forEach(i=>$(i).textContent=\"\");$(\"dcF\").textContent=$(\"dcE\").textContent=\"-\";\n    [\"oSTot\",\"oBTot\"].forEach(i=>$(i).textContent=fmt(0));window._sum=\"\";window._d=null;return;\n  }\n  $(\"oEmpty\").hidden=true;\n  const fbr=Number(s.f)||0,hasE=s.e!=null&&s.e!==\"\",es=hasE?Number(s.e):fbr;\n  $(\"dcF\").textContent=fmtPlain(fbr);$(\"dcE\").textContent=hasE?fmtPlain(es):\"Not listed\";\n  $(\"dcEn\").textContent=hasE?\"Plot value as per E-Stamp\":\"Not listed, FBR DC used for stamp duty\";\n  const sr=sS==\"F\"?g.sF:g.sN,br=sB==\"F\"?g.bF:g.bN;\n  const t236c=fbr*sr/100,t236k=fbr*br/100,sd=es*SD_PCT/100+SD_FIXED,fbrFee=Number(g.fbrFee)||0;\n  const sTot=t236c+g.nadra+z.pst,bTot=t236k+sd+z.tfr+fbrFee+g.nadra+g.proc;\n  const plot=c.n+\", \"+z.n+\", Sector \"+s.k;\n  $(\"oSt\").textContent=(sS==\"F\"?\"Filer\":\"Non-filer\")+\" rate: \"+sr+\"%\";\n  $(\"oBt\").textContent=(sB==\"F\"?\"Filer\":\"Non-filer\")+\" rate: \"+br+\"%\";\n  const sRows=[[\"236C advance tax\",fmt(t236c),sr+\"%\"],[\"Nadra fee\",fmt(g.nadra)],[\"PST tax\",fmt(z.pst)]];\n  const bRows=[[\"236K tax\",fmt(t236k),br+\"%\"],[\"Stamp duty\",fmt(sd)],[\"DHA transfer fee\",fmt(z.tfr)]].concat(fbrFee?[[\"FBR fee\",fmt(fbrFee)]]:[],[[\"Nadra fee\",fmt(g.nadra)],[\"Processing fee\",fmt(g.proc)]]);\n  $(\"oSeller\").innerHTML=row(\"Plot\",esc(plot))+sRows.map(r=>row(r[0],r[1],r[2])).join(\"\");\n  $(\"oPurchaser\").innerHTML=row(\"Plot\",esc(plot))+bRows.map(r=>row(r[0],r[1],r[2])).join(\"\");\n  window._d={cat:c.n,size:z.n,sec:s.k,\n   seller:{title:\"Seller Transfer Fee\",tax:\"236C advance tax\",st:sS==\"F\"?\"Filer\":\"Non-filer\",rate:sr,rows:sRows,total:fmt(sTot)},\n   buyer:{title:\"Purchaser Transfer Fee\",tax:\"236K tax & fees\",st:sB==\"F\"?\"Filer\":\"Non-filer\",rate:br,rows:bRows,total:fmt(bTot)}};\n  $(\"oSTot\").textContent=fmt(sTot);$(\"oBTot\").textContent=fmt(bTot);\n  window._sum=`DHA Multan transfer: ${plot}\\nSeller (${sS==\"F\"?\"Filer\":\"Non-filer\"}): ${fmt(sTot)}\\nPurchaser (${sB==\"F\"?\"Filer\":\"Non-filer\"}): ${fmt(bTot)}`;\n  }catch(e){$(\"oEmpty\").hidden=false;$(\"oEmpty\").textContent=\"Could not calculate: \"+e.message}\n}\n$(\"fCat\").onchange=fillSize;$(\"fSize\").onchange=fillSec;$(\"fSec\").onchange=calc;\n[[\"gS\",v=>sS=v],[\"gB\",v=>sB=v]].forEach(([id,set])=>$(id).addEventListener(\"click\",e=>{const b=e.target.closest(\"button\");if(!b)return;set(b.dataset.v);[...$(id).children].forEach(x=>x.setAttribute(\"aria-pressed\",x===b));calc()}));\n$(\"bCopy\").onclick=async()=>{try{await navigator.clipboard.writeText(window._sum||\"\");$(\"bCopy\").textContent=\"Copied\"}catch(e){$(\"bCopy\").textContent=\"Copy failed\"}setTimeout(()=>$(\"bCopy\").textContent=\"Copy summary\",1500)};\n\n\n// ---- Print ----\nfunction sheetHtml(d,p){\n  const who=p==\"seller\"?\"Seller\":\"Purchaser\",x=d[p];\n  const rows=x.rows.map(r=>`<tr><td>${esc(r[0])}${r[2]?`<small>${esc(r[2])}</small>`:\"\"}</td><td class=\"r\">${esc(r[1])}</td></tr>`).join(\"\");\n  const now=new Date().toLocaleDateString(\"en-GB\",{day:\"2-digit\",month:\"short\",year:\"numeric\"});\n  return `<div class=\"sheet\">${LH?`<img class=\"bg\" src=\"${LH}\" alt=\"\">`:\"\"}<div class=\"ct\"><h1 class=\"ttl\">${x.title}</h1><div class=\"dt\">Date: <b>${now}</b></div>\n<div class=\"meta\"><div><span>Category</span><b>${esc(d.cat)}</b></div><div><span>Plot size</span><b>${esc(d.size)}</b></div><div><span>Sector</span><b>${esc(d.sec)}</b></div><div><span>${who} status</span><b>${x.st}</b></div></div>\n<h2>${esc(x.tax)} &middot; ${x.st} rate ${x.rate}%</h2>\n<table><tr><th>Description</th><th class=\"r\">Amount</th></tr>${rows}</table>\n<div class=\"tot\"><span>${who} total</span><span>${esc(x.total)}</span></div>\n<div class=\"ft\">This is an estimate based on the rates configured in the DHA Multan transfer calculator. Final amounts are subject to DHA Multan and FBR assessment at the time of transfer.</div></div></div>`;\n}\nfunction fitSheets(){const z=Math.min(1,(window.innerWidth-16)/816);document.querySelectorAll(\"#pvBody .sheet\").forEach(e=>e.style.zoom=z)}\nwindow.addEventListener(\"resize\",fitSheets);\nlet pvHtml=\"\",LH=null;\ntry{LH=localStorage.getItem(\"dhaLH\")||null}catch(e){}\nfunction lhUi(){$(\"lhSt\").textContent=LH?\"Letterhead ready. It prints as the page background.\":\"None uploaded\";$(\"lhRm\").hidden=!LH}\nlhUi();\n$(\"lhRm\").onclick=()=>{LH=null;try{localStorage.removeItem(\"dhaLH\")}catch(e){}lhUi()};\nfunction loadLH(f){\n  if(!f)return;\n  if(!/^image\\//.test(f.type||\"\")&&!/\\.(jpe?g|png|webp|gif)$/i.test(f.name||\"\")){$(\"lhSt\").textContent=\"Please choose an image file (JPG or PNG).\";return}\n  $(\"lhSt\").textContent=\"Reading image...\";\n  const fr=new FileReader();\n  fr.onload=()=>{const im=new Image();\n    im.onload=()=>{try{\n      const k=Math.min(1,1700/im.width),c=document.createElement(\"canvas\");c.width=Math.round(im.width*k);c.height=Math.round(im.height*k);\n      const g=c.getContext(\"2d\");g.fillStyle=\"#fff\";g.fillRect(0,0,c.width,c.height);g.drawImage(im,0,0,c.width,c.height);\n      LH=c.toDataURL(\"image/jpeg\",.88);try{localStorage.setItem(\"dhaLH\",LH)}catch(err){}lhUi();\n    }catch(err){$(\"lhSt\").textContent=\"Could not read this image: \"+err.message}};\n    im.onerror=()=>{$(\"lhSt\").textContent=\"This image could not be opened. Try a JPG or PNG.\"};\n    im.src=fr.result};\n  fr.onerror=()=>{$(\"lhSt\").textContent=\"Could not read this file.\"};\n  fr.readAsDataURL(f)}\n$(\"lhFile\").addEventListener(\"change\",e=>{const f=e.target.files&&e.target.files[0];loadLH(f);try{e.target.value=\"\"}catch(x){}});\n$(\"lhFile\").addEventListener(\"input\",e=>{const f=e.target.files&&e.target.files[0];if(f&&!LH)loadLH(f)});\nconst lb=document.querySelector(\"#pm .lhbox\");\n[\"dragover\",\"drop\"].forEach(t=>lb.addEventListener(t,e=>{e.preventDefault();if(t==\"drop\")loadLH(e.dataTransfer.files[0])}));\ndocument.addEventListener(\"paste\",e=>{if($(\"pm\").hidden)return;const it=[...(e.clipboardData?e.clipboardData.items:[])].find(i=>i.type.startsWith(\"image/\"));if(it){e.preventDefault();loadLH(it.getAsFile())}});\nfunction openPreview(p){\n  const d=window._d;if(!d)return;\n  pvHtml=(p==\"both\"?[\"seller\",\"buyer\"]:[p]).map(k=>sheetHtml(d,k)).join(\"\");\n  $(\"pvBody\").innerHTML=pvHtml;$(\"pvMsg\").hidden=true;$(\"pv\").hidden=false;$(\"pv\").scrollTop=0;\n  document.body.style.overflow=\"hidden\";fitSheets();\n}\n$(\"bPrint\").onclick=()=>{if(window._d)$(\"pm\").hidden=false};\n$(\"pm\").addEventListener(\"click\",e=>{\n  if(e.target===$(\"pm\")){$(\"pm\").hidden=true;return}\n  const b=e.target.closest(\"[data-p]\");if(!b)return;\n  $(\"pm\").hidden=true;if(b.dataset.p!=\"x\")openPreview(b.dataset.p);\n});\n$(\"pvClose\").onclick=()=>{$(\"pv\").hidden=true;$(\"pvBody\").innerHTML=\"\";document.body.style.overflow=\"\"};\n$(\"pvPrint\").onclick=()=>{\n  try{window.print()}catch(e){}\n  setTimeout(()=>{const m=$(\"pvMsg\");m.hidden=false;m.textContent=\"If the print dialog did not open, printing is blocked inside this view. Use Download, then open the file in your browser and print it from there.\"},1200);\n};\n(async()=>{try{if(!window.claude)return;const dl=await claude.use(\"downloads\");if(!dl)return;\n  $(\"pvDl\").hidden=false;\n  $(\"pvDl\").onclick=async()=>{try{\n    const css=[...document.styleSheets].flatMap(ss=>{try{return[...ss.cssRules].map(r=>r.cssText)}catch(e){return[]}}).filter(t=>/\\.sheet|@page|@media print/.test(t)).join(\"\\n\");\n    const html=`<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>DHA Multan Transfer Statement</title><style>body{margin:0;background:#fff}${css}.sheet{zoom:1!important;margin:0 auto}</style></head><body><div id=\"pv\" style=\"position:static;background:#fff\"><div class=\"pvbody\">${pvHtml}</div></div></body></html>`;\n    await dl.save({filename:\"DHA-Multan-Transfer-Statement.html\",data:html});\n  }catch(e){}};\n}catch(e){}})();\n\n// ---- Admin login ----\nconst b64=b=>btoa(String.fromCharCode(...new Uint8Array(b)));\nconst unb64=t=>Uint8Array.from(atob(t),c=>c.charCodeAt(0));\nasync function hashPw(user,pw,salt){\n  const k=await crypto.subtle.importKey(\"raw\",new TextEncoder().encode(user.toLowerCase()+\":\"+pw),\"PBKDF2\",false,[\"deriveBits\"]);\n  return b64(await crypto.subtle.deriveBits({name:\"PBKDF2\",hash:\"SHA-256\",salt:unb64(salt),iterations:150000},k,256));\n}\n$(\"aForm\").onsubmit=async e=>{\n  e.preventDefault();const m=$(\"aLoginMsg\");\n  if(Date.now()<lockUntil){m.textContent=\"Too many attempts. Wait a minute and try again.\";return}\n  try{\n    const u=$(\"aUser\").value.trim(),h=await hashPw(u,$(\"aPass\").value,adminCred.salt);\n    if(u.toLowerCase()===adminCred.user&&h===adminCred.hash){loggedIn=true;tries=0;$(\"aPass\").value=\"\";m.textContent=\"\";show(true)}\n    else{tries++;m.textContent=\"Wrong username or password.\";if(tries>=5){lockUntil=Date.now()+60000;tries=0}}\n  }catch(err){m.textContent=\"Login is not available in this browser.\"}\n};\n$(\"aOut\").onclick=()=>{loggedIn=false;$(\"aUser\").value=\"\";show(true)};\n\n// ---- Change login ----\n$(\"cForm\").onsubmit=async e=>{\n  e.preventDefault();const m=$(\"cMsg\"),old=$(\"cOld\").value,nu=$(\"cUser\").value.trim().toLowerCase(),np=$(\"cNew\").value,np2=$(\"cNew2\").value;\n  try{\n    if(!old){m.textContent=\"Enter your current password.\";return}\n    if(await hashPw(adminCred.user,old,adminCred.salt)!==adminCred.hash){m.textContent=\"Current password is wrong.\";return}\n    if(!nu){m.textContent=\"Username cannot be empty.\";return}\n    if(np&&np.length<6){m.textContent=\"New password must be at least 6 characters.\";return}\n    if(np!==np2){m.textContent=\"New password and confirmation do not match.\";return}\n    if(nu===adminCred.user&&!np){m.textContent=\"Nothing to change. Enter a new username or a new password.\";return}\n    if(!isEditor||!credRef){m.textContent=\"Saving needs the owner or an invited editor signed in to claude.ai. Open the page link in claude.ai and try again.\";return}\n    const salt=b64(crypto.getRandomValues(new Uint8Array(16))),hash=await hashPw(nu,np||old,salt);\n    await credRef.set({user:nu,salt,hash});\n    adminCred={user:nu,salt,hash};\n    [\"cOld\",\"cNew\",\"cNew2\"].forEach(i=>$(i).value=\"\");\n    m.textContent=\"Login updated. Use the new username and password next time.\";\n  }catch(err){m.textContent=\"Could not update login: \"+(err.message||err.code||\"unknown error\")}\n};\n\n// ---- Admin editor ----\nconst GL={nadra:\"Nadra fee (Rs.)\",proc:\"Processing fee (Rs.)\",fbrFee:\"FBR fee (Rs.)\",sF:\"Seller 236C filer (%)\",sN:\"Seller 236C non-filer (%)\",bF:\"Purchaser 236K filer (%)\",bN:\"Purchaser 236K non-filer (%)\"};\nconst dc=()=>draft.cats[aCi];\nfunction renderAdm(){\n  const c=dc();\n  $(\"aCat\").innerHTML=draft.cats.map((x,i)=>`<option value=\"${i}\">${esc(x.n)}</option>`).join(\"\");$(\"aCat\").value=aCi;$(\"aCatName\").value=c.n;$(\"aDelCat\").disabled=draft.cats.length<2;\n  $(\"aG\").innerHTML=Object.keys(GL).map(k=>`<div><label for=\"g_${k}\">${GL[k]}</label><input id=\"g_${k}\" type=\"number\" step=\"any\" min=\"0\" value=\"${c.g[k]}\" data-g=\"${k}\"></div>`).join(\"\");\n  aIdx=Math.min(aIdx,Math.max(c.sizes.length-1,0));\n  $(\"aSize\").innerHTML=c.sizes.length?c.sizes.map((z,i)=>`<option value=\"${i}\">${esc(z.n)}</option>`).join(\"\"):'<option value=\"\">No plot sizes yet</option>';\n  const z=c.sizes[aIdx];\n  $(\"aSize\").value=z?aIdx:\"\";$(\"aPst\").value=z?z.pst:\"\";$(\"aTfr\").value=z?z.tfr:\"\";\n  $(\"aPst\").disabled=$(\"aTfr\").disabled=$(\"aAddSec\").disabled=$(\"aDelSize\").disabled=!z;\n  $(\"aT\").innerHTML=z?\"<tr><th>Sector</th><th>FBR DC</th><th>E-Stamp DC</th><th></th></tr>\"+z.s.map((x,i)=>`<tr><td><input value=\"${esc(x.k)}\" data-i=\"${i}\" data-f=\"k\" aria-label=\"Sector name\"></td><td><input type=\"number\" min=\"0\" value=\"${x.f??\"\"}\" data-i=\"${i}\" data-f=\"f\" aria-label=\"FBR DC\"></td><td><input type=\"number\" min=\"0\" value=\"${x.e??\"\"}\" placeholder=\"Not listed\" data-i=\"${i}\" data-f=\"e\" aria-label=\"E-Stamp DC\"></td><td><button class=\"btn\" data-del=\"${i}\" aria-label=\"Delete sector\">Delete</button></td></tr>`).join(\"\"):\"\";\n}\n$(\"aCat\").onchange=()=>{aCi=+$(\"aCat\").value;aIdx=0;renderAdm()};\n$(\"aCatName\").oninput=e=>{dc().n=e.target.value;const o=$(\"aCat\").options[aCi];if(o)o.textContent=e.target.value||\"(unnamed)\"};\nconst nameTaken=n=>draft.cats.some(c=>c.n.trim().toLowerCase()===n.toLowerCase());\n$(\"aAddCat\").onclick=()=>{const n=$(\"aNewCat\").value.trim(),m=$(\"aMsg\");\n  if(!n){m.textContent=\"Type a category name first.\";return}\n  if(nameTaken(n)){m.textContent=\"A category with this name already exists.\";return}\n  draft.cats.push({n,g:{...G},sizes:[]});aCi=draft.cats.length-1;aIdx=0;$(\"aNewCat\").value=\"\";\n  m.textContent=\"Category added. Fill in its rates and plot sizes, then press Save changes.\";renderAdm()};\nlet delT=null;\n$(\"aDelCat\").onclick=()=>{const b=$(\"aDelCat\"),m=$(\"aMsg\");\n  if(draft.cats.length<2){m.textContent=\"At least one category must remain.\";return}\n  if(!delT){b.textContent=\"Click again to confirm\";delT=setTimeout(()=>{delT=null;b.textContent=\"Delete this category\"},3000);return}\n  clearTimeout(delT);delT=null;b.textContent=\"Delete this category\";\n  const n=dc().n;draft.cats.splice(aCi,1);aCi=0;aIdx=0;m.textContent='Category \"'+n+'\" removed. Press Save changes to publish.';renderAdm()};\n$(\"aG\").addEventListener(\"input\",e=>{const k=e.target.dataset.g;if(k)dc().g[k]=parseFloat(e.target.value)||0});\n$(\"aSize\").onchange=()=>{aIdx=+$(\"aSize\").value;renderAdm()};\n$(\"aPst\").oninput=e=>{const z=dc().sizes[aIdx];if(z)z.pst=parseFloat(e.target.value)||0};\n$(\"aTfr\").oninput=e=>{const z=dc().sizes[aIdx];if(z)z.tfr=parseFloat(e.target.value)||0};\n$(\"aT\").addEventListener(\"input\",e=>{const t=e.target,i=t.dataset.i;if(i==null)return;const f=t.dataset.f;dc().sizes[aIdx].s[i][f]=f==\"k\"?t.value.trim():(t.value===\"\"?(f==\"e\"?null:0):parseFloat(t.value))});\n$(\"aT\").addEventListener(\"click\",e=>{const b=e.target.closest(\"[data-del]\");if(!b)return;dc().sizes[aIdx].s.splice(+b.dataset.del,1);renderAdm()});\n$(\"aAddSec\").onclick=()=>{dc().sizes[aIdx].s.push({k:\"New\",f:0,e:null});renderAdm()};\n$(\"aAddSize\").onclick=()=>{const n=$(\"aNewSize\").value.trim();if(!n){$(\"aMsg\").textContent=\"Type a plot size name first.\";return}dc().sizes.push({n,pst:0,tfr:0,s:[{k:\"New\",f:0,e:null}]});aIdx=dc().sizes.length-1;$(\"aNewSize\").value=\"\";$(\"aMsg\").textContent=\"\";renderAdm()};\n$(\"aDelSize\").onclick=()=>{dc().sizes.splice(aIdx,1);aIdx=0;renderAdm()};\n$(\"aReset\").onclick=()=>{draft=clone(DEFAULT);aCi=0;aIdx=0;renderAdm();$(\"aMsg\").textContent=\"Defaults loaded. Press Save changes to publish them.\"};\n$(\"aSave\").onclick=async()=>{\n  if(!isEditor){$(\"aMsg\").textContent=\"Saving needs the owner or an invited editor signed in to claude.ai. Open the page link in claude.ai and try again.\";return}\n  const names=draft.cats.map(c=>(c.n||\"\").trim().toLowerCase());\n  if(names.some(n=>!n)){$(\"aMsg\").textContent=\"Every category needs a name.\";return}\n  if(new Set(names).size!==names.length){$(\"aMsg\").textContent=\"Category names must be unique.\";return}\n  draft.cats.forEach(c=>c.n=c.n.trim());\n  if(draft.cats.some(c=>c.sizes.some(z=>!z.n||z.s.some(x=>!x.k)))){$(\"aMsg\").textContent=\"Every plot size and sector needs a name.\";return}\n  if(!dbRef){$(\"aMsg\").textContent=\"Saving is not available in this view. Open the page link in claude.ai while signed in as the owner.\";return}\n  try{await dbRef.set(clone(draft));$(\"aMsg\").textContent=\"Saved. Everyone now sees the new values.\"}\n  catch(e){$(\"aMsg\").textContent=\"Could not save: \"+(e.message||e.code||\"unknown error\")}\n};\nfunction show(adm){\n  $(\"vCalc\").hidden=adm;$(\"vAdm\").hidden=!adm;$(\"tCalc\").setAttribute(\"aria-pressed\",!adm);$(\"tAdm\").setAttribute(\"aria-pressed\",adm);\n  if(adm){$(\"aLock\").hidden=loggedIn;$(\"aBody\").hidden=!loggedIn;if(loggedIn){$(\"cUser\").value=adminCred.user;draft=clone(CFG);aCi=Math.min(aCi,draft.cats.length-1);renderAdm()}}\n}\n$(\"tCalc\").onclick=()=>show(false);$(\"tAdm\").onclick=()=>show(true);\n\nfillCat();\n\n// ---- Shared database (optional) ----\n(async()=>{\n  try{\n    if(!window.claude)return;\n    const db=await claude.use(\"db\");if(!db)return;\n    dbRef=db.doc(\"config/rates\");\n    credRef=db.doc(\"config/admin\");\n    credRef.onSnapshot(s=>{if(s.exists){const d=s.data();if(d&&d.user&&d.salt&&d.hash)adminCred={user:String(d.user),salt:d.salt,hash:d.hash}}},()=>{});\n    const user=await claude.use(\"user\");\n    isEditor=!!(user&&await user.canEdit());\n    dbRef.onSnapshot(s=>{\n      if(s.exists){const d=s.data();if(d&&(d.cats||d.sizes)){CFG=normalize(d);fillCat()}}\n    },()=>{});\n  }catch(e){}\n})();\n</script>\n</body>\n</html>\n","dis":"Before pay any fee double check and verify from official DHA Multan."},{"title":"Transfer Set Format","code":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><style>:root{--bg:#ffffff;--fg:#0f1917;--muted:#586864;--line:#dbe5df;--acc:#15803d;color-scheme:light}</style><script>(function(){try{window.localStorage.getItem(\"x\")}catch(e){[\"localStorage\",\"sessionStorage\"].forEach(function(k){var m={};var st={getItem:function(a){return a in m?m[a]:null},setItem:function(a,v){m[a]=String(v)},removeItem:function(a){delete m[a]},clear:function(){m={}},key:function(i){return Object.keys(m)[i]||null}};Object.defineProperty(st,\"length\",{get:function(){return Object.keys(m).length}});try{Object.defineProperty(window,k,{value:st,configurable:true})}catch(x){}})}var dbg=[];function note(t){if(!true)return;dbg.push(t);if(dbg.length>5)dbg.shift();var b=document.getElementById(\"__dbg\");if(!b&&document.body){b=document.createElement(\"pre\");b.id=\"__dbg\";b.style.cssText=\"position:fixed;left:8px;right:8px;bottom:8px;max-height:30%;overflow:auto;margin:0;padding:8px 10px;background:#2b0d0d;color:#ffd7d7;font:11px/1.4 monospace;border-radius:6px;z-index:99999;white-space:pre-wrap\";document.body.appendChild(b)}if(b)b.textContent=\"Diagnostics (only shown on this /admin address): \"+dbg.join(\" || \")}window.addEventListener(\"error\",function(e){note(\"JS error: \"+e.message)});window.addEventListener(\"unhandledrejection\",function(e){note(\"Promise error: \"+((e.reason&&e.reason.message)||e.reason))});var fq={},fn=0;window.fetch=function(u,o){o=o||{};var url=typeof u===\"string\"?u:(u&&u.url)||String(u);if(/^(data|blob):/i.test(url))return Promise.reject(new TypeError(\"blocked\"));var h={};try{var H=o.headers||(u&&u.headers);if(H)new Headers(H).forEach(function(v,k){h[k]=v})}catch(e){}return new Promise(function(res,rej){var id=++fn;fq[id]={res:res,rej:rej,m:o.method||\"GET\",u:url};parent.postMessage({type:\"fetch\",id:id,url:url,method:o.method||(u&&u.method)||\"GET\",headers:h,body:typeof o.body===\"string\"?o.body:null},\"*\");setTimeout(function(){if(fq[id]){delete fq[id];rej(new TypeError(\"Network request timed out\"))}},30000)})};window.addEventListener(\"message\",function(e){var d=e.data;if(!d||d.type!==\"fetch-res\"||!fq[d.id])return;var f=fq[d.id];delete fq[d.id];note(f.m+\" \"+f.u+\" -> \"+(d.error||d.status)+((d.error||d.status>=400||/^\\s*</.test(d.body||\"\"))?\" \"+String(d.body||\"\").slice(0,100).replace(/\\s+/g,\" \"):\"\"));if(d.error){f.rej(new TypeError(d.error));return}var nb=[101,204,205,304].indexOf(d.status)>=0;f.res(new Response(nb?null:d.body,{status:d.status,statusText:d.statusText,headers:d.headers}))});var q={},n=0;window.addEventListener(\"message\",function(e){var d=e.data;if(d&&d.type===\"store-res\"&&q[d.id]){q[d.id](d);delete q[d.id]}});function call(m){return new Promise(function(r){var id=++n;q[id]=r;parent.postMessage(Object.assign({id:id},m),\"*\");setTimeout(function(){if(q[id]){delete q[id];r({ok:false})}},8000)})}window.toolStore={load:function(){return call({type:\"store-get\"}).then(function(r){return r.ok?r.data:null})},save:function(d){return call({type:\"store-set\",data:d}).then(function(r){return !!r.ok})},siteLogin:function(u,p){return call({type:\"site-login\",user:u,pass:p}).then(function(r){return !!r.ok})},isAdmin:true}})()</script>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Property Documentation Tool</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Carlito:ital,wght@0,400;0,700;1,400;1,700&amp;family=Tinos:ital,wght@0,400;0,700;1,400;1,700&amp;family=Arimo:ital,wght@0,400;0,700;1,400;1,700&amp;family=Cousine:ital,wght@0,400;0,700;1,400;1,700&amp;family=Open+Sans:ital,wght@0,400;0,700;1,400;1,700&amp;family=Roboto:ital,wght@0,400;0,700;1,400;1,700&amp;family=Lato:ital,wght@0,400;0,700;1,400;1,700&amp;family=Merriweather:ital,wght@0,400;0,700;1,400;1,700&amp;family=Noto+Sans:ital,wght@0,400;0,700;1,400;1,700&amp;family=Poppins:ital,wght@0,400;0,700;1,400;1,700&amp;family=Montserrat:ital,wght@0,400;0,700;1,400;1,700&amp;display=swap\">\n<script>window.PDT_PRESET={\"pages\":[{\"meta\":{\"f\":\"Calibri,Carlito,\\\"Segoe UI\\\",Arial,sans-serif\",\"lh\":1.22,\"ml\":0.6,\"mr\":0.6,\"tm\":2},\"title\":\"Forwading Letter\",\"html\":\"\\u003cp data-ls=\\\"1\\\" style=\\\"line-height: 1.5;\\\">\\u003cb style=\\\"\\\">\\u003cfont style=\\\"font-size: 12pt;\\\">From \\u003c/font>\\u003c/b>\\u003c/p>\\u003cp style=\\\"text-align: left; line-height: 1.5;\\\" data-ls=\\\"1\\\">\\u003cfont style=\\\"font-size: 12pt;\\\">\\u003cspan style=\\\"white-space:pre\\\">\\t\\t\\u003c/span>Name.                \\u003cu>\\u003cb>\\u003cspan class=\\\"ph pf\\\" style=\\\"font-weight:700;text-decoration:underline\\\" contenteditable=\\\"false\\\" data-k=\\\"seller_name\\\" data-m=\\\"\\\">\\u003c/span>\\u003c/b>\\u003c/u>\\u003c/font>\\u003c/p>\\u003cp style=\\\"text-align: left; line-height: 1.5;\\\" data-ls=\\\"1\\\">\\u003cfont style=\\\"font-size: 12pt;\\\">\\u003cspan style=\\\"white-space:pre\\\">\\t\\t\\u003c/span>\\u003cspan class=\\\"ph pf\\\" style=\\\"font-weight:400;text-decoration:none\\\" contenteditable=\\\"false\\\" data-k=\\\"seller_rel\\\" data-m=\\\"|u\\\">\\u003c/span>                  \\u003cu style=\\\"\\\">\\